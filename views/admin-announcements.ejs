<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - University Announcements</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.6rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .layout { display: grid; grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; }
    .form-card { background: #fff; padding: 2rem; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); position: sticky; top: 2rem; }
    .form-card h3 { margin-bottom: 1.5rem; color: var(--navy); font-size: 1.1rem; }
    .form-group { margin-bottom: 1.2rem; }
    .form-group label { display: block; font-size: 0.8rem; font-weight: 800; margin-bottom: 0.4rem; }
    .form-control { width: 100%; padding: 0.9rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); font-size: 0.9rem; }
    .form-control:focus { border-color: var(--amber); background: #fff; outline: none; }
    textarea.form-control { resize: vertical; min-height: 120px; }
    .btn-submit { background: var(--navy); color: #fff; padding: 0.9rem; border-radius: 8px; border: none; font-weight: 800; cursor: pointer; width: 100%; transition: 0.2s; }
    .btn-submit:hover { background: var(--blue); }

    .ann-list { display: flex; flex-direction: column; gap: 1rem; }
    .ann-item { background: #fff; padding: 1.5rem; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); border-left: 4px solid var(--amber); }
    .ann-item h4 { font-size: 1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.5rem; }
    .ann-item p { font-size: 0.85rem; color: #475569; line-height: 1.5; margin-bottom: 1rem; }
    .ann-date { font-size: 0.7rem; color: #94a3b8; font-weight: 600; }

    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Admin Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/admin" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li><a href="/sis/admin/announcements" class="menu-link active"><i class="fas fa-bullhorn main-icon"></i> Announcements</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <div class="top-bar">
      <h1>University Announcements</h1>
      <p>Broadcast important messages to all students and faculty.</p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <div class="layout">
      <div class="form-card">
        <h3><i class="fas fa-plus-circle" style="color: var(--amber);"></i> New Announcement</h3>
        <form method="POST" action="/sis/admin/announcements/new">
          <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Campus Closed for Holiday" required>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea name="message" class="form-control" placeholder="Write your announcement here..." required></textarea>
          </div>
          <button type="submit" class="btn-submit">Broadcast to University</button>
        </form>
      </div>

      <div class="ann-list">
        <% if (announcements.length === 0) { %>
          <div style="background:#fff; padding: 2rem; border-radius: 1rem; text-align: center; color: #64748b;">No announcements yet.</div>
        <% } %>
        <% announcements.forEach(ann => { %>
          <div class="ann-item">
            <h4><%= ann.title %></h4>
            <p><%= ann.message %></p>
            <div class="ann-date"><i class="fas fa-clock"></i> Posted on <%= new Date(ann.created_at).toLocaleDateString() %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>
</body>
</html>