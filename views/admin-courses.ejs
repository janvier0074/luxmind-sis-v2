<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Catalog — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f4f7f9] text-[#0a1e32] font-sans min-h-screen flex">

  <aside class="w-72 bg-[#0a1e32] text-white flex flex-col justify-between h-screen sticky top-0 overflow-y-auto shrink-0">
    <div class="p-6 border-b border-[#1e3a5f]">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 bg-[#0f2a44] rounded-xl flex items-center justify-center font-black text-xl text-[#ffc857] border border-[#f5a623]/30">A</div>
        <div>
          <h2 class="font-extrabold text-base">LuxMind SIS</h2>
          <p class="text-[10px] font-bold text-[#f5a623] uppercase tracking-widest">Registrar</p>
        </div>
      </div>
    </div>
    <nav class="px-3 py-4 flex-1 space-y-1">
      <a href="/sis/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-home text-[#f5a623] text-sm"></i> Dashboard</a>
      <a href="/sis/admin/approvals" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-check-double text-[#f5a623] text-sm"></i> Approvals</a>
      <a href="/sis/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-user-graduate text-[#f5a623] text-sm"></i> Students</a>
      <a href="/sis/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-chalkboard-teacher text-[#f5a623] text-sm"></i> Teachers</a>
      <a href="/sis/admin/faculties" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-university text-[#f5a623] text-sm"></i> Faculties</a>
      <a href="/sis/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-[#f5a623] text-[#0a1e32] shadow-md"><i class="fas fa-book text-sm"></i> Course Catalog</a>
      <a href="/sis/admin/sections" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-layer-group text-[#f5a623] text-sm"></i> Sections</a>
      <a href="/sis/admin/finance" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-wallet text-[#f5a623] text-sm"></i> Finance</a>
      <a href="/sis/admin/documents" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-file-alt text-[#f5a623] text-sm"></i> Documents</a>
      <a href="/sis/admin/leave" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-plane-departure text-[#f5a623] text-sm"></i> Leave Requests</a>
    </nav>
    <footer class="p-4 border-t border-[#1e3a5f] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#f5a623] text-[#0a1e32] font-black flex items-center justify-center text-xs">AD</div>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate"><%= user.full_name %></h4>
          <p class="text-[10px] text-slate-400 font-semibold">Registrar</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <main class="flex-1 p-8 overflow-y-auto">
    <header class="mb-6 pb-4 border-b border-slate-200">
      <div class="flex items-center gap-2 text-[11px] font-extrabold text-amber-600 uppercase tracking-widest">
        <i class="fas fa-book"></i> Academic Management
      </div>
      <h1 class="text-3xl font-black mt-1">Course Catalog</h1>
      <p class="text-xs text-slate-500 mt-1">Create courses and assign them to faculties and departments.</p>
    </header>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="bg-emerald-100 text-emerald-700 p-4 rounded-xl font-bold text-xs mb-4"><i class="fas fa-check-circle mr-2"></i><%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="bg-rose-100 text-rose-700 p-4 rounded-xl font-bold text-xs mb-4"><i class="fas fa-exclamation-circle mr-2"></i><%= flash.error[0] %></div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      
      <!-- Create Course Form -->
      <article class="bg-white p-6 rounded-2xl border border-slate-200">
        <h2 class="font-extrabold text-sm mb-4"><i class="fas fa-plus-circle text-amber-500 mr-2"></i>Add New Course</h2>
        <form action="/sis/admin/courses/new" method="POST" class="space-y-3">
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Course Code *</label>
            <input type="text" name="code" required placeholder="e.g. CMPE 303" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none focus:border-amber-500">
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Course Title *</label>
            <input type="text" name="title" required placeholder="e.g. Database Systems" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none focus:border-amber-500">
          </div>

          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Faculty *</label>
            <select name="faculty_id" id="course_faculty" required onchange="filterDepartments()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
              <option value="">-- Select Faculty --</option>
              <% faculties.forEach(f => { %>
                <option value="<%= f.id %>"><%= f.name %> (<%= f.code %>)</option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Department *</label>
            <select name="department_id" id="course_department" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
              <option value="">-- Select Faculty First --</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Credits</label>
              <input type="number" name="credits" required min="1" max="10" value="3" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Semester</label>
              <input type="number" name="semester_number" required min="1" max="8" value="1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Prerequisite (Optional)</label>
            <select name="prerequisite_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
              <option value="">None</option>
              <% courses.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.code %> - <%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Max Capacity (Quota)</label>
            <input type="number" name="quota" min="1" value="40" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
          </div>
          <button type="submit" class="w-full py-2 bg-[#0a1e32] text-white font-extrabold text-xs rounded-lg hover:bg-[#0f2a44] mt-2">
            <i class="fas fa-save mr-1"></i> Create Course
          </button>
        </form>
      </article>

      <!-- Course List -->
      <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden lg:col-span-2">
        <div class="p-5 border-b border-slate-100">
          <h2 class="font-extrabold text-sm"><i class="fas fa-list text-amber-500 mr-2"></i>Active Catalog (<%= courses.length %> courses)</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[800px]">
            <thead>
              <tr class="bg-slate-50">
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Code</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Title</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Faculty / Dept</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200 text-center">Sem</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200 text-center">CR</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Prereq</th>
              </tr>
            </thead>
            <tbody>
              <% if (courses.length === 0) { %>
                <tr><td colspan="6" class="text-center py-6 text-slate-400 text-xs">No courses yet.</td></tr>
              <% } %>
              <% courses.forEach(c => { %>
                <tr class="border-b border-slate-100 hover:bg-slate-50">
                  <td class="px-4 py-3 text-xs font-extrabold"><%= c.code %></td>
                  <td class="px-4 py-3 text-xs font-semibold text-slate-600"><%= c.title %></td>
                  <td class="px-4 py-3 text-[11px] font-semibold">
                    <% if (c.faculty_name) { %>
                      <div class="text-slate-700"><i class="fas fa-university text-[9px] mr-1 text-amber-500"></i><%= c.faculty_name %></div>
                    <% } else { %>
                      <div class="text-slate-400 italic">No faculty</div>
                    <% } %>
                    <% if (c.department_name) { %>
                      <div class="text-slate-500 mt-0.5"><i class="fas fa-building text-[9px] mr-1"></i><%= c.department_name %></div>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-xs font-bold text-center"><%= c.semester_number %></td>
                  <td class="px-4 py-3 text-xs font-bold text-center text-amber-600"><%= c.credits %></td>
                  <td class="px-4 py-3 text-xs font-semibold">
                    <% if (c.prereq_code) { %>
                      <span class="px-2 py-1 bg-rose-100 text-rose-700 rounded text-[10px] font-bold"><%= c.prereq_code %></span>
                    <% } else { %>
                      <span class="text-slate-400 italic">None</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </article>

    </div>
  </main>

  <script>
    const allDepartments = <%- JSON.stringify(departments || []) %>;

    function filterDepartments() {
      const facultyId = document.getElementById('course_faculty').value;
      const deptSelect = document.getElementById('course_department');
      
      deptSelect.innerHTML = '<option value="">-- Select Department --</option>';
      
      if (!facultyId) {
        deptSelect.innerHTML = '<option value="">-- Select Faculty First --</option>';
        return;
      }
      
      const filtered = allDepartments.filter(d => String(d.faculty_id) === String(facultyId));
      
      if (filtered.length === 0) {
        deptSelect.innerHTML = '<option value="">-- No Departments --</option>';
        return;
      }
      
      filtered.forEach(d => {
        const option = document.createElement('option');
        option.value = d.id;
        option.textContent = d.name;
        deptSelect.appendChild(option);
      });
    }
  </script>

</body>
</html>