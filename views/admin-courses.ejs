<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Catalog — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: { extend: { colors: { navy: { 950: '#040d18', 900: '#0a1e32', 800: '#0f2a44', 700: '#153658', 600: '#1e4d7b', 500: '#2d6a9f' }, amber: { 500: '#f5a623', 400: '#ffb73d' }, gold: { 500: '#ffc857', 400: '#ffd57e' }, ice: { 50: '#f8fafc', 100: '#f4f7f9', 200: '#e6edf3' } }, fontFamily: { sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'] } } }
    }
  </script>
  <style>
    .glass-panel { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); }
    .dark .glass-panel { background: rgba(15, 42, 68, 0.88); border-color: rgba(255, 255, 255, 0.08); }
    @keyframes liveBeacon { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.8); } }
    .live-beacon { animation: liveBeacon 1.6s infinite ease-in-out; }
  </style>
</head>
<body class="bg-ice-100 dark:bg-navy-950 text-navy-900 dark:text-slate-100 font-sans min-h-screen flex flex-col md:flex-row transition-colors duration-300 antialiased overflow-x-hidden">

  <!-- MOBILE HEADER -->
  <header class="md:hidden sticky top-0 z-40 bg-navy-900 text-white px-4 py-3 flex items-center justify-between border-b border-navy-800 shadow-md">
    <div class="flex items-center gap-3">
      <figure class="w-9 h-9 bg-navy-800 rounded-lg flex items-center justify-center font-black text-gold-500 border border-amber-500/30">A</figure>
      <div>
        <h1 class="font-extrabold text-sm leading-tight">Admin Portal</h1>
        <p class="text-[10px] text-amber-400 font-semibold tracking-wider uppercase">LuxMind SIS</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-lg bg-navy-800 text-amber-400 flex items-center justify-center text-sm"><i class="fas fa-moon dark:hidden"></i><i class="fas fa-sun hidden dark:block"></i></button>
      <button onclick="openSidebarDrawer()" class="w-9 h-9 rounded-lg bg-amber-500 text-navy-950 flex items-center justify-center text-lg font-bold"><i class="fas fa-bars"></i></button>
    </div>
  </header>

  <button id="mobileBackdrop" onclick="closeSidebarDrawer()" class="fixed inset-0 z-40 bg-navy-950/70 backdrop-blur-sm hidden md:hidden opacity-0 transition-opacity duration-300"></button>

  <!-- SIDEBAR -->
  <aside id="sidebar" class="fixed md:sticky top-0 inset-y-0 left-0 z-50 w-72 bg-navy-900 text-white flex flex-col justify-between border-r border-navy-800 shadow-2xl md:shadow-none transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out h-screen overflow-y-auto">
    <div class="p-6 border-b border-navy-800/80 shrink-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <figure class="w-11 h-11 bg-navy-800 rounded-xl flex items-center justify-center font-black text-xl text-gold-500 shadow-md border border-amber-500/30">A</figure>
          <div>
            <h2 class="font-extrabold text-base tracking-tight leading-tight text-white">LuxMind SIS</h2>
            <p class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mt-0.5">Registrar</p>
          </div>
        </div>
        <button onclick="closeSidebarDrawer()" class="md:hidden text-slate-400 hover:text-white p-1 text-lg"><i class="fas fa-times"></i></button>
      </div>
    </div>

    <nav class="px-3 py-4 flex-1 overflow-y-auto space-y-1">
      <a href="/sis/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-home text-amber-500 text-sm"></i> Dashboard
      </a>
      <a href="/sis/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-user-graduate text-amber-500 text-sm"></i> Students
      </a>
      <a href="/sis/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-chalkboard-teacher text-amber-500 text-sm"></i> Teachers
      </a>
      <a href="/sis/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-navy-950 shadow-md transition-all">
        <i class="fas fa-book text-sm"></i> Course Catalog
      </a>
      <a href="/sis/admin/sections" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-layer-group text-amber-500 text-sm"></i> Sections
      </a>
      <a href="/sis/admin/finance" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-wallet text-amber-500 text-sm"></i> Finance
      </a>
      <a href="/sis/admin/documents" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-file-alt text-amber-500 text-sm"></i> Documents
      </a>
    </nav>

    <footer class="p-4 border-t border-navy-800 bg-navy-950/60 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <figure class="w-9 h-9 rounded-full bg-amber-500 text-navy-950 font-black flex items-center justify-center text-xs shadow-inner">AD</figure>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate"><%= user.full_name || 'Admin' %></h4>
          <p class="text-[10px] text-slate-400 font-semibold truncate">Registrar Office</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2 text-sm transition-colors" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 max-w-[1600px] mx-auto px-4 sm:px-6 md:px-8 py-6 w-full space-y-6">
    
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-navy-800">
      <div>
        <div class="flex items-center gap-2 text-[11px] font-extrabold text-amber-600 dark:text-amber-400 uppercase tracking-widest"><i class="fas fa-book"></i> Academic Management</div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-900 dark:text-white tracking-tight mt-0.5">Course Catalog</h1>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">Create courses and assign prerequisites.</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="toggleDarkMode()" class="flex w-10 h-10 rounded-xl bg-white dark:bg-navy-800 text-slate-700 dark:text-amber-400 border border-slate-200 dark:border-navy-700 items-center justify-center hover:bg-slate-50 transition-all shadow-sm"><i class="fas fa-moon text-sm dark:hidden"></i><i class="fas fa-sun text-sm hidden dark:block"></i></button>
      </div>
    </header>

    <!-- FLASH MESSAGES -->
    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="bg-emerald-100 text-emerald-700 p-4 rounded-xl font-bold text-xs"><i class="fas fa-check-circle mr-2"></i><%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="bg-rose-100 text-rose-700 p-4 rounded-xl font-bold text-xs"><i class="fas fa-exclamation-circle mr-2"></i><%= flash.error[0] %></div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      
      <!-- Add Course Form -->
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-6 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm lg:col-span-1">
        <h2 class="font-extrabold text-sm mb-4 text-navy-900 dark:text-white"><i class="fas fa-plus-circle text-amber-500 mr-2"></i>Add New Course</h2>
        <form action="/sis/admin/courses/new" method="POST" class="space-y-3">
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Course Code</label>
            <input type="text" name="code" required placeholder="e.g. CMPE 303" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Course Title</label>
            <input type="text" name="title" required placeholder="e.g. Database Systems" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Credits</label>
              <input type="number" name="credits" required min="1" max="10" value="3" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Semester</label>
              <input type="number" name="semester_number" required min="1" max="8" value="1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Prerequisite (Optional)</label>
            <select name="prerequisite_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
              <option value="">None</option>
              <% courses.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.code %> - <%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Max Capacity (Quota)</label>
            <input type="number" name="quota" min="1" value="40" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold focus:outline-none">
          </div>
          <button type="submit" class="w-full py-2 bg-navy-900 text-white font-extrabold text-xs rounded-lg hover:bg-navy-800 transition-all mt-2">
            <i class="fas fa-save mr-1"></i> Create Course
          </button>
        </form>
      </article>

      <!-- Course List Table -->
      <article class="glass-panel bg-white dark:bg-navy-900/80 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm overflow-hidden lg:col-span-2">
        <div class="p-5 border-b border-slate-100 dark:border-navy-800">
          <h2 class="font-extrabold text-sm text-navy-900 dark:text-white"><i class="fas fa-list text-amber-500 mr-2"></i>Active Catalog</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[600px]">
            <thead>
              <tr class="bg-slate-50 dark:bg-navy-950/50">
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Code</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Title</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200 text-center">Sem</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200 text-center">CR</th>
                <th class="px-4 py-3 text-[10px] font-extrabold uppercase text-slate-500 border-b border-slate-200">Prerequisite</th>
              </tr>
            </thead>
            <tbody>
              <% if (courses.length === 0) { %>
                <tr><td colspan="5" class="text-center py-6 text-slate-400 text-xs">No courses found. Add one to get started.</td></tr>
              <% } %>
              
              <% courses.forEach(c => { %>
                <tr class="border-b border-slate-100 dark:border-navy-800/50 hover:bg-slate-50 transition-colors">
                  <td class="px-4 py-3 text-xs font-extrabold text-navy-900"><%= c.code %></td>
                  <td class="px-4 py-3 text-xs font-semibold text-slate-600"><%= c.title %></td>
                  <td class="px-4 py-3 text-xs font-bold text-center text-navy-900"><%= c.semester_number %></td>
                  <td class="px-4 py-3 text-xs font-bold text-center text-amber-600"><%= c.credits %></td>
                  <td class="px-4 py-3 text-xs font-semibold text-slate-500">
                    <% if (c.prereq_code) { %>
                      <span class="px-2 py-1 bg-rose-100 text-rose-700 rounded text-[10px] font-bold"><i class="fas fa-lock text-[9px] mr-1"></i><%= c.prereq_code %></span>
                    <% } else { %>
                      <span class="text-slate-400 italic">None</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </article>

    </div>
  </main>

  <script>
    function openSidebarDrawer() { document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('mobileBackdrop').classList.remove('hidden'); setTimeout(() => document.getElementById('mobileBackdrop').classList.remove('opacity-0'), 10); }
    function closeSidebarDrawer() { document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('mobileBackdrop').classList.add('opacity-0'); setTimeout(() => document.getElementById('mobileBackdrop').classList.add('hidden'), 300); }
    function toggleDarkMode() { document.documentElement.classList.toggle('dark'); }
  </script>
</body>
</html>