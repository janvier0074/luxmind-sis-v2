<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registrar Command Center — LuxMind SIS</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            navy: { 950: '#040d18', 900: '#0a1e32', 800: '#0f2a44', 700: '#153658', 600: '#1e4d7b', 500: '#2d6a9f' },
            amber: { 500: '#f5a623', 400: '#ffb73d' },
            gold: { 500: '#ffc857', 400: '#ffd57e' },
            ice: { 50: '#f8fafc', 100: '#f4f7f9', 200: '#e6edf3' }
          },
          fontFamily: { sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: rgba(10, 30, 50, 0.05); }
    .dark ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
    ::-webkit-scrollbar-thumb { background: #1e4d7b; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #f5a623; }

    .glass-panel { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    .dark .glass-panel { background: rgba(15, 42, 68, 0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-color: rgba(255, 255, 255, 0.08); }
    
    @keyframes liveBeacon { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.8); } }
    .live-beacon { animation: liveBeacon 1.6s infinite ease-in-out; }
  </style>
</head>
<body class="bg-ice-100 dark:bg-navy-950 text-navy-900 dark:text-slate-100 font-sans min-h-screen flex flex-col md:flex-row transition-colors duration-300 antialiased overflow-x-hidden">

  <!-- MOBILE HEADER -->
  <header class="md:hidden sticky top-0 z-40 bg-navy-900 text-white px-4 py-3 flex items-center justify-between border-b border-navy-800 shadow-md">
    <div class="flex items-center gap-3">
      <figure class="w-9 h-9 bg-navy-800 rounded-lg flex items-center justify-center font-black text-gold-500 border border-amber-500/30">A</figure>
      <div>
        <h1 class="font-extrabold text-sm leading-tight">Admin Portal</h1>
        <p class="text-[10px] text-amber-400 font-semibold tracking-wider uppercase">LuxMind SIS</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-lg bg-navy-800 text-amber-400 flex items-center justify-center text-sm"><i class="fas fa-moon dark:hidden"></i><i class="fas fa-sun hidden dark:block"></i></button>
      <button onclick="openSidebarDrawer()" class="w-9 h-9 rounded-lg bg-amber-500 text-navy-950 flex items-center justify-center text-lg font-bold"><i class="fas fa-bars"></i></button>
    </div>
  </header>

  <button id="mobileBackdrop" onclick="closeSidebarDrawer()" class="fixed inset-0 z-40 bg-navy-950/70 backdrop-blur-sm hidden md:hidden opacity-0 transition-opacity duration-300"></button>

  <!-- SIDEBAR (Admin) -->
  <aside id="sidebar" class="fixed md:sticky top-0 inset-y-0 left-0 z-50 w-72 bg-navy-900 text-white flex flex-col justify-between border-r border-navy-800 shadow-2xl md:shadow-none transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out h-screen overflow-y-auto">
    
    <div class="p-6 border-b border-navy-800/80 shrink-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <figure class="w-11 h-11 bg-navy-800 rounded-xl flex items-center justify-center font-black text-xl text-gold-500 shadow-md border border-amber-500/30">A</figure>
          <div>
            <h2 class="font-extrabold text-base tracking-tight leading-tight text-white">LuxMind SIS</h2>
            <p class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mt-0.5">Registrar</p>
          </div>
        </div>
        <button onclick="closeSidebarDrawer()" class="md:hidden text-slate-400 hover:text-white p-1 text-lg"><i class="fas fa-times"></i></button>
      </div>
    </div>

    <nav class="px-3 py-4 flex-1 overflow-y-auto space-y-1">
      <a href="/sis/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-navy-950 shadow-md transition-all">
        <i class="fas fa-home text-sm"></i> Dashboard
      </a>
      <a href="/sis/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-user-graduate text-amber-500 text-sm"></i> Students
      </a>
      <a href="/sis/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-chalkboard-teacher text-amber-500 text-sm"></i> Teachers
      </a>
      <a href="/sis/admin/sections" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-layer-group text-amber-500 text-sm"></i> Sections
      </a>
      <a href="/sis/admin/finance" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-wallet text-amber-500 text-sm"></i> Finance
      </a>
      <a href="/sis/admin/documents" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
        <i class="fas fa-file-alt text-amber-500 text-sm"></i> Documents
      </a>
    </nav>

    <footer class="p-4 border-t border-navy-800 bg-navy-950/60 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <figure class="w-9 h-9 rounded-full bg-amber-500 text-navy-950 font-black flex items-center justify-center text-xs shadow-inner">AD</figure>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate"><%= user.full_name || 'Admin' %></h4>
          <p class="text-[10px] text-slate-400 font-semibold truncate">Registrar Office</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2 text-sm transition-colors" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 max-w-[1600px] mx-auto px-4 sm:px-6 md:px-8 py-6 w-full space-y-6">
    
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-navy-800">
      <div>
        <div class="flex items-center gap-2 text-[11px] font-extrabold text-amber-600 dark:text-amber-400 uppercase tracking-widest"><i class="fas fa-building"></i> University Registrar</div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-900 dark:text-white tracking-tight mt-0.5">Command Center</h1>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">Manage students, staff, and university operations.</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="toggleDarkMode()" class="flex w-10 h-10 rounded-xl bg-white dark:bg-navy-800 text-slate-700 dark:text-amber-400 border border-slate-200 dark:border-navy-700 items-center justify-center hover:bg-slate-50 transition-all shadow-sm"><i class="fas fa-moon text-sm dark:hidden"></i><i class="fas fa-sun text-sm hidden dark:block"></i></button>
      </div>
    </header>

    <!-- STATS ROW -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-user-graduate"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Total Students</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= stats.students %></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-chalkboard-teacher"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Total Teachers</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= stats.teachers %></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-clock"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Pending Regs</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= stats.pendingRegs %></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-file-alt"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Pending Docs</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= stats.pendingDocs %></div>
      </article>
    </section>

    <!-- CHARTS ROW -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Enrollment Chart -->
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm flex flex-col">
        <h2 class="font-extrabold text-sm text-navy-900 dark:text-white mb-4 flex items-center gap-2"><i class="fas fa-chart-bar text-amber-500"></i> Students by Faculty</h2>
        <div class="flex-1 min-h-[250px] relative">
          <canvas id="facultyChart"></canvas>
        </div>
      </article>

      <!-- Financial Chart -->
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm flex flex-col">
        <h2 class="font-extrabold text-sm text-navy-900 dark:text-white mb-4 flex items-center gap-2"><i class="fas fa-chart-pie text-emerald-500"></i> Financial Status</h2>
        <div class="flex-1 min-h-[250px] relative flex justify-center">
          <canvas id="financeChart"></canvas>
        </div>
      </article>
    </section>



<!-- TARGETED ANNOUNCEMENT FORM -->
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm mt-6" style="max-width: 600px;">
  <h3 class="font-extrabold text-sm mb-4"><i class="fas fa-bullhorn text-amber-500 mr-2"></i>Send Targeted Announcement</h3>
  <form action="/sis/announcements/send-targeted" method="POST" class="space-y-3">
    <input type="hidden" name="redirect_to" value="/sis/admin">
    <select name="target_role" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
      <option value="all">Everyone</option>
      <option value="student">All Students</option>
      <option value="teacher">All Teachers</option>
      <option value="advisor">All Advisors</option>
    </select>
    <input type="text" name="title" required placeholder="Message Title" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
    <textarea name="message" required rows="2" placeholder="Type your message here..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold"></textarea>
    <button type="submit" class="w-full py-2 bg-navy-900 text-white font-bold text-xs rounded-lg hover:bg-navy-800 transition-colors">Send Message</button>
  </form>
</div>


  </main>

  <script>
    function openSidebarDrawer() { document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('mobileBackdrop').classList.remove('hidden'); setTimeout(() => document.getElementById('mobileBackdrop').classList.remove('opacity-0'), 10); }
    function closeSidebarDrawer() { document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('mobileBackdrop').classList.add('opacity-0'); setTimeout(() => document.getElementById('mobileBackdrop').classList.add('hidden'), 300); }
    function toggleDarkMode() { document.documentElement.classList.toggle('dark'); setTimeout(initCharts, 200); }

    let facultyChartInstance = null;
    let financeChartInstance = null;

    function initCharts() {
      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#94a3b8' : '#64748b';
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

      // 1. Faculty Chart
      const ctx1 = document.getElementById('facultyChart').getContext('2d');
      if (facultyChartInstance) facultyChartInstance.destroy();
      
      facultyChartInstance = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: <%- JSON.stringify(chartData.facultyLabels) %>,
          datasets: [{
            label: 'Students',
            data: <%- JSON.stringify(chartData.facultyData) %>,
            backgroundColor: '#f5a623',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: textColor, font: { size: 10 } }, grid: { display: false } },
            y: { ticks: { color: textColor, stepSize: 1 }, grid: { color: gridColor } }
          }
        }
      });

      // 2. Finance Chart
      const ctx2 = document.getElementById('financeChart').getContext('2d');
      if (financeChartInstance) financeChartInstance.destroy();
      
      financeChartInstance = new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: ['Collected', 'Outstanding'],
          datasets: [{
            data: [<%= chartData.totalPaid %>, <%= chartData.totalOutstanding %>],
            backgroundColor: ['#10b981', '#ef4444'],
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false, cutout: '75%',
          plugins: {
            legend: { position: 'bottom', labels: { color: textColor, font: { size: 11, weight: 'bold' } } }
          }
        }
      });
    }

    window.addEventListener('DOMContentLoaded', initCharts);
  </script>
</body>
</html>