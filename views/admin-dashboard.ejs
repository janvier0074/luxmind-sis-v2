<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Admin Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Dashboard Cards */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1.2rem; }
    .stat-icon { width: 55px; height: 55px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-icon.students { background: #e0f2fe; color: #0284c7; }
    .stat-icon.teachers { background: #dcfce7; color: #16a34a; }
    .stat-icon.courses { background: #fef3c7; color: #d97706; }
    .stat-icon.pending { background: #fee2e2; color: #b91c1c; }
    .stat-info h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); margin-top: 0.2rem; }

    .welcome-banner { background: linear-gradient(135deg, var(--navy), var(--blue)); color: #fff; padding: 2.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border-bottom: 4px solid var(--amber); }
    .welcome-banner h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem; }
    .welcome-banner p { font-size: 1rem; color: #cbd5e1; font-weight: 500; }
  </style>
</head>
<body>

  <!-- ADMIN SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Admin Portal</span></div>
    </div>

    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/admin" class="menu-link active"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <!-- USER MANAGEMENT -->
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-users main-icon"></i> User Management <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/admin/students" class="menu-link"><i class="fas fa-user-graduate main-icon"></i> Students</a></li>
          <li class="menu-item"><a href="/sis/admin/teachers" class="menu-link"><i class="fas fa-chalkboard-teacher main-icon"></i> Teachers</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-user-tie main-icon"></i> Advisors</a></li>
        </ul>
      </li>

      <!-- ACADEMIC MANAGEMENT -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-university main-icon"></i> Academic Management <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-book main-icon"></i> Course Catalog</a></li>
         <li class="menu-item"><a href="/sis/admin/sections" class="menu-link"><i class="fas fa-layer-group main-icon"></i> Sections & Groups</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-list main-icon"></i> Curriculum Setup</a></li>
        </ul>
      </li>

      <!-- REGISTRATION CONTROL -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-clipboard-check main-icon"></i> Registration Control <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-alt main-icon"></i> Active Semester</a></li>
          <li class="menu-item"><a href="/sis/admin/registrations" class="menu-link"><i class="fas fa-tasks main-icon"></i> All Registrations</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-user-friends main-icon"></i> Advisor Assignments</a></li>
        </ul>
      </li>

      <!-- FINANCE -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-wallet main-icon"></i> Finance <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-invoice-dollar main-icon"></i> Fee Structure</a></li>
         <li class="menu-item"><a href="/sis/admin/finance" class="menu-link"><i class="fas fa-credit-card main-icon"></i> Payments & Balances</a></li>
        </ul>
      </li>
  
      <!-- DOCUMENT REQUESTS -->
      <li class="menu-item">
        <a href="/sis/admin/documents" class="menu-link">
          <i class="fas fa-file-alt main-icon"></i> Document Requests
        </a>
      </li>



      <!-- SYSTEM SETTINGS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-cog main-icon"></i> System Settings <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-bullhorn main-icon"></i> Announcements</a></li>
          <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <div class="top-bar">
      <div class="greeting">
        <h1><%= greeting %>, Registrar 👋</h1>
        <p>University overview and control center.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-shield"></i>
        <%= user.full_name || user.username %>
      </div>
    </div>

    <!-- STATS ROW -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon students"><i class="fas fa-user-graduate"></i></div>
        <div class="stat-info">
          <h3>Total Students</h3>
          <p><%= stats.students %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon teachers"><i class="fas fa-chalkboard-teacher"></i></div>
        <div class="stat-info">
          <h3>Total Teachers</h3>
          <p><%= stats.teachers %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon courses"><i class="fas fa-book"></i></div>
        <div class="stat-info">
          <h3>Total Courses</h3>
          <p><%= stats.courses %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon pending"><i class="fas fa-clock"></i></div>
        <div class="stat-info">
          <h3>Pending Regs</h3>
          <p><%= stats.pending %></p>
        </div>
      </div>
    </div>

    <!-- WELCOME BANNER -->
    <div class="welcome-banner">
      <h2>Welcome to the Registrar Portal</h2>
      <p>From here, you can register new students, create course sections, assign advisors, and control the overall operations of LuxMind University.</p>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
  </script>
</body>
</html>