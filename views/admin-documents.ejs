<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LuxMind SIS - Admin Documents</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1rem; }
    .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-icon.pending { background: #fef3c7; color: #d97706; }
    .stat-icon.ready { background: #dcfce7; color: #16a34a; }
    .stat-icon.rejected { background: #fee2e2; color: #dc2626; }
    .stat-info h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; font-weight: 800; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); }

    /* Table */
    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1.2rem 1rem; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; }
    .data-table td { padding: 1.2rem 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; vertical-align: top; }
    .data-table tr:hover { background: var(--ice); }
    
    .student-info { display: flex; flex-direction: column; }
    .student-info strong { color: var(--navy); font-size: 1rem; }
    .student-info span { color: var(--blue); font-size: 0.8rem; margin-top: 0.2rem; }
    
    .doc-info { display: flex; flex-direction: column; }
    .doc-info strong { color: var(--navy); }
    .doc-info .note { font-size: 0.75rem; color: #94a3b8; font-style: italic; margin-top: 0.3rem; font-weight: 500; max-width: 250px; }
    
    .badge { padding: 0.3rem 0.8rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge.pending { background: #fef3c7; color: #d97706; }
    .badge.ready { background: #dcfce7; color: #16a34a; }
    .badge.rejected { background: #fee2e2; color: #dc2626; }
    
    .btn-action { padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.8rem; font-weight: 800; cursor: pointer; border: none; transition: 0.2s; margin-right: 0.5rem; display: inline-flex; align-items: center; gap: 0.4rem; }
    .btn-ready { background: #dcfce7; color: #16a34a; }
    .btn-ready:hover { background: #16a34a; color: #fff; transform: translateY(-2px); }
    .btn-reject { background: #fee2e2; color: #dc2626; }
    .btn-reject:hover { background: #dc2626; color: #fff; transform: translateY(-2px); }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Admin Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/admin" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/admin/students" class="menu-link"><i class="fas fa-users"></i> User Management</a></li>
      <li><a href="/sis/admin/registrations" class="menu-link"><i class="fas fa-clipboard-check"></i> All Registrations</a></li>
      <li><a href="/sis/admin/finance" class="menu-link"><i class="fas fa-wallet"></i> Finance</a></li>
      <li><a href="/sis/admin/documents" class="menu-link active"><i class="fas fa-file-alt"></i> Document Requests</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <div class="top-bar">
      <h1>Document Requests</h1>
      <p>Review, approve, and process student documents.</p>
    </div>

    <% 
      const pendingCount = requests.filter(r => r.status === 'pending').length;
      const readyCount = requests.filter(r => r.status === 'ready').length;
      const rejectedCount = requests.filter(r => r.status === 'rejected').length;
    %>
    
    <!-- STATS -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon pending"><i class="fas fa-clock"></i></div>
        <div class="stat-info">
          <h3>Pending Requests</h3>
          <p><%= pendingCount %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon ready"><i class="fas fa-check-circle"></i></div>
        <div class="stat-info">
          <h3>Documents Ready</h3>
          <p><%= readyCount %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon rejected"><i class="fas fa-times-circle"></i></div>
        <div class="stat-info">
          <h3>Rejected</h3>
          <p><%= rejectedCount %></p>
        </div>
      </div>
    </div>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student Details</th>
            <th>Document Details</th>
            <th>Date</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr><td colspan="5" style="text-align: center; padding: 3rem; color: #64748b;">No document requests found.</td></tr>
          <% } %>
          
          <% requests.forEach(req => { %>
            <tr>
              <td>
                <div class="student-info">
                  <strong><%= req.student_name %></strong>
                  <span>ID: <%= req.username %></span>
                </div>
              </td>
              <td>
                <div class="doc-info">
                  <strong><%= req.document_type %></strong>
                  <% if (req.notes) { %>
                    <span class="note">"<%= req.notes %>"</span>
                  <% } %>
                </div>
              </td>
              <td><%= new Date(req.requested_at).toLocaleDateString() %></td>
              <td><span class="badge <%= req.status %>"><%= req.status %></span></td>
              <td>
                <% if (req.status === 'pending') { %>
                  <form method="POST" action="/sis/admin/documents/<%= req.id %>/status" style="display: inline;">
                    <input type="hidden" name="status" value="ready">
                    <button type="submit" class="btn-action btn-ready"><i class="fas fa-check"></i> Mark Ready</button>
                  </form>
                  <form method="POST" action="/sis/admin/documents/<%= req.id %>/status" style="display: inline;">
                    <input type="hidden" name="status" value="rejected">
                    <button type="submit" class="btn-action btn-reject"><i class="fas fa-times"></i> Reject</button>
                  </form>
                <% } else { %>
                  <span style="color: #94a3b8; font-size: 0.8rem; font-weight: 700;">Processed</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>