<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Manage Exams</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .layout { display: grid; grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; }
    
    .form-card { background: #fff; padding: 2rem; border-radius: 1.5rem; box-shadow: var(--shadow); border: 1px solid var(--frost); position: sticky; top: 2rem; }
    .form-card h3 { margin-bottom: 1.5rem; color: var(--navy); font-size: 1.2rem; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 800; margin-bottom: 0.5rem; }
    .form-control { width: 100%; padding: 1rem; border: 1px solid var(--frost); border-radius: 10px; font-family: inherit; background: var(--ice); outline: none; }
    .btn-submit { background: var(--navy); color: #fff; padding: 1rem; border-radius: 10px; border: none; font-weight: 800; cursor: pointer; width: 100%; transition: 0.2s; }
    .btn-submit:hover { background: var(--blue); }

    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1.2rem 1rem; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; }
    .data-table td { padding: 1.2rem 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .btn-back { display: inline-flex; }
      .layout { grid-template-columns: 1fr; gap: 1rem; }
      .table-container { overflow-x: auto; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Admin Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/admin" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/admin/students" class="menu-link"><i class="fas fa-users"></i> User Management</a></li>
      <li><a href="/sis/admin/exams" class="menu-link active"><i class="fas fa-file-signature"></i> Exam Schedule</a></li>
      <li><a href="/sis/admin/finance" class="menu-link"><i class="fas fa-wallet"></i> Finance</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Exam Schedule</h1>
      <p>Create and manage upcoming exams.</p>
    </div>

    <div class="layout">
      <div class="form-card">
        <h3><i class="fas fa-plus-circle" style="color: var(--amber);"></i> Schedule New Exam</h3>
        <form method="POST" action="/sis/admin/exams/new">
          <div class="form-group">
            <label>Select Course</label>
            <select name="course_id" class="form-control" required>
              <option value="" disabled selected>-- Choose course --</option>
              <% courses.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.code %> - <%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Exam Type</label>
            <select name="exam_type" class="form-control" required>
              <option value="Midterm">Midterm</option>
              <option value="Final">Final</option>
            </select>
          </div>
          <div class="form-group">
            <label>Date</label>
            <input type="date" name="exam_date" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Start Time</label>
            <input type="text" name="start_time" class="form-control" placeholder="e.g. 09:00" required>
          </div>
          <div class="form-group">
            <label>Room</label>
            <input type="text" name="room" class="form-control" placeholder="e.g. Exam Hall 1" required>
          </div>
          <button type="submit" class="btn-submit">Schedule Exam</button>
        </form>
      </div>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Type</th>
              <th>Date & Time</th>
              <th>Room</th>
            </tr>
          </thead>
          <tbody>
            <% exams.forEach(exam => { %>
              <tr>
                <td><strong><%= exam.code %></strong> - <%= exam.title %></td>
                <td><%= exam.exam_type %></td>
                <td><%= new Date(exam.exam_date).toLocaleDateString() %> at <%= exam.start_time %></td>
                <td><%= exam.room %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>
</body>
</html>