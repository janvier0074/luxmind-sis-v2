<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= faculty.name %> — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f4f7f9] text-[#0a1e32] font-sans min-h-screen flex">

  <!-- SIDEBAR -->
  <aside class="w-72 bg-[#0a1e32] text-white flex flex-col justify-between h-screen sticky top-0 overflow-y-auto shrink-0">
    <div class="p-6 border-b border-[#1e3a5f]">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 bg-[#0f2a44] rounded-xl flex items-center justify-center font-black text-xl text-[#ffc857] border border-[#f5a623]/30">A</div>
        <div>
          <h2 class="font-extrabold text-base">LuxMind SIS</h2>
          <p class="text-[10px] font-bold text-[#f5a623] uppercase tracking-widest">Registrar</p>
        </div>
      </div>
    </div>

    <nav class="px-3 py-4 flex-1 space-y-1">
      <a href="/sis/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-home text-[#f5a623] text-sm"></i> Dashboard</a>
      <a href="/sis/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-user-graduate text-[#f5a623] text-sm"></i> Students</a>
      <a href="/sis/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-chalkboard-teacher text-[#f5a623] text-sm"></i> Teachers</a>
      <a href="/sis/admin/faculties" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-[#f5a623] text-[#0a1e32] shadow-md"><i class="fas fa-university text-sm"></i> Faculties</a>
      <a href="/sis/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-book text-[#f5a623] text-sm"></i> Course Catalog</a>
    </nav>

    <footer class="p-4 border-t border-[#1e3a5f] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#f5a623] text-[#0a1e32] font-black flex items-center justify-center text-xs">AD</div>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate"><%= user.full_name %></h4>
          <p class="text-[10px] text-slate-400 font-semibold">Registrar</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <main class="flex-1 p-8 overflow-y-auto">
    
    <a href="/sis/admin/faculties" class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 hover:text-amber-600 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Faculties
    </a>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="bg-emerald-100 text-emerald-700 p-4 rounded-xl font-bold text-xs mb-4"><i class="fas fa-check-circle mr-2"></i><%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="bg-rose-100 text-rose-700 p-4 rounded-xl font-bold text-xs mb-4"><i class="fas fa-exclamation-circle mr-2"></i><%= flash.error[0] %></div>
    <% } %>

    <!-- FACULTY HERO -->
    <div class="bg-gradient-to-r from-[#0a1e32] to-[#1e4d7b] text-white p-8 rounded-2xl mb-6 shadow-xl">
      <div class="flex justify-between items-start">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-1 bg-[#ffc857] text-[#0a1e32] rounded text-xs font-black"><%= faculty.code %></span>
            <% if (faculty.is_active) { %>
              <span class="px-2 py-1 bg-emerald-500/20 text-emerald-300 rounded text-[10px] font-black">ACTIVE</span>
            <% } else { %>
              <span class="px-2 py-1 bg-rose-500/20 text-rose-300 rounded text-[10px] font-black">INACTIVE</span>
            <% } %>
          </div>
          <h1 class="text-3xl font-black"><%= faculty.name %></h1>
          <p class="text-slate-300 text-sm mt-2"><%= faculty.description || 'No description' %></p>
        </div>
        <div class="text-right">
          <p class="text-[10px] font-extrabold uppercase text-[#ffc857]">Current Dean</p>
          <p class="text-xl font-black mt-1"><%= faculty.dean_name || 'Not Assigned' %></p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- DEAN ASSIGNMENT -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200">
        <h2 class="font-extrabold text-sm mb-4"><i class="fas fa-user-tie text-amber-500 mr-2"></i>Assign Dean</h2>
        <form action="/sis/admin/faculties/<%= faculty.id %>/assign-dean" method="POST" class="space-y-3">
          <select name="dean_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
            <option value="">-- No Dean --</option>
            <% teachers.forEach(t => { %>
              <option value="<%= t.id %>" <%= faculty.dean_id === t.id ? 'selected' : '' %>><%= t.full_name %></option>
            <% }) %>
          </select>
          <button type="submit" class="w-full py-2 bg-[#0a1e32] text-white font-extrabold text-xs rounded-lg hover:bg-[#0f2a44]">
            <i class="fas fa-save mr-1"></i> Update Dean
          </button>
        </form>
      </div>

      <!-- CREATE DEPARTMENT -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200 lg:col-span-2">
        <h2 class="font-extrabold text-sm mb-4"><i class="fas fa-plus-circle text-amber-500 mr-2"></i>Create New Department</h2>
        <form action="/sis/admin/faculties/<%= faculty.id %>/departments/new" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Department Name *</label>
            <input type="text" name="name" required placeholder="e.g., Computer Engineering" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Code</label>
            <input type="text" name="code" placeholder="e.g., CMPE" maxlength="10" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
          </div>
          <div>
            <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Head (Optional)</label>
            <select name="head_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
              <option value="">-- No Head --</option>
              <% teachers.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.full_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="md:col-span-3">
            <button type="submit" class="w-full py-2 bg-[#0a1e32] text-white font-extrabold text-xs rounded-lg hover:bg-[#0f2a44]">
              <i class="fas fa-save mr-1"></i> Create Department
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- DEPARTMENTS LIST -->
    <div class="mt-8">
      <h2 class="font-extrabold text-lg mb-4"><i class="fas fa-building text-amber-500 mr-2"></i>Departments</h2>
      
      <% if (departments.length === 0) { %>
        <div class="bg-white p-8 text-center rounded-2xl border-2 border-dashed border-slate-200">
          <i class="fas fa-building text-3xl text-slate-300 mb-2 block"></i>
          <p class="text-sm font-bold text-slate-500">No departments yet. Create one above.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <% departments.forEach(d => { %>
            <div class="bg-white p-4 rounded-xl border border-slate-200">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-extrabold text-sm"><%= d.name %></h3>
                  <p class="text-[10px] font-bold text-slate-500 uppercase mt-0.5"><%= d.code || 'N/A' %></p>
                </div>
                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px] font-black"><%= d.student_count %> students</span>
              </div>
              
              <form action="/sis/admin/faculties/<%= faculty.id %>/departments/<%= d.id %>/assign-head" method="POST" class="flex gap-2">
                <select name="head_id" class="flex-1 px-2 py-1.5 bg-slate-50 border border-slate-200 rounded text-[11px] font-semibold">
                  <option value="">-- No Head --</option>
                  <% teachers.forEach(t => { %>
                    <option value="<%= t.id %>" <%= d.head_id === t.id ? 'selected' : '' %>><%= t.full_name %></option>
                  <% }) %>
                </select>
                <button type="submit" class="px-3 py-1.5 bg-[#f5a623] text-[#0a1e32] rounded text-[11px] font-black hover:bg-[#e09513]">
                  <i class="fas fa-check"></i>
                </button>
              </form>
              <p class="text-[10px] text-slate-500 mt-2"><i class="fas fa-user-tie mr-1"></i>Head: <strong><%= d.head_name || 'Not Assigned' %></strong></p>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>
</body>
</html>