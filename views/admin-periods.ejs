<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Academic Periods</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: Inter, sans-serif; background: #f4f6fa; }
    .navy { background: #101c35; }
    .amber { color: #d99b27; }
  </style>
</head>
<body class="min-h-screen text-slate-800">

  <header class="navy text-white px-6 py-5 shadow-lg">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="text-xl font-extrabold tracking-tight">LuxMind <span class="amber">SIS</span></div>
        <div class="text-xs text-slate-300 mt-1">Academic Period Management</div>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <span class="text-slate-300"><%= user.full_name %></span>
        <a href="/sis/admin" class="text-amber-400 hover:text-white">Dashboard</a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-5 py-8">

    <div class="flex flex-wrap justify-between items-start gap-4 mb-7">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Academic Periods</h1>
        <p class="text-sm text-slate-500 mt-1">Create and manage academic years and terms.</p>
      </div>
      <a href="/sis/admin/sections"
         class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-sm font-semibold hover:bg-slate-50">
        Manage Sections & Groups
      </a>
    </div>

    <% if (success && success.length) { %>
      <% success.forEach(message => { %>
        <div class="mb-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">
          <%= message %>
        </div>
      <% }) %>
    <% } %>

    <% if (error && error.length) { %>
      <% error.forEach(message => { %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm">
          <%= message %>
        </div>
      <% }) %>
    <% } %>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-8">
      <h2 class="text-lg font-bold mb-1">Create Academic Period</h2>
      <p class="text-sm text-slate-500 mb-5">
        New periods are created inactive. You must activate a period before using it for new sections.
      </p>

      <form action="/sis/admin/periods/new" method="POST" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">Academic Year *</label>
          <input name="academic_year" required placeholder="e.g. 2026/2027"
                 class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">Term *</label>
          <select name="term" required
                  class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm bg-white">
            <option value="">Select term</option>
            <option value="Fall">Fall</option>
            <option value="Spring">Spring</option>
            <option value="Summer">Summer</option>
            <option value="Full Year">Full Year</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">Start Date *</label>
          <input type="date" name="start_date" required
                 class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">End Date *</label>
          <input type="date" name="end_date" required
                 class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">Registration Opens</label>
          <input type="datetime-local" name="registration_open_at"
                 class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-2">Registration Closes</label>
          <input type="datetime-local" name="registration_close_at"
                 class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm">
        </div>

        <div class="md:col-span-2 lg:col-span-3 flex justify-end">
          <button type="submit"
                  class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm px-6 py-3 rounded-lg">
            Create Academic Period
          </button>
        </div>
      </form>
    </section>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-200">
        <h2 class="text-lg font-bold">Existing Academic Periods</h2>
        <p class="text-sm text-slate-500 mt-1">Only one academic period can be active at a time.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-500 uppercase text-xs">
            <tr>
              <th class="px-5 py-4">Academic Year</th>
              <th class="px-5 py-4">Term</th>
              <th class="px-5 py-4">Dates</th>
              <th class="px-5 py-4">Registration Window</th>
              <th class="px-5 py-4">Sections</th>
              <th class="px-5 py-4">Status</th>
              <th class="px-5 py-4">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (!periods.length) { %>
              <tr>
                <td colspan="7" class="px-5 py-10 text-center text-slate-400">
                  No academic periods found.
                </td>
              </tr>
            <% } %>

            <% periods.forEach(period => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-5 py-4 font-bold text-slate-800"><%= period.academic_year %></td>
                <td class="px-5 py-4"><%= period.term %></td>
                <td class="px-5 py-4 whitespace-nowrap">
                  <%= period.start_date ? String(period.start_date).slice(0, 10) : '—' %>
                  <span class="text-slate-400">to</span>
                  <%= period.end_date ? String(period.end_date).slice(0, 10) : '—' %>
                </td>
                <td class="px-5 py-4 text-xs whitespace-nowrap">
                  <div>Opens: <%= period.registration_open_at ? new Date(period.registration_open_at).toLocaleString() : 'Not set' %></div>
                  <div class="mt-1">Closes: <%= period.registration_close_at ? new Date(period.registration_close_at).toLocaleString() : 'Not set' %></div>
                </td>
                <td class="px-5 py-4"><%= period.section_count %></td>
                <td class="px-5 py-4">
                  <% if (period.is_active) { %>
                    <span class="inline-block rounded-full bg-emerald-100 text-emerald-800 px-3 py-1 text-xs font-bold">Active</span>
                  <% } else { %>
                    <span class="inline-block rounded-full bg-slate-100 text-slate-600 px-3 py-1 text-xs font-bold">Inactive</span>
                  <% } %>
                </td>
                <td class="px-5 py-4">
                  <% if (!period.is_active) { %>
                    <form action="/sis/admin/periods/<%= period.id %>/activate" method="POST"
                          onsubmit="return confirm('Activate this academic period? The currently active period will become inactive.');">
                      <button type="submit"
                              class="rounded-lg bg-slate-900 hover:bg-slate-700 text-white px-3 py-2 text-xs font-bold">
                        Activate
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-xs font-semibold text-emerald-700">Current period</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <p class="text-xs text-slate-400 mt-5">
      Activating a period does not move existing sections or registrations to another period.
    </p>

  </main>
</body>
</html>