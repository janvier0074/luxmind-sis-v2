<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New Student — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f4f7f9] text-[#0a1e32] font-sans min-h-screen flex">

  <aside class="w-72 bg-[#0a1e32] text-white flex flex-col justify-between h-screen sticky top-0 overflow-y-auto shrink-0">
    <div class="p-6 border-b border-[#1e3a5f]">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 bg-[#0f2a44] rounded-xl flex items-center justify-center font-black text-xl text-[#ffc857] border border-[#f5a623]/30">A</div>
        <div>
          <h2 class="font-extrabold text-base">LuxMind SIS</h2>
          <p class="text-[10px] font-bold text-[#f5a623] uppercase tracking-widest">Registrar</p>
        </div>
      </div>
    </div>
    <nav class="px-3 py-4 flex-1 space-y-1">
      <a href="/sis/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-home text-[#f5a623] text-sm"></i> Dashboard</a>
      <a href="/sis/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-[#f5a623] text-[#0a1e32] shadow-md"><i class="fas fa-user-graduate text-sm"></i> Students</a>
      <a href="/sis/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-chalkboard-teacher text-[#f5a623] text-sm"></i> Teachers</a>
      <a href="/sis/admin/faculties" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-university text-[#f5a623] text-sm"></i> Faculties</a>
      <a href="/sis/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-[#0f2a44] hover:text-white"><i class="fas fa-book text-[#f5a623] text-sm"></i> Course Catalog</a>
    </nav>
    <footer class="p-4 border-t border-[#1e3a5f] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#f5a623] text-[#0a1e32] font-black flex items-center justify-center text-xs">AD</div>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate"><%= user.full_name %></h4>
          <p class="text-[10px] text-slate-400 font-semibold">Registrar</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <main class="flex-1 p-8 overflow-y-auto">
    <a href="/sis/admin/students" class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 hover:text-amber-600 mb-4">
      <i class="fas fa-arrow-left"></i> Back to Students
    </a>

    <header class="mb-6 pb-4 border-b border-slate-200">
      <div class="flex items-center gap-2 text-[11px] font-extrabold text-amber-600 uppercase tracking-widest">
        <i class="fas fa-user-plus"></i> Student Administration
      </div>
      <h1 class="text-3xl font-black mt-1">Add New Student</h1>
      <p class="text-xs text-slate-500 mt-1">Register a new student and assign them to a faculty.</p>
    </header>

    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="bg-rose-100 text-rose-700 p-4 rounded-xl font-bold text-xs mb-4"><i class="fas fa-exclamation-circle mr-2"></i><%= flash.error[0] %></div>
    <% } %>

    <div class="bg-white p-8 rounded-2xl border border-slate-200 max-w-3xl">
      <form action="/sis/admin/students/new" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Full Name *</label>
          <input type="text" name="full_name" required placeholder="John Doe" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Username *</label>
          <input type="text" name="username" required placeholder="johndoe" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Email</label>
          <input type="email" name="email" placeholder="john@luxmind.edu" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Admission Number</label>
          <input type="text" name="admission_number" placeholder="Auto-generated if empty" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Faculty *</label>
          <select name="faculty_id" id="faculty_id" required onchange="filterDepartments()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
            <option value="">-- Select Faculty --</option>
            <% faculties.forEach(f => { %>
              <option value="<%= f.id %>"><%= f.name %> (<%= f.code %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Department *</label>
          <select name="department_id" id="department_id" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
            <option value="">-- Select Faculty First --</option>
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Program / Class Level</label>
          <input type="text" name="class_level" value="Computer Engineering" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Advisor</label>
          <select name="advisor_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
            <option value="">-- No Advisor --</option>
            <% advisors.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.full_name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">Student Type</label>
          <select name="is_international" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
            <option value="false">Local Student</option>
            <option value="true">International Student</option>
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-extrabold uppercase text-slate-500 mb-1">High School GPA</label>
          <input type="number" name="high_school_gpa" step="0.01" min="0" max="4" placeholder="e.g., 3.50" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-semibold focus:outline-none focus:border-amber-500">
        </div>

        <div class="md:col-span-2">
          <button type="submit" class="w-full py-3 bg-[#0a1e32] text-white font-extrabold text-sm rounded-lg hover:bg-[#0f2a44] transition-all">
            <i class="fas fa-save mr-2"></i> Create Student
          </button>
        </div>

      </form>
    </div>
  </main>

  <script>
    const allDepartments = <%- JSON.stringify(departments || []) %>;

    function filterDepartments() {
      const facultyId = document.getElementById('faculty_id').value;
      const deptSelect = document.getElementById('department_id');
      
      deptSelect.innerHTML = '<option value="">-- Select Department --</option>';
      
      if (!facultyId) {
        deptSelect.innerHTML = '<option value="">-- Select Faculty First --</option>';
        return;
      }
      
      const filtered = allDepartments.filter(d => String(d.faculty_id) === String(facultyId));
      
      if (filtered.length === 0) {
        deptSelect.innerHTML = '<option value="">-- No Departments in this Faculty --</option>';
        return;
      }
      
      filtered.forEach(d => {
        const option = document.createElement('option');
        option.value = d.id;
        option.textContent = d.name;
        deptSelect.appendChild(option);
      });
    }
  </script>

</body>
</html>