<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Advisees — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }
    
    /* Sidebar (Premium) */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 30px rgba(0,0,0,0.15); z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); box-shadow: 0 4px 12px rgba(245,166,35,0.35); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; margin-top: 2px; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.15), transparent); border-left-color: var(--gold); }
    .menu-link i { width: 24px; color: var(--gold); font-size: 0.9rem; }
    .submenu { list-style: none; background: rgba(0,0,0,0.15); padding: 0.5rem 0; }
    .submenu .menu-link { padding-left: 3rem; font-size: 0.8rem; }

    /* Main Content */
    .main-content { margin-left: 280px; padding: 3rem; flex: 1; width: calc(100% - 280px); max-width: 1400px; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.85rem; transition: var(--transition); }
    .btn-back:hover { color: var(--amber); transform: translateX(-3px); }
    
    .header-wrap { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; }
    .page-title h1 { font-size: 2rem; font-weight: 800; letter-spacing: -1px; margin-bottom: 0.3rem; }
    .page-title p { color: #64748b; font-size: 0.95rem; font-weight: 500; }

    /* Stat Cards */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1.2rem; transition: var(--transition); position: relative; overflow: hidden; }
    .stat-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--amber); }
    .stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
    .stat-icon { width: 55px; height: 55px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-icon.total { background: #e0f2fe; color: #0284c7; }
    .stat-icon.gpa { background: #dcfce7; color: #16a34a; }
    .stat-icon.risk { background: #fee2e2; color: #b91c1c; }
    .stat-info h3 { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; font-weight: 800; }
    .stat-info p { font-size: 1.8rem; font-weight: 800; color: var(--navy); line-height: 1.2; }

    /* Table Container */
    .table-container { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .table-header { padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eef2f7; }
    .table-header h2 { font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 0.6rem; }
    .table-header h2 i { color: var(--amber); }
    
    .search-box { display: flex; align-items: center; gap: 0.6rem; background: #f8fafc; padding: 0.6rem 1.2rem; border-radius: 100px; border: 1px solid var(--frost); width: 300px; transition: var(--transition); }
    .search-box:focus-within { border-color: var(--amber); background: #fff; box-shadow: 0 0 0 3px rgba(245,166,35,0.1); }
    .search-box i { color: #94a3b8; }
    .search-box input { border: none; background: transparent; outline: none; font-family: inherit; font-weight: 600; font-size: 0.85rem; width: 100%; color: var(--navy); }

    table { width: 100%; border-collapse: collapse; }
    thead { background: #f8fafc; }
    th { padding: 1rem 1.5rem; text-align: left; font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--frost); }
    td { padding: 1.2rem 1.5rem; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
    tbody tr { transition: var(--transition); }
    tbody tr:hover { background: #fbfdff; transform: scale(1.002); }
    
    .student-cell { display: flex; align-items: center; gap: 1rem; }
    .avatar { width: 45px; height: 45px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 1rem; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .student-name { font-weight: 800; font-size: 0.95rem; color: var(--navy); }
    .student-id { font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-top: 2px; }
    
    .badge-gpa { padding: 0.4rem 0.8rem; border-radius: 100px; font-size: 0.85rem; font-weight: 800; display: inline-block; }
    .gpa-high { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
    .gpa-mid { background: #fef3c7; color: #b45309; border: 1px solid #fcd34d; }
    .gpa-low { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    .btn-action { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; background: var(--navy); color: #fff; text-decoration: none; border-radius: 100px; font-size: 0.8rem; font-weight: 800; transition: var(--transition); }
    .btn-action:hover { background: var(--amber); transform: translateX(3px); box-shadow: 0 4px 12px rgba(245,166,35,0.3); }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-mark">L</div><div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div></div>
    <ul class="sidebar-menu">
      <li><a href="/sis/faculty" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li>
        <a href="#" class="menu-link active"><i class="fas fa-user-friends"></i> Advising</a>
        <ul class="submenu">
          <li><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-check-circle"></i> Approvals</a></li>
          <li><a href="/sis/advisor/advisees" class="menu-link active"><i class="fas fa-users"></i> My Advisees</a></li>
        </ul>
      </li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    
    <div class="header-wrap">
      <div class="page-title">
        <h1>My Advisees</h1>
        <p>Monitor academic standing, CGPA, and progress for your assigned students.</p>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon total"><i class="fas fa-user-graduate"></i></div>
        <div class="stat-info"><h3>Total Advisees</h3><p><%= totalAdvisees %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon gpa"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info"><h3>Average CGPA</h3><p><%= avgCGPA %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon risk"><i class="fas fa-triangle-exclamation"></i></div>
        <div class="stat-info"><h3>At Risk (< 2.0)</h3><p><%= atRiskCount %></p></div>
      </div>
    </div>

    <div class="table-container">
      <div class="table-header">
        <h2><i class="fas fa-list"></i> Advisee Directory</h2>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Search by name or ID..." oninput="filterTable()">
        </div>
      </div>
      <table>
        <thead>
          <tr>
            <th>Student Name</th>
            <th>Program / Semester</th>
            <th>CGPA</th>
            <th>Credits Earned</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="adviseeBody">
          <% if (advisees.length === 0) { %>
            <tr><td colspan="5" style="text-align:center; padding: 4rem; color: #94a3b8; font-size: 1rem;"><i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 1rem; display: block; color: var(--frost);"></i>No advisees assigned to you yet.</td></tr>
          <% } %>
          <% advisees.forEach(student => { %>
            <% 
              const cgpaNum = Number(student.cgpa);
              let gpaClass = 'gpa-mid';
              if (cgpaNum >= 3.0) gpaClass = 'gpa-high';
              if (cgpaNum < 2.0) gpaClass = 'gpa-low';
              
              const colors = ['#1e4d7b', '#0284c7', '#9333ea', '#d97706', '#16a34a', '#b91c1c'];
              const colorIdx = (student.full_name || 'A').charCodeAt(0) % colors.length;
              const initials = student.full_name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            %>
            <tr data-search="<%= (student.full_name + ' ' + (student.admission_number || '')).toLowerCase() %>">
              <td>
                <div class="student-cell">
                  <div class="avatar" style="background: <%= colors[colorIdx] %>;"><%= initials %></div>
                  <div>
                    <div class="student-name"><%= student.full_name %></div>
                    <div class="student-id"><%= student.admission_number || 'No ID' %></div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-weight: 700; font-size: 0.85rem;"><%= student.class_level %></div>
                <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Semester <%= student.current_semester %></div>
              </td>
              <td><span class="badge-gpa <%= gpaClass %>"><%= cgpaNum.toFixed(2) %></span></td>
              <td><span style="font-size: 1.05rem; font-weight: 800; color: var(--navy);"><%= student.credits_earned %></span> <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">cr</span></td>
              <td>
                <a href="/sis/advisor/advisees/<%= student.id %>" class="btn-action">View Progress <i class="fas fa-arrow-right"></i></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function filterTable() {
      const q = document.getElementById('searchInput').value.toLowerCase().trim();
      document.querySelectorAll('#adviseeBody tr[data-search]').forEach(row => {
        row.style.display = row.dataset.search.includes(q) ? '' : 'none';
      });
    }
  </script>
</body>
</html>