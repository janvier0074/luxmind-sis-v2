<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Advisor Portal — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    html, body { overflow-x: hidden; max-width: 100vw; width: 100%; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: radial-gradient(circle at 100% 0%, rgba(245,166,35,0.06), transparent 40%), radial-gradient(circle at 0% 100%, rgba(30,77,123,0.05), transparent 40%), var(--ice);
      min-height: 100vh; display: flex; color: var(--navy);
    }

    /* Massive Sidebar (Teacher + Advisor) */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; scrollbar-width: thin; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; }
    
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s ease; }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.18), transparent); border-left-color: var(--gold); }
    
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.18); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .submenu .submenu .menu-link { padding-left: 3.5rem; font-size: 0.7rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }
    .menu-item.open > .menu-link { color: #fff; }

    /* Main */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); max-width: calc(100vw - 280px); }
    .page-title { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
    .page-title-icon { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--navy), var(--blue)); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.4rem; }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; color: var(--navy); }
    .page-title p { color: #64748b; font-size: 0.9rem; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; margin-bottom: 2rem; }
    .stat-card { background: #fff; padding: 1.2rem; border-radius: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1rem; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .stat-icon.blue { background: #e0f2fe; color: #0284c7; }
    .stat-icon.gold { background: #fef3c7; color: #d97706; }
    .stat-info h3 { font-size: 0.7rem; color: #64748b; text-transform: uppercase; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); margin-top: 0.1rem; }

    /* Table */
    .table-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .table-toolbar { padding: 1.2rem 1.4rem; border-bottom: 1px solid #eef2f7; display: flex; justify-content: space-between; align-items: center; }
    .table-toolbar h2 { font-size: 1.05rem; font-weight: 800; }
    .table-wrap { width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 600px; }
    th { background: #f8fafc; color: #64748b; font-size: 0.7rem; text-transform: uppercase; font-weight: 800; padding: 1rem 1.4rem; text-align: left; border-bottom: 2px solid var(--frost); }
    td { padding: 1rem 1.4rem; border-bottom: 1px solid #eef2f7; font-size: 0.85rem; font-weight: 600; color: var(--navy); }
    .cgpa-badge { display: inline-block; padding: 0.3rem 0.7rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; }
    .cgpa-badge.excellent { background: #dcfce7; color: #15803d; }
    .cgpa-badge.warning { background: #fef3c7; color: #b45309; }
    .cgpa-badge.danger { background: #fee2e2; color: #991b1b; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; max-width: 100vw !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">A</div>
      <div class="brand-name">LuxMind SIS <span>Advisor Portal</span></div>
    </div>
    
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/advisor" class="menu-link active"><i class="fas fa-home main-icon"></i> Dashboard</a></li>

      <!-- ADVISING (Primary) -->
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-user-friends main-icon"></i> Advising <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-check-circle main-icon"></i> Registration Approvals</a></li>
          <li class="menu-item"><a href="/sis/advisor/withdrawals" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Withdrawal Requests</a></li>
        </ul>
      </li>

      <!-- MY COURSES (Teaching Role) -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> My Courses <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-list main-icon"></i> Course List</a></li>
          <li class="menu-item"><a href="/sis/faculty/class-roster" class="menu-link"><i class="fas fa-users main-icon"></i> Class Roster</a></li>
          <li class="menu-item"><a href="/sis/faculty/course-materials" class="menu-link"><i class="fas fa-folder main-icon"></i> Content & Materials</a></li>
          <li class="menu-item"><a href="/sis/faculty/course-weights" class="menu-link"><i class="fas fa-sliders main-icon"></i> Course Weights</a></li>
          <li class="menu-item"><a href="/sis/faculty/evaluations" class="menu-link"><i class="fas fa-poll main-icon"></i> Course Evaluations</a></li>
        </ul>
      </li>

      <!-- GRADING & EXAMS (Teaching Role) -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-pen main-icon"></i> Grading & Exams <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/grades" class="menu-link"><i class="fas fa-marker main-icon"></i> Gradebook Entry</a></li>
          <li class="menu-item"><a href="/sis/faculty/publish-results" class="menu-link"><i class="fas fa-cloud-upload-alt main-icon"></i> Publish Results</a></li>
          <li class="menu-item"><a href="/sis/faculty/exam-objections" class="menu-link"><i class="fas fa-exclamation-circle main-icon"></i> Exam Objections</a></li>
          <li class="menu-item"><a href="/sis/faculty/makeup-exams" class="menu-link"><i class="fas fa-undo main-icon"></i> Makeup Exams</a></li>
        </ul>
      </li>

      <!-- COMMUNICATION -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-comments main-icon"></i> Communication <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/announcements" class="menu-link"><i class="fas fa-bullhorn main-icon"></i> Announcements</a></li>
          <li class="menu-item"><a href="/sis/faculty/messages" class="menu-link"><i class="fas fa-envelope main-icon"></i> Messaging</a></li>
        </ul>
      </li>

      <!-- SYSTEM -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-cog main-icon"></i> System <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/profile" class="menu-link"><i class="fas fa-user-cog main-icon"></i> My Profile</a></li>
          <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <main class="main-content">
    <header class="page-title">
      <div class="page-title-icon"><i class="fas fa-user-tie"></i></div>
      <div>
        <h1>Advisor Dashboard</h1>
        <p>Monitor your advisees and manage your teaching schedule</p>
      </div>
    </header>

    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-users"></i></div>
        <div class="stat-info"><h3>My Advisees</h3><p><%= advisees.length %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon gold"><i class="fas fa-clock"></i></div>
        <div class="stat-info"><h3>Pending Approvals</h3><p><%= pendingCount %></p></div>
      </div>
    </section>

    <section class="table-card">
      <div class="table-toolbar">
        <h2>My Advisees</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student Name</th>
              <th>ID</th>
              <th>Semester</th>
              <th>CGPA</th>
            </tr>
          </thead>
          <tbody>
            <% if (advisees.length === 0) { %>
              <tr><td colspan="4" style="text-align: center; padding: 2rem; color: #94a3b8;">No students assigned to you yet.</td></tr>
            <% } %>
            <% advisees.forEach(st => { %>
              <% 
                const gpa = Number(st.cgpa);
                let badgeClass = gpa >= 3.0 ? 'excellent' : (gpa >= 2.0 ? 'warning' : 'danger');
              %>
              <tr>
                <td><strong><%= st.full_name %></strong></td>
                <td><%= st.admission_number || '—' %></td>
                <td>Semester <%= st.current_semester %></td>
                <td><span class="cgpa-badge <%= badgeClass %>"><%= gpa.toFixed(2) %> / 4.00</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) { sb.classList.toggle('active'); ov.classList.toggle('active'); }
    }
  </script>
</body>
</html>