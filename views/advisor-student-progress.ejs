<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Academic Progress — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }
    
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(245,166,35,0.18); border-left-color: var(--gold); }
    .menu-link i { width: 22px; color: var(--gold); }
    .submenu { list-style: none; background: rgba(0,0,0,0.18); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.85rem; }
    
    .student-hero { background: linear-gradient(135deg, var(--navy), var(--deep)); border-radius: 1.5rem; padding: 2rem; color: #fff; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    .hero-avatar { width: 80px; height: 80px; border-radius: 20px; background: var(--amber); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--navy); }
    .hero-title h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.3rem; }
    .hero-subtitle { font-size: 0.9rem; color: #cbd5e1; display: flex; gap: 1rem; }
    
    .hero-right { display: flex; gap: 1rem; }
    .hero-stat { background: rgba(255,255,255,0.1); padding: 1rem 1.5rem; border-radius: 1rem; text-align: center; }
    .hero-stat span { display: block; font-size: 0.65rem; color: var(--gold); text-transform: uppercase; font-weight: 800; margin-bottom: 0.3rem; }
    .hero-stat strong { font-size: 1.5rem; font-weight: 800; }

    .progress-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .info-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); overflow: hidden; }
    .card-head { padding: 1.2rem; border-bottom: 1px solid #eef2f7; }
    .card-head h2 { font-size: 1rem; font-weight: 800; }
    .card-body { padding: 1.4rem; }
    
    .enrollment-item { padding: 1rem; background: #f8fafc; border-radius: 10px; margin-bottom: 0.8rem; }
    .code { font-size: 0.75rem; font-weight: 800; color: var(--blue); background: #e0f2fe; padding: 0.2rem 0.5rem; border-radius: 6px; }
    .title { font-size: 0.9rem; font-weight: 800; margin-top: 0.4rem; }
    
    .semester-title { font-size: 0.85rem; font-weight: 800; margin-bottom: 0.8rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--frost); }
    .grade-badge { padding: 0.2rem 0.5rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; }
    .grade-a { background: #dcfce7; color: #15803d; }
    .grade-f { background: #fee2e2; color: #991b1b; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-mark">L</div><div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div></div>
    <ul class="sidebar-menu">
      <li><a href="/sis/faculty" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li>
        <a href="#" class="menu-link active"><i class="fas fa-user-friends"></i> Advising</a>
        <ul class="submenu">
          <li><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-check-circle"></i> Approvals</a></li>
          <li><a href="/sis/advisor/advisees" class="menu-link active"><i class="fas fa-users"></i> My Advisees</a></li>
        </ul>
      </li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/advisor/advisees" class="btn-back"><i class="fas fa-arrow-left"></i> Back to My Advisees</a>

    <div class="student-hero">
      <div class="hero-left" style="display: flex; gap: 1.5rem; align-items: center;">
        <div class="hero-avatar"><%= student.full_name.substring(0,2).toUpperCase() %></div>
        <div class="hero-title">
          <h1><%= student.full_name %></h1>
          <div class="hero-subtitle">
            <span><i class="fas fa-id-card"></i> <%= student.admission_number %></span>
            <span><i class="fas fa-graduation-cap"></i> <%= student.class_level %></span>
          </div>
        </div>
      </div>
      <div class="hero-right">
        <div class="hero-stat"><span>CGPA</span><strong><%= cgpa %></strong></div>
        <div class="hero-stat"><span>Credits</span><strong><%= totalCredits %></strong></div>
      </div>
    </div>

    <div class="progress-layout">
      <div class="info-card">
        <div class="card-head"><h2><i class="fas fa-book-reader" style="color: var(--amber);"></i> Current Enrollments</h2></div>
        <div class="card-body">
          <% if (enrollments.length === 0) { %>
            <p style="color: #94a3b8; font-size: 0.85rem;">No active enrollments.</p>
          <% } %>
          <% enrollments.forEach(enr => { %>
            <div class="enrollment-item">
              <span class="code"><%= enr.code %></span>
              <div class="title"><%= enr.title %> (<%= enr.credits %> cr)</div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="info-card">
        <div class="card-head"><h2><i class="fas fa-scroll" style="color: var(--amber);"></i> Academic Transcript</h2></div>
        <div class="card-body">
          <% if (Object.keys(transcript).length === 0) { %>
            <p style="color: #94a3b8; font-size: 0.85rem;">No published grades yet.</p>
          <% } %>
          <% Object.keys(transcript).forEach(sem => { %>
            <div style="margin-bottom: 1.5rem;">
              <div class="semester-title">Semester <%= sem %></div>
              <% transcript[sem].forEach(c => { 
                const lg = c.letter_grade || 'F';
                const gClass = lg.startsWith('A') ? 'grade-a' : 'grade-f';
              %>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px dashed #eef2f7; font-size: 0.85rem;">
                  <div><strong><%= c.code %></strong> - <%= c.title %></div>
                  <span class="grade-badge <%= gClass %>"><%= lg %></span>
                </div>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>