      <blockquote>
        LuxMind is not simply where I studied. It is where I discovered who I was capable of becoming. The faculty, the community, the city — every part of it shaped me.
      </blockquote>
      <div class="testimonial-author">
        <img src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?w=200&q=80&auto=format&fit=crop" alt="Student testimonial" loading="lazy" onerror="this.style.display='none';">
        <div class="info">
          <div class="name">Aline Niyonkuru</div>
          <div class="role">Class of 2024 · Burundi</div>
        </div>
      </div>
    </div>
  </section>

  <!-- APPLICATION FORM -->
  <section class="form-section" id="apply">
    <div class="form-wrap">
      <div class="form-header">
        <h2>Begin Your Application</h2>
        <p>Complete the form below to start your journey at LuxMind University. Our admissions team will respond within 48 hours.</p>
      </div>
      <div class="form-body">

        <% if (error) { %>
          <div class="alert"><%= error %></div>
        <% } %>

        <form method="POST" action="/apply">

          <!-- SECTION 1: PERSONAL -->
          <div class="form-fieldset">
            <div class="fieldset-head">
              <div class="fieldset-num">1</div>
              <div class="fieldset-title">Personal Information</div>
            </div>
            <div class="form-grid">
              <div class="form-field form-field-full">
                <label>Full Legal Name <span class="req">*</span></label>
                <input type="text" name="full_name" value="<%= values.full_name || '' %>" required minlength="3" placeholder="As written on your passport">
              </div>
              <div class="form-field">
                <label>Email Address <span class="req">*</span></label>
                <input type="email" name="email" value="<%= values.email || '' %>" required placeholder="you@example.com">
              </div>
              <div class="form-field">
                <label>Phone Number</label>
                <input type="tel" name="phone" value="<%= values.phone || '' %>" placeholder="+257 79 xxx xxx">
              </div>
              <div class="form-field">
                <label>Date of Birth</label>
                <input type="date" name="date_of_birth" value="<%= values.date_of_birth || '' %>">
              </div>
              <div class="form-field">
                <label>Gender</label>
                <select name="gender">
                  <option value="">— Select —</option>
                  <option value="Male" <%= values.gender === 'Male' ? 'selected' : '' %>>Male</option>
                  <option value="Female" <%= values.gender === 'Female' ? 'selected' : '' %>>Female</option>
                  <option value="Other" <%= values.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
              <div class="form-field">
                <label>Nationality</label>
                <input type="text" name="nationality" value="<%= values.nationality || '' %>" placeholder="e.g. Burundian">
              </div>
              <div class="form-field">
                <label>Country of Residence</label>
                <input type="text" name="country_of_residence" value="<%= values.country_of_residence || '' %>" placeholder="e.g. Burundi">
              </div>
            </div>
          </div>

          <!-- SECTION 2: ACADEMIC -->
          <div class="form-fieldset">
            <div class="fieldset-head">
              <div class="fieldset-num">2</div>
              <div class="fieldset-title">Academic Background</div>
            </div>
            <div class="form-grid">
              <div class="form-field form-field-full">
                <label>High School / Secondary School</label>
                <input type="text" name="high_school_name" value="<%= values.high_school_name || '' %>" placeholder="Full name of institution attended">
              </div>
              <div class="form-field">
                <label>High School GPA <span class="req">*</span></label>
                <input type="number" name="high_school_gpa" value="<%= values.high_school_gpa || '' %>" required min="0" max="4" step="0.01" placeholder="Out of 4.00">
                <div class="form-hint">Minimum 2.00 required for most programs</div>
              </div>
              <div class="form-field">
                <label>Passport Number</label>
                <input type="text" name="passport_number" value="<%= values.passport_number || '' %>" placeholder="e.g. AB1234567">
              </div>
              <div class="form-field">
                <label>English Test Type</label>
                <select name="english_test_type">
                  <option value="">None / Not taken</option>
                  <option value="IELTS" <%= values.english_test_type === 'IELTS' ? 'selected' : '' %>>IELTS</option>
                  <option value="TOEFL" <%= values.english_test_type === 'TOEFL' ? 'selected' : '' %>>TOEFL</option>
                  <option value="Duolingo" <%= values.english_test_type === 'Duolingo' ? 'selected' : '' %>>Duolingo English Test</option>
                </select>
              </div>
              <div class="form-field">
                <label>English Test Score</label>
                <input type="number" name="english_test_score" value="<%= values.english_test_score || '' %>" step="0.1" min="0" placeholder="e.g. 6.5">
              </div>
            </div>
          </div>

          <!-- SECTION 3: PROGRAM -->
          <div class="form-fieldset">
            <div class="fieldset-head">
              <div class="fieldset-num">3</div>
              <div class="fieldset-title">Program Selection</div>
            </div>
            <div class="form-grid">
              <div class="form-field">
                <label>Intended Program <span class="req">*</span></label>
                <select name="intended_program" required>
                  <option value="">— Select a Program —</option>
                  <% programs.forEach(p => { %>
                    <option value="<%= p %>" <%= values.intended_program === p ? 'selected' : '' %>><%= p %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-field">
                <label>Entry Semester</label>
                <select name="intended_semester">
                  <% for (let i = 1; i <= 8; i++) { %>
                    <option value="<%= i %>" <%= String(values.intended_semester) === String(i) ? 'selected' : '' %>>Semester <%= i %></option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <div class="form-submit-area">
            <p><strong>Confidentiality:</strong> Your information is reviewed only by the LuxMind admissions team and never shared with third parties.</p>
            <button type="submit" class="btn-submit">
              Submit Application <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>

        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="faq-inner">
      <div class="section-title-block">
        <div class="section-eyebrow">Frequently Asked</div>
        <h2>Questions &amp; Answers</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <button type="button" class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>What are the English language requirements?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner">
            We accept IELTS (minimum 6.0), TOEFL (minimum 80), or Duolingo English Test (minimum 100). If you completed secondary school in an English-speaking country, the requirement is waived.
          </div></div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>How much does tuition cost?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner">
            Tuition varies by program, typically $2,500–$4,000 per semester. International students automatically qualify for a 50% scholarship, and students with a GPA of 3.0 or above receive between 75% and 100% coverage.
          </div></div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>Do you assist with the student visa?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner">
            Yes — completely. Once you are accepted, our Visa &amp; Immigration Team issues your embassy support letter, guides you through the application at your local embassy, and processes your residence permit on arrival in Burundi.
          </div></div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>Is housing provided for international students?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner">
            Yes. On-campus dormitories are available for all international students, with single and shared room options. Our Orientation team handles check-in, roommate assignment, and arrival coordination personally.
          </div></div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>When will I learn the admissions decision?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner">
            Applications are reviewed within five to ten business days. You will receive an email decision and can track your status by logging into the student portal once your account is created.
