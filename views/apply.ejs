  <!-- FORM SECTION -->
  <section class="form-section" id="apply-form">
    <div style="text-align: center; max-width: 640px; margin: 0 auto 48px;">
      <div class="section-eyebrow">Apply Now</div>
      <h2 class="section-title" style="margin-bottom: 16px;">Your Application Starts Here</h2>
      <p style="color: var(--muted); font-size: 16px; line-height: 1.6; margin: 0;">Fill in the form below. It takes about 5 minutes. Our admissions team will review your application within 48 hours.</p>
    </div>

    <div class="form-container">
      <div class="form-card">
        <% if (error) { %>
          <div class="alert alert-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="POST" action="/apply">

          <!-- SECTION 1: Personal -->
          <div class="form-group">
            <div class="section-head">
              <div class="section-num">1</div>
              <h2 class="section-title">Personal Information</h2>
            </div>
            <div class="field-grid">
              <div class="field field-full">
                <label>Full Legal Name <span class="req">*</span></label>
                <input type="text" name="full_name" value="<%= values.full_name || '' %>" required minlength="3" placeholder="As written on your passport">
              </div>
              <div class="field">
                <label>Email Address <span class="req">*</span></label>
                <input type="email" name="email" value="<%= values.email || '' %>" required placeholder="you@example.com">
              </div>
              <div class="field">
                <label>Phone Number</label>
                <input type="tel" name="phone" value="<%= values.phone || '' %>" placeholder="+250 788 xxx xxx">
              </div>
              <div class="field">
                <label>Date of Birth</label>
                <input type="date" name="date_of_birth" value="<%= values.date_of_birth || '' %>">
              </div>
              <div class="field">
                <label>Gender</label>
                <select name="gender">
                  <option value="">—</option>
                  <option value="Male" <%= values.gender === 'Male' ? 'selected' : '' %>>Male</option>
                  <option value="Female" <%= values.gender === 'Female' ? 'selected' : '' %>>Female</option>
                  <option value="Other" <%= values.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
              <div class="field">
                <label>Nationality</label>
                <input type="text" name="nationality" value="<%= values.nationality || '' %>" placeholder="e.g. Rwandan">
              </div>
              <div class="field">
                <label>Country of Residence</label>
                <input type="text" name="country_of_residence" value="<%= values.country_of_residence || '' %>" placeholder="e.g. Kenya">
              </div>
            </div>
          </div>

          <!-- SECTION 2: Academic -->
          <div class="form-group">
            <div class="section-head">
              <div class="section-num">2</div>
              <h2 class="section-title">Academic Background</h2>
            </div>
            <div class="field-grid">
              <div class="field field-full">
                <label>High School / Secondary School Name</label>
                <input type="text" name="high_school_name" value="<%= values.high_school_name || '' %>" placeholder="Full name of the school you attended">
              </div>
              <div class="field">
                <label>High School GPA <span class="req">*</span></label>
                <input type="number" name="high_school_gpa" value="<%= values.high_school_gpa || '' %>" required min="0" max="4" step="0.01" placeholder="Out of 4.00">
                <span class="field-hint">Minimum 2.00 required for most programs</span>
              </div>
              <div class="field">
                <label>Passport Number</label>
                <input type="text" name="passport_number" value="<%= values.passport_number || '' %>" placeholder="e.g. AB1234567">
              </div>
              <div class="field">
                <label>English Proficiency Test</label>
                <select name="english_test_type">
                  <option value="">None / Not taken</option>
                  <option value="IELTS" <%= values.english_test_type === 'IELTS' ? 'selected' : '' %>>IELTS</option>
                  <option value="TOEFL" <%= values.english_test_type === 'TOEFL' ? 'selected' : '' %>>TOEFL</option>
                  <option value="Duolingo" <%= values.english_test_type === 'Duolingo' ? 'selected' : '' %>>Duolingo English Test</option>
                </select>
              </div>
              <div class="field">
                <label>English Test Score</label>
                <input type="number" name="english_test_score" value="<%= values.english_test_score || '' %>" step="0.1" min="0" placeholder="e.g. 6.5 IELTS / 95 TOEFL">
              </div>
            </div>
          </div>

          <!-- SECTION 3: Program -->
          <div class="form-group">
            <div class="section-head">
              <div class="section-num">3</div>
              <h2 class="section-title">Program of Interest</h2>
            </div>
            <div class="field-grid">
              <div class="field">
                <label>Intended Program <span class="req">*</span></label>
                <select name="intended_program" required>
                  <option value="">— select a program —</option>
                  <% programs.forEach(p => { %>
                    <option value="<%= p %>" <%= values.intended_program === p ? 'selected' : '' %>><%= p %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field">
                <label>Intended Entry Semester</label>
                <select name="intended_semester">
                  <% for (let i = 1; i <= 8; i++) { %>
                    <option value="<%= i %>" <%= String(values.intended_semester) === String(i) ? 'selected' : '' %>>Semester <%= i %></option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <!-- Documents note -->
          <div class="doc-notice">
            <i class="fa-solid fa-circle-info"></i>
            <div>
              <strong>Document uploads are coming next.</strong> Once you submit this form, our team will email you a secure link to upload your passport scan, transcripts, and English certificate.
            </div>
          </div>

          <div class="submit-bar">
            <small><i class="fa-solid fa-lock"></i> Confidential · Reviewed only by the Admissions team</small>
            <button type="submit" class="btn-submit">
              Submit Application <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- FORM SIDEBAR -->
      <aside class="form-sidebar">
        <div class="side-card">
          <h3><i class="fa-solid fa-calendar-check"></i> Fall 2026 Intake</h3>
          <span class="deadline-badge">Deadline: Aug 31, 2026</span>
          <p>Applications reviewed on a rolling basis. Early applicants receive priority for scholarships.</p>
        </div>

        <div class="side-card">
          <h3><i class="fa-solid fa-star"></i> Why Students Choose Us</h3>
          <div class="side-list">
            <div class="side-item"><i class="fa-solid fa-check-circle"></i><span>Students from 40+ countries</span></div>
            <div class="side-item"><i class="fa-solid fa-check-circle"></i><span>Up to 100% merit scholarships</span></div>
            <div class="side-item"><i class="fa-solid fa-check-circle"></i><span>Full visa and immigration support</span></div>
            <div class="side-item"><i class="fa-solid fa-check-circle"></i><span>Kigali — Africa's safest capital</span></div>
            <div class="side-item"><i class="fa-solid fa-check-circle"></i><span>96% graduate employment rate</span></div>
          </div>
        </div>

        <div class="side-card">
          <h3><i class="fa-solid fa-envelope"></i> Questions?</h3>
          <p class="side-contact">
            Email us at<br>
            <a href="mailto:admissions@luxmind.edu">admissions@luxmind.edu</a><br><br>
            We respond within 24 hours.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- JOURNEY TIMELINE -->
  <section class="section journey">
    <div class="section-inner">
      <div class="section-eyebrow">Your Journey</div>
      <h2 class="section-title">From Application to Arrival</h2>
      <p class="section-subtitle">Six clear steps. No mystery. You'll always know exactly where you stand.</p>

      <div class="journey-grid">
        <div class="journey-step">
          <div class="journey-num">1</div>
          <h4>Submit Application</h4>
          <p>Fill out the form above. It takes 5 minutes.</p>
        </div>
        <div class="journey-step">
          <div class="journey-num">2</div>
          <h4>Upload Documents</h4>
          <p>Receive an email with a secure upload link.</p>
        </div>
        <div class="journey-step">
          <div class="journey-num">3</div>
          <h4>Admissions Review</h4>
          <p>Our team evaluates your application in 5-10 days.</p>
        </div>
        <div class="journey-step">
          <div class="journey-num">4</div>
          <h4>Acceptance & Visa</h4>
          <p>Get your acceptance letter + visa support letter.</p>
        </div>
        <div class="journey-step">
          <div class="journey-num">5</div>
          <h4>Prepare for Arrival</h4>
          <p>Dorm, buddy mentor, airport pickup — all coordinated.</p>
        </div>
        <div class="journey-step">
          <div class="journey-num">6</div>
          <h4>Welcome to LuxMind</h4>
          <p>Land in Kigali. Start your new chapter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="section-inner">
      <div class="section-eyebrow">FAQ</div>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-subtitle">Everything you're wondering, answered by the people who actually handle it.</p>

      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>What are the English proficiency requirements?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">We accept IELTS (min 6.0), TOEFL (min 80), or Duolingo English Test (min 100). If you completed high school in an English-speaking country, this requirement is waived.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>How much does tuition cost?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">Tuition varies by program, typically $2,500–$4,000 per semester. International students automatically qualify for a 50% scholarship. Students with a GPA of 3.0+ receive 75-100% scholarships.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>Do you help with the student visa?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">Yes — completely. Once accepted, our Visa & Immigration Team issues your embassy support letter, guides you through the application at your local embassy, and processes your residence permit on arrival in Rwanda.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>Is housing provided?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">Yes. On-campus dormitories are available for all international students, with single and shared room options. Our Orientation Team handles your check-in, roommate assignment, and arrival coordination.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>When will I know if I'm accepted?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">Applications are reviewed within 5-10 business days. You'll receive an email decision, and you can track your status by logging into the student portal.</div></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">
            <span>Can I transfer credits from another university?</span>
            <i class="fa-solid fa-plus"></i>
          </button>
          <div class="faq-a"><div class="faq-a-inner">Yes. Our Academic & Exchange Team evaluates transcripts from other universities and determines transfer credit eligibility on a course-by-course basis.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
