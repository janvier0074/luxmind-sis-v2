<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1f3a">
  <title>Admissions 2026 · LuxMind University</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #0b1f3a;
      --navy-2: #162d52;
      --navy-3: #1e3a66;
      --gold: #c9a961;
      --gold-2: #b8955a;
      --cream: #f8f6f0;
      --white: #ffffff;
      --text: #1a2332;
      --muted: #64748b;
      --border: #e2e8f0;
      --border-dark: rgba(201, 169, 97, 0.2);
      --serif: "Playfair Display", Georgia, serif;
      --sans: "Source Sans 3", -apple-system, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
    body { background: var(--cream); color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.65; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    input, select, textarea, button { font: inherit; }

    /* ============ ANNOUNCEMENT BAR ============ */
    .announce { background: var(--navy); color: rgba(255,255,255,0.85); font-size: 12px; letter-spacing: 0.03em; padding: 10px 40px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
    .announce strong { color: var(--gold); font-weight: 600; }
    .announce .announce-right { display: flex; gap: 24px; font-size: 12px; }
    .announce .announce-right span { display: flex; align-items: center; gap: 8px; }
    .announce i { color: var(--gold); font-size: 11px; }

    /* ============ NAVBAR ============ */
    .nav { background: var(--white); border-bottom: 1px solid var(--border); padding: 18px 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(11, 31, 58, 0.04); }
    .nav-brand { display: flex; align-items: center; gap: 14px; }
    .crest { width: 52px; height: 52px; flex-shrink: 0; }
    .nav-brand-text .name { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--navy); letter-spacing: -0.01em; line-height: 1.1; }
    .nav-brand-text .tagline { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-top: 3px; }
    .nav-links { display: flex; align-items: center; gap: 36px; font-size: 14px; font-weight: 500; }
    .nav-links a { color: var(--text); transition: color 0.2s; }
    .nav-links a:hover { color: var(--navy); }
    .nav-links a.apply-btn { background: var(--navy); color: var(--white); padding: 11px 24px; letter-spacing: 0.05em; font-size: 12px; font-weight: 600; text-transform: uppercase; transition: all 0.2s; border-radius: 2px; }
    .nav-links a.apply-btn:hover { background: var(--gold); color: var(--navy); }

    /* ============ HERO ============ */
    .hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; background: var(--navy); position: relative; }
    .hero-content { padding: 100px 80px 100px 80px; display: flex; flex-direction: column; justify-content: center; color: var(--white); position: relative; z-index: 2; }
    .hero-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 32px; }
    .hero-eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--gold); }
    .hero h1 { font-family: var(--serif); font-size: clamp(38px, 4.5vw, 62px); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; color: var(--white); margin-bottom: 28px; }
    .hero h1 .accent { color: var(--gold); font-style: italic; font-weight: 500; }
    .hero p.lead { font-size: 17px; line-height: 1.75; font-weight: 300; color: rgba(255,255,255,0.78); margin-bottom: 44px; max-width: 520px; }
    .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
    .btn-gold { display: inline-flex; align-items: center; gap: 10px; background: var(--gold); color: var(--navy); padding: 16px 36px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; transition: all 0.2s; border-radius: 2px; border: 2px solid var(--gold); }
    .btn-gold:hover { background: transparent; color: var(--gold); }
    .btn-outline { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: var(--white); padding: 16px 32px; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; border: 2px solid rgba(255,255,255,0.3); transition: all 0.2s; border-radius: 2px; }
    .btn-outline:hover { border-color: var(--gold); color: var(--gold); }

    .hero-image { position: relative; overflow: hidden; background: var(--navy-2); }
    .hero-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,31,58,0.4) 0%, transparent 40%); pointer-events: none; }

    /* HERO BADGE */
    .hero-badge { position: absolute; bottom: 40px; left: 80px; z-index: 3; background: rgba(11,31,58,0.92); backdrop-filter: blur(8px); color: var(--white); padding: 18px 26px; border-left: 3px solid var(--gold); max-width: 340px; display: flex; gap: 16px; align-items: center; }
    .hero-badge-icon { font-size: 28px; color: var(--gold); }
    .hero-badge-text { font-size: 13px; line-height: 1.4; }
    .hero-badge-text strong { display: block; font-family: var(--serif); font-size: 16px; font-weight: 700; margin-bottom: 2px; }
    .hero-badge-text span { color: rgba(255,255,255,0.7); font-size: 12px; }

    /* ============ STATS BAND ============ */
    .stats-band { background: var(--navy-2); padding: 52px 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; color: var(--white); position: relative; }
    .stats-band::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(90deg, transparent, transparent 100px, rgba(201,169,97,0.04) 100px, rgba(201,169,97,0.04) 101px); pointer-events: none; }
    .stat { position: relative; z-index: 1; }
    .stat-num { font-family: var(--serif); font-size: clamp(36px, 4vw, 52px); font-weight: 700; color: var(--gold); line-height: 1; margin-bottom: 8px; }
    .stat-label { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.65); font-weight: 600; }
    .stat-divider { position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: rgba(201,169,97,0.15); }
    .stat:last-child .stat-divider { display: none; }

    /* ============ SECTION TITLE ============ */
    .section-title-block { text-align: center; max-width: 720px; margin: 0 auto 68px; }
    .section-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold-2); font-weight: 700; margin-bottom: 20px; }
    .section-eyebrow::before, .section-eyebrow::after { content: ''; width: 24px; height: 1px; background: var(--gold); }
    .section-title-block h2 { font-family: var(--serif); font-size: clamp(32px, 4vw, 48px); font-weight: 700; color: var(--navy); line-height: 1.15; letter-spacing: -0.01em; margin-bottom: 16px; }
    .section-title-block h2 em { font-style: italic; color: var(--gold-2); font-weight: 500; }
    .section-title-block p { font-size: 16px; color: var(--muted); line-height: 1.7; font-weight: 400; }

    /* ============ GALLERY (MASONRY) ============ */
    .gallery { padding: 100px 40px; background: var(--white); }
    .gallery-inner { max-width: 1400px; margin: 0 auto; }
    .masonry { column-count: 3; column-gap: 16px; }
    .masonry-item { break-inside: avoid; margin-bottom: 16px; position: relative; overflow: hidden; border-radius: 4px; cursor: pointer; }
    .masonry-item img { width: 100%; height: auto; display: block; transition: transform 0.6s ease; }
    .masonry-item:hover img { transform: scale(1.04); }
    .masonry-item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(11,31,58,0.85) 100%); opacity: 0; transition: opacity 0.3s; }
    .masonry-item:hover::after { opacity: 1; }
    .masonry-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 24px; color: var(--white); z-index: 2; transform: translateY(10px); opacity: 0; transition: all 0.3s; }
    .masonry-item:hover .masonry-caption { transform: translateY(0); opacity: 1; }
    .masonry-caption h4 { font-family: var(--serif); font-size: 18px; font-weight: 700; margin-bottom: 4px; }
    .masonry-caption p { font-size: 12px; color: rgba(255,255,255,0.8); letter-spacing: 0.05em; }

    /* ============ WHY LUXMIND ============ */
    .why { padding: 100px 40px; background: var(--cream); }
    .why-inner { max-width: 1200px; margin: 0 auto; }
    .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .why-card { background: var(--white); border-radius: 4px; overflow: hidden; transition: all 0.3s; border: 1px solid transparent; }
    .why-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(11, 31, 58, 0.1); border-color: var(--gold); }
    .why-card-img { height: 200px; overflow: hidden; position: relative; background: var(--navy); }
    .why-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
    .why-card:hover .why-card-img img { transform: scale(1.06); }
    .why-card-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(11,31,58,0.6) 100%); }
    .why-card-icon { position: absolute; bottom: 16px; left: 20px; width: 44px; height: 44px; background: var(--gold); color: var(--navy); display: grid; place-items: center; font-size: 18px; z-index: 2; border-radius: 2px; }
    .why-card-body { padding: 28px 26px; }
    .why-card-body h3 { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--navy); margin-bottom: 12px; line-height: 1.25; }
    .why-card-body p { font-size: 14px; color: var(--muted); line-height: 1.7; }

    /* ============ PROGRAMS ============ */
    .programs { padding: 100px 40px; background: var(--white); }
    .programs-inner { max-width: 1200px; margin: 0 auto; }
    .program-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .program-card { background: var(--cream); border: 1px solid var(--border); padding: 36px 32px; transition: all 0.25s; border-radius: 4px; position: relative; overflow: hidden; }
    .program-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
    .program-card:hover { box-shadow: 0 16px 40px rgba(11,31,58,0.08); border-color: var(--navy); }
    .program-card:hover::before { transform: scaleX(1); }
    .program-icon { width: 56px; height: 56px; background: var(--navy); color: var(--gold); display: grid; place-items: center; font-size: 22px; margin-bottom: 24px; border-radius: 2px; }
    .program-card h3 { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--navy); margin-bottom: 12px; line-height: 1.2; }
    .program-card p { font-size: 14px; color: var(--muted); line-height: 1.65; margin-bottom: 20px; }
    .program-meta { display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); letter-spacing: 0.05em; font-weight: 600; text-transform: uppercase; }
    .program-meta .duration { display: flex; align-items: center; gap: 8px; }
    .program-meta i { color: var(--gold); }

    /* ============ PROCESS ============ */
    .process { padding: 100px 40px; background: var(--navy); color: var(--white); position: relative; overflow: hidden; }
    .process::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle at 20% 50%, rgba(201,169,97,0.08) 0%, transparent 50%); pointer-events: none; }
    .process-inner { max-width: 1200px; margin: 0 auto; position: relative; z-index: 1; }
    .process .section-title-block h2 { color: var(--white); }
    .process .section-title-block p { color: rgba(255,255,255,0.65); }
    .process .section-eyebrow { color: var(--gold); }
    .process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; position: relative; }
    .process-steps::before { content: ''; position: absolute; top: 44px; left: 10%; right: 10%; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
    .step { text-align: center; position: relative; }
    .step-circle { width: 88px; height: 88px; border-radius: 50%; background: var(--navy-2); border: 2px solid var(--gold); color: var(--gold); display: grid; place-items: center; margin: 0 auto 24px; font-family: var(--serif); font-size: 32px; font-weight: 700; position: relative; z-index: 2; }
    .step h4 { font-family: var(--serif); font-size: 20px; font-weight: 700; color: var(--white); margin-bottom: 10px; }
    .step p { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.6; }

    /* ============ TESTIMONIAL ============ */
    .testimonial { padding: 100px 40px; background: var(--cream); }
    .testimonial-inner { max-width: 960px; margin: 0 auto; text-align: center; }
    .quote-mark { font-family: var(--serif); font-size: 120px; line-height: 0.5; color: var(--gold); margin-bottom: 24px; }
    .testimonial blockquote { font-family: var(--serif); font-size: clamp(22px, 2.6vw, 32px); line-height: 1.45; color: var(--navy); font-weight: 500; font-style: italic; margin-bottom: 40px; }
    .testimonial-author { display: inline-flex; align-items: center; gap: 16px; padding: 20px 32px; background: var(--white); border-radius: 100px; box-shadow: 0 4px 12px rgba(11,31,58,0.05); }
    .testimonial-author img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
    .testimonial-author .info { text-align: left; }
    .testimonial-author .name { font-family: var(--serif); font-size: 17px; font-weight: 700; color: var(--navy); }
    .testimonial-author .role { font-size: 12px; color: var(--muted); letter-spacing: 0.05em; }

    /* ============ APPLICATION FORM ============ */
    .form-section { padding: 100px 40px; background: var(--white); }
    .form-wrap { max-width: 1100px; margin: 0 auto; background: var(--white); border-radius: 6px; box-shadow: 0 24px 60px rgba(11, 31, 58, 0.1); overflow: hidden; border: 1px solid var(--border); }
    .form-header { background: var(--navy); color: var(--white); padding: 44px 56px; text-align: center; position: relative; }
    .form-header::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(201,169,97,0.05) 40px, rgba(201,169,97,0.05) 41px); pointer-events: none; }
    .form-header h2 { font-family: var(--serif); font-size: 34px; font-weight: 700; margin-bottom: 12px; color: var(--white); position: relative; z-index: 1; }
    .form-header p { color: rgba(255,255,255,0.72); font-size: 15px; max-width: 560px; margin: 0 auto; position: relative; z-index: 1; }

    .form-body { padding: 56px; }
    .alert { padding: 16px 20px; border-radius: 4px; margin-bottom: 32px; font-size: 14px; background: #fef2f2; border-left: 4px solid #dc2626; color: #991b1b; }

    .form-fieldset { margin-bottom: 44px; }
    .form-fieldset:last-of-type { margin-bottom: 32px; }
    .fieldset-head { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; padding-bottom: 16px; border-bottom: 2px solid var(--cream); }
    .fieldset-num { width: 36px; height: 36px; border-radius: 50%; background: var(--navy); color: var(--gold); font-family: var(--serif); font-size: 17px; font-weight: 700; display: grid; place-items: center; flex-shrink: 0; }
    .fieldset-title { font-family: var(--serif); font-size: 21px; font-weight: 700; color: var(--navy); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
    .form-field-full { grid-column: 1 / -1; }
    .form-field label { display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: var(--navy); margin-bottom: 8px; }
    .form-field label .req { color: var(--gold-2); margin-left: 3px; }
    .form-field input, .form-field select { width: 100%; padding: 14px 16px; border: 1.5px solid var(--border); border-radius: 3px; font-size: 15px; font-family: var(--sans); color: var(--text); background: var(--white); transition: all 0.2s; outline: none; }
    .form-field input:focus, .form-field select:focus { border-color: var(--navy); box-shadow: 0 0 0 3px rgba(11, 31, 58, 0.08); }
    .form-field input::placeholder { color: #94a3b8; }
    .form-hint { font-size: 12px; color: var(--muted); margin-top: 6px; }

    .form-submit-area { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: 36px; border-top: 2px solid var(--cream); flex-wrap: wrap; }
    .form-submit-area p { font-size: 13px; color: var(--muted); max-width: 400px; line-height: 1.5; }
    .form-submit-area p strong { color: var(--navy); }
    .btn-submit { display: inline-flex; align-items: center; gap: 12px; background: var(--navy); color: var(--white); padding: 18px 44px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; border: 2px solid var(--navy); transition: all 0.2s; border-radius: 3px; cursor: pointer; }
    .btn-submit:hover { background: var(--gold); border-color: var(--gold); color: var(--navy); }
    .btn-submit i { font-size: 12px; }

    /* ============ FAQ ============ */
    .faq { padding: 100px 40px; background: var(--cream); }
    .faq-inner { max-width: 880px; margin: 0 auto; }
    .faq-list { border-top: 2px solid var(--border); }
    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-q { width: 100%; padding: 28px 8px; background: none; border: none; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 24px; cursor: pointer; font-family: var(--serif); font-size: 19px; font-weight: 600; color: var(--navy); transition: color 0.2s; }
    .faq-q:hover { color: var(--gold-2); }
    .faq-q .faq-icon { font-size: 20px; color: var(--gold-2); transition: transform 0.3s; flex-shrink: 0; font-family: var(--sans); font-weight: 300; }
    .faq-item.open .faq-q .faq-icon { transform: rotate(45deg); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
    .faq-item.open .faq-a { max-height: 500px; }
    .faq-a-inner { padding: 0 8px 28px; font-size: 15px; color: var(--muted); line-height: 1.75; }

    /* ============ CTA BAND ============ */
    .cta-band { padding: 80px 40px; background: linear-gradient(135deg, var(--navy-2) 0%, var(--navy-3) 100%); text-align: center; color: var(--white); position: relative; overflow: hidden; }
    .cta-band::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, transparent, transparent 60px, rgba(201,169,97,0.04) 60px, rgba(201,169,97,0.04) 61px); }
    .cta-inner { max-width: 700px; margin: 0 auto; position: relative; z-index: 1; }
    .cta-inner h2 { font-family: var(--serif); font-size: clamp(30px, 3.8vw, 44px); font-weight: 700; margin-bottom: 16px; line-height: 1.2; }
    .cta-inner h2 em { font-style: italic; color: var(--gold); font-weight: 500; }
    .cta-inner p { font-size: 16px; color: rgba(255,255,255,0.72); line-height: 1.7; margin-bottom: 36px; }

    /* ============ FOOTER ============ */
    .footer { background: var(--navy); color: rgba(255,255,255,0.7); padding: 72px 40px 32px; }
    .footer-inner { max-width: 1200px; margin: 0 auto; }
    .footer-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--border-dark); margin-bottom: 32px; }
    .footer-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; }
    .footer-brand .crest { width: 48px; height: 48px; }
    .footer-brand .name { font-family: var(--serif); font-size: 20px; font-weight: 700; color: var(--white); line-height: 1.1; }
    .footer-brand .tagline { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); margin-top: 4px; font-weight: 600; }
    .footer p { font-size: 13px; line-height: 1.75; }
    .footer h4 { font-family: var(--serif); font-size: 16px; font-weight: 700; color: var(--white); margin-bottom: 20px; letter-spacing: 0.02em; }
    .footer ul { list-style: none; }
    .footer ul li { font-size: 13px; margin-bottom: 12px; line-height: 1.5; }
    .footer ul li a:hover { color: var(--gold); }
    .footer ul li i { color: var(--gold); width: 16px; margin-right: 8px; font-size: 12px; }
    .footer-bottom { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-top: 24px; font-size: 12px; color: rgba(255,255,255,0.45); }
    .footer-bottom .dev { color: var(--gold); font-weight: 600; letter-spacing: 0.05em; }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 1200px) {
      .masonry { column-count: 2; }
    }
    @media (max-width: 1024px) {
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-content { padding: 80px 40px; }
      .hero-image { min-height: 400px; }
      .hero-badge { left: 40px; bottom: 40px; max-width: 300px; }
      .why-grid { grid-template-columns: 1fr 1fr; }
      .program-grid { grid-template-columns: 1fr 1fr; }
      .process-steps { grid-template-columns: 1fr 1fr; gap: 40px; }
      .process-steps::before { display: none; }
      .footer-top { grid-template-columns: 1fr 1fr; }
      .nav-links { display: none; }
    }
    @media (max-width: 768px) {
      .masonry { column-count: 1; }
      .announce { padding: 8px 20px; font-size: 11px; flex-wrap: wrap; gap: 10px; }
      .announce .announce-right span:last-child { display: none; }
      .nav { padding: 14px 20px; }
      .nav-brand-text .name { font-size: 18px; }
      .crest { width: 42px; height: 42px; }
      .hero-content { padding: 60px 24px; }
      .hero h1 { font-size: 34px; }
      .hero-badge { left: 24px; right: 24px; max-width: none; bottom: 24px; }
      .stats-band { grid-template-columns: 1fr 1fr; padding: 40px 24px; gap: 32px; }
      .stat:nth-child(2) .stat-divider { display: none; }
      .section-title-block { margin-bottom: 48px; }
      .gallery, .why, .programs, .process, .testimonial, .form-section, .faq, .cta-band { padding: 64px 24px; }
      .why-grid, .program-grid, .process-steps { grid-template-columns: 1fr; gap: 20px; }
      .form-header { padding: 36px 24px; }
      .form-header h2 { font-size: 26px; }
      .form-body { padding: 32px 24px; }
      .form-grid, .form-grid-3 { grid-template-columns: 1fr; gap: 20px; }
      .form-submit-area { flex-direction: column; align-items: stretch; }
      .btn-submit { width: 100%; justify-content: center; }
      .footer { padding: 56px 24px 24px; }
      .footer-top { grid-template-columns: 1fr; gap: 32px; padding-bottom: 32px; }
      .footer-bottom { flex-direction: column; text-align: center; }
      .hero-actions { flex-direction: column; align-items: stretch; }
      .btn-gold, .btn-outline { justify-content: center; }
    }
  </style>
</head>
