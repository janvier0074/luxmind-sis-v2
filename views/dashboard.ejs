<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.8rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1.2rem; }
    .stat-icon { width: 55px; height: 55px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
    .stat-icon.gpa { background: #e0f2fe; color: #0284c7; }
    .stat-icon.credits { background: #dcfce7; color: #16a34a; }
    .stat-icon.finance { background: #fef3c7; color: #d97706; }
    .stat-info h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); margin-top: 0.2rem; }
    .stat-info small { font-size: 0.75rem; font-weight: 600; color: var(--danger); }

    .section-title { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.8rem; }
    .section-title i { color: var(--amber); }
    
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.5rem; }
    .tile { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); text-decoration: none; color: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: 0.2s; min-height: 160px; }
    .tile:hover { transform: translateY(-5px); border-color: var(--amber); box-shadow: 0 15px 30px -10px rgba(10, 30, 50, 0.15); }
    .tile i { font-size: 2.2rem; color: var(--blue); margin-bottom: 1rem; transition: 0.2s; }
    .tile:hover i { color: var(--amber); transform: scale(1.1); }
    .tile span { font-size: 0.9rem; font-weight: 700; line-height: 1.3; }
    .tile.highlight { background: linear-gradient(135deg, var(--navy), var(--deep)); color: #fff; border: none; }
    .tile.highlight i { color: var(--amber); }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow-soft); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: none; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); width: 280px; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .btn-back { display: inline-flex; }
      
      .top-bar { flex-direction: column; align-items: flex-start; }
      .greeting h1 { font-size: 1.4rem; }
      .user-pill { width: 100%; justify-content: center; }
      .stats-grid { grid-template-columns: 1fr; gap: 1rem; }
      .tile-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .tile { min-height: 120px; padding: 1rem; }
      .tile i { font-size: 1.8rem; margin-bottom: 0.5rem; }
    }
    @media (max-width: 480px) {
      .tile-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-building main-icon"></i> Accommodation</a></li>
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-dumbbell main-icon"></i> LuxMind Arena</a></li>
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-users main-icon"></i> Clubs</a></li>
      
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-file-alt main-icon"></i> Documents <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-pdf main-icon"></i> Transcript Request</a></li>
          <li class="menu-item"><a href="/sis/my/documents" class="menu-link"><i class="fas fa-id-card main-icon"></i> Student ID Request</a></li>
          <li class="menu-item"><a href="/sis/my/documents" class="menu-link"><i class="fas fa-certificate main-icon"></i> Enrollment Certificate</a></li>
          <li class="menu-item"><a href="/sis/my/documents" class="menu-link"><i class="fas fa-envelope-open-text main-icon"></i> Recommendation Letter</a></li>
        </ul>
      </li>

      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i> Student <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-wallet main-icon"></i> Accounting <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="/sis/my/finance" class="menu-link"><i class="fas fa-file-invoice main-icon"></i> My Fees</a></li>
              <li class="menu-item"><a href="/sis/my/finance" class="menu-link"><i class="fas fa-credit-card main-icon"></i> Make a Payment</a></li>
              <li class="menu-item"><a href="/sis/my/finance" class="menu-link"><i class="fas fa-balance-scale main-icon"></i> Financial Status</a></li>
            </ul>
          </li>
          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i> Course <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu open">
             <li class="menu-item"><a href="/sis/my/attendance" class="menu-link"><i class="fas fa-check-square main-icon"></i> Attendance Detail</a></li>
              <li class="menu-item"><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit main-icon"></i> Course Registration</a></li>
             <li class="menu-item"><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt main-icon"></i> Timetable</a></li>
            </ul>
          </li>
          
          <!-- NEW EXAM PROGRAM LINK ADDED HERE -->
                   <!-- EXAM MENU (NESTED) -->
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-file-signature main-icon"></i> Exam <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="/sis/my/exams" class="menu-link"><i class="fas fa-calendar-day main-icon"></i> Exam Program</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-poll main-icon"></i> Exam Result</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-exclamation-circle main-icon"></i> Exam Objection</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-undo main-icon"></i> Makeup Exam Application</a></li>
            </ul>
          </li>
          
          <li class="menu-item"><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol main-icon"></i> My Transcript</a></li>
         <li class="menu-item"><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-download main-icon"></i> Document Request</a></li>
        </ul>
      </li>
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <% if (typeof unseenDocs !== 'undefined' && unseenDocs > 0) { %>
      <div style="background: #fee2e2; border: 2px solid #dc2626; color: #991b1b; padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; font-weight: 700; flex-wrap: wrap; gap: 1rem;">
        <div><i class="fas fa-bell"></i> You have <strong><%= unseenDocs %></strong> new notification<%= unseenDocs > 1 ? 's' : '' %>.</div>
        <a href="/sis/my/documents" style="background: #dc2626; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; text-decoration: none; font-size: 0.85rem; font-weight: 800;">View Now</a>
      </div>
    <% } %>

    <div class="top-bar">
      <div class="greeting">
        <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %> 👋</h1>
        <p>Here is what is happening with your academics today.</p>
      </div>
      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div class="user-pill">
          <i class="fas fa-user-circle"></i>
          <%= user.admission_number || user.username %>
        </div>
        <a href="/logout" style="background: #b33e2e; color: white; padding: 0.5rem 1rem; border-radius: 100px; text-decoration: none; font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; box-shadow: var(--shadow-soft);">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon gpa"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info">
          <h3>Current CGPA</h3>
          <p><%= stats.gpa %> <span style="font-size: 1rem; color: #64748b;">/ 4.0</span></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon credits"><i class="fas fa-medal"></i></div>
        <div class="stat-info">
          <h3>Credits Earned</h3>
          <p><%= stats.credits %> <span style="font-size: 1rem; color: #64748b;">/ 120</span></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon finance"><i class="fas fa-wallet"></i></div>
        <div class="stat-info">
          <h3>Account Balance</h3>
          <p>$<%= stats.balance %></p>
          <small>Payment required</small>
        </div>
      </div>
    </div>

    <div class="section-title"><i class="fas fa-th-large"></i> Quick Actions</div>
    
    <div class="tile-grid">
      <a href="/sis/my/registration" class="tile highlight">
        <i class="fas fa-edit"></i>
        <span>Course Registration</span>
      </a>
      <a href="/sis/my/timetable" class="tile">
        <i class="fas fa-calendar-alt"></i>
        <span>My Timetable</span>
      </a>
      <a href="/sis/my/attendance" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Attendance</span>
      </a>
      <a href="/sis/my/transcript" class="tile">
        <i class="fas fa-list-ol"></i>
        <span>My Transcript</span>
      </a>
      <a href="/sis/my/finance" class="tile">
        <i class="fas fa-file-invoice"></i>
        <span>Financial Statement</span>
      </a>
      <a href="/sis/my/documents" class="tile">
        <i class="fas fa-file-alt"></i>
        <span>Document Requests</span>
      </a>
      <!-- NEW EXAM QUICK ACTION ADDED HERE -->
      <a href="/sis/my/exams" class="tile">
        <i class="fas fa-file-signature"></i>
        <span>Exam Program</span>
      </a>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
        const text = element.innerText.trim().split('\n')[0]; 
        if (parent.classList.contains('open')) {
          localStorage.setItem('menu_' + text, 'open');
        } else {
          localStorage.removeItem('menu_' + text);
        }
      }
    }

    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.menu-link').forEach(link => {
        if (link.nextElementSibling && link.nextElementSibling.classList.contains('submenu')) {
          const text = link.innerText.trim().split('\n')[0];
          if (localStorage.getItem('menu_' + text) === 'open') {
            link.parentElement.classList.add('open');
            link.nextElementSibling.classList.add('open');
          }
        }
      });
    });
  </script>

</body>
</html>