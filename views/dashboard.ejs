        </div>
      </div>
    </div>

    <div class="section-title"><i class="fas fa-th-large"></i> <%= lang.quick_actions || 'Quick Actions' %></div>

    <div class="tile-grid">
      <a href="/sis/my/registration" class="tile highlight">
        <i class="fas fa-edit"></i>
        <span>Course Registration</span>
      </a>
      <a href="/sis/my/timetable" class="tile">
        <i class="fas fa-calendar-alt"></i>
        <span>My Timetable</span>
      </a>
      <a href="/sis/my/attendance" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Attendance</span>
      </a>
      <a href="/sis/my/transcript" class="tile">
        <i class="fas fa-list-ol"></i>
        <span><%= lang.transcript || 'My Transcript' %></span>
      </a>
      <a href="/sis/my/finance" class="tile">
        <i class="fas fa-file-invoice"></i>
        <span>Financial Statement</span>
      </a>
      <a href="/sis/my/documents" class="tile">
        <i class="fas fa-file-alt"></i>
        <span>Document Requests</span>
      </a>
      <a href="/sis/my/exams" class="tile">
        <i class="fas fa-file-signature"></i>
        <span>Exam Program</span>
      </a>
      <a href="/sis/my/announcements" class="tile">
        <i class="fas fa-bullhorn"></i>
        <span><%= lang.announcements || 'Announcements' %></span>
      </a>
      <a href="/sis/my/messages" class="tile">
        <i class="fas fa-envelope"></i>
        <span><%= lang.messaging || 'Messaging' %></span>
