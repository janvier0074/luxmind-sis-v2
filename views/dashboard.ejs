
<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --navy: #0a1e32;
      --deep: #0f2a44;
      --blue: #1e4d7b;
      --amber: #f5a623;
      --gold: #ffc857;
      --mist: #eef4fa;
      --frost: #d9e6f2;
      --ice: #f7fafd;
      --success: #1f8a5f;
      --danger: #b33e2e;

      --shadow-soft: 0 5px 15px -6px rgba(10, 30, 50, 0.12);
      --shadow-hover: 0 10px 22px -8px rgba(10, 30, 50, 0.18);
      --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background:
        radial-gradient(circle at 100% 0%, rgba(245, 166, 35, 0.06), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(30, 77, 123, 0.05), transparent 40%),
        var(--ice);
      min-height: 100vh;
      display: flex;
      color: var(--navy);
      -webkit-font-smoothing: antialiased;
      font-size: 13px;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      background: linear-gradient(180deg, var(--navy) 0%, var(--deep) 100%);
      color: #fff;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      overflow-y: auto;
      box-shadow: 4px 0 25px rgba(0,0,0,0.12);
      z-index: 1000;
      transition: transform 0.3s ease;
      scrollbar-width: thin;
      scrollbar-color: #1e3a5f transparent;
    }

    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb {
      background: #1e3a5f;
      border-radius: 10px;
    }
    .sidebar::-webkit-scrollbar-track { background: transparent; }

    .sidebar-brand {
      padding: 1.25rem 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      position: sticky;
      top: 0;
      background: var(--navy);
      z-index: 10;
    }

    .brand-mark {
      width: 35px;
      height: 35px;
      background: linear-gradient(135deg, var(--amber), var(--gold));
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--navy);
      box-shadow: 0 4px 12px rgba(245, 166, 35, 0.25);
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: -0.4px;
    }

    .brand-name span {
      display: block;
      font-size: 0.58rem;
      color: var(--gold);
      letter-spacing: 1.6px;
      text-transform: uppercase;
      font-weight: 600;
      margin-top: 2px;
    }

    .sidebar-menu {
      list-style: none;
      padding: 0.4rem 0 1.5rem;
    }

    .menu-item { cursor: pointer; }

    .menu-link {
      display: flex;
      align-items: center;
      padding: 0.65rem 1.1rem;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.77rem;
      font-weight: 600;
      transition: var(--transition);
      border-left: 3px solid transparent;
      min-height: 36px;
    }

    .menu-link:hover {
      color: #fff;
      background: rgba(255,255,255,0.06);
      border-left-color: var(--amber);
    }

    .menu-link i.main-icon {
      width: 23px;
      color: var(--gold);
      font-size: 0.82rem;
      opacity: 0.85;
      transition: var(--transition);
      flex-shrink: 0;
    }

    .menu-link:hover i.main-icon {
      opacity: 1;
      transform: scale(1.05);
    }

    .menu-link .arrow {
      margin-left: auto;
      font-size: 0.58rem;
      transition: transform 0.3s ease;
    }

    .menu-link.active {
      color: #fff;
      background: linear-gradient(90deg, rgba(245, 166, 35, 0.18), transparent);
      border-left-color: var(--gold);
    }

    .menu-link.active i.main-icon {
      color: var(--gold);
      opacity: 1;
    }

    .submenu {
      list-style: none;
      display: none;
      background: rgba(0,0,0,0.18);
      border-left: 2px solid transparent;
      animation: slideDown 0.25s ease;
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .submenu.open {
      display: block;
      border-left-color: var(--amber);
    }

    .submenu .menu-link {
      padding-left: 2.8rem;
      font-size: 0.72rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .submenu .menu-link i.main-icon {
      color: #cbd5e1;
      opacity: 0.6;
    }

    .submenu .menu-link:hover i.main-icon {
      color: var(--gold);
      opacity: 1;
    }

    .submenu .submenu .menu-link {
      padding-left: 3.8rem;
      font-size: 0.69rem;
    }

    .menu-item.open > .menu-link .arrow {
      transform: rotate(90deg);
    }

    .menu-item.open > .menu-link { color: #fff; }

    /* MAIN CONTENT */
    .main-content {
      margin-left: 250px;
      padding: 1.8rem;
      flex: 1;
      width: calc(100% - 250px);
      min-width: 0;
      transition: margin 0.3s ease;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--blue);
      font-weight: 800;
      text-decoration: none;
      margin-bottom: 0.8rem;
      font-size: 0.76rem;
      padding: 0.35rem 0.65rem;
      border-radius: 7px;
      transition: var(--transition);
    }

    .btn-back:hover {
      background: #fff;
      box-shadow: var(--shadow-soft);
      color: var(--amber);
    }

    /* NOTIFICATION BANNERS */
    .notif-banner {
      background: linear-gradient(135deg, #fee2e2, #fecaca);
      border: 1px solid #f87171;
      color: #991b1b;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      margin-bottom: 0.8rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      flex-wrap: wrap;
      gap: 0.7rem;
      box-shadow: 0 4px 12px -4px rgba(220, 38, 38, 0.15);
      transition: var(--transition);
      font-size: 0.78rem;
    }

    .notif-banner:hover {
      transform: translateY(-1px);
      box-shadow: 0 7px 16px -6px rgba(220, 38, 38, 0.2);
    }

    .notif-btn {
      background: #dc2626;
      color: #fff;
      padding: 0.45rem 0.85rem;
      border-radius: 7px;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 800;
      transition: var(--transition);
    }

    .notif-btn:hover {
      background: #b91c1c;
      transform: scale(1.02);
    }

    /* TOP BAR */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.8rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .greeting h1 {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.5px;
    }

    .greeting p {
      color: #64748b;
      font-weight: 500;
      font-size: 0.78rem;
      margin-top: 0.25rem;
    }

    .user-pill {
      background: #fff;
      padding: 0.45rem 0.85rem;
      border-radius: 100px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      font-weight: 700;
      font-size: 0.75rem;
    }

    .user-pill i { color: var(--amber); }

    .logout-pill {
      background: linear-gradient(135deg, #b33e2e, #8b2d20);
      color: white;
      padding: 0.45rem 0.85rem;
      border-radius: 100px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: var(--shadow-soft);
      transition: var(--transition);
    }

    .logout-pill:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-hover);
    }

    /* LANGUAGE SWITCHER */
    .lang-switcher {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: #fff;
      padding: 0.4rem 0.7rem;
      border-radius: 100px;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
    }

    .lang-switcher i {
      color: var(--amber);
      font-size: 0.78rem;
    }

    .lang-switcher select {
      border: none;
      background: transparent;
      font-family: inherit;
      font-weight: 700;
      font-size: 0.73rem;
      color: var(--navy);
      cursor: pointer;
      outline: none;
      max-width: 105px;
    }

    /* STATISTICS */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 1.8rem;
    }

    .stat-card {
      background: #fff;
      padding: 1rem;
      border-radius: 1rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      display: flex;
      align-items: center;
      gap: 0.8rem;
      min-width: 0;
      transition: var(--transition);
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
      border-color: var(--gold);
    }

    .stat-icon {
      width: 43px;
      height: 43px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      flex-shrink: 0;
    }

    .stat-icon.gpa { background: #e0f2fe; color: #0284c7; }
    .stat-icon.credits { background: #dcfce7; color: #16a34a; }
    .stat-icon.finance { background: #fef3c7; color: #d97706; }

    .stat-info {
      min-width: 0;
    }

    .stat-info h3 {
      font-size: 0.68rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-weight: 700;
    }

    .stat-info p {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--navy);
      margin-top: 0.15rem;
      overflow-wrap: anywhere;
    }

    .stat-info p span {
      font-size: 0.8rem !important;
    }

    .stat-info small {
      font-size: 0.66rem;
      font-weight: 600;
      color: var(--danger);
    }

    /* SECTION TITLE */
    .section-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-title i { color: var(--amber); }

    /* QUICK ACTION TILES */
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
      gap: 1rem;
    }

    .tile {
      background: #fff;
      padding: 1.1rem 0.8rem;
      border-radius: 1rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      text-decoration: none;
      color: var(--navy);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      transition: var(--transition);
      min-height: 125px;
      position: relative;
      overflow: hidden;
    }

    .tile::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(245,166,35,0.08), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .tile:hover {
      transform: translateY(-3px);
      border-color: var(--amber);
      box-shadow: var(--shadow-hover);
    }

    .tile:hover::before { opacity: 1; }

    .tile i {
      font-size: 1.75rem;
      color: var(--blue);
      margin-bottom: 0.7rem;
      transition: var(--transition);
      position: relative;
      z-index: 1;
    }

    .tile:hover i {
      color: var(--amber);
      transform: scale(1.08) rotate(-3deg);
    }

    .tile span {
      font-size: 0.78rem;
      font-weight: 700;
      line-height: 1.35;
      position: relative;
      z-index: 1;
    }

    .tile.highlight {
      background: linear-gradient(135deg, var(--navy), var(--deep));
      color: #fff;
      border: none;
    }

    .tile.highlight:hover {
      box-shadow: 0 12px 28px -8px rgba(10, 30, 50, 0.35);
    }

    .tile.highlight i { color: var(--amber); }

    /* MOBILE MENU */
    .mobile-menu-btn {
      display: none;
      position: fixed;
      top: 0.8rem;
      left: 0.8rem;
      z-index: 1001;
      background: var(--navy);
      color: var(--gold);
      border: none;
      width: 39px;
      height: 39px;
      border-radius: 9px;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: var(--shadow-soft);
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .mobile-menu-btn:hover { background: var(--deep); }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10,30,50,0.5);
      z-index: 999;
      backdrop-filter: blur(2px);
    }

    /* TABLET */
    @media (max-width: 1024px) {
      .main-content {
        padding: 1.3rem;
      }

      .stats-grid {
        gap: 0.7rem;
      }

      .stat-card {
        padding: 0.8rem;
        gap: 0.6rem;
      }

      .tile-grid {
        grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
        gap: 0.8rem;
      }
    }

    /* MOBILE */
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }

      .sidebar {
        transform: translateX(-100%);
        width: 255px;
      }

      .sidebar.active { transform: translateX(0); }

      .sidebar-overlay.active { display: block; }

      .main-content {
        margin-left: 0;
        width: 100%;
        padding: 0.85rem;
        padding-top: 4rem;
      }

      .btn-back {
        margin-bottom: 0.55rem;
        font-size: 0.7rem;
      }

      .top-bar {
        flex-direction: column;
        align-items: stretch;
        margin-bottom: 1.2rem;
        gap: 0.75rem;
      }

      .greeting h1 {
        font-size: 1.2rem;
      }

      .greeting p {
        font-size: 0.7rem;
      }

      .top-bar > div:last-child {
        width: 100%;
        gap: 0.5rem !important;
        justify-content: space-between;
      }

      .user-pill {
        padding: 0.4rem 0.65rem;
        font-size: 0.68rem;
        min-width: 0;
      }

      .logout-pill {
        padding: 0.4rem 0.65rem;
        font-size: 0.68rem;
        white-space: nowrap;
      }

      .lang-switcher {
        padding: 0.35rem 0.55rem;
      }

      .lang-switcher select {
        font-size: 0.68rem;
        max-width: 85px;
      }

      .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
        margin-bottom: 1.3rem;
      }

      .stat-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.4rem;
        padding: 0.7rem 0.55rem;
        border-radius: 0.8rem;
      }

      .stat-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        font-size: 0.9rem;
      }

      .stat-info h3 {
        font-size: 0.56rem;
      }

      .stat-info p {
        font-size: 0.95rem;
      }

      .stat-info p span {
        font-size: 0.65rem !important;
      }

      .stat-info small {
        font-size: 0.56rem;
      }

      .section-title {
        font-size: 0.8rem;
        margin-bottom: 0.7rem;
      }

      .tile-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
      }

      .tile {
        min-height: 100px;
        padding: 0.8rem 0.45rem;
        border-radius: 0.8rem;
      }

      .tile i {
        font-size: 1.4rem;
        margin-bottom: 0.45rem;
      }

      .tile span {
        font-size: 0.68rem;
      }

      .notif-banner {
        padding: 0.65rem 0.75rem;
        font-size: 0.7rem;
        gap: 0.5rem;
      }

      .notif-btn {
        font-size: 0.65rem;
        padding: 0.4rem 0.65rem;
      }
    }

    /* SMALL MOBILE */
    @media (max-width: 380px) {
      .main-content {
        padding-left: 0.65rem;
        padding-right: 0.65rem;
      }

      .greeting h1 {
        font-size: 1.05rem;
      }

      .top-bar > div:last-child {
        gap: 0.35rem !important;
      }

      .user-pill {
        font-size: 0.62rem;
        padding: 0.35rem 0.5rem;
      }

      .logout-pill {
        font-size: 0.62rem;
        padding: 0.35rem 0.5rem;
      }

      .lang-switcher select {
        max-width: 72px;
      }

      .stat-card {
        padding: 0.55rem 0.4rem;
      }

      .stat-info h3 {
        font-size: 0.51rem;
      }

      .stat-info p {
        font-size: 0.85rem;
      }

      .tile {
        min-height: 90px;
      }

      .tile span {
        font-size: 0.64rem;
      }
    }

    /* NOTIFICATION DROPDOWN RESPONSIVENESS */
    @media (max-width: 768px) {
      #notifDropdown {
        position: fixed !important;
        top: 65px !important;
        right: 10px !important;
        left: 10px !important;
        width: auto !important;
        max-width: 420px;
        max-height: 65vh !important;
        margin-top: 0 !important;
        margin-left: auto;
        padding: 0.8rem !important;
      }
    }
  </style>

  <link rel="stylesheet" href="/css/mobile.css">
  <script src="/js/mobile.js" defer></script>
</head>

<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Open menu">
    <i class="fas fa-bars"></i>
  </button>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>

    <ul class="sidebar-menu">
      <li class="menu-item">
        <a href="/sis/my" class="menu-link">
          <i class="fas fa-home main-icon"></i>
          <%= lang.dashboard || 'Dashboard' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="/sis/my/announcements" class="menu-link">
          <i class="fas fa-bullhorn main-icon"></i>
          <%= lang.announcements || 'Announcements' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="/sis/announcements" class="menu-link">
          <i class="fas fa-university main-icon"></i>
          <%= lang.university_news || 'University News' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="/sis/my/messages" class="menu-link">
          <i class="fas fa-envelope main-icon"></i>
          <%= lang.messaging || 'Messaging' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="#" class="menu-link">
          <i class="fas fa-building main-icon"></i>
          <%= lang.accommodation || 'Accommodation' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="#" class="menu-link">
          <i class="fas fa-dumbbell main-icon"></i>
          <%= lang.arena || 'LuxMind Arena' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="#" class="menu-link">
          <i class="fas fa-users main-icon"></i>
          <%= lang.clubs || 'Clubs' %>
        </a>
      </li>

      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-file-alt main-icon"></i>
          <%= lang.documents || 'Documents' %>
          <i class="fas fa-chevron-right arrow"></i>
        </a>

        <ul class="submenu">
          <li class="menu-item">
            <a href="/sis/my/documents" class="menu-link">
              <i class="fas fa-file-pdf main-icon"></i> Transcript Request
            </a>
          </li>
          <li class="menu-item">
            <a href="/sis/my/documents" class="menu-link">
              <i class="fas fa-id-card main-icon"></i> Student ID Request
            </a>
          </li>
          <li class="menu-item">
            <a href="/sis/my/documents" class="menu-link">
              <i class="fas fa-certificate main-icon"></i> Enrollment Certificate
            </a>
          </li>
          <li class="menu-item">
            <a href="/sis/my/documents" class="menu-link">
              <i class="fas fa-envelope-open-text main-icon"></i> Recommendation Letter
            </a>
          </li>
        </ul>
      </li>

      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i>
          <%= lang.student || 'Student' %>
          <i class="fas fa-chevron-right arrow"></i>
        </a>

        <ul class="submenu open">
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-wallet main-icon"></i>
              <%= lang.accounting || 'Accounting' %>
              <i class="fas fa-chevron-right arrow"></i>
            </a>

            <ul class="submenu">
              <li class="menu-item">
                <a href="/sis/my/finance" class="menu-link">
                  <i class="fas fa-file-invoice main-icon"></i> My Fees
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/finance" class="menu-link">
                  <i class="fas fa-credit-card main-icon"></i> Make a Payment
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/finance" class="menu-link">
                  <i class="fas fa-balance-scale main-icon"></i> Financial Status
                </a>
              </li>
            </ul>
          </li>

          <li class="menu-item">
            <a href="/sis/my/guidance" class="menu-link">
              <i class="fas fa-hands-helping main-icon"></i> Guidance Requests
            </a>
          </li>

          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i>
              <%= lang.course || 'Course' %>
              <i class="fas fa-chevron-right arrow"></i>
            </a>

            <ul class="submenu open">
              <li class="menu-item">
                <a href="/sis/my/attendance" class="menu-link">
                  <i class="fas fa-check-square main-icon"></i> Attendance Detail
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/registration" class="menu-link">
                  <i class="fas fa-edit main-icon"></i> Course Registration
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/timetable" class="menu-link">
                  <i class="fas fa-calendar-alt main-icon"></i> Timetable
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/materials" class="menu-link">
                  <i class="fas fa-folder-open main-icon"></i> Course Materials
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/withdrawal" class="menu-link">
                  <i class="fas fa-sign-out-alt main-icon"></i> Course Withdrawal
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/evaluations" class="menu-link">
                  <i class="fas fa-poll main-icon"></i>
                  <%= lang.course_evaluation || 'Course Evaluation' %>
                </a>
              </li>
            </ul>
          </li>

          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-file-signature main-icon"></i>
              <%= lang.exam || 'Exam' %>
              <i class="fas fa-chevron-right arrow"></i>
            </a>

            <ul class="submenu">
              <li class="menu-item">
                <a href="/sis/my/exams" class="menu-link">
                  <i class="fas fa-calendar-day main-icon"></i> Exam Program
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/exam-results" class="menu-link">
                  <i class="fas fa-poll main-icon"></i> Exam Result
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/exam-objections" class="menu-link">
                  <i class="fas fa-exclamation-circle main-icon"></i> Exam Objection
                </a>
              </li>
              <li class="menu-item">
                <a href="/sis/my/makeup-exams" class="menu-link">
                  <i class="fas fa-undo main-icon"></i> Makeup Exam Application
                </a>
              </li>
            </ul>
          </li>

          <li class="menu-item">
            <a href="/sis/my/curriculum" class="menu-link">
              <i class="fas fa-list main-icon"></i>
              <%= lang.curriculum || 'Curriculum' %>
            </a>
          </li>

          <li class="menu-item">
            <a href="/sis/my/profile" class="menu-link">
              <i class="fas fa-address-card main-icon"></i>
              <%= lang.contact_information || 'Contact Information' %>
            </a>
          </li>

          <li class="menu-item">
            <a href="/sis/my/transcript" class="menu-link">
              <i class="fas fa-list-ol main-icon"></i>
              <%= lang.transcript || 'My Transcript' %>
            </a>
          </li>

          <li class="menu-item">
            <a href="/sis/my/cgpa-simulator" class="menu-link">
              <i class="fas fa-calculator main-icon"></i> CGPA Simulator
            </a>
          </li>

          <li class="menu-item">
            <a href="/sis/my/documents" class="menu-link">
              <i class="fas fa-file-download main-icon"></i>
              <%= lang.document_request || 'Document Request' %>
            </a>
          </li>
        </ul>
      </li>

      <li class="menu-item">
        <a href="/logout" class="menu-link">
          <i class="fas fa-sign-out-alt main-icon"></i>
          <%= lang.logout || 'Logout' %>
        </a>
      </li>
    </ul>
  </aside>

  <main class="main-content">

    <% if (typeof targetedMessages !== 'undefined' && targetedMessages.length > 0) { %>
      <div style="margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.65rem;">
        <% targetedMessages.forEach(msg => { %>
          <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 0.8rem 1rem; border-radius: 0 10px 10px 0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
              <h4 style="font-weight: 800; color: #78350f; font-size: 0.8rem;">
                <i class="fas fa-bullhorn" style="margin-right: 0.4rem;"></i><%= msg.title %>
              </h4>
              <span style="font-size: 0.62rem; font-weight: 800; color: #b45309; text-transform: uppercase;">
                <%= new Date(msg.created_at).toLocaleDateString() %>
              </span>
            </div>
            <p style="font-size: 0.73rem; color: #92400e; margin-top: 0.3rem; font-weight: 600;">
              <%= msg.message %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <a href="javascript:history.back()" class="btn-back">
      <i class="fas fa-arrow-left"></i> Back
    </a>

    <!-- OVERDUE PAYMENT ALERT -->
    <% if (typeof stats !== 'undefined' && stats.overdueCount > 0) { %>
      <div class="notif-banner" style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-color: #f87171; color: #991b1b; border-width: 2px;">
        <div>
          <i class="fas fa-exclamation-triangle"></i>
          <strong>Overdue Payment: $<%= Number(stats.overdueTotal).toFixed(2) %></strong>
          <br>
          <span style="font-size: 0.75rem; font-weight: 500; color: #7f1d1d;">
            You have <%= stats.overdueCount %> overdue installment<%= stats.overdueCount > 1 ? 's' : '' %>. Please pay immediately to avoid academic holds.
          </span>
        </div>
        <a href="/sis/my/finance" class="notif-btn" style="background: #dc2626;">Pay Now</a>
      </div>
    <% } %>

    <!-- NEXT INSTALLMENT REMINDER -->
    <% if (typeof stats !== 'undefined' && stats.nextInstallment && stats.overdueCount === 0) { %>
      <div class="notif-banner" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-color: #f59e0b; color: #78350f;">
        <div>
          <i class="fas fa-calendar-alt"></i>
          <strong>Next Payment: $<%= Number(stats.nextInstallment.amount).toFixed(2) %></strong>
          <br>
          <span style="font-size: 0.75rem; font-weight: 500; color: #92400e;">
            Due on <strong><%= new Date(stats.nextInstallment.due_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
          </span>
        </div>
        <a href="/sis/my/finance" class="notif-btn" style="background: #d97706;">View Schedule</a>
      </div>
    <% } %>

    <% if (typeof unseenDocs !== 'undefined' && unseenDocs > 0) { %>
      <div class="notif-banner">
        <div>
          <i class="fas fa-bell"></i>
          You have <strong><%= unseenDocs %></strong> new notification<%= unseenDocs > 1 ? 's' : '' %> regarding document requests.
        </div>
        <a href="/sis/my/documents" class="notif-btn">View Now</a>
      </div>
    <% } %>

    <% if (typeof globalAnnouncementCount !== 'undefined' && globalAnnouncementCount > 0) { %>
      <div class="notif-banner">
        <div>
          <i class="fas fa-university"></i>
          You have <strong><%= globalAnnouncementCount %></strong> new university announcement<%= globalAnnouncementCount > 1 ? 's' : '' %>.
        </div>
        <a href="/sis/announcements" class="notif-btn">Read Now</a>
      </div>
    <% } %>

    <% if (typeof announcementCount !== 'undefined' && announcementCount > 0) { %>
      <div class="notif-banner" style="margin-bottom: 1.2rem;">
        <div>
          <i class="fas fa-bullhorn"></i>
          You have <strong><%= announcementCount %></strong> new announcement<%= announcementCount > 1 ? 's' : '' %> from your teachers.
        </div>
        <a href="/sis/my/announcements" class="notif-btn">View Announcements</a>
      </div>
    <% } %>

    <!-- HEADER -->
    <div class="top-bar">
      <div class="greeting">
        <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %> 👋</h1>
        <p>Here is what is happening with your academics today.</p>
      </div>

      <div style="display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;">
        <div class="lang-switcher">
          <i class="fas fa-globe"></i>
          <select onchange="window.location.href='/set-language/' + this.value">
            <option value="en" <%= (typeof locale !== 'undefined' && locale === 'en') ? 'selected' : '' %>>English</option>
            <option value="fr" <%= (typeof locale !== 'undefined' && locale === 'fr') ? 'selected' : '' %>>Français</option>
            <option value="sw" <%= (typeof locale !== 'undefined' && locale === 'sw') ? 'selected' : '' %>>Kiswahili</option>
            <option value="rn" <%= (typeof locale !== 'undefined' && locale === 'rn') ? 'selected' : '' %>>Ikirundi</option>
          </select>
        </div>

        <div class="user-pill">
          <i class="fas fa-user-circle"></i>
          <%= user.admission_number || user.username %>
        </div>

        <!-- NOTIFICATION BELL -->
        <div class="notification-bell-wrapper" style="position: relative;">
          <button id="notifBell" onclick="toggleNotifDropdown()" aria-label="Notifications" style="background: #fff; border: 1px solid var(--frost); border-radius: 100px; padding: 0.45rem 0.75rem; cursor: pointer; position: relative; box-shadow: var(--shadow-soft); display: flex; align-items: center; gap: 0.4rem;">
            <i class="fas fa-bell" style="color: var(--amber); font-size: 0.9rem;"></i>
            <span id="notifCount" style="display: none; position: absolute; top: -5px; right: -5px; background: var(--danger); color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 0.6rem; font-weight: 800; align-items: center; justify-content: center; border: 2px solid #fff;">0</span>
          </button>

          <div id="notifDropdown" style="display: none; position: absolute; top: 100%; right: 0; margin-top: 0.5rem; width: 350px; max-height: 450px; overflow-y: auto; background: #fff; border: 1px solid var(--frost); border-radius: 12px; box-shadow: 0 10px 40px rgba(10,30,50,0.15); z-index: 999; padding: 0.85rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; padding-bottom: 0.65rem; border-bottom: 1px solid var(--frost);">
              <h3 style="font-size: 0.82rem; font-weight: 800; color: var(--navy);">Notifications</h3>
              <button onclick="markAllAsRead()" style="background: transparent; border: none; color: var(--blue); font-size: 0.65rem; font-weight: 700; cursor: pointer;">Mark all read</button>
            </div>

            <div id="notifList" style="display: flex; flex-direction: column; gap: 0.5rem;">
              <p style="text-align: center; color: #94a3b8; font-size: 0.75rem; padding: 1rem;">Loading...</p>
            </div>
          </div>
        </div>

        <a href="/logout" class="logout-pill">
          <i class="fas fa-sign-out-alt"></i>
          <%= lang.logout || 'Logout' %>
        </a>
      </div>
    </div>

    <!-- STATISTICS -->
    <div class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon gpa">
          <i class="fas fa-chart-line"></i>
        </div>
        <div class="stat-info">
          <h3>Current CGPA</h3>
          <p><%= stats.gpa %> <span style="font-size: 0.8rem; color: #64748b;">/ 4.0</span></p>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon credits">
          <i class="fas fa-medal"></i>
        </div>
        <div class="stat-info">
          <h3>Credits Earned</h3>
          <p><%= stats.credits %> <span style="font-size: 0.8rem; color: #64748b;">/ 120</span></p>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon finance">
          <i class="fas fa-wallet"></i>
        </div>
        <div class="stat-info">
          <h3>Account Balance</h3>
          <p>$<%= Number(stats.balance).toFixed(2) %></p>

          <% if (stats.balance > 0) { %>
            <small style="color: var(--danger); font-weight: 800;">
              <i class="fas fa-exclamation-circle"></i> Payment required
            </small>
          <% } else { %>
            <small style="color: var(--success); font-weight: 800;">
              <i class="fas fa-check-circle"></i> Fully paid
            </small>
          <% } %>
        </div>
      </div>

    </div>

    <!-- QUICK ACTIONS -->
    <div class="section-title">
      <i class="fas fa-th-large"></i>
      <%= lang.quick_actions || 'Quick Actions' %>
    </div>

    <div class="tile-grid">

      <a href="/sis/my/registration" class="tile highlight">
        <i class="fas fa-edit"></i>
        <span>Course Registration</span>
      </a>

      <a href="/sis/my/timetable" class="tile">
        <i class="fas fa-calendar-alt"></i>
        <span>My Timetable</span>
      </a>

      <a href="/sis/my/attendance" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Attendance</span>
      </a>

      <a href="/sis/my/transcript" class="tile">
        <i class="fas fa-list-ol"></i>
        <span><%= lang.transcript || 'My Transcript' %></span>
      </a>

      <a href="/sis/my/finance" class="tile">
        <i class="fas fa-file-invoice"></i>
        <span>Financial Statement</span>
      </a>

      <a href="/sis/my/documents" class="tile">
        <i class="fas fa-file-alt"></i>
        <span>Document Requests</span>
      </a>

      <a href="/sis/my/exams" class="tile">
        <i class="fas fa-file-signature"></i>
        <span>Exam Program</span>
      </a>

      <a href="/sis/my/announcements" class="tile">
        <i class="fas fa-bullhorn"></i>
        <span><%= lang.announcements || 'Announcements' %></span>
      </a>

      <a href="/sis/my/messages" class="tile">
        <i class="fas fa-envelope"></i>
        <span><%= lang.messaging || 'Messaging' %></span>
      </a>

      <a href="/sis/my/withdrawal" class="tile">
        <i class="fas fa-sign-out-alt"></i>
        <span>Course Withdrawal</span>
      </a>

      <a href="/sis/my/evaluations" class="tile">
        <i class="fas fa-poll"></i>
        <span><%= lang.course_evaluation || 'Course Evaluation' %></span>
      </a>

    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();

      const parent = element.parentElement;
      parent.classList.toggle('open');

      const submenu = parent.querySelector(':scope > .submenu');

      if (submenu) {
        submenu.classList.toggle('open');
      }
    }

    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');

      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    // NOTIFICATIONS SYSTEM

    function toggleNotifDropdown() {
      const dropdown = document.getElementById('notifDropdown');

      if (dropdown.style.display === 'none' || dropdown.style.display === '') {
        dropdown.style.display = 'block';
        loadNotifications();
      } else {
        dropdown.style.display = 'none';
      }
    }

    async function loadNotifications() {
      try {
        const res = await fetch('/api/notifications');

        if (!res.ok) {
          throw new Error('Unable to load notifications');
        }

        const data = await res.json();

        const badge = document.getElementById('notifCount');

        if (data.unreadCount > 0) {
          badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
        }

        const list = document.getElementById('notifList');

        if (!data.notifications || data.notifications.length === 0) {
          list.innerHTML = '<p style="text-align: center; color: #94a3b8; font-size: 0.75rem; padding: 1rem;">No notifications</p>';
          return;
        }

        list.innerHTML = data.notifications.map(n => `
          <div onclick="openNotification(${Number(n.id)}, '${String(n.link || '/sis/my').replace(/\\/g, '\\\\').replace(/'/g, "\\'")}')"
               style="padding: 0.65rem; border-radius: 8px; background: ${n.is_read ? '#f8fafc' : '#eff6ff'}; border: 1px solid ${n.is_read ? 'var(--frost)' : '#bfdbfe'}; cursor: pointer; transition: 0.2s;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
              <div style="flex: 1; min-width: 0;">
                <div style="font-size: 0.73rem; font-weight: 800; color: ${n.is_read ? '#64748b' : 'var(--navy)'}; margin-bottom: 0.2rem;">
                  ${!n.is_read ? '● ' : ''}${escapeNotificationText(n.title)}
                </div>
                <div style="font-size: 0.68rem; color: #64748b; line-height: 1.4;">${escapeNotificationText(n.body)}</div>
                <div style="font-size: 0.6rem; color: #94a3b8; margin-top: 0.3rem;">${new Date(n.created_at).toLocaleString()}</div>
              </div>
            </div>
          </div>
        `).join('');

      } catch (err) {
        console.error('Failed to load notifications:', err);
      }
    }

    function escapeNotificationText(value) {
      const element = document.createElement('div');
      element.textContent = value == null ? '' : String(value);
      return element.innerHTML;
    }

    async function openNotification(id, link) {
      try {
        await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
      } catch (err) {
        console.error('Failed to mark notification as read:', err);
      }

      window.location.href = link;
    }

    async function markAllAsRead() {
      try {
        const response = await fetch('/api/notifications/read-all', {
          method: 'POST'
        });

        if (!response.ok) {
          throw new Error('Unable to mark notifications as read');
        }

        await loadNotifications();

      } catch (err) {
        console.error('Failed to mark all notifications as read:', err);
      }
    }

    // Load notifications on page load
    loadNotifications();

    // Poll for new notifications every 30 seconds
    setInterval(loadNotifications, 30000);

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const wrapper = document.querySelector('.notification-bell-wrapper');
      const dropdown = document.getElementById('notifDropdown');

      if (wrapper && !wrapper.contains(e.target)) {
        dropdown.style.display = 'none';
      }
    });
  </script>

</body>
</html>
