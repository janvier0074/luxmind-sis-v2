<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar::-webkit-scrollbar { width: 6px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.8rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    
    /* Nested Menus */
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    
    /* Level 2 */
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    /* Level 3 */
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    /* Level 4 */
    .submenu .submenu .submenu .menu-link { padding-left: 5.5rem; font-size: 0.75rem; }
    
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    
    /* Top Bar */
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Stats Grid */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1.2rem; }
    .stat-icon { width: 55px; height: 55px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-icon.gpa { background: #e0f2fe; color: #0284c7; }
    .stat-icon.credits { background: #dcfce7; color: #16a34a; }
    .stat-icon.finance { background: #fef3c7; color: #d97706; }
    .stat-info h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); margin-top: 0.2rem; }
    .stat-info small { font-size: 0.75rem; font-weight: 600; color: var(--danger); }

    /* Dashboard Tiles */
    .section-title { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.8rem; }
    .section-title i { color: var(--amber); }
    
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.5rem; }
    .tile { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); text-decoration: none; color: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: 0.2s; min-height: 160px; }
    .tile:hover { transform: translateY(-5px); border-color: var(--amber); box-shadow: 0 15px 30px -10px rgba(10, 30, 50, 0.15); }
    .tile i { font-size: 2.2rem; color: var(--blue); margin-bottom: 1rem; transition: 0.2s; }
    .tile:hover i { color: var(--amber); transform: scale(1.1); }
    .tile span { font-size: 0.9rem; font-weight: 700; line-height: 1.3; }
    
    /* Highlighted Tile */
    .tile.highlight { background: linear-gradient(135deg, var(--navy), var(--deep)); color: #fff; border: none; }
    .tile.highlight i { color: var(--amber); }
    .tile.highlight:hover { box-shadow: 0 15px 30px -10px rgba(10, 30, 50, 0.4); }

  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>

    <ul class="sidebar-menu">
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-building main-icon"></i> Accommodation</a></li>
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-dumbbell main-icon"></i> LuxMind Arena</a></li>
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-users main-icon"></i> Clubs</a></li>
      
      <!-- DOCUMENTS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-file-alt main-icon"></i> Documents <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-pdf main-icon"></i> Transcript Request</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-id-card main-icon"></i> Student ID Request</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-certificate main-icon"></i> Enrollment Certificate</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-envelope-open-text main-icon"></i> Recommendation Letter</a></li>
        </ul>
      </li>

      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-flask main-icon"></i> Laboratory Appointment System</a></li>
      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-comments main-icon"></i> Messaging</a></li>
      
      <!-- PCGC -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-user-tie main-icon"></i> PCGC <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-check main-icon"></i> Book Appointment</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-history main-icon"></i> My Appointments</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-hand-holding-heart main-icon"></i> Guidance Requests</a></li>
        </ul>
      </li>

      <!-- REQUESTS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-envelope-open-text main-icon"></i> Requests <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-pen main-icon"></i> Additional Course</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Withdrawal</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-signature main-icon"></i> Make-up Exam</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-exclamation-triangle main-icon"></i> Objection</a></li>
        </ul>
      </li>

      <!-- STUDENT MENU (MASSIVE) -->
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i> Student <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          
          <!-- ACCOUNTING -->
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-wallet main-icon"></i> Accounting <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-invoice main-icon"></i> My Fees</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-credit-card main-icon"></i> Make a Payment</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-balance-scale main-icon"></i> Financial Status</a></li>
            </ul>
          </li>

          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-plus-circle main-icon"></i> Additional Course Request</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calculator main-icon"></i> CGPA Calculator</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-car main-icon"></i> Car Stamp</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-address-card main-icon"></i> Contact Information</a></li>

          <!-- COURSE -->
          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i> Course <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu open">
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-check-square main-icon"></i> Attendance Detail</a></li>
              <li class="menu-item"><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit main-icon"></i> Course Registration</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-alt main-icon"></i> Timetable</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-poll main-icon"></i> Course Evaluation</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-folder-open main-icon"></i> Course Materials</a></li>
            </ul>
          </li>

          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Course Withdrawal Application</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-list main-icon"></i> Curriculum</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-download main-icon"></i> Document Request</a></li>
          
          <!-- EXAM (EXPANDED AS REQUESTED) -->
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-file-signature main-icon"></i> Exam <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-day main-icon"></i> Exam Program</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-poll main-icon"></i> Exam Result</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-exclamation-circle main-icon"></i> Exam Objection</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-undo main-icon"></i> Makeup Exam Application</a></li>
            </ul>
          </li>

          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-layer-group main-icon"></i> Extended Curriculum</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-graduation-cap main-icon"></i> Graduation Make-up Application</a></li>
        </ul>
      </li>

      <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-star main-icon"></i> Student Ambassador</a></li>
      
      <!-- STUDENT ENGAGEMENT -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-hands-helping main-icon"></i> Student Engagement <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-alt main-icon"></i> Events Calendar</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-camera main-icon"></i> Photo Gallery</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-clipboard-list main-icon"></i> Surveys</a></li>
        </ul>
      </li>

      <!-- SYSTEM -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-cog main-icon"></i> System <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-user-cog main-icon"></i> Account Settings</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-key main-icon"></i> Change Password</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <div class="top-bar">
      <div class="greeting">
        <h1>Good night, <%= user.full_name.split(' ')[0] %> 👋</h1>
        <p>Here is what is happening with your academics today.</p>
      </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
        <div class="user-pill">
          <i class="fas fa-user-circle"></i>
          <%= user.admission_number || user.username %>
        </div>
        <a href="/logout" style="background: #b33e2e; color: white; padding: 0.5rem 1rem; border-radius: 100px; text-decoration: none; font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; box-shadow: var(--shadow-soft);">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </div>
    </div>

    <!-- STATS ROW -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon gpa"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info">
          <h3>Current CGPA</h3>
          <p><%= stats.gpa %> <span style="font-size: 1rem; color: #64748b;">/ 4.0</span></p>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon credits"><i class="fas fa-medal"></i></div>
        <div class="stat-info">
          <h3>Credits Earned</h3>
          <p><%= stats.credits %> <span style="font-size: 1rem; color: #64748b;">/ 120</span></p>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon finance"><i class="fas fa-wallet"></i></div>
        <div class="stat-info">
          <h3>Account Balance</h3>
          <p>$<%= stats.balance %></p>
          <small>Payment required</small>
        </div>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="section-title"><i class="fas fa-th-large"></i> Quick Actions</div>
    
    <div class="tile-grid">
      <a href="/sis/my/registration" class="tile highlight">
        <i class="fas fa-edit"></i>
        <span>Course Registration</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-calendar-alt"></i>
        <span>My Timetable</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Attendance</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-list-ol"></i>
        <span>My Transcript</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-list"></i>
        <span>Curriculum Map</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-file-invoice"></i>
        <span>Financial Statement</span>
      </a>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
      }
    }
  </script>
</body>
</html>