<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('show');
}

/* ---- tab switching ---- */
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const target = document.getElementById('tab-' + btn.dataset.tab);
    if (target) target.classList.add('active');
  });
});

/* ---- program selection ---- */
function selectProgram(card){
  document.querySelectorAll('.program-card').forEach(item => {
    item.classList.remove('selected');
  });
  card.classList.add('selected');

  const name = card.dataset.name || '';
  const records = Number(card.dataset.records || 0);

  document.getElementById('detailName').textContent = name;
  document.getElementById('detailRecords').textContent = records;

  // progress bar
  const maxRecords = 10;
  const pct = Math.min(100, Math.round((records / maxRecords) * 100));
  const fill = document.getElementById('detailProgressFill');
  const label = document.getElementById('detailProgressLabel');
  if (fill) fill.style.width = pct + '%';
  if (label) label.textContent = pct + '% complete';
}

/* ---- filtering (overview) ---- */
function filterPrograms(type, button, scope){
  const container = scope || 'overview';
  const filterGroup = button.parentElement;
  filterGroup.querySelectorAll('.filter').forEach(item => item.classList.remove('active'));
  button.classList.add('active');
  applyProgramFilters(container);
}

function applyProgramFilters(scope){
  const prefix = scope === 'overview' ? 'Overview' : '';
  const searchInput = document.getElementById('programSearch' + prefix);
  const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
  const listContainer = document.getElementById('programList' + prefix);
  if (!listContainer) return;

  const activeFilterEl = listContainer.closest('.panel-body').querySelector('.filter.active');
  const filter = activeFilterEl ? activeFilterEl.dataset.filter : 'all';
  const cards = listContainer.querySelectorAll('.program-card');
  let visible = 0;

  cards.forEach(card => {
    const matchesText = (card.dataset.search || '').includes(query);
    const records = Number(card.dataset.records || 0);
    let matchesFilter = true;
    if (filter === 'with-records') matchesFilter = records > 0;
    if (filter === 'without-records') matchesFilter = records === 0;
    const show = matchesText && matchesFilter;
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });

  const noResults = document.getElementById('noResults' + prefix);
  if (noResults) {
    noResults.style.display = (cards.length && visible === 0) ? 'block' : 'none';
  }
}

/* ---- search listeners ---- */
const overviewSearch = document.getElementById('programSearchOverview');
if (overviewSearch) overviewSearch.addEventListener('input', () => applyProgramFilters('overview'));

const portfolioSearch = document.getElementById('programSearchPortfolio');
if (portfolioSearch) {
  portfolioSearch.addEventListener('input', () => {
    const q = portfolioSearch.value.trim().toLowerCase();
    document.querySelectorAll('#portfolioTable tbody tr').forEach(row => {
      const txt = (row.dataset.search || '').toLowerCase();
      row.style.display = (q === '' || txt.includes(q)) ? '' : 'none';
    });
  });
}

/* ---- sidebar link close ---- */
document.querySelectorAll('.sidebar .nav-link').forEach(link => {
  link.addEventListener('click', () => {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('show');
  });
});

/* ---- initialise progress on load ---- */
document.addEventListener('DOMContentLoaded', () => {
  const selected = document.querySelector('.program-card.selected');
  if (selected) selectProgram(selected);
});
</script>
</body>
