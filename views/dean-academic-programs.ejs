<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('show');
}

function selectProgram(card){
  document.querySelectorAll('.program-card').forEach(item=>{
    item.classList.remove('selected');
  });

  card.classList.add('selected');
  document.getElementById('detailName').textContent = card.dataset.name || '';
  document.getElementById('detailRecords').textContent = card.dataset.records || '0';
}

function filterPrograms(type,button){
  document.querySelectorAll('.filter').forEach(item=>{
    item.classList.remove('active');
  });
  button.classList.add('active');
  applyProgramFilters();
}

function applyProgramFilters(){
  const query = document.getElementById('programSearch').value.trim().toLowerCase();
  const activeFilter = document.querySelector('.filter.active');
  const filter = activeFilter ? activeFilter.dataset.filter : 'all';
  const cards = document.querySelectorAll('.program-card');
  let visible = 0;

  cards.forEach(card=>{
    const matchesText = (card.dataset.search || '').includes(query);
    const records = Number(card.dataset.records || 0);
    const matchesFilter = filter === 'all' || records > 0;
    const show = matchesText && matchesFilter;

    card.style.display = show ? '' : 'none';
    if(show) visible++;
  });

  document.getElementById('noResults').style.display =
    cards.length && visible === 0 ? 'block' : 'none';
}

document.getElementById('programSearch').addEventListener('input',applyProgramFilters);

document.querySelectorAll('.sidebar .nav-link').forEach(link=>{
  link.addEventListener('click',()=>{
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('show');
  });
});
</script>
