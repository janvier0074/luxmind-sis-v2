<%
/*
  LuxMind Dean Dashboard
  File: views/dean-dashboard.ejs

  Expected render locals:
    user        - logged-in Dean account
    faculty     - { id, name, code? }
    stats       - { department_count, student_count, staff_count,
                    teacher_count, advisor_count, department_head_count,
                    course_count }
    departments - [{ id, name, code, head_name, head_username }]
    students    - [{ id, full_name, username, department_name }]
    staff       - [{ id, full_name, username, role, department_name }]
    activity    - [{ title, description, created_at }]
    courses     - [{ code, title, department_name }]
    announcements - [{ title, body, created_at }]

  All displayed values are HTML-escaped by EJS.
  This file is the UI only. The Express route must enforce role='dean'
  and filter every query by req.session.user.faculty_id.
*/
const deanUser = (typeof user !== 'undefined' && user) ? user : {};
const facultyInfo = (typeof faculty !== 'undefined' && faculty) ? faculty : {};
const dashboardStats = (typeof stats !== 'undefined' && stats) ? stats : {};
const departmentRows = Array.isArray(typeof departments !== 'undefined' ? departments : null) ? departments : [];
const studentRows = Array.isArray(typeof students !== 'undefined' ? students : null) ? students : [];
const staffRows = Array.isArray(typeof staff !== 'undefined' ? staff : null) ? staff : [];
const activityRows = Array.isArray(typeof activity !== 'undefined' ? activity : null) ? activity : [];
const courseRows = Array.isArray(typeof courses !== 'undefined' ? courses : null) ? courses : [];
const announcementRows = Array.isArray(typeof announcements !== 'undefined' ? announcements : null) ? announcements : [];
const deanName = deanUser.full_name || deanUser.username || 'Faculty Dean';
const facultyName = facultyInfo.name || 'Assigned Faculty';
const initials = String(deanName).split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || 'D';
const fmtDate = value => {
  if (!value) return '—';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString();
};
const stat = key => Number(dashboardStats[key] || 0).toLocaleString();
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#087f5b">
  <title>Dean Portal | LuxMind SIS</title>
  <style>
    :root {
      --green:#087f5b; --green-dark:#066548; --green-soft:#e9f7f1;
      --ink:#172b25; --muted:#71817b; --line:#e6eeea;
      --surface:#fff; --canvas:#f5f8f6; --sidebar:#102d25;
      --sidebar-muted:#a9c0b7; --shadow:0 8px 28px rgba(20,55,42,.06);
      --radius:16px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--canvas);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
    a{color:inherit;text-decoration:none}
    button{font:inherit}
    .app{min-height:100vh}
    .sidebar{position:fixed;inset:0 auto 0 0;width:258px;background:var(--sidebar);color:#fff;padding:24px 16px;display:flex;flex-direction:column;z-index:20;overflow-y:auto;transition:transform .25s ease}
    .brand{display:flex;align-items:center;gap:11px;padding:2px 10px 27px;border-bottom:1px solid rgba(255,255,255,.12)}
    .brand-mark{width:39px;height:39px;border-radius:12px;background:#18a875;display:grid;place-items:center;font-weight:900;font-size:19px}
    .brand-name{font-size:20px;font-weight:800;letter-spacing:-.6px}
    .brand-sub{font-size:10px;color:#a9c0b7;letter-spacing:1.5px;text-transform:uppercase;margin-top:2px}
    .nav-label{padding:23px 11px 9px;color:#7f9e91;font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}
    .nav{display:grid;gap:5px}
    .nav a{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;color:var(--sidebar-muted);font-size:13px;font-weight:600;transition:.18s}
    .nav a:hover,.nav a.active{background:rgba(31,178,125,.17);color:#fff}
    .nav-icon{width:20px;text-align:center;font-size:16px}
    .sidebar-bottom{margin-top:auto;padding:18px 10px 4px;color:#89a79a;font-size:11px;line-height:1.6}
    .main{margin-left:258px;min-height:100vh}
    .topbar{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 34px;position:sticky;top:0;z-index:10}
    .top-left{display:flex;align-items:center;gap:14px}
    .menu-btn{display:none;border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 11px;cursor:pointer}
    .crumb{font-size:12px;color:var(--muted)}
    .crumb strong{color:var(--ink)}
    .top-actions{display:flex;align-items:center;gap:18px}
    .faculty-chip{background:var(--green-soft);color:var(--green-dark);padding:8px 12px;border-radius:999px;font-size:11px;font-weight:800;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .profile{display:flex;align-items:center;gap:10px}
    .avatar{width:38px;height:38px;border-radius:50%;background:#d8f1e6;color:var(--green-dark);display:grid;place-items:center;font-size:12px;font-weight:900}
    .profile-name{font-size:12px;font-weight:800}
    .profile-role{font-size:10px;color:var(--muted);margin-top:2px}
    .content{max-width:1500px;margin:auto;padding:30px 34px 50px}
    .welcome{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:25px}
    .eyebrow{font-size:11px;color:var(--green);font-weight:900;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:8px}
    h1{font-size:27px;letter-spacing:-.8px;margin:0 0 7px}
    .welcome p{margin:0;color:var(--muted);font-size:13px}
    .date-label{font-size:12px;color:var(--muted);background:#fff;border:1px solid var(--line);padding:10px 13px;border-radius:10px;white-space:nowrap}
    .notice{padding:13px 16px;border:1px solid #d7eee3;background:#f0faf5;color:#236b50;border-radius:12px;font-size:12px;margin-bottom:22px;line-height:1.55}
    .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:24px}
    .stat-card,.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
    .stat-card{padding:19px;min-height:126px}
    .stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;font-weight:700}
    .stat-icon{width:33px;height:33px;border-radius:10px;background:var(--green-soft);display:grid;place-items:center;font-size:16px}
    .stat-number{font-size:28px;font-weight:850;letter-spacing:-1px;margin-top:12px}
    .stat-foot{font-size:10px;color:var(--muted);margin-top:3px}
    .section-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,1fr);gap:18px;margin-bottom:20px}
    .panel{padding:20px;margin-bottom:20px;scroll-margin-top:95px}
    .panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:17px}
    .panel-title{font-size:15px;font-weight:850;margin:0}
    .panel-sub{font-size:11px;color:var(--muted);margin-top:5px}
    .pill{font-size:10px;font-weight:800;color:var(--green-dark);background:var(--green-soft);padding:6px 9px;border-radius:999px;white-space:nowrap}
    .table-wrap{overflow-x:auto}
    table{width:100%;border-collapse:collapse;min-width:520px}
    th{text-align:left;color:#87958f;font-size:10px;text-transform:uppercase;letter-spacing:.8px;font-weight:800;padding:11px 10px;border-bottom:1px solid var(--line)}
    td{padding:13px 10px;border-bottom:1px solid #edf2ef;font-size:12px;color:#40534b}
    tr:last-child td{border-bottom:0}
    .primary-text{font-weight:750;color:var(--ink)}
    .muted{color:var(--muted);font-size:11px}
    .role-tag{display:inline-block;padding:5px 8px;border-radius:7px;background:#eef4f1;color:#53685e;font-size:10px;font-weight:800}
    .quick-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .quick-link{border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;gap:11px;align-items:center;transition:.18s}
    .quick-link:hover{border-color:#a8d9c3;background:#fbfefc}
    .quick-icon{width:35px;height:35px;border-radius:10px;background:var(--green-soft);display:grid;place-items:center;font-size:16px;flex:none}
    .quick-link strong{display:block;font-size:11px}
    .quick-link small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
    .info-list{display:grid;gap:13px}
    .info-row{display:flex;justify-content:space-between;gap:12px;font-size:12px}
    .info-row span:first-child{color:var(--muted)}
    .info-row strong{text-align:right}
    .empty{padding:25px 12px;text-align:center;color:var(--muted);font-size:12px}
    .activity{display:grid;gap:0}
    .activity-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #edf2ef}
    .activity-item:last-child{border-bottom:0}
    .activity-dot{width:8px;height:8px;border-radius:50%;background:#1aa875;margin-top:5px;flex:none}
    .activity-item strong{display:block;font-size:12px}
    .activity-item p{font-size:11px;color:var(--muted);margin:4px 0 0;line-height:1.5}
    .section-anchor{scroll-margin-top:95px}
    .footer{text-align:center;color:#91a099;font-size:10px;padding:15px 0 5px}
    .overlay{display:none}
    @media(max-width:1100px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.section-grid{grid-template-columns:1fr}}
    @media(max-width:760px){
      .sidebar{transform:translateX(-100%);width:270px}
      body.nav-open .sidebar{transform:translateX(0)}
      .overlay{position:fixed;inset:0;background:rgba(7,25,18,.42);z-index:15}
      body.nav-open .overlay{display:block}
      .main{margin-left:0}
      .topbar{height:66px;padding:0 17px}
      .menu-btn{display:block}
      .content{padding:23px 17px 35px}
      .welcome{align-items:flex-start;flex-direction:column}
      h1{font-size:23px}
      .date-label{display:none}
      .faculty-chip{max-width:145px}
      .profile-name,.profile-role{display:none}
    }
    @media(max-width:430px){.stats{gap:9px}.stat-card{padding:14px;min-height:115px}.stat-number{font-size:24px}.quick-links{grid-template-columns:1fr}.panel{padding:15px}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark">L</div>
      <div><div class="brand-name">LuxMind</div><div class="brand-sub">Student Information System</div></div>
    </div>

    <div class="nav-label">Dean workspace</div>
    <nav class="nav" aria-label="Dean navigation">
      <a class="active" href="#overview"><span class="nav-icon">▦</span>Overview</a>
      <a href="#departments"><span class="nav-icon">▤</span>Departments</a>
      <a href="#department-heads"><span class="nav-icon">♙</span>Department Heads</a>
      <a href="#staff"><span class="nav-icon">♧</span>Faculty Staff</a>
      <a href="#students"><span class="nav-icon">♧</span>Students</a>
      <a href="#courses"><span class="nav-icon">▣</span>Courses & Sections</a>
      <a href="#performance"><span class="nav-icon">▥</span>Academic Performance</a>
      <a href="#attendance"><span class="nav-icon">◷</span>Attendance</a>
      <a href="#announcements"><span class="nav-icon">◉</span>Announcements</a>
      <a href="#reports"><span class="nav-icon">▧</span>Faculty Reports</a>
    </nav>

    <div class="nav-label">Account</div>
    <nav class="nav">
      <a href="#faculty-information"><span class="nav-icon">ⓘ</span>Faculty Information</a>
      <a href="/logout"><span class="nav-icon">↪</span>Sign out</a>
    </nav>
    <div class="sidebar-bottom">LuxMind SIS<br>Faculty-level academic administration</div>
  </aside>

  <div class="overlay" id="overlay"></div>

  <main class="main">
    <header class="topbar">
      <div class="top-left">
        <button class="menu-btn" id="menuBtn" aria-label="Open navigation">☰</button>
        <div class="crumb">LuxMind / <strong>Dean Portal</strong></div>
      </div>
      <div class="top-actions">
        <div class="faculty-chip"><%= facultyName %></div>
        <div class="profile">
          <div class="avatar"><%= initials %></div>
          <div><div class="profile-name"><%= deanName %></div><div class="profile-role">Faculty Dean</div></div>
        </div>
      </div>
    </header>

    <div class="content">
      <section class="welcome" id="overview">
        <div>
          <div class="eyebrow">Faculty administration</div>
          <h1>Dean Dashboard</h1>
          <p>Welcome, <strong><%= deanName %></strong>. Here is an overview of your faculty.</p>
        </div>
        <div class="date-label" id="todayLabel">Faculty overview</div>
      </section>

      <div class="notice">
        <strong>Faculty scope:</strong> This dashboard is intended to show information belonging only to
        <strong><%= facultyName %></strong>. The server route must enforce this scope in every database query.
      </div>

      <section class="stats" aria-label="Faculty statistics">
        <article class="stat-card"><div class="stat-top"><span>Departments</span><span class="stat-icon">▤</span></div><div class="stat-number"><%= stat('department_count') || departmentRows.length %></div><div class="stat-foot">Departments in this faculty</div></article>
        <article class="stat-card"><div class="stat-top"><span>Students</span><span class="stat-icon">♧</span></div><div class="stat-number"><%= stat('student_count') %></div><div class="stat-foot">Enrolled student accounts</div></article>
        <article class="stat-card"><div class="stat-top"><span>Academic staff</span><span class="stat-icon">♙</span></div><div class="stat-number"><%= stat('staff_count') %></div><div class="stat-foot">Teachers and advisors</div></article>
        <article class="stat-card"><div class="stat-top"><span>Department Heads</span><span class="stat-icon">⌂</span></div><div class="stat-number"><%= stat('department_head_count') || departmentRows.filter(d => d.head_name).length %></div><div class="stat-foot">Assigned department leaders</div></article>
      </section>

      <div class="section-grid">
        <section class="panel" id="departments">
          <div class="panel-head"><div><h2 class="panel-title">Departments</h2><div class="panel-sub">Departments registered under your faculty</div></div><span class="pill"><%= departmentRows.length %> listed</span></div>
          <% if (departmentRows.length) { %>
            <div class="table-wrap"><table><thead><tr><th>Department</th><th>Code</th><th>Department Head</th></tr></thead><tbody>
              <% departmentRows.forEach(dept => { %>
                <tr><td class="primary-text"><%= dept.name || 'Unnamed department' %></td><td><%= dept.code || '—' %></td><td><%= dept.head_name || 'Not assigned' %><% if (dept.head_username) { %><div class="muted"><%= dept.head_username %></div><% } %></td></tr>
              <% }) %>
            </tbody></table></div>
          <% } else { %><div class="empty">No department records were supplied to this dashboard.</div><% } %>
        </section>

        <section class="panel" id="faculty-information">
          <div class="panel-head"><div><h2 class="panel-title">Faculty information</h2><div class="panel-sub">Your assigned administrative scope</div></div><span class="pill">Dean</span></div>
          <div class="info-list">
            <div class="info-row"><span>Faculty name</span><strong><%= facultyName %></strong></div>
            <div class="info-row"><span>Faculty ID</span><strong><%= facultyInfo.id || deanUser.faculty_id || '—' %></strong></div>
            <div class="info-row"><span>Dean</span><strong><%= deanName %></strong></div>
            <div class="info-row"><span>Username</span><strong><%= deanUser.username || '—' %></strong></div>
            <div class="info-row"><span>Departments</span><strong><%= stat('department_count') || departmentRows.length %></strong></div>
            <div class="info-row"><span>Courses</span><strong><%= stat('course_count') || courseRows.length %></strong></div>
          </div>
        </section>
      </div>

      <section class="panel" id="department-heads">
        <div class="panel-head"><div><h2 class="panel-title">Department Head directory</h2><div class="panel-sub">Leadership assignments across your faculty</div></div></div>
        <% const headRows = departmentRows.filter(d => d.head_name); %>
        <% if (headRows.length) { %>
          <div class="table-wrap"><table><thead><tr><th>Department</th><th>Department Head</th><th>Username</th><th>Assignment</th></tr></thead><tbody>
            <% headRows.forEach(dept => { %><tr><td class="primary-text"><%= dept.name %></td><td><%= dept.head_name %></td><td><%= dept.head_username || '—' %></td><td><span class="role-tag">Assigned</span></td></tr><% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty">No Department Head assignments were found for this faculty.</div><% } %>
      </section>

      <div class="section-grid">
        <section class="panel" id="staff">
          <div class="panel-head"><div><h2 class="panel-title">Faculty staff</h2><div class="panel-sub">Teachers and academic advisors</div></div><span class="pill"><%= staffRows.length %> listed</span></div>
          <% if (staffRows.length) { %>
            <div class="table-wrap"><table><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Department</th></tr></thead><tbody>
              <% staffRows.forEach(person => { %><tr><td class="primary-text"><%= person.full_name || '—' %></td><td><%= person.username || '—' %></td><td><span class="role-tag"><%= person.role || 'Staff' %></span></td><td><%= person.department_name || '—' %></td></tr><% }) %>
            </tbody></table></div>
          <% } else { %><div class="empty">No staff records were supplied.</div><% } %>
        </section>

        <section class="panel" id="students">
          <div class="panel-head"><div><h2 class="panel-title">Recently listed students</h2><div class="panel-sub">Student accounts within your faculty</div></div><span class="pill"><%= studentRows.length %> shown</span></div>
          <% if (studentRows.length) { %>
            <div class="table-wrap"><table><thead><tr><th>Student</th><th>Username</th><th>Department</th></tr></thead><tbody>
              <% studentRows.slice(0, 12).forEach(student => { %><tr><td class="primary-text"><%= student.full_name || '—' %></td><td><%= student.username || '—' %></td><td><%= student.department_name || '—' %></td></tr><% }) %>
            </tbody></table></div>
          <% } else { %><div class="empty">No student records were supplied.</div><% } %>
        </section>
      </div>

      <section class="panel" id="courses">
        <div class="panel-head"><div><h2 class="panel-title">Courses and sections</h2><div class="panel-sub">Course catalogue entries supplied for this faculty</div></div><span class="pill"><%= courseRows.length %> listed</span></div>
        <% if (courseRows.length) { %>
          <div class="table-wrap"><table><thead><tr><th>Course code</th><th>Course title</th><th>Department</th></tr></thead><tbody>
            <% courseRows.forEach(course => { %><tr><td class="primary-text"><%= course.code || '—' %></td><td><%= course.title || '—' %></td><td><%= course.department_name || '—' %></td></tr><% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty">Course data has not been connected to this dashboard yet.</div><% } %>
      </section>

      <div class="section-grid">
        <section class="panel" id="performance">
          <div class="panel-head"><div><h2 class="panel-title">Academic performance</h2><div class="panel-sub">Academic activity feed for this faculty</div></div></div>
          <% if (activityRows.length) { %><div class="activity">
            <% activityRows.forEach(item => { %><div class="activity-item"><span class="activity-dot"></span><div><strong><%= item.title || item.description || 'Academic update' %></strong><p><%= item.description && item.title ? item.description : 'Recorded academic activity' %> · <%= fmtDate(item.created_at) %></p></div></div><% }) %>
          </div><% } else { %><div class="empty">Academic performance data has not been connected yet.</div><% } %>
        </section>

        <section class="panel" id="attendance">
          <div class="panel-head"><div><h2 class="panel-title">Attendance overview</h2><div class="panel-sub">Attendance reporting workspace</div></div><span class="pill">Faculty scope</span></div>
          <div class="empty">Attendance summaries will appear here when the faculty-scoped attendance query is connected.</div>
        </section>
      </div>

      <div class="section-grid">
        <section class="panel" id="announcements">
          <div class="panel-head"><div><h2 class="panel-title">Faculty announcements</h2><div class="panel-sub">Updates published for this faculty</div></div></div>
          <% if (announcementRows.length) { %><div class="activity">
            <% announcementRows.forEach(item => { %><div class="activity-item"><span class="activity-dot"></span><div><strong><%= item.title || 'Announcement' %></strong><p><%= item.body || '' %> · <%= fmtDate(item.created_at) %></p></div></div><% }) %>
          </div><% } else { %><div class="empty">No faculty announcements are available.</div><% } %>
        </section>

        <section class="panel" id="reports">
          <div class="panel-head"><div><h2 class="panel-title">Faculty reports</h2><div class="panel-sub">Quick access to dashboard sections</div></div></div>
          <div class="quick-links">
            <a class="quick-link" href="#departments"><span class="quick-icon">▤</span><span><strong>Department summary</strong><small>View department list</small></span></a>
            <a class="quick-link" href="#staff"><span class="quick-icon">♙</span><span><strong>Staff directory</strong><small>Review academic staff</small></span></a>
            <a class="quick-link" href="#students"><span class="quick-icon">♧</span><span><strong>Student overview</strong><small>View listed students</small></span></a>
            <a class="quick-link" href="#performance"><span class="quick-icon">▥</span><span><strong>Academic activity</strong><small>Review recent updates</small></span></a>
          </div>
        </section>
      </div>

      <div class="footer">LuxMind Student Information System · Dean Portal</div>
    </div>
  </main>
</div>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const overlay = document.getElementById('overlay');
  const closeMenu = () => document.body.classList.remove('nav-open');

  menuBtn?.addEventListener('click', () => document.body.classList.toggle('nav-open'));
  overlay?.addEventListener('click', closeMenu);

  document.querySelectorAll('.sidebar .nav a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => {
      document.querySelectorAll('.sidebar .nav a').forEach(item => item.classList.remove('active'));
      link.classList.add('active');
      closeMenu();
    });
  });

  const todayLabel = document.getElementById('todayLabel');
  if (todayLabel) {
    todayLabel.textContent = new Intl.DateTimeFormat(undefined, {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    }).format(new Date());
  }
</script>
</body>
</html>
