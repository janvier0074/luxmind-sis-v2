
<%
/*
  LUXMIND - DEAN FACULTY MANAGEMENT PORTAL
  File: views/dean-dashboard.ejs

  Connected workspaces:
  - Overview
  - Faculty Profile
  - Departments Management
  - Department Heads
  - Other Dean modules: internal workspaces

  Existing route locals:
  user, faculty, stats, departments, students,
  staff, courses, activity, announcements
*/

const deanUser = (typeof user !== 'undefined' && user) ? user : {};
const facultyInfo = (typeof faculty !== 'undefined' && faculty) ? faculty : {};
const dashboardStats = (typeof stats !== 'undefined' && stats) ? stats : {};

const departmentRows = Array.isArray(typeof departments !== 'undefined' ? departments : null) ? departments : [];
const studentRows = Array.isArray(typeof students !== 'undefined' ? students : null) ? students : [];
const staffRows = Array.isArray(typeof staff !== 'undefined' ? staff : null) ? staff : [];
const activityRows = Array.isArray(typeof activity !== 'undefined' ? activity : null) ? activity : [];
const courseRows = Array.isArray(typeof courses !== 'undefined' ? courses : null) ? courses : [];
const announcementRows = Array.isArray(typeof announcements !== 'undefined' ? announcements : null) ? announcements : [];

const deanName = deanUser.full_name || deanUser.username || 'Faculty Dean';
const facultyName = facultyInfo.name || 'Assigned Faculty';

const initials = String(deanName)
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map(part => part[0])
  .join('')
  .toUpperCase() || 'D';

const stat = key => Number(dashboardStats[key] || 0).toLocaleString();

const fmtDate = value => {
  if (!value) return '—';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString();
};

/*
  CENTRAL DEAN NAVIGATION
*/

const navGroups = [
  {
    title: 'Dean Workspace',
    items: [
      ['overview', '▦', 'Overview', 'Faculty dashboard and pending priorities']
    ]
  },
  {
    title: 'Faculty Administration',
    items: [
      ['faculty-profile', '▣', 'Faculty Profile', 'Faculty identity and information'],
      ['departments', '▤', 'Departments Management', 'Department directory and structure'],
      ['department-heads', '♙', 'Department Heads', 'Leadership assignments'],
      ['faculty-staff', '♧', 'Faculty Staff', 'Teachers, advisors and staff'],
      ['staff-assignments', '⇄', 'Staff Assignments', 'Staff responsibilities and allocation'],
      ['faculty-structure', '⌘', 'Faculty Structure', 'Organizational structure']
    ]
  },
  {
    title: 'Academic Management',
    items: [
      ['academic-programs', '▥', 'Academic Programs', 'Programs offered by the faculty'],
      ['courses', '▣', 'Courses & Curriculum', 'Course catalogue and curriculum'],
      ['course-allocation', '⇄', 'Course Allocation', 'Teaching assignments'],
      ['timetables', '▦', 'Class Timetables', 'Class and teaching schedules'],
      ['examinations', '✎', 'Examinations', 'Examination planning'],
      ['grades', '▤', 'Grades & Results', 'Academic results and grades'],
      ['performance', '▥', 'Academic Performance', 'Faculty performance indicators'],
      ['academic-calendar', '▦', 'Academic Calendar', 'Important academic dates']
    ]
  },
  {
    title: 'Student Affairs',
    items: [
      ['students', '♧', 'Student Directory', 'Students registered in the faculty'],
      ['student-registration', '＋', 'Student Registration', 'Registration overview'],
      ['enrollment', '▤', 'Enrollment Overview', 'Enrollment monitoring'],
      ['student-records', '▣', 'Student Academic Records', 'Academic history'],
      ['student-progress', '↗', 'Student Progress', 'Progress monitoring'],
      ['advising', '♙', 'Academic Advising', 'Advising activities'],
      ['student-requests', '▧', 'Student Requests', 'Requests requiring attention']
    ]
  },
  {
    title: 'Monitoring & Quality',
    items: [
      ['attendance', '◷', 'Attendance Monitoring', 'Attendance overview'],
      ['teaching-evaluation', '★', 'Teaching Evaluation', 'Teaching quality feedback'],
      ['department-performance', '▥', 'Department Performance', 'Department-level indicators'],
      ['quality-assurance', '✓', 'Quality Assurance', 'Quality review activities'],
      ['accreditation', '▣', 'Accreditation', 'Accreditation preparation'],
      ['compliance', '☷', 'Academic Compliance', 'Academic policy monitoring']
    ]
  },
  {
    title: 'Research & Development',
    items: [
      ['research-projects', '⌕', 'Research Projects', 'Faculty research portfolio'],
      ['publications', '▤', 'Publications', 'Research publications'],
      ['faculty-projects', '◇', 'Faculty Projects', 'Projects and initiatives'],
      ['collaboration', '⇄', 'Research Collaboration', 'Research partnerships']
    ]
  },
  {
    title: 'Communication',
    items: [
      ['announcements', '◉', 'Announcements', 'Faculty notices and updates'],
      ['messages', '✉', 'Messages', 'Faculty communication'],
      ['meetings', '▦', 'Meetings', 'Faculty and department meetings'],
      ['faculty-notices', '▤', 'Faculty Notices', 'Official faculty notices'],
      ['approval-requests', '✓', 'Approval Requests', 'Items awaiting Dean review']
    ]
  },
  {
    title: 'Reports & Analytics',
    items: [
      ['faculty-reports', '▧', 'Faculty Reports', 'Faculty-level reports'],
      ['student-reports', '▤', 'Student Reports', 'Student reporting'],
      ['staff-reports', '▤', 'Staff Reports', 'Staff reporting'],
      ['academic-reports', '▥', 'Academic Reports', 'Academic reporting'],
      ['attendance-reports', '◷', 'Attendance Reports', 'Attendance reporting'],
      ['export-center', '⇩', 'Export Center', 'Export approved reports']
    ]
  },
  {
    title: 'Resources & Finance',
    items: [
      ['budget', '＄', 'Faculty Budget Overview', 'Budget visibility'],
      ['resource-requests', '＋', 'Resource Requests', 'Resource requests'],
      ['facilities', '⌂', 'Equipment & Facilities', 'Faculty facilities and equipment'],
      ['resource-allocation', '⇄', 'Department Resource Allocation', 'Resource distribution']
    ]
  },
  {
    title: 'Account',
    items: [
      ['dean-profile', '♙', 'Dean Profile', 'Personal account information'],
      ['notifications', '♧', 'Notifications', 'Alerts and updates'],
      ['preferences', '⚙', 'Security & Preferences', 'Account preferences']
    ]
  }
];

/*
  ACTUAL STANDALONE PAGES

  These pages have their own Express routes and EJS templates.
  Department Heads, Faculty Staff and Staff Assignments
  are connected here.
*/

const standaloneRoutes = {
  'faculty-profile': '/sis/dean/faculty-profile',
  'departments': '/sis/dean/departments',
  'department-heads': '/sis/dean/department-heads',
  'faculty-staff': '/sis/dean/faculty-staff',
  'staff-assignments': '/sis/dean/staff-assignments',
  'faculty-structure': '/sis/dean/faculty-structure',
  'academic-programs': '/sis/dean/academic-programs',
  'courses': '/sis/dean/courses-curriculum',
  'timetables': '/sis/dean/class-timetables',
'course-allocation': '/sis/dean/course-allocation',
'examinations': '/sis/dean/examinations',
'grades': '/sis/dean/grades-results'
};

const quickAccess = [
  ['departments', '▤', 'Departments', 'Manage faculty departments'],
  ['department-heads', '♙', 'Department Heads', 'Review leadership assignments'],
  ['faculty-staff', '♧', 'Faculty Staff', 'Manage academic staff'],
  ['students', '♧', 'Students', 'Open student directory'],
  ['courses', '▣', 'Courses', 'Review course catalogue'],
  ['announcements', '◉', 'Announcements', 'Open faculty notices']
];

%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#087f5b">

<title>Dean Portal | LuxMind Faculty Management</title>

<style>
:root{
  --green:#087f5b;
  --green-dark:#066548;
  --green-soft:#e9f7f1;
  --ink:#172b25;
  --muted:#71817b;
  --line:#e6eeea;
  --surface:#fff;
  --canvas:#f5f8f6;
  --sidebar:#102d25;
  --sidebar-muted:#a9c0b7;
  --shadow:0 8px 28px rgba(20,55,42,.06);
  --radius:16px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--canvas);
  color:var(--ink);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
}
button{font:inherit}
a{color:inherit;text-decoration:none}
.app{min-height:100vh}

/* SIDEBAR */

.sidebar{
  position:fixed;
  inset:0 auto 0 0;
  width:278px;
  background:var(--sidebar);
  color:#fff;
  padding:20px 14px 16px;
  display:flex;
  flex-direction:column;
  z-index:30;
  overflow-y:auto;
  transition:transform .25s ease;
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  padding:5px 10px 20px;
  border-bottom:1px solid rgba(255,255,255,.12);
  margin-bottom:8px;
}
.brand-mark{
  width:40px;
  height:40px;
  border-radius:12px;
  background:#18a875;
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:20px;
}
.brand-name{
  font-size:20px;
  font-weight:850;
  letter-spacing:-.6px;
}
.brand-sub{
  font-size:9px;
  color:#a9c0b7;
  letter-spacing:1.15px;
  text-transform:uppercase;
  margin-top:3px;
  line-height:1.4;
}
.nav-group{margin-top:8px}
.nav-label{
  padding:13px 11px 7px;
  color:#7f9e91;
  font-size:9px;
  font-weight:850;
  letter-spacing:1.35px;
  text-transform:uppercase;
}
.nav{display:grid;gap:3px}
.nav-link{
  width:100%;
  border:0;
  background:transparent;
  display:flex;
  align-items:center;
  gap:11px;
  padding:9px 11px;
  border-radius:9px;
  color:var(--sidebar-muted);
  font-size:12px;
  font-weight:620;
  text-align:left;
  cursor:pointer;
  transition:.16s;
}
.nav-link:hover,.nav-link.active{
  background:rgba(31,178,125,.18);
  color:#fff;
}
.nav-icon{
  width:19px;
  text-align:center;
  font-size:15px;
  flex:none;
}
.nav-link.active{
  box-shadow:inset 3px 0 #28c58c;
}
.sidebar-bottom{
  margin-top:20px;
  padding:15px 10px 4px;
  border-top:1px solid rgba(255,255,255,.1);
  color:#89a79a;
  font-size:10px;
  line-height:1.6;
}

/* MAIN AND TOPBAR */

.main{
  margin-left:278px;
  min-height:100vh;
}
.topbar{
  height:74px;
  background:#fff;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 30px;
  position:sticky;
  top:0;
  z-index:20;
}
.top-left{
  display:flex;
  align-items:center;
  gap:13px;
}
.menu-btn{
  display:none;
  border:1px solid var(--line);
  background:#fff;
  border-radius:9px;
  padding:8px 11px;
  cursor:pointer;
}
.crumb{font-size:12px;color:var(--muted)}
.crumb strong{color:var(--ink)}
.top-actions{
  display:flex;
  align-items:center;
  gap:16px;
}
.faculty-chip{
  background:var(--green-soft);
  color:var(--green-dark);
  padding:8px 12px;
  border-radius:999px;
  font-size:11px;
  font-weight:800;
  max-width:230px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.notification-btn{
  position:relative;
  width:38px;
  height:38px;
  border:1px solid var(--line);
  border-radius:11px;
  background:#fff;
  color:#40534b;
  cursor:pointer;
  font-size:17px;
}
.notification-dot{
  position:absolute;
  right:7px;
  top:6px;
  width:8px;
  height:8px;
  border-radius:50%;
  background:#e05252;
  border:1px solid #fff;
}
.profile{
  display:flex;
  align-items:center;
  gap:9px;
}
.avatar{
  width:37px;
  height:37px;
  border-radius:50%;
  background:#d8f1e6;
  color:var(--green-dark);
  display:grid;
  place-items:center;
  font-size:12px;
  font-weight:900;
}
.profile-name{font-size:12px;font-weight:800}
.profile-role{
  font-size:10px;
  color:var(--muted);
  margin-top:2px;
}
.logout-btn{
  border:1px solid #f0d9d9;
  background:#fff7f7;
  color:#a33b3b;
  border-radius:9px;
  padding:9px 12px;
  font-size:11px;
  font-weight:750;
  cursor:pointer;
}

/* CONTENT */

.content{
  max-width:1550px;
  margin:auto;
  padding:28px 30px 48px;
}
.page-heading{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:20px;
  margin-bottom:22px;
}
.eyebrow{
  font-size:10px;
  color:var(--green);
  font-weight:900;
  letter-spacing:1.3px;
  text-transform:uppercase;
  margin-bottom:7px;
}
.page-heading h1{
  font-size:26px;
  letter-spacing:-.7px;
  margin:0 0 6px;
}
.page-heading p{
  margin:0;
  color:var(--muted);
  font-size:12px;
}
.date-label{
  font-size:11px;
  color:var(--muted);
  background:#fff;
  border:1px solid var(--line);
  padding:10px 12px;
  border-radius:10px;
  white-space:nowrap;
}

/* STATISTICS */

.stats{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
  margin-bottom:19px;
}
.stat-card,.panel{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}
.stat-card{
  padding:17px;
  min-height:119px;
}
.stat-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
}
.stat-icon{
  width:32px;
  height:32px;
  border-radius:10px;
  background:var(--green-soft);
  display:grid;
  place-items:center;
  font-size:15px;
}
.stat-number{
  font-size:27px;
  font-weight:850;
  letter-spacing:-1px;
  margin-top:10px;
}
.stat-foot{
  font-size:10px;
  color:var(--muted);
  margin-top:3px;
}

/* PANELS */

.panel{
  padding:19px;
  margin-bottom:17px;
}
.panel-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:15px;
  margin-bottom:15px;
}
.panel-title{
  font-size:14px;
  font-weight:850;
  margin:0;
}
.panel-sub{
  font-size:10px;
  color:var(--muted);
  margin-top:5px;
}
.pill{
  font-size:10px;
  font-weight:800;
  color:var(--green-dark);
  background:var(--green-soft);
  padding:6px 9px;
  border-radius:999px;
  white-space:nowrap;
}
a.pill:hover{background:#d8f2e5}
.overview-grid{
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(270px,1fr);
  gap:17px;
}
.summary-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}
.summary-item{
  border:1px solid var(--line);
  border-radius:12px;
  padding:13px;
}
.summary-item strong{
  display:block;
  font-size:12px;
}
.summary-item span{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:4px;
}
.info-list{display:grid;gap:12px}
.info-row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  font-size:11px;
}
.info-row span:first-child{color:var(--muted)}
.info-row strong{text-align:right}

/* QUICK ACCESS */

.quick-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
}
.quick-link{
  border:1px solid var(--line);
  border-radius:11px;
  padding:12px;
  display:flex;
  gap:10px;
  align-items:center;
  text-align:left;
  background:#fff;
  cursor:pointer;
  transition:.16s;
  width:100%;
}
.quick-link:hover{
  border-color:#a8d9c3;
  background:#fbfefc;
}
.quick-icon{
  width:32px;
  height:32px;
  border-radius:9px;
  background:var(--green-soft);
  display:grid;
  place-items:center;
  font-size:15px;
  flex:none;
}
.quick-link strong{
  display:block;
  font-size:10px;
}
.quick-link small{
  display:block;
  color:var(--muted);
  font-size:9px;
  margin-top:3px;
}

/* TABLES */

.table-wrap{overflow-x:auto}
table{
  width:100%;
  border-collapse:collapse;
  min-width:480px;
}
th{
  text-align:left;
  color:#87958f;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.8px;
  font-weight:800;
  padding:10px;
  border-bottom:1px solid var(--line);
}
td{
  padding:12px 10px;
  border-bottom:1px solid #edf2ef;
  font-size:11px;
  color:#40534b;
}
tr:last-child td{border-bottom:0}
.primary-text{
  font-weight:750;
  color:var(--ink);
}
.muted{color:var(--muted);font-size:10px}
.empty{
  padding:22px 12px;
  text-align:center;
  color:var(--muted);
  font-size:11px;
}

/* ACTIVITY */

.activity{display:grid}
.activity-item{
  display:flex;
  gap:10px;
  padding:10px 0;
  border-bottom:1px solid #edf2ef;
}
.activity-item:last-child{border-bottom:0}
.activity-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#1aa875;
  margin-top:5px;
  flex:none;
}
.activity-item strong{
  display:block;
  font-size:11px;
}
.activity-item p{
  font-size:10px;
  color:var(--muted);
  margin:4px 0 0;
  line-height:1.5;
}

/* WORKSPACES */

.module-view{display:none}
.module-view.active{display:block}
.overview-view.active{display:block}

.module-placeholder{
  min-height:300px;
  display:grid;
  place-items:center;
  text-align:center;
  padding:35px;
}
.placeholder-icon{
  width:62px;
  height:62px;
  border-radius:18px;
  background:var(--green-soft);
  color:var(--green);
  display:grid;
  place-items:center;
  font-size:26px;
  margin:0 auto 15px;
}
.module-placeholder h2{
  font-size:19px;
  margin:0 0 8px;
}
.module-placeholder p{
  font-size:12px;
  color:var(--muted);
  max-width:470px;
  line-height:1.7;
  margin:0 auto 17px;
}
.coming-soon{
  display:inline-block;
  background:#f3f5f4;
  color:#687970;
  padding:7px 11px;
  border-radius:999px;
  font-size:10px;
  font-weight:800;
}
.workspace-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:9px;
  margin-top:17px;
}
.workspace-action{
  display:inline-block;
  background:var(--green);
  color:#fff;
  border-radius:9px;
  padding:10px 14px;
  font-size:11px;
  font-weight:750;
}
.workspace-action:hover{background:var(--green-dark)}
.footer{
  text-align:center;
  color:#91a099;
  font-size:10px;
  padding:15px 0 4px;
}

/* MOBILE */

.overlay{display:none}

@media(max-width:1150px){
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .overview-grid{grid-template-columns:1fr}
  .quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media(max-width:760px){
  .sidebar{
    transform:translateX(-100%);
    width:285px;
  }
  .sidebar.open{transform:translateX(0)}
  .overlay{
    position:fixed;
    inset:0;
    background:rgba(7,25,18,.42);
    z-index:25;
  }
  .overlay.show{display:block}
  .main{margin-left:0}
  .topbar{
    height:65px;
    padding:0 14px;
  }
  .menu-btn{display:block}
  .content{padding:22px 15px 35px}
  .page-heading{
    align-items:flex-start;
    flex-direction:column;
  }
  .date-label{display:none}
  .faculty-chip{display:none}
  .profile-name,.profile-role{display:none}
  .top-actions{gap:9px}
  .logout-btn{padding:8px 9px}
  .quick-grid{grid-template-columns:1fr 1fr}
}

@media(max-width:430px){
  .stats{gap:8px}
  .stat-card{
    padding:13px;
    min-height:108px;
  }
  .stat-number{font-size:23px}
  .quick-grid,.summary-grid{grid-template-columns:1fr}
  .panel{padding:14px}
  .page-heading h1{font-size:23px}
}
</style>
  <link rel="stylesheet" href="/css/mobile.css">
  <script src="/js/mobile.js" defer></script>
</head>

<body>
<div class="app">

  <!-- DEAN SIDEBAR -->

  <aside class="sidebar" id="sidebar">

    <div class="brand">
      <div class="brand-mark">L</div>
      <div>
        <div class="brand-name">LuxMind</div>
        <div class="brand-sub">Faculty Management Portal</div>
      </div>
    </div>

    <% navGroups.forEach(group => { %>
      <div class="nav-group">

        <div class="nav-label"><%= group.title %></div>

        <nav class="nav" aria-label="<%= group.title %>">

          <% group.items.forEach(item => { %>

            <% if (standaloneRoutes[item[0]]) { %>

              <a
                href="<%= standaloneRoutes[item[0]] %>"
                class="nav-link"
                data-route="<%= item[0] %>"
                title="<%= item[3] %>"
              >
                <span class="nav-icon"><%= item[1] %></span>
                <span><%= item[2] %></span>
              </a>

            <% } else { %>

              <button
                type="button"
                class="nav-link <%= item[0] === 'overview' ? 'active' : '' %>"
                data-view="<%= item[0] %>"
                title="<%= item[3] %>"
              >
                <span class="nav-icon"><%= item[1] %></span>
                <span><%= item[2] %></span>
              </button>

            <% } %>

          <% }) %>

        </nav>
      </div>
    <% }) %>

    <div class="sidebar-bottom">
      LuxMind<br>
      Faculty-level academic administration
    </div>

  </aside>

  <div class="overlay" id="overlay"></div>

  <!-- MAIN AREA -->

  <main class="main">

    <!-- TOPBAR -->

    <header class="topbar">

      <div class="top-left">
        <button
          class="menu-btn"
          id="menuBtn"
          type="button"
          aria-label="Open navigation"
        >☰</button>

        <div class="crumb">
          LuxMind / <strong id="breadcrumbTitle">Overview</strong>
        </div>
      </div>

      <div class="top-actions">

        <div class="faculty-chip"><%= facultyName %></div>

        <button
          type="button"
          class="notification-btn"
          id="notificationBtn"
          aria-label="Open notifications"
          title="Notifications"
        >
          ♧
          <% if (announcementRows.length) { %>
            <span class="notification-dot"></span>
          <% } %>
        </button>

        <div class="profile">
          <div class="avatar"><%= initials %></div>
          <div>
            <div class="profile-name"><%= deanName %></div>
            <div class="profile-role">Faculty Dean</div>
          </div>
        </div>

        <a class="logout-btn" href="/logout">↪ Logout</a>

      </div>
    </header>

    <div class="content">

      <!-- =====================================
           OVERVIEW WORKSPACE
      ====================================== -->

      <section class="module-view overview-view active" data-page="overview">

        <div class="page-heading">
          <div>
            <div class="eyebrow">Faculty administration</div>
            <h1>Dean Dashboard</h1>
            <p>
              Welcome, <strong><%= deanName %></strong>.
              Here is your faculty at a glance.
            </p>
          </div>

          <div class="date-label" id="todayLabel">Faculty overview</div>
        </div>

        <!-- STATISTICS -->

        <section class="stats" aria-label="Faculty statistics">

          <article class="stat-card">
            <div class="stat-top">
              <span>Departments</span>
              <span class="stat-icon">▤</span>
            </div>
            <div class="stat-number">
              <%= stat('department_count') || departmentRows.length %>
            </div>
            <div class="stat-foot">Departments in your faculty</div>
          </article>

          <article class="stat-card">
            <div class="stat-top">
              <span>Students</span>
              <span class="stat-icon">♧</span>
            </div>
            <div class="stat-number"><%= stat('student_count') %></div>
            <div class="stat-foot">Student accounts</div>
          </article>

          <article class="stat-card">
            <div class="stat-top">
              <span>Academic staff</span>
              <span class="stat-icon">♙</span>
            </div>
            <div class="stat-number"><%= stat('staff_count') %></div>
            <div class="stat-foot">Teachers, advisors and heads</div>
          </article>

          <article class="stat-card">
            <div class="stat-top">
              <span>Department Heads</span>
              <span class="stat-icon">⌂</span>
            </div>
            <div class="stat-number">
              <%= stat('department_head_count') || departmentRows.filter(d => d.head_name).length %>
            </div>
            <div class="stat-foot">Assigned department leaders</div>
          </article>

        </section>

        <!-- FACULTY SNAPSHOT -->

        <div class="overview-grid">

          <section class="panel">

            <div class="panel-head">
              <div>
                <h2 class="panel-title">Faculty snapshot</h2>
                <div class="panel-sub">
                  A quick summary of your faculty structure
                </div>
              </div>
              <span class="pill">Overview</span>
            </div>

            <div class="summary-grid">

              <div class="summary-item">
                <strong><%= stat('course_count') || courseRows.length %> Courses</strong>
                <span>Courses registered under this faculty</span>
              </div>

              <div class="summary-item">
                <strong><%= departmentRows.length %> Departments</strong>
                <span>Department records in your faculty</span>
              </div>

              <div class="summary-item">
                <strong><%= staffRows.length %> Staff listed</strong>
                <span>Academic and department leadership staff</span>
              </div>

              <div class="summary-item">
                <strong><%= announcementRows.length %> Announcements</strong>
                <span>Announcements currently supplied</span>
              </div>

            </div>
          </section>

          <!-- FACULTY INFORMATION -->

          <section class="panel">

            <div class="panel-head">
              <div>
                <h2 class="panel-title">Faculty information</h2>
                <div class="panel-sub">Your assigned administrative scope</div>
              </div>
              <span class="pill">Dean</span>
            </div>

            <div class="info-list">

              <div class="info-row">
                <span>Faculty</span>
                <strong><%= facultyName %></strong>
              </div>

              <div class="info-row">
                <span>Faculty ID</span>
                <strong><%= facultyInfo.id || deanUser.faculty_id || '—' %></strong>
              </div>

              <div class="info-row">
                <span>Dean</span>
                <strong><%= deanName %></strong>
              </div>

              <div class="info-row">
                <span>Username</span>
                <strong><%= deanUser.username || '—' %></strong>
              </div>

            </div>

          </section>

        </div>

        <!-- QUICK ACCESS -->

        <section class="panel">

          <div class="panel-head">
            <div>
              <h2 class="panel-title">Quick access</h2>
              <div class="panel-sub">
                Open frequently used faculty workspaces
              </div>
            </div>
          </div>

          <div class="quick-grid">

            <% quickAccess.forEach(item => { %>

              <% if (standaloneRoutes[item[0]]) { %>

                <a
                  class="quick-link"
                  href="<%= standaloneRoutes[item[0]] %>"
                >
                  <span class="quick-icon"><%= item[1] %></span>
                  <span>
                    <strong><%= item[2] %></strong>
                    <small><%= item[3] %></small>
                  </span>
                </a>

              <% } else { %>

                <button
                  type="button"
                  class="quick-link"
                  data-open-view="<%= item[0] %>"
                >
                  <span class="quick-icon"><%= item[1] %></span>
                  <span>
                    <strong><%= item[2] %></strong>
                    <small><%= item[3] %></small>
                  </span>
                </button>

              <% } %>

            <% }) %>

          </div>
        </section>

        <!-- DEPARTMENT OVERVIEW AND ACTIVITY -->

        <div class="overview-grid">

          <section class="panel">

            <div class="panel-head">
              <div>
                <h2 class="panel-title">Departments overview</h2>
                <div class="panel-sub">
                  Departments registered under your faculty
                </div>
              </div>

              <a class="pill" href="/sis/dean/departments">
                Manage Departments →
              </a>
            </div>

            <% if (departmentRows.length) { %>

              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Department</th>
                      <th>Code</th>
                      <th>Department Head</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% departmentRows.slice(0, 6).forEach(dept => { %>
                      <tr>
                        <td class="primary-text">
                          <%= dept.name || 'Unnamed department' %>
                        </td>
                        <td><%= dept.code || '—' %></td>
                        <td><%= dept.head_name || 'Not assigned' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

            <% } else { %>

              <div class="empty">
                No department records are available.
              </div>

            <% } %>

          </section>

          <section class="panel">

            <div class="panel-head">
              <div>
                <h2 class="panel-title">Recent academic activity</h2>
                <div class="panel-sub">
                  Latest activity supplied by academic records
                </div>
              </div>
            </div>

            <% if (activityRows.length) { %>

              <div class="activity">

                <% activityRows.slice(0, 6).forEach(item => { %>

                  <div class="activity-item">
                    <span class="activity-dot"></span>
                    <div>
                      <strong><%= item.title || 'Academic update' %></strong>
                      <p>
                        <%= item.description || '' %>
                        · <%= fmtDate(item.created_at) %>
                      </p>
                    </div>
                  </div>

                <% }) %>

              </div>

            <% } else { %>

              <div class="empty">
                No recent academic activity is available.
              </div>

            <% } %>

          </section>

        </div>

        <!-- ANNOUNCEMENTS -->

        <section class="panel">

          <div class="panel-head">
            <div>
              <h2 class="panel-title">Recent announcements</h2>
              <div class="panel-sub">Faculty updates and notices</div>
            </div>

            <button
              type="button"
              class="pill"
              data-open-view="announcements"
            >
              View all →
            </button>
          </div>

          <% if (announcementRows.length) { %>

            <div class="activity">

              <% announcementRows.slice(0, 5).forEach(item => { %>

                <div class="activity-item">
                  <span class="activity-dot"></span>
                  <div>
                    <strong><%= item.title || 'Announcement' %></strong>
                    <p>
                      <%= item.body || '' %>
                      · <%= fmtDate(item.created_at) %>
                    </p>
                  </div>
                </div>

              <% }) %>

            </div>

          <% } else { %>

            <div class="empty">
              No announcements have been connected yet.
            </div>

          <% } %>

        </section>

      </section>

      <!-- =====================================
           OTHER INTERNAL DEAN WORKSPACES
      ====================================== -->

      <% navGroups.forEach(group => { %>

        <% group.items.forEach(item => { %>

          <% if (item[0] !== 'overview' && !standaloneRoutes[item[0]]) { %>

            <section
              class="module-view"
              data-page="<%= item[0] %>"
            >

              <div class="page-heading">

                <div>
                  <div class="eyebrow"><%= group.title %></div>
                  <h1><%= item[2] %></h1>
                  <p><%= item[3] %></p>
                </div>

                <div class="date-label"><%= facultyName %></div>

              </div>

              <div class="panel module-placeholder">

                <div>

                  <div class="placeholder-icon"><%= item[1] %></div>

                  <h2><%= item[2] %></h2>

                  <p>
                    This workspace belongs to the
                    <strong><%= facultyName %></strong> faculty.

                    Its database operations, management tools,
                    permissions, reports and interface will be
                    implemented in this workspace.
                  </p>

                  <span class="coming-soon">
                    Workspace connected · Implementation pending
                  </span>

                  <div class="workspace-actions">

                    <button
                      type="button"
                      class="workspace-action"
                      data-go-overview
                    >
                      Back to Overview
                    </button>

                  </div>

                </div>

              </div>

            </section>

          <% } %>

        <% }) %>

      <% }) %>

      <div class="footer">
        LuxMind Faculty Management Portal · Dean Workspace
      </div>

    </div>
  </main>
</div>

<!-- DEAN WORKSPACE NAVIGATION JAVASCRIPT -->

<script>

(function(){

  'use strict';

  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('overlay');
  const menuBtn = document.getElementById('menuBtn');
  const breadcrumb = document.getElementById('breadcrumbTitle');
  const notificationBtn = document.getElementById('notificationBtn');

  if (!sidebar || !overlay || !menuBtn || !breadcrumb) {
    console.error('Dean sidebar elements are missing.');
    return;
  }

  // Internal workspace links only.
  const navLinks = Array.from(
    document.querySelectorAll('.nav-link[data-view]')
  );

  // Standalone Express route links.
  const standaloneLinks = Array.from(
    document.querySelectorAll('.nav-link[data-route]')
  );

  // Internal workspace sections.
  const pages = Array.from(
    document.querySelectorAll('.module-view')
  );

  const closeMenu = () => {
    sidebar.classList.remove('open');
    overlay.classList.remove('show');
  };

  // Open an internal Dean workspace.
  function openView(viewId) {

    const target = pages.find(
      page => page.dataset.page === viewId
    );

    if (!target) {
      console.warn('Dean workspace not found:', viewId);
      return;
    }

    pages.forEach(page => {
      page.classList.toggle('active', page === target);
    });

    navLinks.forEach(link => {
      link.classList.toggle(
        'active',
        link.dataset.view === viewId
      );
    });

    const selected = navLinks.find(
      link => link.dataset.view === viewId
    );

    breadcrumb.textContent = selected
      ? selected.innerText.trim()
      : 'Overview';

    closeMenu();

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

    history.replaceState(
      null,
      '',
      '#' + encodeURIComponent(viewId)
    );
  }

  // Internal sidebar navigation.
  navLinks.forEach(link => {

    link.addEventListener('click', function(event) {

      event.preventDefault();

      openView(this.dataset.view);

    });

  });

// Standalone sidebar navigation — force the actual Express route.
standaloneLinks.forEach(link => {

  link.addEventListener('click', function(event) {

    event.preventDefault();
    event.stopPropagation();

    const targetUrl = this.getAttribute('href');

    if (targetUrl) {
      window.location.assign(targetUrl);
    }

  }, true);

});
  // Quick access navigation.
  document.querySelectorAll('[data-open-view]').forEach(button => {

    button.addEventListener('click', function() {

      openView(this.dataset.openView);

    });

  });

  // Back to overview buttons.
  document.querySelectorAll('[data-go-overview]').forEach(button => {

    button.addEventListener('click', function() {

      openView('overview');

    });

  });

  // Mobile sidebar toggle.
  menuBtn.addEventListener('click', function() {

    sidebar.classList.toggle('open');
    overlay.classList.toggle('show');

  });

  overlay.addEventListener('click', closeMenu);

  // Notifications.
  if (notificationBtn) {

    notificationBtn.addEventListener('click', function() {

      const notificationPage = pages.find(
        page => page.dataset.page === 'notifications'
      );

      if (notificationPage) {
        openView('notifications');
      }

    });

  }

  // Restore internal workspace from URL hash.
  function restoreWorkspace() {

    const hash = decodeURIComponent(
      window.location.hash.replace(/^#/, '')
    );

    const validPage = pages.some(
      page => page.dataset.page === hash
    );

    openView(validPage ? hash : 'overview');

  }

  window.addEventListener('hashchange', restoreWorkspace);

  restoreWorkspace();

  // Current date.
  const todayLabel = document.getElementById('todayLabel');

  if (todayLabel) {

    todayLabel.textContent =
      new Intl.DateTimeFormat(undefined, {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      }).format(new Date());

  }

})();

</script>

</body>
</html>
