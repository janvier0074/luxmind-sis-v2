
<%
const dean = user || {};
const facultyInfo = faculty || {};
const staffList = staff || [];
const departmentList = departments || [];
const totals = stats || { total: 0, teachers: 0, advisors: 0, departmentHeads: 0 };

const safe = value => value == null ? '' : String(value);
const initials = value => safe(value).trim().split(/\s+/).filter(Boolean).slice(0, 2).map(x => x[0].toUpperCase()).join('') || 'S';

const roleLabel = role => ({
  teacher: 'Teacher',
  advisor: 'Advisor',
  department_head: 'Department Head'
}[role] || safe(role));

const successMessages = success || [];
const errorMessages = error || [];
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Faculty Staff | LuxMind</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --green: #0e9f6e;
  --green-dark: #087f5b;
  --sidebar: #103d31;
  --sidebar-hover: #1b5141;
  --sidebar-active: #24634e;
  --green-light: #e8f7f1;
  --ink: #172b25;
  --muted: #718078;
  --border: #e7eee9;
  --background: #f4f7f5;
  --white: #fff;
  --shadow: 0 8px 28px rgba(20,50,36,.055);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Inter, sans-serif;
  color: var(--ink);
  background: var(--background);
}

a { text-decoration: none; color: inherit; }

.layout {
  display: flex;
  min-height: 100vh;
}

/* FIXED SIDEBAR */

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 258px;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  flex-shrink: 0;
  background: var(--sidebar);
  color: white;
  padding: 25px 17px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  box-shadow: 5px 0 22px rgba(0,0,0,.08);
}

.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,.2);
  border-radius: 10px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 9px 30px;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.8px;
}

.brand-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  color: var(--sidebar);
  background: #fff;
  border-radius: 11px;
  font-size: 20px;
}

.side-label {
  padding: 13px 11px 10px;
  color: #a3c1b4;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.side-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  border-radius: 9px;
  color: #d1e3da;
  font-size: 12px;
  font-weight: 600;
  transition: background .2s, color .2s, transform .2s;
}

.side-link:hover {
  background: var(--sidebar-hover);
  color: #fff;
  transform: translateX(2px);
}

.side-link.active {
  background: var(--sidebar-active);
  color: #fff;
  box-shadow: inset 3px 0 #55d6a2;
}

.side-icon {
  width: 21px;
  text-align: center;
  font-size: 18px;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 25px;
}

.sidebar-footer {
  padding: 16px 12px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  background: rgba(255,255,255,.055);
  color: #c1d9ce;
  font-size: 10px;
  line-height: 1.8;
}

.sidebar-footer strong {
  color: white;
  font-size: 12px;
}

/* MAIN CONTENT SCROLLS INDEPENDENTLY */

.main {
  width: calc(100% - 258px);
  height: 100vh;
  margin-left: 258px;
  padding: 28px 34px 45px;
  overflow-y: auto;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

.main::-webkit-scrollbar { width: 7px; }
.main::-webkit-scrollbar-thumb {
  background: #cbd8cf;
  border-radius: 10px;
}
.main::-webkit-scrollbar-thumb:hover { background: #9eafa3; }

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 30px;
}

.breadcrumb {
  color: var(--muted);
  font-size: 11px;
}

.breadcrumb strong { color: var(--ink); }

.profile-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 30px;
  padding: 6px 13px 6px 6px;
  font-size: 11px;
  font-weight: 700;
  box-shadow: 0 3px 12px rgba(0,0,0,.025);
}

.avatar {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 11px;
  font-weight: 800;
  flex-shrink: 0;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 25px;
}

.eyebrow {
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  margin-bottom: 9px;
}

h1 {
  margin: 0;
  font-size: 28px;
  letter-spacing: -1px;
}

.subtitle {
  margin-top: 8px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.faculty-code {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 13px;
  padding: 8px 11px;
  border-radius: 8px;
  background: white;
  border: 1px solid var(--border);
  color: #66756c;
  font-size: 10px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 11px 14px;
  border-radius: 9px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  border: 1px solid var(--border);
  background: white;
  color: #53645a;
  cursor: pointer;
  transition: .2s;
}

.btn:hover {
  border-color: #a9d5bf;
  color: var(--green-dark);
  transform: translateY(-1px);
}

.btn-primary {
  color: white;
  background: var(--green);
  border-color: var(--green);
}

.btn-primary:hover {
  color: white;
  background: var(--green-dark);
}

/* STATISTICS */

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 15px;
  margin-bottom: 23px;
}

.stat-card {
  position: relative;
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 19px;
  box-shadow: var(--shadow);
  transition: transform .2s, box-shadow .2s;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(20,50,36,.09);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
}

.stat-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 16px;
}

.stat-number {
  margin-top: 14px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -.8px;
}

.stat-note {
  margin-top: 5px;
  color: #95a198;
  font-size: 10px;
}

/* DIRECTORY */

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.panel-heading {
  padding: 21px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--border);
}

.panel-heading h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 800;
}

.panel-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.result-count {
  padding: 7px 10px;
  border-radius: 7px;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
}

.filters {
  display: grid;
  grid-template-columns: minmax(200px,1.7fr) repeat(2,minmax(145px,1fr)) auto;
  gap: 10px;
  padding: 16px 22px;
  border-bottom: 1px solid var(--border);
}

.field {
  width: 100%;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e1e9e3;
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: var(--ink);
  font-family: inherit;
  font-size: 10px;
  transition: .2s;
}

.field:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(14,159,110,.09);
}

.search-wrap { position: relative; }
.search-wrap input { padding-left: 35px; }

.search-symbol {
  position: absolute;
  left: 12px;
  top: 12px;
  color: #96a49b;
  font-size: 13px;
  pointer-events: none;
}

.clear-btn {
  border: 1px solid var(--border);
  background: white;
  border-radius: 8px;
  padding: 0 12px;
  color: #63746a;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: .2s;
}

.clear-btn:hover {
  background: var(--green-light);
  color: var(--green-dark);
}

/* TABLE */

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 750px;
}

thead { background: #f9fbfa; }

th {
  padding: 14px 17px;
  text-align: left;
  color: #849188;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .8px;
  white-space: nowrap;
}

td {
  padding: 14px 17px;
  border-top: 1px solid #eff3f0;
  font-size: 10px;
  vertical-align: middle;
}

tbody tr {
  cursor: pointer;
  transition: background .15s;
}

tbody tr:hover { background: #f3faf6; }

.staff-person {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 185px;
}

.staff-person .avatar { width: 37px; height: 37px; }

.person-name {
  font-size: 10px;
  font-weight: 800;
  color: #263a30;
}

.person-username {
  margin-top: 4px;
  color: #98a49c;
  font-size: 9px;
}

.email {
  color: #6c7c72;
  overflow-wrap: anywhere;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 9px;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
}

.role-teacher { color: #2463a0; background: #edf5ff; }
.role-advisor { color: #8155a6; background: #f5effb; }
.role-head { color: #087f5b; background: #e8f7f1; }

.department {
  color: #64736a;
  font-weight: 600;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #16865e;
  font-size: 9px;
  font-weight: 700;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #20b477;
}

.view-hint {
  color: #a2aea5;
  font-size: 9px;
}

/* EMPTY STATE */

.empty-state {
  display: none;
  padding: 55px 20px;
  text-align: center;
  color: var(--muted);
}

.empty-icon { font-size: 30px; margin-bottom: 12px; }

.empty-state strong {
  display: block;
  color: var(--ink);
  font-size: 13px;
  margin-bottom: 7px;
}

.empty-state p { font-size: 10px; }

/* ALERTS */

.alert {
  padding: 12px 15px;
  border-radius: 9px;
  margin-bottom: 15px;
  font-size: 11px;
}

.alert-success { background: #e9f8f0; color: #087f5b; }
.alert-error { background: #fff0f0; color: #b72e2e; }

.footer-note {
  margin-top: 22px;
  color: #9aa69e;
  font-size: 9px;
  text-align: center;
}

/* STAFF DETAILS MODAL */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(12,31,24,.55);
  backdrop-filter: blur(3px);
}

.modal-backdrop.show { display: flex; }

.modal {
  width: 100%;
  max-width: 430px;
  background: white;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 25px 70px rgba(0,0,0,.2);
  animation: modalIn .2s ease;
}

@keyframes modalIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.modal-header h3 { margin: 0; font-size: 16px; }

.close-modal {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 8px;
  background: #f0f4f1;
  color: #53645a;
  font-size: 19px;
  cursor: pointer;
}

.modal-person {
  display: flex;
  align-items: center;
  gap: 13px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 15px;
}

.modal-person .avatar {
  width: 52px;
  height: 52px;
  font-size: 15px;
}

.modal-person strong { display: block; font-size: 13px; }
.modal-person span { color: var(--muted); font-size: 10px; }

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 12px 0;
  border-bottom: 1px solid #f0f3f1;
  font-size: 11px;
}

.detail-row span:first-child { color: var(--muted); }
.detail-row strong { text-align: right; overflow-wrap: anywhere; }

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20px;
}

/* RESPONSIVE */

@media(max-width: 1100px) {
  .sidebar { width: 230px; }
  .main {
    width: calc(100% - 230px);
    margin-left: 230px;
    padding: 25px 22px 40px;
  }
  .stats { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .filters { grid-template-columns: 1fr 1fr; }
}

@media(max-width: 720px) {
  .layout { display: block; }

  .sidebar {
    position: relative;
    width: 100%;
    height: auto;
    max-height: none;
    padding: 13px;
    overflow: visible;
  }

  .brand { padding: 0 7px 12px; }

  .side-label, .sidebar-bottom { display: none; }

  .sidebar nav {
    flex-direction: row;
    gap: 5px;
    overflow-x: auto;
    padding-bottom: 3px;
  }

  .side-link {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 10px;
  }

  .side-link:hover { transform: none; }

  .main {
    width: 100%;
    height: auto;
    min-height: calc(100vh - 100px);
    margin-left: 0;
    padding: 20px 14px 35px;
    overflow: visible;
  }

  .page-heading { display: block; }
  .actions { margin-top: 16px; }
  .stats { gap: 9px; }
  .stat-card { padding: 14px; }
  .stat-number { font-size: 23px; }
  .filters { grid-template-columns: 1fr; padding: 14px; }
  .clear-btn { height: 38px; }
  .panel-heading { padding: 17px 14px; }
  .topbar { margin-bottom: 22px; }
}

@media(max-width: 390px) {
  .stats { grid-template-columns: 1fr 1fr; }
  h1 { font-size: 24px; }
  .breadcrumb { font-size: 9px; }
}
</style>
  <link rel="stylesheet" href="/css/mobile.css">
  <script src="/js/mobile.js" defer></script>
</head>

<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">L</span>
      <span>LuxMind</span>
    </div>

    <div class="side-label">Dean workspace</div>

    <nav>
      <a class="side-link" href="/sis/dean">
        <span class="side-icon">⌂</span> Dashboard
      </a>

      <a class="side-link" href="/sis/dean/faculty-profile">
        <span class="side-icon">▣</span> Faculty Profile
      </a>

      <a class="side-link" href="/sis/dean/departments">
        <span class="side-icon">▤</span> Departments Management
      </a>

      <a class="side-link" href="/sis/dean/department-heads">
        <span class="side-icon">♙</span> Department Heads
      </a>

      <a class="side-link active" href="/sis/dean/faculty-staff">
        <span class="side-icon">♧</span> Faculty Staff
      </a>
    </nav>

    <div class="sidebar-bottom">
      <div class="sidebar-footer">
        <strong>LuxMind SIS</strong><br>
        Faculty Administration Portal<br>
        Academic Management Workspace
      </div>
    </div>
  </aside>

  <main class="main">

    <div class="topbar">
      <div class="breadcrumb">
        Dean Portal &nbsp; / &nbsp; Faculty Administration &nbsp; / &nbsp;
        <strong>Faculty Staff</strong>
      </div>

      <div class="profile-chip">
        <span class="avatar"><%= initials(dean.full_name || dean.username) %></span>
        <span><%= safe(dean.full_name || dean.username || 'Dean') %></span>
      </div>
    </div>

    <% successMessages.forEach(message => { %>
      <div class="alert alert-success"><%= message %></div>
    <% }); %>

    <% errorMessages.forEach(message => { %>
      <div class="alert alert-error"><%= message %></div>
    <% }); %>

    <section class="page-heading">
      <div>
        <div class="eyebrow">Faculty Administration</div>
        <h1>Faculty Staff</h1>
        <div class="subtitle">
          View and monitor academic staff assigned to your faculty.
        </div>

        <div class="faculty-code">
          <span>▣</span>
          <strong><%= safe(facultyInfo.name) %></strong>
          <% if (facultyInfo.code) { %>
            <span>·</span>
            <%= safe(facultyInfo.code) %>
          <% } %>
        </div>
      </div>

      <div class="actions">
        <a class="btn" href="/sis/dean/departments">▤ Departments</a>
        <a class="btn btn-primary" href="/sis/dean/department-heads">
          ♙ Manage Department Heads
        </a>
      </div>
    </section>

    <section class="stats">
      <div class="stat-card">
        <div class="stat-top">Total Faculty Staff <span class="stat-icon">♧</span></div>
        <div class="stat-number"><%= totals.total %></div>
        <div class="stat-note">Academic staff in this faculty</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">Teachers <span class="stat-icon">▣</span></div>
        <div class="stat-number"><%= totals.teachers %></div>
        <div class="stat-note">Teaching personnel</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">Advisors <span class="stat-icon">♙</span></div>
        <div class="stat-number"><%= totals.advisors %></div>
        <div class="stat-note">Academic advising personnel</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">Department Heads <span class="stat-icon">⌘</span></div>
        <div class="stat-number"><%= totals.departmentHeads %></div>
        <div class="stat-note">Staff with department head role</div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <h2>Staff Directory</h2>
          <p>Academic personnel registered under your faculty. Select a staff member to view details.</p>
        </div>
        <div class="result-count" id="resultCount"><%= staffList.length %> Members</div>
      </div>

      <div class="filters">
        <div class="search-wrap">
          <span class="search-symbol">⌕</span>
          <input class="field" type="search" id="staffSearch" placeholder="Search name, username or email...">
        </div>

        <select class="field" id="roleFilter">
          <option value="">All staff roles</option>
          <option value="teacher">Teachers</option>
          <option value="advisor">Advisors</option>
          <option value="department_head">Department Heads</option>
        </select>

        <select class="field" id="departmentFilter">
          <option value="">All departments</option>
          <% departmentList.forEach(department => { %>
            <option value="<%= department.id %>"><%= safe(department.name) %></option>
          <% }); %>
        </select>

        <button class="clear-btn" type="button" id="clearFilters">Clear filters</button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Staff Member</th>
              <th>Email</th>
              <th>Role</th>
              <th>Department</th>
              <th>Account</th>
              <th>Details</th>
            </tr>
          </thead>

          <tbody id="staffTableBody">
            <% staffList.forEach(member => {
              const roleClass = member.role === 'department_head'
                ? 'role-head'
                : member.role === 'advisor'
                  ? 'role-advisor'
                  : 'role-teacher';
            %>
              <tr class="staff-row"
                  tabindex="0"
                  role="button"
                  aria-label="View details for <%= safe(member.full_name || member.username) %>"
                  data-name="<%= safe(member.full_name || 'Name not provided') %>"
                  data-username="<%= safe(member.username) %>"
                  data-email="<%= safe(member.email || 'Not provided') %>"
                  data-role="<%= safe(member.role) %>"
                  data-department-name="<%= safe(member.department_name || 'Not assigned') %>"
                  data-search="<%= safe([member.full_name, member.username, member.email].join(' ')).toLowerCase() %>"
                  data-department="<%= safe(member.department_id) %>">

                <td>
                  <div class="staff-person">
                    <span class="avatar"><%= initials(member.full_name || member.username) %></span>
                    <div>
                      <div class="person-name"><%= safe(member.full_name || 'Name not provided') %></div>
                      <div class="person-username">@<%= safe(member.username) %></div>
                    </div>
                  </div>
                </td>

                <td><span class="email"><%= safe(member.email || 'Not provided') %></span></td>

                <td><span class="role-badge <%= roleClass %>"><%= roleLabel(member.role) %></span></td>

                <td><span class="department"><%= safe(member.department_name || 'Not assigned') %></span></td>

                <td>
                  <span class="status"><span class="status-dot"></span> Registered</span>
                </td>

                <td><span class="view-hint">View details →</span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="empty-state" id="emptyState">
        <div class="empty-icon">⌕</div>
        <strong>No matching staff members</strong>
        <p>Try changing your search or filter selection.</p>
      </div>
    </section>

    <div class="footer-note">
      LuxMind Student Information System · Faculty Administration
    </div>
  </main>
</div>

<!-- STAFF DETAILS WINDOW -->
<div class="modal-backdrop" id="staffModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-header">
      <h3 id="modalTitle">Staff Information</h3>
      <button class="close-modal" type="button" id="closeModal" aria-label="Close">×</button>
    </div>

    <div class="modal-person">
      <span class="avatar" id="modalAvatar">S</span>
      <div>
        <strong id="modalName">Staff name</strong>
        <span id="modalUsername">@username</span>
      </div>
    </div>

    <div class="detail-row">
      <span>Email address</span>
      <strong id="modalEmail">—</strong>
    </div>

    <div class="detail-row">
      <span>Staff role</span>
      <strong id="modalRole">—</strong>
    </div>

    <div class="detail-row">
      <span>Department</span>
      <strong id="modalDepartment">—</strong>
    </div>

    <div class="detail-row">
      <span>Account</span>
      <strong>Registered</strong>
    </div>

    <div class="modal-actions">
      <button class="btn btn-primary" type="button" id="doneModal">Close</button>
    </div>
  </div>
</div>

<script>
(function () {
  const searchInput = document.getElementById('staffSearch');
  const roleFilter = document.getElementById('roleFilter');
  const departmentFilter = document.getElementById('departmentFilter');
  const clearButton = document.getElementById('clearFilters');

  const rows = Array.from(document.querySelectorAll('.staff-row'));
  const resultCount = document.getElementById('resultCount');
  const emptyState = document.getElementById('emptyState');
  const tableBody = document.getElementById('staffTableBody');

  const modal = document.getElementById('staffModal');

  function filterStaff() {
    const search = searchInput.value.trim().toLowerCase();
    const role = roleFilter.value;
    const department = departmentFilter.value;

    let visible = 0;

    rows.forEach(row => {
      const matchesSearch = row.dataset.search.includes(search);
      const matchesRole = !role || row.dataset.role === role;
      const matchesDepartment =
        !department || row.dataset.department === department;

      const show = matchesSearch && matchesRole && matchesDepartment;

      row.style.display = show ? '' : 'none';

      if (show) visible++;
    });

    resultCount.textContent =
      visible + (visible === 1 ? ' Member' : ' Members');

    emptyState.style.display = visible === 0 ? 'block' : 'none';
    tableBody.style.display = visible === 0 ? 'none' : '';
  }

  searchInput.addEventListener('input', filterStaff);
  roleFilter.addEventListener('change', filterStaff);
  departmentFilter.addEventListener('change', filterStaff);

  clearButton.addEventListener('click', function () {
    searchInput.value = '';
    roleFilter.value = '';
    departmentFilter.value = '';
    filterStaff();
    searchInput.focus();
  });

  function openStaffDetails(row) {
    const name = row.dataset.name || 'Staff member';
    const username = row.dataset.username || '';
    const email = row.dataset.email || 'Not provided';
    const role = row.dataset.role || '';
    const department = row.dataset.departmentName || 'Not assigned';

    document.getElementById('modalName').textContent = name;
    document.getElementById('modalUsername').textContent = '@' + username;
    document.getElementById('modalEmail').textContent = email;
    document.getElementById('modalRole').textContent =
      role.replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase());
    document.getElementById('modalDepartment').textContent = department;
    document.getElementById('modalAvatar').textContent =
      name.trim().split(/\s+/).slice(0, 2).map(x => x[0].toUpperCase()).join('') || 'S';

    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
    document.getElementById('closeModal').focus();
  }

  function closeStaffDetails() {
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
  }

  rows.forEach(row => {
    row.addEventListener('click', () => openStaffDetails(row));

    row.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openStaffDetails(row);
      }
    });
  });

  document.getElementById('closeModal').addEventListener('click', closeStaffDetails);
  document.getElementById('doneModal').addEventListener('click', closeStaffDetails);

  modal.addEventListener('click', event => {
    if (event.target === modal) closeStaffDetails();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && modal.classList.contains('show')) {
      closeStaffDetails();
    }
  });

  filterStaff();
})();
</script>

</body>
</html>
