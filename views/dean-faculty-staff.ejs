
<%
const dean = user || {};
const facultyInfo = faculty || {};
const staffList = staff || [];
const departmentList = departments || [];
const totals = stats || {
  total: 0,
  teachers: 0,
  advisors: 0,
  departmentHeads: 0
};

const safe = value => value == null ? '' : String(value);
const initials = value => {
  const parts = safe(value).trim().split(/\s+/).filter(Boolean);
  return parts.slice(0, 2).map(part => part[0].toUpperCase()).join('') || 'S';
};

const roleLabel = role => ({
  teacher: 'Teacher',
  advisor: 'Advisor',
  department_head: 'Department Head'
}[role] || safe(role));

const successMessages = success || [];
const errorMessages = error || [];
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Faculty Staff | LuxMind</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --green: #0e9f6e;
  --green-dark: #087f5b;
  --green-light: #e8f7f1;
  --ink: #172b25;
  --muted: #718078;
  --border: #e7eee9;
  --surface: #ffffff;
  --background: #f5f8f6;
  --danger: #dc4444;
  --shadow: 0 8px 28px rgba(20, 50, 36, .055);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, sans-serif;
  color: var(--ink);
  background: var(--background);
}

a {
  text-decoration: none;
  color: inherit;
}

.layout {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 250px;
  flex-shrink: 0;
  background: #fff;
  border-right: 1px solid var(--border);
  padding: 27px 17px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 9px 29px;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -.8px;
}

.brand-mark {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  color: white;
  background: var(--green);
  border-radius: 11px;
  font-size: 19px;
}

.side-label {
  padding: 12px 10px 9px;
  color: #9aa79f;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.1px;
  text-transform: uppercase;
}

.side-link {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px 11px;
  margin: 4px 0;
  border-radius: 9px;
  color: #627168;
  font-size: 13px;
  font-weight: 600;
  transition: .2s;
}

.side-link:hover {
  background: #f2f8f4;
  color: var(--green-dark);
}

.side-link.active {
  color: var(--green-dark);
  background: var(--green-light);
}

.side-icon {
  width: 20px;
  text-align: center;
  font-size: 17px;
}

.sidebar-footer {
  margin-top: 35px;
  padding: 15px 10px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.main {
  flex: 1;
  min-width: 0;
  padding: 30px 35px 45px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 30px;
}

.breadcrumb {
  color: var(--muted);
  font-size: 12px;
}

.breadcrumb strong {
  color: var(--ink);
}

.profile-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 30px;
  padding: 7px 13px 7px 7px;
  font-size: 12px;
  font-weight: 700;
}

.avatar {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 12px;
  font-weight: 800;
  flex-shrink: 0;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 24px;
}

.eyebrow {
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.1px;
  text-transform: uppercase;
  margin-bottom: 9px;
}

h1 {
  margin: 0;
  font-size: 27px;
  letter-spacing: -.9px;
}

.subtitle {
  margin-top: 8px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.faculty-code {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 12px;
  padding: 7px 10px;
  border-radius: 7px;
  background: white;
  border: 1px solid var(--border);
  color: #66756c;
  font-size: 11px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 11px 14px;
  border-radius: 9px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  border: 1px solid var(--border);
  background: white;
  color: #53645a;
  cursor: pointer;
  transition: .2s;
}

.btn:hover {
  border-color: #b9dcca;
  color: var(--green-dark);
}

.btn-primary {
  color: white;
  background: var(--green);
  border-color: var(--green);
}

.btn-primary:hover {
  color: white;
  background: var(--green-dark);
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 23px;
}

.stat-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 19px;
  box-shadow: var(--shadow);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.stat-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 16px;
}

.stat-number {
  margin-top: 15px;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -.8px;
}

.stat-note {
  margin-top: 5px;
  color: #95a198;
  font-size: 10px;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.panel-heading {
  padding: 21px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--border);
}

.panel-heading h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 800;
}

.panel-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.result-count {
  padding: 7px 10px;
  border-radius: 7px;
  background: var(--green-light);
  color: var(--green-dark);
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}

.filters {
  display: grid;
  grid-template-columns: minmax(200px, 1.7fr) repeat(2, minmax(145px, 1fr));
  gap: 11px;
  padding: 17px 22px;
  border-bottom: 1px solid var(--border);
}

.field {
  width: 100%;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e1e9e3;
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: var(--ink);
  font-family: inherit;
  font-size: 11px;
}

.field:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(14,159,110,.09);
}

.search-wrap {
  position: relative;
}

.search-wrap input {
  padding-left: 35px;
}

.search-symbol {
  position: absolute;
  left: 12px;
  top: 12px;
  color: #96a49b;
  font-size: 13px;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

thead {
  background: #fafcfb;
}

th {
  padding: 13px 18px;
  text-align: left;
  color: #849188;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .8px;
  white-space: nowrap;
}

td {
  padding: 15px 18px;
  border-top: 1px solid #eff3f0;
  font-size: 11px;
  vertical-align: middle;
}

tbody tr:hover {
  background: #fbfdfb;
}

.staff-person {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 185px;
}

.staff-person .avatar {
  width: 36px;
  height: 36px;
}

.person-name {
  font-size: 11px;
  font-weight: 800;
  color: #263a30;
}

.person-username {
  margin-top: 4px;
  color: #98a49c;
  font-size: 10px;
}

.email {
  color: #6c7c72;
  overflow-wrap: anywhere;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 9px;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
}

.role-teacher {
  color: #2463a0;
  background: #edf5ff;
}

.role-advisor {
  color: #8155a6;
  background: #f5effb;
}

.role-head {
  color: #087f5b;
  background: #e8f7f1;
}

.department {
  color: #64736a;
  font-weight: 600;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #16865e;
  font-size: 10px;
  font-weight: 700;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #20b477;
}

.empty-state {
  display: none;
  padding: 55px 20px;
  text-align: center;
  color: var(--muted);
}

.empty-icon {
  font-size: 29px;
  margin-bottom: 12px;
}

.empty-state strong {
  display: block;
  color: var(--ink);
  font-size: 13px;
  margin-bottom: 7px;
}

.empty-state p {
  font-size: 11px;
}

.alert {
  padding: 12px 15px;
  border-radius: 9px;
  margin-bottom: 15px;
  font-size: 12px;
}

.alert-success {
  background: #e9f8f0;
  color: #087f5b;
}

.alert-error {
  background: #fff0f0;
  color: #b72e2e;
}

.footer-note {
  margin-top: 22px;
  color: #9aa69e;
  font-size: 10px;
  text-align: center;
}

@media(max-width: 1050px) {
  .sidebar {
    width: 215px;
  }

  .main {
    padding: 25px 22px;
  }

  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media(max-width: 720px) {
  .layout {
    display: block;
  }

  .sidebar {
    width: 100%;
    padding: 13px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    padding: 0 7px 10px;
  }

  .side-label,
  .sidebar-footer {
    display: none;
  }

  .sidebar nav {
    display: flex;
    gap: 5px;
    overflow-x: auto;
  }

  .side-link {
    white-space: nowrap;
    padding: 9px 10px;
  }

  .main {
    padding: 20px 14px 35px;
  }

  .page-heading {
    display: block;
  }

  .actions {
    margin-top: 16px;
  }

  .stats {
    gap: 9px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-number {
    font-size: 23px;
  }

  .filters {
    grid-template-columns: 1fr;
    padding: 14px;
  }

  .panel-heading {
    padding: 17px 14px;
  }

  .topbar {
    margin-bottom: 22px;
  }
}
</style>
</head>

<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">L</span>
      <span>LuxMind</span>
    </div>

    <div class="side-label">Dean workspace</div>

    <nav>
      <a class="side-link" href="/sis/dean">
        <span class="side-icon">⌂</span> Dashboard
      </a>

      <a class="side-link" href="/sis/dean/faculty-profile">
        <span class="side-icon">▣</span> Faculty Profile
      </a>

      <a class="side-link" href="/sis/dean/departments">
        <span class="side-icon">▤</span> Departments Management
      </a>

      <a class="side-link" href="/sis/dean/department-heads">
        <span class="side-icon">♙</span> Department Heads
      </a>

      <a class="side-link active" href="/sis/dean/faculty-staff">
        <span class="side-icon">♧</span> Faculty Staff
      </a>
    </nav>

    <div class="sidebar-footer">
      <strong>LuxMind SIS</strong><br>
      Faculty Administration Portal
    </div>
  </aside>

  <main class="main">

    <div class="topbar">
      <div class="breadcrumb">
        Dean Portal &nbsp; / &nbsp; Faculty Administration &nbsp; / &nbsp;
        <strong>Faculty Staff</strong>
      </div>

      <div class="profile-chip">
        <span class="avatar"><%= initials(dean.full_name || dean.username) %></span>
        <span><%= safe(dean.full_name || dean.username || 'Dean') %></span>
      </div>
    </div>

    <% successMessages.forEach(message => { %>
      <div class="alert alert-success"><%= message %></div>
    <% }); %>

    <% errorMessages.forEach(message => { %>
      <div class="alert alert-error"><%= message %></div>
    <% }); %>

    <section class="page-heading">
      <div>
        <div class="eyebrow">Faculty Administration</div>
        <h1>Faculty Staff</h1>
        <div class="subtitle">
          View and monitor academic staff assigned to your faculty.
        </div>

        <div class="faculty-code">
          <span>▣</span>
          <strong><%= safe(facultyInfo.name) %></strong>
          <% if (facultyInfo.code) { %>
            <span>·</span>
            <%= safe(facultyInfo.code) %>
          <% } %>
        </div>
      </div>

      <div class="actions">
        <a class="btn" href="/sis/dean/departments">
          ▤ Departments
        </a>
        <a class="btn btn-primary" href="/sis/dean/department-heads">
          ♙ Manage Department Heads
        </a>
      </div>
    </section>

    <section class="stats">

      <div class="stat-card">
        <div class="stat-top">
          Total Faculty Staff
          <span class="stat-icon">♧</span>
        </div>
        <div class="stat-number"><%= totals.total %></div>
        <div class="stat-note">Academic staff in this faculty</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          Teachers
          <span class="stat-icon">▣</span>
        </div>
        <div class="stat-number"><%= totals.teachers %></div>
        <div class="stat-note">Teaching personnel</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          Advisors
          <span class="stat-icon">♙</span>
        </div>
        <div class="stat-number"><%= totals.advisors %></div>
        <div class="stat-note">Academic advising personnel</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          Department Heads
          <span class="stat-icon">⌘</span>
        </div>
        <div class="stat-number"><%= totals.departmentHeads %></div>
        <div class="stat-note">Staff with department head role</div>
      </div>

    </section>

    <section class="panel">

      <div class="panel-heading">
        <div>
          <h2>Staff Directory</h2>
          <p>Academic personnel registered under your faculty.</p>
        </div>

        <div class="result-count" id="resultCount">
          <%= staffList.length %> Members
        </div>
      </div>

      <div class="filters">

        <div class="search-wrap">
          <span class="search-symbol">⌕</span>
          <input
            class="field"
            type="search"
            id="staffSearch"
            placeholder="Search name, username or email..."
          >
        </div>

        <select class="field" id="roleFilter">
          <option value="">All staff roles</option>
          <option value="teacher">Teachers</option>
          <option value="advisor">Advisors</option>
          <option value="department_head">Department Heads</option>
        </select>

        <select class="field" id="departmentFilter">
          <option value="">All departments</option>
          <% departmentList.forEach(department => { %>
            <option value="<%= department.id %>">
              <%= safe(department.name) %>
            </option>
          <% }); %>
        </select>

      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Staff Member</th>
              <th>Email</th>
              <th>Role</th>
              <th>Department</th>
              <th>Account</th>
            </tr>
          </thead>

          <tbody id="staffTableBody">

            <% staffList.forEach(member => {
              const roleClass =
                member.role === 'department_head'
                  ? 'role-head'
                  : member.role === 'advisor'
                    ? 'role-advisor'
                    : 'role-teacher';
            %>

              <tr
                class="staff-row"
                data-search="<%= safe([member.full_name, member.username, member.email].join(' ')).toLowerCase() %>"
                data-role="<%= safe(member.role) %>"
                data-department="<%= safe(member.department_id) %>"
              >

                <td>
                  <div class="staff-person">
                    <span class="avatar">
                      <%= initials(member.full_name || member.username) %>
                    </span>

                    <div>
                      <div class="person-name">
                        <%= safe(member.full_name || 'Name not provided') %>
                      </div>
                      <div class="person-username">
                        @<%= safe(member.username) %>
                      </div>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="email">
                    <%= safe(member.email || 'Not provided') %>
                  </span>
                </td>

                <td>
                  <span class="role-badge <%= roleClass %>">
                    <%= roleLabel(member.role) %>
                  </span>
                </td>

                <td>
                  <span class="department">
                    <%= safe(member.department_name || 'Not assigned') %>
                  </span>
                </td>

                <td>
                  <span class="status">
                    <span class="status-dot"></span>
                    Registered
                  </span>
                </td>

              </tr>

            <% }); %>

          </tbody>
        </table>
      </div>

      <div class="empty-state" id="emptyState">
        <div class="empty-icon">⌕</div>
        <strong>No matching staff members</strong>
        <p>Try changing your search or filter selection.</p>
      </div>

    </section>

    <div class="footer-note">
      LuxMind Student Information System · Faculty Administration
    </div>

  </main>
</div>

<script>
(function () {
  const searchInput = document.getElementById('staffSearch');
  const roleFilter = document.getElementById('roleFilter');
  const departmentFilter = document.getElementById('departmentFilter');
  const rows = Array.from(document.querySelectorAll('.staff-row'));
  const resultCount = document.getElementById('resultCount');
  const emptyState = document.getElementById('emptyState');
  const tableBody = document.getElementById('staffTableBody');

  function filterStaff() {
    const search = searchInput.value.trim().toLowerCase();
    const role = roleFilter.value;
    const department = departmentFilter.value;

    let visible = 0;

    rows.forEach(row => {
      const matchesSearch = row.dataset.search.includes(search);
      const matchesRole = !role || row.dataset.role === role;
      const matchesDepartment =
        !department || row.dataset.department === department;

      const show = matchesSearch && matchesRole && matchesDepartment;

      row.style.display = show ? '' : 'none';

      if (show) visible++;
    });

    resultCount.textContent =
      visible + (visible === 1 ? ' Member' : ' Members');

    emptyState.style.display = visible === 0 ? 'block' : 'none';
    tableBody.style.display = visible === 0 ? 'none' : '';
  }

  searchInput.addEventListener('input', filterStaff);
  roleFilter.addEventListener('change', filterStaff);
  departmentFilter.addEventListener('change', filterStaff);
})();
</script>

</body>
</html>
