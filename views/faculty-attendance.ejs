<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Faculty Attendance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    
    /* Layout Grid */
    .attendance-layout { display: grid; grid-template-columns: 1fr 350px; gap: 2rem; align-items: flex-start; }

    /* Student List Vertical */
    .roster-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .roster-header { background: var(--mist); padding: 1.5rem; border-bottom: 2px solid var(--frost); }
    .roster-header h2 { font-size: 1.2rem; font-weight: 800; color: var(--navy); }
    
    .student-row { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--frost); }
    .student-row:last-child { border-bottom: none; }
    
    /* Profile Placeholder */
    .student-profile { display: flex; align-items: center; gap: 1rem; width: 250px; }
    .avatar-placeholder { width: 50px; height: 50px; border-radius: 50%; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 800; }
    .student-name { font-weight: 800; font-size: 1rem; color: var(--navy); }

    /* Radio & Info */
    .attendance-controls { text-align: right; }
    .radio-group { display: flex; gap: 1.5rem; justify-content: flex-end; margin-bottom: 0.5rem; }
    .radio-group label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-weight: 700; font-size: 0.9rem; }
    .radio-group input[type="radio"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--blue); }
    
    .student-meta { font-size: 0.75rem; color: #64748b; font-weight: 600; }

    /* QR Codes Right Column */
    .qr-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); padding: 1.5rem; }
    .qr-container h3 { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 1rem; text-align: center; }
    .qr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .qr-box { text-align: center; background: var(--ice); padding: 0.8rem; border-radius: 10px; border: 1px solid var(--frost); }
    .qr-box img { width: 100px; height: 100px; border-radius: 8px; margin-bottom: 0.5rem; }
    .qr-box span { display: block; font-size: 0.75rem; font-weight: 800; color: var(--blue); }

    .btn-save { background: var(--navy); color: #fff; padding: 1rem 2.5rem; border-radius: 100px; border: none; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.2s; display: block; width: 100%; margin-top: 1.5rem; }
    .btn-save:hover { background: var(--deep); transform: translateY(-2px); }
    
    .back-btn { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
  
    /* --- MOBILE FIXES (AUTO-INJECTED) --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy, #0a1e32); color: var(--gold, #ffc857); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: 0 8px 20px -6px rgba(10,30,50,0.12); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue, #1e4d7b); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .btn-back { display: inline-flex; }
      .layout, .finance-layout, .attendance-grid, .tile-grid, .course-grid, .stats-grid, .semester-grid, .weekly-grid, .data-table { 
        grid-template-columns: 1fr !important; 
        gap: 1rem !important; 
      }
      .table-container, .table-wrapper { display: block; overflow-x: auto; white-space: nowrap; }
    }

  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>


  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> Course Management <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link active"><i class="fas fa-user-check main-icon"></i> Attendance Management</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-pen main-icon"></i> Grade Entry</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    
    <div class="top-bar">
      <div class="greeting">
        <h1>Attendance Management</h1>
        <p>Only the courses assigned to you are shown below.</p>
      </div>
    </div>

    <% if (!section) { %>
      <!-- SHOW LIST OF COURSES (ONLY TEACHER'S COURSES) -->
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        <% if (courses.length === 0) { %>
          <div style="background:#fff; padding: 2rem; border-radius: 1.25rem; color:#64748b;">You are not assigned to teach any courses.</div>
        <% } %>
        
        <% courses.forEach(course => { %>
          <a href="/sis/faculty/attendance/<%= course.section_id %>" style="background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); padding: 1.5rem; text-decoration: none; color: var(--navy); display: block; transition: 0.2s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="font-size: 0.8rem; font-weight: 800; color: var(--blue); text-transform: uppercase; margin-bottom: 0.5rem;"><%= course.code %> · <%= course.group_name %></div>
            <div style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem;"><%= course.title %></div>
            <div style="font-size: 0.85rem; color: #64748b; font-weight: 600; display: flex; flex-direction: column; gap: 0.5rem;">
              <span><i class="fas fa-calendar-alt" style="color: var(--amber); width: 20px;"></i> <%= course.day_of_week || 'TBA' %></span>
              <span><i class="fas fa-clock" style="color: var(--amber); width: 20px;"></i> <%= course.start_time || 'TBA' %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <!-- SHOW ATTENDANCE PAGE FOR SPECIFIC CLASS -->
      <a href="/sis/faculty/attendance" class="back-btn"><i class="fas fa-arrow-left"></i> Back to My Courses</a>
      
      <div class="attendance-layout">
        
        <!-- LEFT: VERTICAL LIST OF STUDENTS -->
        <div class="roster-container">
          <div class="roster-header">
            <h2><%= section.code %> - <%= section.title %> (<%= section.group_name %>)</h2>
          </div>

          <form method="POST" action="/sis/faculty/attendance/<%= section.id %>">
            <% if (students.length === 0) { %>
              <div style="padding: 2rem; text-align: center; color: #64748b;">No students enrolled yet.</div>
            <% } %>
            
            <% students.forEach(student => { %>
              <div class="student-row">
                <!-- Profile & Name -->
                <div class="student-profile">
                  <div class="avatar-placeholder"><%= student.full_name.charAt(0) %></div>
                  <div class="student-name"><%= student.full_name %></div>
                </div>
                
                <!-- Radio & Date/ID -->
                <div class="attendance-controls">
                  <div class="radio-group">
                    <label style="color: var(--success);">
                      <input type="radio" name="status_<%= student.user_id %>" value="Present" <%= student.current_status === 'Present' ? 'checked' : '' %>> Present
                    </label>
                    <label style="color: var(--danger);">
                      <input type="radio" name="status_<%= student.user_id %>" value="Absent" <%= student.current_status === 'Absent' ? 'checked' : '' %>> Absent
                    </label>
                  </div>
                  <div class="student-meta">
                    Date: <%= today %> | ID: <%= student.username %>
                  </div>
                </div>
              </div>
            <% }) %>
            
            <div style="padding: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Attendance</button>
            </div>
          </form>
        </div>

        <!-- RIGHT: QR CODES PER HOUR -->
        <div class="qr-container">
          <h3>Scan QR Code</h3>
          <p style="font-size: 0.8rem; color: #64748b; text-align: center; margin-bottom: 1rem;">QR codes refresh every hour.</p>
          
          <div class="qr-grid">
            <% hours.forEach(hour => { %>
              <div class="qr-box">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= process.env.APP_URL %>/sis/my/attendance/scan?section_id=<%= section.id %>&date=<%= today %>&hour=<%= hour %>" alt="QR Code">
 <span>Hour <%= hour %></span>
              </div>
            <% }) %>
          </div>
          
          <div style="margin-top: 1rem; font-size: 0.75rem; color: #94a3b8; text-align: center; font-weight: 600;">
            Today: <%= today %>
          </div>
        </div>

      </div>
    <% } %>

  </main>

  
  <script>
    // 1. Toggle menu function
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
        // Save the state to browser memory
        const text = element.innerText.trim().split('\n')[0]; 
        if (parent.classList.contains('open')) {
          localStorage.setItem('menu_' + text, 'open');
        } else {
          localStorage.removeItem('menu_' + text);
        }
      }
    }

    // 2. Mobile toggle function
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    // 3. Restore open menus on page load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.menu-link').forEach(link => {
        if (link.nextElementSibling && link.nextElementSibling.classList.contains('submenu')) {
          const text = link.innerText.trim().split('\n')[0];
          if (localStorage.getItem('menu_' + text) === 'open') {
            link.parentElement.classList.add('open');
            link.nextElementSibling.classList.add('open');
          }
        }
      });
    });
  </script>

</body>
</html>