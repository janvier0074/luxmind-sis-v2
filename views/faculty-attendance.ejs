<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Faculty Attendance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Dashboard Cards */
    .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
    .course-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); padding: 1.5rem; text-decoration: none; color: var(--navy); transition: 0.2s; display: block; }
    .course-card:hover { transform: translateY(-5px); border-color: var(--amber); box-shadow: 0 15px 30px -10px rgba(10,30,50,0.15); }
    .course-code { font-size: 0.8rem; font-weight: 800; color: var(--blue); text-transform: uppercase; margin-bottom: 0.5rem; }
    .course-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; }
    .course-meta { font-size: 0.85rem; color: #64748b; font-weight: 600; display: flex; flex-direction: column; gap: 0.5rem; }

    /* Attendance Roster Layout */
    .attendance-layout { display: grid; grid-template-columns: 350px 1fr; gap: 2rem; align-items: flex-start; }
    
    /* QR Code Card */
    .qr-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); padding: 2rem; text-align: center; }
    .qr-card h3 { font-size: 1.1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--navy); }
    .qr-card p { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; font-weight: 500; }
    .qr-card img { border-radius: 1rem; border: 4px solid var(--mist); }
    
    /* Manual Form Card */
    .roster-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .roster-header { background: var(--mist); padding: 1.5rem; border-bottom: 2px solid var(--frost); }
    .roster-header h2 { font-size: 1.2rem; font-weight: 800; color: var(--navy); }
    
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .data-table td { padding: 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; vertical-align: middle; }
    
    /* Radio Buttons & Info */
    .attendance-options { display: flex; gap: 1.5rem; margin-bottom: 0.4rem; }
    .attendance-options label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-weight: 700; font-size: 0.85rem; }
    .attendance-options input[type="radio"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--blue); }
    
    .student-info { font-size: 0.75rem; color: #64748b; font-weight: 600; }

    .btn-save { background: var(--navy); color: #fff; padding: 1rem 2.5rem; border-radius: 100px; border: none; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem; }
    .btn-save:hover { background: var(--deep); transform: translateY(-2px); }
    
    .back-btn { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> Course Management <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link active"><i class="fas fa-user-check main-icon"></i> Attendance Management</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-pen main-icon"></i> Grade Entry</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <div class="top-bar">
      <div class="greeting">
        <h1>Attendance Management</h1>
        <p>Mark attendance via QR code or manually.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-chalkboard-teacher"></i>
        <%= user.full_name || user.username %>
      </div>
    </div>

    <% if (!section) { %>
      <!-- SHOW LIST OF COURSES -->
      <div class="course-grid">
        <% if (courses.length === 0) { %>
          <div style="background:#fff; padding: 2rem; border-radius: 1.25rem; color:#64748b;">You are not assigned to teach any courses.</div>
        <% } %>
        
        <% courses.forEach(course => { %>
          <a href="/sis/faculty/attendance/<%= course.section_id %>" class="course-card">
            <div class="course-code"><%= course.code %> · <%= course.group_name %></div>
            <div class="course-title"><%= course.title %></div>
            <div class="course-meta">
              <span><i class="fas fa-calendar-alt" style="color: var(--amber); width: 20px;"></i> <%= course.day_of_week || 'TBA' %></span>
              <span><i class="fas fa-clock" style="color: var(--amber); width: 20px;"></i> <%= course.start_time || 'TBA' %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <!-- SHOW ROSTER FOR SPECIFIC CLASS -->
      <a href="/sis/faculty/attendance" class="back-btn"><i class="fas fa-arrow-left"></i> Back to My Classes</a>
      
      <div class="attendance-layout">
        
        <!-- METHOD 1: QR CODE -->
        <div class="qr-card">
          <h3>Method 1: Scan to Attend</h3>
          <p>Display this QR code for students to scan.</p>
          <!-- We use a public API to generate the QR code image -->
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=https://luxmind-sis-v2.onrender.com/sis/my/attendance/scan?section_id=<%= section.id %>&date=<%= today %>" alt="Attendance QR Code">
          <p style="margin-top: 1rem; font-size: 0.75rem; color: #94a3b8;">Date: <%= today %></p>
        </div>

        <!-- METHOD 2: MANUAL VALIDATION -->
        <div class="roster-container">
          <div class="roster-header">
            <h2><%= section.code %> - <%= section.title %> (<%= section.group_name %>)</h2>
            <p style="color: #64748b; font-size: 0.85rem; margin-top: 0.5rem;">Manual Validation</p>
          </div>

          <form method="POST" action="/sis/faculty/attendance/<%= section.id %>">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Student Name</th>
                  <th>Attendance</th>
                </tr>
              </thead>
              <tbody>
                <% if (students.length === 0) { %>
                  <tr><td colspan="2" style="text-align: center; padding: 2rem;">No students enrolled in this class yet.</td></tr>
                <% } %>
                
                <% students.forEach(student => { %>
                  <tr>
                    <td>
                      <div style="font-weight: 800; font-size: 0.95rem;"><%= student.full_name %></div>
                      <div style="font-size: 0.75rem; color: var(--blue); font-weight: 600;">ID: <%= student.username %></div>
                    </td>
                    <td>
                      <div class="attendance-options">
                        <label style="color: var(--success);">
                          <input type="radio" name="status_<%= student.user_id %>" value="Present" <%= student.current_status === 'Present' ? 'checked' : '' %>> Present
                        </label>
                        <label style="color: var(--danger);">
                          <input type="radio" name="status_<%= student.user_id %>" value="Absent" <%= student.current_status === 'Absent' ? 'checked' : '' %>> Absent
                        </label>
                      </div>
                      <!-- Requested Info below Radio Buttons -->
                      <div class="student-info">
                        Date: <%= today %> · Student No: <%= student.username %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            
            <div style="padding: 0 1.5rem 1.5rem;">
              <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Manual Attendance</button>
            </div>
          </form>
        </div>

      </div>
    <% } %>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
  </script>
</body>
</html>