<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Weights — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background:
        radial-gradient(circle at 100% 0%, rgba(245,166,35,0.06), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(30,77,123,0.05), transparent 40%),
        var(--ice);
      min-height: 100vh; display: flex; color: var(--navy);
      -webkit-font-smoothing: antialiased;
    }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 30px rgba(0,0,0,0.15); z-index: 1000; scrollbar-width: thin; scrollbar-color: #1e3a5f transparent; transition: transform 0.3s ease; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); box-shadow: 0 4px 12px rgba(245,166,35,0.35); }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; margin-top: 2px; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; opacity: 0.85; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s ease; }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.18), transparent); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.18); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }
    .menu-item.open > .menu-link { color: #fff; }

    /* Main */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }

    .btn-back {
      display: inline-flex; align-items: center; gap: 0.5rem;
      color: var(--blue); font-weight: 800; text-decoration: none;
      margin-bottom: 1rem; font-size: 0.85rem; padding: 0.4rem 0.8rem;
      border-radius: 8px; transition: var(--transition);
    }
    .btn-back:hover { background: #fff; box-shadow: var(--shadow-soft); color: var(--amber); }

    .page-header { margin-bottom: 2rem; }
    .page-title { display: flex; align-items: center; gap: 1rem; }
    .page-title-icon {
      width: 56px; height: 56px; border-radius: 16px;
      background: linear-gradient(135deg, var(--navy), var(--blue));
      display: flex; align-items: center; justify-content: center;
      color: var(--gold); font-size: 1.4rem;
      box-shadow: 0 8px 24px -8px rgba(10,30,50,0.4);
    }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .page-title p { color: #64748b; font-weight: 500; font-size: 0.9rem; margin-top: 0.2rem; }

    /* CIU Info banner */
    .ciu-banner {
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      border: 1px solid #f59e0b;
      color: #78350f;
      padding: 1rem 1.3rem;
      border-radius: 1rem;
      margin-bottom: 1.5rem;
      display: flex; gap: 0.8rem; align-items: flex-start;
      font-size: 0.82rem; font-weight: 600;
      box-shadow: 0 4px 12px -4px rgba(245,158,11,0.2);
    }
    .ciu-banner i { font-size: 1.1rem; color: #b45309; margin-top: 0.1rem; }
    .ciu-banner strong { font-weight: 800; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-bottom: 2rem; }
    .stat-card {
      background: #fff; padding: 1.2rem 1.3rem;
      border-radius: 1rem; box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      display: flex; align-items: center; gap: 1rem;
      transition: var(--transition);
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: var(--gold); }
    .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
    .stat-icon.total    { background: #e0f2fe; color: #0284c7; }
    .stat-icon.locked   { background: #fee2e2; color: #b91c1c; }
    .stat-icon.unlocked { background: #dcfce7; color: #16a34a; }
    .stat-icon.custom   { background: #f3e8ff; color: #9333ea; }
    .stat-info h3 { font-size: 0.68rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; font-weight: 700; }
    .stat-info p { font-size: 1.4rem; font-weight: 800; color: var(--navy); margin-top: 0.1rem; line-height: 1; }

    /* Section label */
    .section-label {
      font-size: 1.05rem; font-weight: 800; color: var(--navy);
      margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;
    }
    .section-label i { color: var(--amber); }

    /* Weight cards */
    .weights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 1.4rem;
    }
    .weight-card {
      background: #fff; border-radius: 1.25rem;
      box-shadow: var(--shadow-soft); border: 1px solid var(--frost);
      overflow: hidden; transition: var(--transition);
      text-decoration: none; color: inherit;
      display: flex; flex-direction: column;
    }
    .weight-card:hover {
      transform: translateY(-6px); box-shadow: var(--shadow-hover);
      border-color: var(--amber);
    }

    .weight-head {
      background: linear-gradient(135deg, var(--navy), var(--deep));
      padding: 1rem 1.3rem;
      display: flex; justify-content: space-between; align-items: center;
    }
    .weight-code {
      font-size: 0.7rem; font-weight: 800; color: var(--gold);
      letter-spacing: 1.5px; text-transform: uppercase;
    }
    .lock-badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.28rem 0.7rem; border-radius: 100px;
      font-size: 0.62rem; font-weight: 800;
      letter-spacing: 0.4px; text-transform: uppercase;
    }
    .lock-badge.locked { background: rgba(254,226,226,0.95); color: #991b1b; }
    .lock-badge.editable { background: rgba(220,252,231,0.95); color: #15803d; }
    .lock-badge i { font-size: 0.55rem; }

    .weight-body { padding: 1.2rem 1.3rem; flex: 1; display: flex; flex-direction: column; }
    .weight-title { font-size: 1rem; font-weight: 800; color: var(--navy); line-height: 1.35; margin-bottom: 0.3rem; }
    .weight-group { font-size: 0.72rem; color: #94a3b8; font-weight: 700; margin-bottom: 1rem; letter-spacing: 0.3px; }

    /* Weight visualization */
    .weights-visual { margin-bottom: 1.1rem; }
    .weights-bar {
      display: flex; height: 34px;
      border-radius: 10px; overflow: hidden;
      margin-bottom: 0.5rem;
      box-shadow: inset 0 1px 3px rgba(10,30,50,0.08);
    }
    .wbar-midterm {
      background: linear-gradient(135deg, var(--blue), #2c5d8e);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.3px;
      transition: width 0.4s ease;
    }
    .wbar-final {
      background: linear-gradient(135deg, var(--amber), var(--gold));
      display: flex; align-items: center; justify-content: center;
      color: var(--navy); font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.3px;
      transition: width 0.4s ease;
    }
    .weights-labels {
      display: flex; justify-content: space-between;
      font-size: 0.68rem; font-weight: 700; color: #64748b;
    }
    .weights-labels span { display: flex; align-items: center; gap: 0.3rem; }

    /* Info row */
    .weight-info {
      display: flex; justify-content: space-between; align-items: center;
      padding: 0.6rem 0.8rem;
      background: #f8fafc; border-radius: 10px;
      font-size: 0.72rem; font-weight: 700; color: #475569;
      margin-top: auto;
    }
    .weight-info i { color: var(--blue); margin-right: 0.3rem; }
    .weight-info .grades-count { color: var(--navy); font-weight: 800; }

    /* Empty state */
    .empty-state {
      background: #fff; padding: 4rem 2rem;
      border-radius: 1.25rem; border: 2px dashed var(--frost);
      text-align: center; grid-column: 1 / -1;
    }
    .empty-state i { font-size: 3rem; color: var(--frost); margin-bottom: 1rem; display: block; }
    .empty-state h3 { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem; }
    .empty-state p { color: #64748b; font-size: 0.85rem; font-weight: 500; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow-soft); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    @media (max-width: 1024px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 0.8rem; }
      .page-title h1 { font-size: 1.3rem; }
      .page-title-icon { width: 44px; height: 44px; font-size: 1.2rem; }
    }
    @media (max-width: 500px) {
      .weights-grid { grid-template-columns: 1fr; }
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> <%= lang.dashboard || 'Dashboard' %></a></li>

      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> <%= lang.my_courses || 'My Courses' %> <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-list main-icon"></i> Course List</a></li>
          <li class="menu-item"><a href="/sis/faculty/class-roster" class="menu-link"><i class="fas fa-users main-icon"></i> Class Roster</a></li>
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-folder main-icon"></i> Content & Materials <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="/sis/faculty/course-materials" class="menu-link">Upload Syllabus</a></li>
              <li class="menu-item"><a href="/sis/faculty/course-materials" class="menu-link">Lecture Notes/Slides</a></li>
              <li class="menu-item"><a href="/sis/faculty/course-materials" class="menu-link">Add Moodle Links</a></li>
              <li class="menu-item"><a href="/sis/faculty/course-weights" class="menu-link active">Course Weights</a></li>
            </ul>
          </li>
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-check-square main-icon"></i> Attendance <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link">Take Attendance</a></li>
              <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link">Generate QR Code</a></li>
            </ul>
          </li>
          <li class="menu-item"><a href="/sis/faculty/evaluations" class="menu-link"><i class="fas fa-poll main-icon"></i> <%= lang.course_evaluations || 'Course Evaluations' %></a></li>
        </ul>
      </li>

      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-pen main-icon"></i> <%= lang.grading_exams || 'Grading & Exams' %> <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/grades" class="menu-link"><i class="fas fa-marker main-icon"></i> Gradebook Entry</a></li>
        </ul>
      </li>

      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> <%= lang.logout || 'Logout' %></a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>

    <div class="page-header">
      <div class="page-title">
        <div class="page-title-icon"><i class="fas fa-sliders"></i></div>
        <div>
          <h1>Course Weights</h1>
          <p>Configure how midterm and final scores contribute to each section's total grade</p>
        </div>
      </div>
    </div>

    <div class="ciu-banner">
      <i class="fas fa-info-circle"></i>
      <div>
        <strong>CIU Rule:</strong> Weights can be edited freely until the first grade is entered. Once any grade exists, weights are <strong>locked</strong> to guarantee grade integrity. Contact the registrar if you need to unlock.
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon total"><i class="fas fa-layer-group"></i></div>
        <div class="stat-info"><h3>My Sections</h3><p><%= stats.total %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon unlocked"><i class="fas fa-pen-to-square"></i></div>
        <div class="stat-info"><h3>Editable</h3><p><%= stats.unlocked %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon locked"><i class="fas fa-lock"></i></div>
        <div class="stat-info"><h3>Locked</h3><p><%= stats.locked %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon custom"><i class="fas fa-scale-balanced"></i></div>
        <div class="stat-info"><h3>Custom Weights</h3><p><%= stats.custom %></p></div>
      </div>
    </div>

    <div class="section-label"><i class="fas fa-list"></i> Select a section to view or edit its weights</div>

    <div class="weights-grid">
      <% if (sections.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <h3>No sections assigned</h3>
          <p>You are not assigned to teach any sections yet. Contact the registrar.</p>
        </div>
      <% } %>

      <% sections.forEach(sec => { %>
        <a href="/sis/faculty/course-weights/<%= sec.section_id %>" class="weight-card">
          <div class="weight-head">
            <span class="weight-code"><%= sec.code %> · <%= sec.group_name || '—' %></span>
            <% if (sec.weights_locked) { %>
              <span class="lock-badge locked"><i class="fas fa-lock"></i> Locked</span>
            <% } else { %>
              <span class="lock-badge editable"><i class="fas fa-pen"></i> Editable</span>
            <% } %>
          </div>
          <div class="weight-body">
            <div class="weight-title"><%= sec.title %></div>
            <div class="weight-group"><%= sec.credits %> credits · <%= sec.student_count %> enrolled</div>

            <div class="weights-visual">
              <div class="weights-bar">
                <div class="wbar-midterm" style="width: <%= sec.midterm_weight %>%">Midterm <%= sec.midterm_weight %>%</div>
                <div class="wbar-final" style="width: <%= sec.final_weight %>%">Final <%= sec.final_weight %>%</div>
              </div>
              <div class="weights-labels">
                <span><i class="fas fa-square" style="color: var(--blue);"></i> Midterm</span>
                <span><i class="fas fa-square" style="color: var(--amber);"></i> Final</span>
              </div>
            </div>

            <div class="weight-info">
              <span><i class="fas fa-pen"></i> Grades entered</span>
              <span class="grades-count"><%= sec.grade_count %> / <%= sec.student_count %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) { sb.classList.toggle('active'); ov.classList.toggle('active'); }
    }
  </script>
</body>
</html>