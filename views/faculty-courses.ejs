<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Courses</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }

    /* Sidebar & Main Content Layout */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.6rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    /* Course Grid */
    .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
    .course-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; display: flex; flex-direction: column; }
    .course-header { background: var(--navy); color: #fff; padding: 1.2rem; border-bottom: 3px solid var(--amber); }
    .course-code { font-size: 0.75rem; font-weight: 800; color: var(--gold); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.3rem; }
    .course-title { font-size: 1.1rem; font-weight: 800; }
    .course-body { padding: 1.2rem; flex: 1; display: flex; flex-direction: column; gap: 0.6rem; }
    .course-meta { display: flex; align-items: center; gap: 0.8rem; font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .course-meta i { width: 18px; color: var(--blue); }
    .course-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-top: 1rem; }
    .btn-action { padding: 0.7rem; border-radius: 8px; font-weight: 800; font-size: 0.75rem; text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.4rem; transition: 0.2s; }
    .btn-attendance { background: #dcfce7; color: #16a34a; }
    .btn-attendance:hover { background: #16a34a; color: #fff; }
    .btn-grades { background: #e0f2fe; color: #0284c7; }
    .btn-grades:hover { background: #0284c7; color: #fff; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .course-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> My Courses <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link active"><i class="fas fa-list main-icon"></i> Course List</a></li>
        </ul>
      </li>
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>My Courses</h1>
      <p>Manage your classes, attendance, and grades.</p>
    </div>

    <div class="course-grid">
      <% if (courses.length === 0) { %>
        <div style="background:#fff; padding: 2rem; border-radius: 1rem; color:#64748b; grid-column: 1 / -1;">You are not assigned to teach any courses yet.</div>
      <% } %>
      
      <% courses.forEach(course => { %>
        <div class="course-card">
          <div class="course-header">
            <div class="course-code"><%= course.code %> · <%= course.group_name %></div>
            <div class="course-title"><%= course.title %></div>
          </div>
          <div class="course-body">
            <div class="course-meta"><i class="fas fa-calendar-alt"></i> <%= course.day_of_week || 'TBA' %></div>
            <div class="course-meta"><i class="fas fa-clock"></i> <%= course.start_time || 'TBA' %></div>
            <div class="course-meta"><i class="fas fa-door-open"></i> <%= course.room || 'TBA' %></div>
            <div class="course-meta"><i class="fas fa-users"></i> <%= course.student_count %> Students Enrolled</div>
            
                            <div class="course-actions" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 0.5rem;">
              <a href="/sis/faculty/attendance/<%= course.section_id %>" class="btn-action btn-attendance"><i class="fas fa-check-square"></i> Attend</a>
              <a href="/sis/faculty/attendance-history/<%= course.section_id %>" class="btn-action" style="background:#f3f4f6; color:#4b5563;"><i class="fas fa-history"></i> History</a>
              <a href="/sis/faculty/grades/<%= course.section_id %>" class="btn-action btn-grades"><i class="fas fa-pen"></i> Grades</a>
              <a href="/sis/faculty/courses/<%= course.course_id %>/materials" class="btn-action" style="background:#fef3c7; color:#d97706;"><i class="fas fa-folder-open"></i> Files</a>
              <a href="/sis/faculty/grades/<%= course.section_id %>/summary" class="btn-action" style="background:#f3e8ff; color:#9333ea;"><i class="fas fa-chart-pie"></i> Stats</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
  </script>
</body>
</html>