<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Faculty Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
      --shadow-hover: 0 14px 30px -10px rgba(10, 30, 50, 0.2);
      --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background:
        radial-gradient(circle at 100% 0%, rgba(245, 166, 35, 0.06), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(30, 77, 123, 0.05), transparent 40%),
        var(--ice);
      min-height: 100vh;
      display: flex;
      color: var(--navy);
      -webkit-font-smoothing: antialiased;
    }

    /* --- SIDEBAR --- */
    .sidebar {
      width: 280px;
      background: linear-gradient(180deg, var(--navy) 0%, var(--deep) 100%);
      color: #fff;
      position: fixed;
      top: 0; bottom: 0; left: 0;
      overflow-y: auto;
      box-shadow: 4px 0 30px rgba(0,0,0,0.15);
      z-index: 1000;
      transition: transform 0.3s ease;
      scrollbar-width: thin;
      scrollbar-color: #1e3a5f transparent;
    }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    .sidebar::-webkit-scrollbar-track { background: transparent; }

    .sidebar-brand {
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      position: sticky;
      top: 0;
      background: var(--navy);
      z-index: 10;
    }
    .brand-mark {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--amber), var(--gold));
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; font-weight: 800; color: var(--navy);
      box-shadow: 0 4px 12px rgba(245, 166, 35, 0.35);
    }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span {
      display: block; font-size: 0.6rem; color: var(--gold);
      letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; margin-top: 2px;
    }

    /* Sidebar Menu */
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link {
      display: flex; align-items: center;
      padding: 0.65rem 1rem;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      transition: var(--transition);
      border-left: 3px solid transparent;
      position: relative;
    }
    .menu-link:hover {
      color: #fff;
      background: rgba(255,255,255,0.06);
      border-left-color: var(--amber);
    }
    .menu-link i.main-icon {
      width: 22px;
      color: var(--gold);
      font-size: 0.85rem;
      opacity: 0.85;
      transition: var(--transition);
    }
    .menu-link:hover i.main-icon { opacity: 1; transform: scale(1.08); }
    .menu-link .arrow {
      margin-left: auto; font-size: 0.6rem;
      transition: transform 0.3s ease;
    }
    .menu-link.active {
      color: #fff;
      background: linear-gradient(90deg, rgba(245, 166, 35, 0.18), transparent);
      border-left-color: var(--gold);
    }
    .menu-link.active i.main-icon { color: var(--gold); opacity: 1; }

    /* Nested Menus */
    .submenu {
      list-style: none;
      display: none;
      background: rgba(0,0,0,0.18);
      border-left: 2px solid transparent;
      animation: slideDown 0.25s ease;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link {
      padding-left: 2.5rem;
      font-size: 0.75rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    .submenu .submenu .menu-link {
      padding-left: 3.5rem;
      font-size: 0.7rem;
    }
    .submenu .menu-link i.main-icon { color: #cbd5e1; opacity: 0.6; }
    .submenu .menu-link:hover i.main-icon { color: var(--gold); opacity: 1; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }
    .menu-item.open > .menu-link { color: #fff; }

    /* --- MAIN CONTENT --- */
    .main-content {
      margin-left: 280px;
      padding: 2.5rem;
      flex: 1;
      width: calc(100% - 280px);
      transition: margin 0.3s ease;
    }

    .btn-back {
      display: inline-flex; align-items: center; gap: 0.5rem;
      color: var(--blue); font-weight: 800; text-decoration: none;
      margin-bottom: 1rem; font-size: 0.85rem;
      padding: 0.4rem 0.8rem; border-radius: 8px;
      transition: var(--transition);
    }
    .btn-back:hover { background: #fff; box-shadow: var(--shadow-soft); color: var(--amber); }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;
    }
    .greeting h1 {
      font-size: 1.8rem; font-weight: 800; color: var(--navy);
      letter-spacing: -0.5px;
    }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill {
      background: #fff; padding: 0.6rem 1.1rem; border-radius: 100px;
      display: flex; align-items: center; gap: 0.8rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      font-weight: 700; font-size: 0.85rem;
    }
    .user-pill i { color: var(--amber); font-size: 1rem; }

    /* Language Switcher */
    .lang-switcher {
      display: flex; align-items: center; gap: 0.5rem;
      background: #fff; padding: 0.5rem 1rem; border-radius: 100px;
      box-shadow: var(--shadow-soft); border: 1px solid var(--frost);
    }
    .lang-switcher i { color: var(--amber); font-size: 0.9rem; }
    .lang-switcher select {
      border: none; background: transparent; font-family: inherit;
      font-weight: 700; font-size: 0.85rem; color: var(--navy);
      cursor: pointer; outline: none;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.2rem;
      margin-bottom: 2.5rem;
    }
    .stat-card {
      background: #fff;
      padding: 1.2rem;
      border-radius: 1rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      display: flex; align-items: center; gap: 1rem;
      transition: var(--transition);
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: var(--gold); }
    .stat-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; flex-shrink: 0;
    }
    .stat-icon.classes  { background: #e0f2fe; color: #0284c7; }
    .stat-icon.students { background: #dcfce7; color: #16a34a; }
    .stat-icon.grades   { background: #fef3c7; color: #d97706; }
    .stat-icon.advising { background: #f3e8ff; color: #9333ea; }
    .stat-info h3 {
      font-size: 0.7rem; color: #64748b;
      text-transform: uppercase; letter-spacing: 0.6px; font-weight: 700;
    }
    .stat-info p { font-size: 1.4rem; font-weight: 800; color: var(--navy); margin-top: 0.1rem; }

    /* Section Titles */
    .section-title {
      font-size: 1.05rem; font-weight: 800; color: var(--navy);
      margin-bottom: 1rem;
      display: flex; align-items: center; gap: 0.6rem;
    }
    .section-title i { color: var(--amber); }

    /* Quick Action Tiles */
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1.2rem;
    }
    .tile {
      background: #fff;
      padding: 1.5rem 1rem;
      border-radius: 1rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      text-decoration: none; color: var(--navy);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      transition: var(--transition);
      min-height: 140px;
      position: relative;
      overflow: hidden;
    }
    .tile::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(245,166,35,0.08), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .tile:hover {
      transform: translateY(-5px);
      border-color: var(--amber);
      box-shadow: var(--shadow-hover);
    }
    .tile:hover::before { opacity: 1; }
    .tile i {
      font-size: 2rem; color: var(--blue);
      margin-bottom: 0.8rem;
      transition: var(--transition);
      position: relative; z-index: 1;
    }
    .tile:hover i { color: var(--amber); transform: scale(1.12) rotate(-3deg); }
    .tile span {
      font-size: 0.85rem; font-weight: 700;
      line-height: 1.3;
      position: relative; z-index: 1;
    }

    /* --- MOBILE --- */
    .mobile-menu-btn {
      display: none;
      position: fixed; top: 1rem; left: 1rem; z-index: 1001;
      background: var(--navy); color: var(--gold);
      border: none; width: 45px; height: 45px; border-radius: 10px;
      font-size: 1.2rem; cursor: pointer;
      box-shadow: var(--shadow-soft);
      align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .mobile-menu-btn:hover { background: var(--deep); }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(10,30,50,0.5); z-index: 999;
      backdrop-filter: blur(2px);
    }

    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .stats-grid { grid-template-columns: 1fr; gap: 1rem; }
      .tile-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .top-bar { flex-direction: column; align-items: flex-start; }
      .user-pill { width: 100%; justify-content: center; }
    }
    @media (max-width: 480px) {
      .tile-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

