        <div class="stat-icon classes"><i class="fas fa-book"></i></div>
        <div class="stat-info">
          <h3>My Courses</h3>
          <p><%= courses.length %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon students"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <h3>Total Students</h3>
          <p><%= courses.reduce((sum, c) => sum + Number(c.student_count), 0) %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon grades"><i class="fas fa-pen"></i></div>
        <div class="stat-info">
          <h3>Pending Gradings</h3>
          <p>0</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon advising"><i class="fas fa-user-friends"></i></div>
        <div class="stat-info">
          <h3>Advising Queue</h3>
          <p>0</p>
        </div>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="section-title"><i class="fas fa-th-large"></i> <%= lang.quick_actions || 'Quick Actions' %></div>

    <div class="tile-grid">
      <a href="/sis/faculty/attendance" class="tile">
        <i class="fas fa-user-check"></i>
        <span>Take Attendance</span>
      </a>

      <a href="/sis/faculty/grades" class="tile">
        <i class="fas fa-pen"></i>
        <span>Grade Entry</span>
      </a>

      <a href="/sis/advisor/approvals" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Approve Registrations</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-file-upload"></i>
        <span>Upload Materials</span>
      </a>

      <!-- ✅ NEW QUICK ACTION for Course Evaluations -->
      <a href="/sis/faculty/evaluations" class="tile">
        <i class="fas fa-poll"></i>
        <span><%= lang.course_evaluations || 'Course Evaluations' %></span>
      </a>
    </div>

    <!-- MY TEACHING SCHEDULE -->
    <div class="section-title" style="margin-top: 2.5rem;">
      <i class="fas fa-chalkboard-teacher"></i> My Teaching Schedule
    </div>
    <div class="tile-grid">
      <% if (courses.length === 0) { %>
        <div style="background:#fff; padding: 2rem; border-radius: 1rem; color:#64748b; grid-column: 1 / -1; text-align: center; border: 1px dashed var(--frost);">
          <i class="fas fa-inbox" style="font-size: 2rem; color: var(--frost); display: block; margin-bottom: 0.5rem;"></i>
          You are not assigned to teach any courses yet.
        </div>
      <% } %>

      <% courses.forEach(course => { %>
        <div class="tile" style="align-items: flex-start; text-align: left; cursor: default;">
          <div style="font-size: 0.75rem; font-weight: 800; color: var(--blue); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.5px;">
            <%= course.code %> · <%= course.group_name %>
          </div>
          <div style="font-size: 1rem; font-weight: 800; margin-bottom: 0.8rem; color: var(--navy); line-height: 1.3;">
            <%= course.title %>
          </div>
          <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
            <div style="margin-bottom: 0.35rem;"><i class="fas fa-calendar-alt" style="color: var(--amber); width: 15px;"></i> <%= course.day_of_week || 'TBA' %></div>
            <div style="margin-bottom: 0.35rem;"><i class="fas fa-clock" style="color: var(--amber); width: 15px;"></i> <%= course.start_time || 'TBA' %></div>
            <div><i class="fas fa-users" style="color: var(--amber); width: 15px;"></i> <%= course.student_count %> Students</div>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
      }
    }

    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }
  </script>
</body>
</html>