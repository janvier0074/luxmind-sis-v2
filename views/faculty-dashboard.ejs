            <option value="sw" <%= (typeof locale !== 'undefined' && locale === 'sw') ? 'selected' : '' %>>Kiswahili</option>
            <option value="rn" <%= (typeof locale !== 'undefined' && locale === 'rn') ? 'selected' : '' %>>Ikirundi</option>
