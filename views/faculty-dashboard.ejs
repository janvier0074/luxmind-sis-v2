<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Faculty Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1.2rem; }
    .stat-icon { width: 55px; height: 55px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background: #e0f2fe; color: #0284c7; }
    .stat-info h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); }

    /* Courses */
    .section-title { font-size: 1.2rem; font-weight: 800; color: var(--navy); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.8rem; }
    .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
    .course-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); padding: 1.5rem; text-decoration: none; color: var(--navy); transition: 0.2s; display: block; position: relative; overflow: hidden; }
    .course-card:hover { transform: translateY(-5px); border-color: var(--amber); box-shadow: 0 15px 30px -10px rgba(10,30,50,0.15); }
    .course-code { font-size: 0.8rem; font-weight: 800; color: var(--blue); text-transform: uppercase; margin-bottom: 0.5rem; }
    .course-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; }
    .course-meta { font-size: 0.85rem; color: #64748b; font-weight: 600; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
    .course-meta i { color: var(--amber); width: 20px; }
    
    .course-actions { display: flex; gap: 1rem; border-top: 1px solid var(--frost); padding-top: 1rem; }
    .btn-action { background: var(--mist); color: var(--navy); padding: 0.5rem 1rem; border-radius: 8px; font-weight: 700; font-size: 0.8rem; text-decoration: none; transition: 0.2s; display: inline-flex; align-items: center; gap: 0.5rem; }
    .btn-action:hover { background: var(--blue); color: #fff; }
  
    /* --- MOBILE FIXES (AUTO-INJECTED) --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy, #0a1e32); color: var(--gold, #ffc857); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: 0 8px 20px -6px rgba(10,30,50,0.12); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue, #1e4d7b); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .btn-back { display: inline-flex; }
      .layout, .finance-layout, .attendance-grid, .tile-grid, .course-grid, .stats-grid, .semester-grid, .weekly-grid, .data-table { 
        grid-template-columns: 1fr !important; 
        gap: 1rem !important; 
      }
      .table-container, .table-wrapper { display: block; overflow-x: auto; white-space: nowrap; }
    }

  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>


  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link active"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> Course Management <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link"><i class="fas fa-user-check main-icon"></i> Attendance Management</a></li>
          <li class="menu-item"><a href="/sis/faculty/grades" class="menu-link"><i class="fas fa-pen main-icon"></i> Grade Entry</a></li>
        </ul>
      </li>
      
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    
    <div class="top-bar">
      <div class="greeting">
       <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %> 👋</h1>
        <p>Here is an overview of your teaching schedule.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-chalkboard-teacher"></i>
        Faculty Member
      </div>
    </div>

    <!-- STATS ROW -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-book"></i></div>
        <div class="stat-info">
          <h3>My Courses</h3>
          <p><%= courses.length %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #dcfce7; color: #16a34a;"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <h3>Total Students</h3>
          <p><%= courses.reduce((sum, c) => sum + Number(c.student_count), 0) %></p>
        </div>
      </div>
    </div>

    <!-- COURSE LIST -->
    <div class="section-title"><i class="fas fa-chalkboard-teacher"></i> My Teaching Schedule</div>
    <div class="course-grid">
      <% if (courses.length === 0) { %>
        <div style="background:#fff; padding: 2rem; border-radius: 1.25rem; color:#64748b; grid-column: 1 / -1;">You are not assigned to teach any courses yet.</div>
      <% } %>
      
      <% courses.forEach(course => { %>
        <div class="course-card">
          <div class="course-code"><%= course.code %> · <%= course.group_name %></div>
          <div class="course-title"><%= course.title %></div>
          <div class="course-meta">
            <span><i class="fas fa-calendar-alt"></i> <%= course.day_of_week || 'TBA' %></span>
            <span><i class="fas fa-clock"></i> <%= course.start_time || 'TBA' %></span>
            <span><i class="fas fa-users"></i> <%= course.student_count %> Students Enrolled</span>
          </div>
          <div class="course-actions">
            <a href="/sis/faculty/attendance/<%= course.section_id %>" class="btn-action"><i class="fas fa-user-check"></i> Take Attendance</a>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

  
  <script>
    // 1. Toggle menu function
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
        // Save the state to browser memory
        const text = element.innerText.trim().split('\n')[0]; 
        if (parent.classList.contains('open')) {
          localStorage.setItem('menu_' + text, 'open');
        } else {
          localStorage.removeItem('menu_' + text);
        }
      }
    }

    // 2. Mobile toggle function
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    // 3. Restore open menus on page load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.menu-link').forEach(link => {
        if (link.nextElementSibling && link.nextElementSibling.classList.contains('submenu')) {
          const text = link.innerText.trim().split('\n')[0];
          if (localStorage.getItem('menu_' + text) === 'open') {
            link.parentElement.classList.add('open');
            link.nextElementSibling.classList.add('open');
          }
        }
      });
    });
  </script>

</body>
</html>