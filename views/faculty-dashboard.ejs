<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Faculty Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 1000; transition: transform 0.3s ease; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; }
    
    /* Sidebar Menu */
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.6rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    
    /* Nested Menus */
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .submenu .submenu .menu-link { padding-left: 3.5rem; font-size: 0.7rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 0.8rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Stats Grid */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-bottom: 2.5rem; }
    .stat-card { background: #fff; padding: 1.2rem; border-radius: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1rem; }
    .stat-icon { width: 45px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
    .stat-icon.classes { background: #e0f2fe; color: #0284c7; }
    .stat-icon.students { background: #dcfce7; color: #16a34a; }
    .stat-icon.grades { background: #fef3c7; color: #d97706; }
    .stat-icon.advising { background: #f3e8ff; color: #9333ea; }
    .stat-info h3 { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .stat-info p { font-size: 1.3rem; font-weight: 800; color: var(--navy); margin-top: 0.1rem; }

    /* Quick Actions */
    .section-title { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .section-title i { color: var(--amber); }
    .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.2rem; }
    .tile { background: #fff; padding: 1.5rem 1rem; border-radius: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); text-decoration: none; color: var(--navy); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: 0.2s; min-height: 140px; }
    .tile:hover { transform: translateY(-4px); border-color: var(--amber); box-shadow: 0 12px 25px -8px rgba(10, 30, 50, 0.15); }
    .tile i { font-size: 2rem; color: var(--blue); margin-bottom: 0.8rem; transition: 0.2s; }
    .tile:hover i { color: var(--amber); transform: scale(1.1); }
    .tile span { font-size: 0.85rem; font-weight: 700; line-height: 1.3; }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow-soft); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .stats-grid { grid-template-columns: 1fr; gap: 1rem; }
      .tile-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .top-bar { flex-direction: column; align-items: flex-start; }
      .user-pill { width: 100%; justify-content: center; }
    }
    @media (max-width: 480px) {
      .tile-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <!-- MASSIVE FACULTY SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>

    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link active"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <!-- 1. MY COURSES -->
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> My Courses <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-list main-icon"></i> Course List</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-users main-icon"></i> Class Roster</a></li>
          
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-folder main-icon"></i> Content & Materials <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="#" class="menu-link">Upload Syllabus</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Lecture Notes/Slides</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Add Moodle Links</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Course Weights</a></li>
            </ul>
          </li>

          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-check-square main-icon"></i> Attendance <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link">Take Attendance</a></li>
              <li class="menu-item"><a href="/sis/faculty/attendance" class="menu-link">Generate QR Code</a></li>
              <li class="menu-item"><a href="#" class="menu-link">History & Reports</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Low Attendance (<70%)</a></li>
            </ul>
          </li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-poll main-icon"></i> Course Evaluation</a></li>
        </ul>
      </li>

      <!-- 2. GRADING & EXAMS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-pen main-icon"></i> Grading & Exams <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/grades" class="menu-link"><i class="fas fa-marker main-icon"></i> Gradebook Entry</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-chart-pie main-icon"></i> Grade Distribution</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-export main-icon"></i> Export Grades</a></li>
          
          <li class="menu-item">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-file-signature main-icon"></i> Exam Management <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu">
              <li class="menu-item"><a href="#" class="menu-link">Exam Schedule</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Proctoring Schedule</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Exam Objections</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Makeup Exams</a></li>
              <li class="menu-item"><a href="#" class="menu-link">Publish Results</a></li>
            </ul>
          </li>
        </ul>
      </li>

      <!-- 3. ADVISING -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-user-friends main-icon"></i> Advising <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/advisor/approvals" class="menu-link"><i class="fas fa-check-circle main-icon"></i> Registration Approvals</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-users main-icon"></i> My Advisees</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-clipboard-list main-icon"></i> Advising Notes</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-chart-line main-icon"></i> Academic Progress</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-calendar-check main-icon"></i> Appointments</a></li>
        </ul>
      </li>

      <!-- 4. STUDENT REQUESTS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-envelope-open-text main-icon"></i> Student Requests <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-file-alt main-icon"></i> Document Requests</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Course Withdrawals</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-plus-circle main-icon"></i> Additional Courses</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-undo main-icon"></i> Makeup Exams</a></li>
        </ul>
      </li>

      <!-- 5. RESEARCH & PROJECTS -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-flask main-icon"></i> Research & Projects <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-microscope main-icon"></i> My Projects</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-user-graduate main-icon"></i> Thesis Supervision</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-book main-icon"></i> Publications</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-clipboard-check main-icon"></i> Project Requests</a></li>
        </ul>
      </li>

      <!-- 6. COMMUNICATION -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-comments main-icon"></i> Communication <i class="fas fa-chevron-right arrow"></i>
<li class="menu-item"><a href="/sis/faculty/exam-objections" class="menu-link"><i class="fas fa-exclamation-circle main-icon"></i> Exam Objections</a></li>
        </a>
        <ul class="submenu">
                    <li class="menu-item"><a href="/sis/faculty/announcements" class="menu-link"><i class="fas fa-bullhorn main-icon"></i> Announcements</a></li>
                   <li class="menu-item"><a href="/sis/faculty/messages" class="menu-link"><i class="fas fa-envelope main-icon"></i> Messaging</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-comments main-icon"></i> Discussion Forums</a></li>
        </ul>
      </li>

      <!-- 7. FACULTY SERVICES -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-building main-icon"></i> Faculty Services <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-door-open main-icon"></i> Room Reservation</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-plane-departure main-icon"></i> Leave Request</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-headset main-icon"></i> IT Support</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-book-reader main-icon"></i> Library/Journals</a></li>
        </ul>
      </li>

      <!-- 8. SYSTEM -->
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-cog main-icon"></i> System <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-user-cog main-icon"></i> My Profile</a></li>
          <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-key main-icon"></i> Change Password</a></li>
          <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <div class="greeting">
        <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %> 👋</h1>
        <p>Here is an overview of your teaching and advising tasks.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-chalkboard-teacher"></i>
        Faculty Member
      </div>
    </div>

    <!-- STATS ROW -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon classes"><i class="fas fa-book"></i></div>
        <div class="stat-info">
          <h3>My Courses</h3>
          <p><%= courses.length %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon students"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <h3>Total Students</h3>
          <p><%= courses.reduce((sum, c) => sum + Number(c.student_count), 0) %></p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon grades"><i class="fas fa-pen"></i></div>
        <div class="stat-info">
          <h3>Pending Gradings</h3>
          <p>0</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon advising"><i class="fas fa-user-friends"></i></div>
        <div class="stat-info">
          <h3>Advising Queue</h3>
          <p>0</p>
        </div>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="section-title"><i class="fas fa-th-large"></i> Quick Actions</div>
    
    <div class="tile-grid">
      <a href="/sis/faculty/attendance" class="tile">
        <i class="fas fa-user-check"></i>
        <span>Take Attendance</span>
      </a>

      <a href="/sis/faculty/grades" class="tile">
        <i class="fas fa-pen"></i>
        <span>Grade Entry</span>
      </a>

      <a href="/sis/advisor/approvals" class="tile">
        <i class="fas fa-check-circle"></i>
        <span>Approve Registrations</span>
      </a>

      <a href="#" class="tile">
        <i class="fas fa-file-upload"></i>
        <span>Upload Materials</span>
      </a>
    </div>

    <!-- MY TEACHING SCHEDULE (Optional visual) -->
    <div class="section-title" style="margin-top: 2.5rem;"><i class="fas fa-chalkboard-teacher"></i> My Teaching Schedule</div>
    <div class="tile-grid">
      <% if (courses.length === 0) { %>
        <div style="background:#fff; padding: 2rem; border-radius: 1rem; color:#64748b; grid-column: 1 / -1;">You are not assigned to teach any courses yet.</div>
      <% } %>
      
      <% courses.forEach(course => { %>
        <div class="tile" style="align-items: flex-start; text-align: left; cursor: default;">
          <div style="font-size: 0.8rem; font-weight: 800; color: var(--blue); text-transform: uppercase; margin-bottom: 0.5rem;"><%= course.code %> · <%= course.group_name %></div>
          <div style="font-size: 1rem; font-weight: 800; margin-bottom: 0.8rem; color: var(--navy);"><%= course.title %></div>
          <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
            <div style="margin-bottom: 0.3rem;"><i class="fas fa-calendar-alt" style="color: var(--amber); width: 15px;"></i> <%= course.day_of_week || 'TBA' %></div>
            <div style="margin-bottom: 0.3rem;"><i class="fas fa-clock" style="color: var(--amber); width: 15px;"></i> <%= course.start_time || 'TBA' %></div>
            <div><i class="fas fa-users" style="color: var(--amber); width: 15px;"></i> <%= course.student_count %> Students</div>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
      }
    }

    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }
  </script>
</body>
</html>