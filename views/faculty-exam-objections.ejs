<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Exam Objections</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --danger: #b33e2e; --success: #1f8a5f; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.7rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.9rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .obj-card { background: #fff; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); padding: 1.5rem; margin-bottom: 1.5rem; border-left: 5px solid var(--amber); }
    .obj-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem; }
    .obj-header h3 { font-size: 1.1rem; font-weight: 800; color: var(--navy); }
    .obj-header p { font-size: 0.8rem; color: #64748b; font-weight: 600; margin-top: 0.2rem; }
    
    .student-info { background: var(--ice); padding: 0.8rem 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid var(--frost); }
    .student-info strong { font-weight: 800; color: var(--navy); }
    .student-info span { font-size: 0.85rem; color: var(--blue); }
    
    .reason-box { background: #fef3c7; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem; color: #78350f; line-height: 1.5; border: 1px solid #fde68a; }
    
    .current-grade { background: #e0f2fe; padding: 0.8rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.85rem; color: var(--blue); }
    
    .action-box { border-top: 1px dashed var(--frost); padding-top: 1rem; }
    .action-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 1rem; }
    .form-group { display: flex; flex-direction: column; }
    .form-group label { font-size: 0.75rem; font-weight: 800; margin-bottom: 0.3rem; }
    .form-control { padding: 0.7rem; border: 1px solid var(--frost); border-radius: 6px; font-family: inherit; font-size: 0.85rem; }
    .btn-action { padding: 0.7rem 1.2rem; border-radius: 6px; font-size: 0.8rem; font-weight: 800; cursor: pointer; border: none; transition: 0.2s; }
    .btn-resolve { background: var(--success); color: #fff; }
    .btn-resolve:hover { background: #166a48; }
    .btn-dismiss { background: var(--danger); color: #fff; }
    .btn-dismiss:hover { background: #922e20; }

    .alert { padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; }
    .alert-success { background: #dcfce7; color: #16a34a; }
    .alert-error { background: #fee2e2; color: #dc2626; }

    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .action-form { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li><a href="/sis/faculty/exam-objections" class="menu-link active"><i class="fas fa-exclamation-circle main-icon"></i> Exam Objections</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Exam Objections</h1>
      <p>Review and resolve grade disputes from your students.</p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %><div class="alert alert-success"><%= flash.success[0] %></div><% } %>
    <% if (flash.error && flash.error.length > 0) { %><div class="alert alert-error"><%= flash.error[0] %></div><% } %>

    <% if (objections.length === 0) { %>
      <div style="background:#fff; padding: 3rem; border-radius: 1rem; text-align: center; color: #64748b;">
        <i class="fas fa-check-circle" style="font-size: 3rem; color: var(--frost); margin-bottom: 1rem;"></i>
        <h3>No pending objections</h3>
      </div>
    <% } %>

    <% objections.forEach(o => { %>
      <div class="obj-card">
        <div class="obj-header">
          <div>
            <h3><%= o.code %> - <%= o.title %></h3>
            <p>Submitted on <%= new Date(o.requested_at).toLocaleDateString() %></p>
          </div>
        </div>

        <div class="student-info">
          <strong><i class="fas fa-user"></i> <%= o.student_name %></strong> · <span><%= o.username %></span>
        </div>

        <div class="reason-box">
          <strong><i class="fas fa-comment"></i> Student's Reason:</strong><br>
          <%= o.reason %>
        </div>

        <div class="current-grade">
          <strong>Current Grade:</strong> Midterm = <%= o.midterm_grade || 0 %>, Final = <%= o.final_grade || 0 %>, Letter = <strong><%= o.letter_grade %></strong>
        </div>

        <div class="action-box">
          <form method="POST" action="/sis/faculty/exam-objections/<%= o.id %>/resolve" class="action-form">
            <div class="form-group">
              <label>New Midterm</label>
              <input type="number" name="new_midterm_grade" class="form-control" value="<%= o.midterm_grade || 0 %>" min="0" max="100">
            </div>
            <div class="form-group">
              <label>New Final</label>
              <input type="number" name="new_final_grade" class="form-control" value="<%= o.final_grade || 0 %>" min="0" max="100">
            </div>
            <div class="form-group">
              <label>Response to Student</label>
              <input type="text" name="teacher_response" class="form-control" placeholder="Explain your decision...">
            </div>
            <button type="submit" name="action" value="resolve" class="btn-action btn-resolve"><i class="fas fa-check"></i> Correct Grade</button>
            <button type="submit" name="action" value="dismiss" class="btn-action btn-dismiss" onclick="return confirm('Dismiss this objection?');"><i class="fas fa-times"></i> Dismiss</button>
          </form>
        </div>
      </div>
    <% }) %>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>
</body>
</html>