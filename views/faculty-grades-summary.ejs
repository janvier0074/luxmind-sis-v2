<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Grade Distribution</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }

    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.6rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    /* Distribution Grid */
    .dist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 1rem; max-width: 800px; }
    .dist-card { background: #fff; border-radius: 1rem; padding: 1.5rem 1rem; text-align: center; box-shadow: var(--shadow); border: 1px solid var(--frost); border-top: 4px solid transparent; }
    .dist-card.grade-A { border-top-color: #16a34a; }
    .dist-card.grade-B { border-top-color: #0284c7; }
    .dist-card.grade-C { border-top-color: #d97706; }
    .dist-card.grade-D { border-top-color: #ea580c; }
    .dist-card.grade-F { border-top-color: #dc2626; }
    
    .dist-grade { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.3rem; }
    .dist-count { font-size: 0.85rem; color: #64748b; font-weight: 600; }

    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link active"><i class="fas fa-book-open main-icon"></i> My Courses</a></li>
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty/courses" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Courses</a>
    <div class="top-bar">
      <h1>Grade Distribution</h1>
      <p><strong><%= section.code %> - <%= section.title %></strong> (<%= section.group_name %>)</p>
    </div>

    <div class="dist-grid">
      <% Object.keys(distribution).forEach(grade => { 
           const baseLetter = grade.charAt(0);
      %>
        <div class="dist-card grade-<%= baseLetter %>">
          <div class="dist-grade" style="color: <%= baseLetter === 'A' ? '#16a34a' : baseLetter === 'B' ? '#0284c7' : baseLetter === 'C' ? '#d97706' : baseLetter === 'D' ? '#ea580c' : '#dc2626' %>;"><%= grade %></div>
          <div class="dist-count"><%= distribution[grade] %> Students</div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>