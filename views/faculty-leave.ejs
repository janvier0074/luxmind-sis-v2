<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leave Request — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --amber: #f5a623; --frost: #d9e6f2; --ice: #f7fafd; --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); color: var(--navy); padding: 2rem; }
    .container { max-width: 900px; margin: 0 auto; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--navy); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }
    .header { background: var(--navy); color: #fff; padding: 2rem; border-radius: 1.5rem; margin-bottom: 2rem; }
    .header h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .header p { color: #94a3b8; font-weight: 600; }
    .card { background: #fff; padding: 2rem; border-radius: 1rem; border: 1px solid var(--frost); margin-bottom: 2rem; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group.full { grid-column: 1 / -1; }
    label { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: #64748b; }
    input, select, textarea { width: 100%; padding: 0.8rem; border: 2px solid var(--frost); border-radius: 8px; font-family: inherit; font-weight: 600; outline: none; }
    input:focus, select:focus, textarea:focus { border-color: var(--amber); }
    button { background: var(--navy); color: #fff; padding: 0.8rem 2rem; border-radius: 8px; border: none; font-weight: 800; cursor: pointer; }
    .table-list { display: flex; flex-direction: column; gap: 1rem; }
    .request-card { background: #fff; padding: 1.5rem; border-radius: 1rem; border: 1px solid var(--frost); display: flex; justify-content: space-between; align-items: center; }
    .request-info h4 { font-weight: 800; margin-bottom: 0.3rem; }
    .request-info p { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .badge { padding: 0.3rem 0.8rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
    .badge.pending { background: #fef3c7; color: #b45309; }
    .badge.approved { background: #dcfce7; color: #15803d; }
    .badge.rejected { background: #fee2e2; color: #991b1b; }
    @media(max-width: 768px) { .form-grid { grid-template-columns: 1fr; } .request-card { flex-direction: column; align-items: flex-start; gap: 1rem; } }
  </style>
</head>
<body>
  <div class="container">
    <a href="/sis/faculty" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    <div class="header">
      <h1><i class="fas fa-plane-departure"></i> Leave Requests</h1>
      <p>Submit a new leave request or view your past applications.</p>
    </div>
    <div class="card">
      <h2 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1.5rem;">Submit New Request</h2>
      <form action="/sis/faculty/leave/request" method="POST">
        <div class="form-grid">
          <div class="form-group">
            <label>Leave Type</label>
            <select name="leave_type" required>
              <option value="Sick Leave">Sick Leave</option>
              <option value="Annual Leave">Annual Leave</option>
              <option value="Maternity/Paternity">Maternity/Paternity</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Reason</label>
            <input type="text" name="reason" required placeholder="Brief reason...">
          </div>
          <div class="form-group">
            <label>Start Date</label>
            <input type="date" name="start_date" required>
          </div>
          <div class="form-group">
            <label>End Date</label>
            <input type="date" name="end_date" required>
          </div>
        </div>
        <button type="submit"><i class="fas fa-paper-plane"></i> Submit Request</button>
      </form>
    </div>
    <h2 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem;">My History</h2>
    <div class="table-list">
      <% if (requests.length === 0) { %>
        <p style="text-align: center; color: #94a3b8; font-weight: 600;">No leave requests found.</p>
      <% } %>
      <% requests.forEach(r => { %>
        <div class="request-card">
          <div class="request-info">
            <h4><%= r.leave_type %></h4>
            <p><%= new Date(r.start_date).toLocaleDateString() %> to <%= new Date(r.end_date).toLocaleDateString() %></p>
            <p>Reason: <%= r.reason %></p>
          </div>
          <span class="badge <%= r.status.toLowerCase() %>"><%= r.status %></span>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>