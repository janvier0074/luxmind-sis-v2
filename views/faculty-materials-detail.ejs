<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= section.code %> Materials — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* Sidebar (Standard) */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.15), transparent); border-left-color: var(--gold); }
    .menu-link i { width: 24px; color: var(--gold); }
    .submenu { list-style: none; background: rgba(0,0,0,0.15); padding: 0.5rem 0; }
    .submenu .menu-link { padding-left: 3rem; font-size: 0.8rem; }

    /* Main Content */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); max-width: 1400px; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.85rem; transition: var(--transition); }
    .btn-back:hover { color: var(--amber); transform: translateX(-3px); }

    /* Hero Header */
    .hero-header { background: linear-gradient(135deg, var(--navy), var(--deep)); border-radius: 1.5rem; padding: 2.5rem; color: #fff; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 20px 40px -10px rgba(10,30,50,0.4); position: relative; overflow: hidden; }
    .hero-header::before { content: '📚'; position: absolute; right: -20px; bottom: -40px; font-size: 15rem; opacity: 0.05; pointer-events: none; transform: rotate(-15deg); }
    .hero-title h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.3rem; }
    .hero-subtitle { font-size: 0.95rem; color: #cbd5e1; font-weight: 600; display: flex; gap: 1.5rem; align-items: center; }
    .hero-subtitle span { display: flex; align-items: center; gap: 0.4rem; }
    
    /* Layout Grid */
    .materials-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }

    /* Cards */
    .premium-card { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; margin-bottom: 2rem; }
    .card-header { padding: 1.5rem; background: #f8fafc; border-bottom: 1px solid var(--frost); display: flex; align-items: center; gap: 0.8rem; }
    .card-header i { font-size: 1.3rem; color: var(--amber); }
    .card-header h2 { font-size: 1.15rem; font-weight: 800; color: var(--navy); }
    .card-body { padding: 1.5rem; }

    /* Flash Messages */
    .alert { padding: 1rem 1.2rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.6rem; }
    .alert.success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
    .alert.error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    /* Drag & Drop Zone */
    .dropzone { border: 2px dashed var(--frost); border-radius: 1rem; padding: 2.5rem 1rem; text-align: center; cursor: pointer; transition: var(--transition); position: relative; background: #fbfdff; display: block; }
    .dropzone:hover { border-color: var(--amber); background: #fff; box-shadow: 0 0 20px rgba(245,166,35,0.1); }
    .dropzone input[type="file"] { display: none; }
    .dropzone-icon { font-size: 2.5rem; color: var(--amber); margin-bottom: 1rem; display: block; animation: float 3s ease-in-out infinite; }
    @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-8px); } 100% { transform: translateY(0px); } }
    .dropzone-text { font-size: 0.9rem; font-weight: 700; color: var(--navy); }
    .dropzone-sub { font-size: 0.75rem; color: #94a3b8; margin-top: 0.3rem; }

    /* Forms & Inputs */
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 0.4rem; }
    .form-control { width: 100%; padding: 0.85rem 1rem; border: 2px solid var(--frost); border-radius: 10px; font-family: inherit; font-size: 0.9rem; font-weight: 600; color: var(--navy); transition: var(--transition); background: #f8fafc; outline: none; }
    .form-control:focus { border-color: var(--amber); background: #fff; box-shadow: 0 0 0 4px rgba(245,166,35,0.12); }
    
    .btn-submit { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.9rem 1.5rem; background: linear-gradient(135deg, var(--amber), var(--gold)); color: var(--navy); font-family: inherit; font-size: 0.85rem; font-weight: 800; border: none; border-radius: 10px; cursor: pointer; transition: var(--transition); width: 100%; box-shadow: 0 4px 12px -4px rgba(245,166,35,0.4); }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 16px -6px rgba(245,166,35,0.5); }

    /* History List */
    .history-list { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.5rem; }
    .history-item { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1rem; background: #f8fafc; border-radius: 10px; border: 1px solid #eef2f7; transition: var(--transition); }
    .history-item:hover { border-color: var(--amber); }
    .history-item.active { background: #fef3c7; border-color: var(--amber); }
    .history-info { display: flex; align-items: center; gap: 0.8rem; }
    .history-info i { font-size: 1.2rem; color: var(--danger); }
    .history-info i.current { color: var(--success); }
    .history-title { font-size: 0.85rem; font-weight: 800; color: var(--navy); }
    .history-date { font-size: 0.7rem; color: #64748b; font-weight: 600; }
    .badge-version { padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.7rem; font-weight: 800; background: var(--navy); color: var(--gold); }

    /* Timeline (Lecture Notes) */
    .timeline { position: relative; padding-left: 2rem; margin-top: 1rem; }
    .timeline::before { content: ''; position: absolute; left: 0.75rem; top: 0; bottom: 0; width: 2px; background: var(--frost); }
    .timeline-item { position: relative; margin-bottom: 1.5rem; }
    .timeline-dot { position: absolute; left: -1.65rem; top: 0.2rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #fff; border: 3px solid var(--amber); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 800; color: var(--navy); z-index: 1; }
    .timeline-content { background: #f8fafc; padding: 1rem; border-radius: 12px; border: 1px solid var(--frost); transition: var(--transition); }
    .timeline-content:hover { border-color: var(--amber); box-shadow: 0 4px 12px rgba(245,166,35,0.05); }
    
    .week-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
    .week-title { font-size: 0.9rem; font-weight: 800; color: var(--navy); }
    
    .file-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .file-item { display: flex; align-items: center; gap: 0.8rem; padding: 0.5rem; background: #fff; border-radius: 8px; border: 1px solid #eef2f7; font-size: 0.8rem; font-weight: 600; transition: var(--transition); }
    .file-item:hover { border-color: var(--amber); box-shadow: 0 2px 8px rgba(245,166,35,0.1); }
    .file-icon { color: var(--blue); font-size: 1rem; }

    /* Moodle Card */
    .moodle-card { text-align: center; padding: 2rem; background: linear-gradient(135deg, #fff, #f8fafc); }
    .moodle-icon { font-size: 3rem; color: #f98012; margin-bottom: 1rem; }
    .moodle-card h3 { font-size: 1.1rem; font-weight: 800; margin-bottom: 0.5rem; }
    .moodle-card p { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; }

    @media (max-width: 1024px) { .materials-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-mark">L</div><div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div></div>
    <ul class="sidebar-menu">
      <li><a href="/sis/faculty" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li>
        <a href="#" class="menu-link active"><i class="fas fa-book-open"></i> My Courses</a>
        <ul class="submenu">
          <li><a href="/sis/faculty/course-materials" class="menu-link active"><i class="fas fa-folder"></i> Content & Materials</a></li>
        </ul>
      </li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty/course-materials" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Materials Hub</a>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="alert success">✅ <%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="alert error">⚠️ <%= flash.error[0] %></div>
    <% } %>

    <div class="hero-header">
      <div class="hero-title">
        <h1><%= section.code %> — <%= section.title %></h1>
        <div class="hero-subtitle">
          <span><i class="fas fa-users"></i> <%= section.student_count %> Students</span>
          <span><i class="fas fa-medal"></i> <%= section.credits %> Credits</span>
          <span><i class="fas fa-layer-group"></i> Group <%= section.group_name %></span>
        </div>
      </div>
    </div>

    <div class="materials-grid">
      
      <!-- LEFT COLUMN: SYLLABUS & MOODLE -->
      <div>
        <!-- Syllabus Card -->
        <div class="premium-card">
          <div class="card-header">
            <i class="fas fa-file-pdf"></i>
            <h2>Course Syllabus</h2>
          </div>
          <div class="card-body">
            <form action="/sis/faculty/course-materials/<%= section.id %>/syllabus" method="POST" enctype="multipart/form-data">
              <label class="dropzone">
                <input type="file" name="syllabus" accept=".pdf,.doc,.docx" required onchange="this.form.submit()">
                <i class="fas fa-cloud-upload-alt dropzone-icon"></i>
                <div class="dropzone-text">Click or Drag to upload new Syllabus</div>
                <div class="dropzone-sub">PDF or Word (Max 5MB) • Uploading creates a new version</div>
              </label>
            </form>

            <div class="history-list">
              <% if (syllabus.length === 0) { %>
                <div style="text-align:center; padding: 1rem; color: #94a3b8; font-size: 0.85rem;">No syllabus uploaded yet.</div>
              <% } %>
              <% syllabus.forEach(syl => { %>
                <div class="history-item <%= syl.is_current ? 'active' : '' %>">
                  <div class="history-info">
                    <i class="fas fa-file-pdf <%= syl.is_current ? 'current' : '' %>"></i>
                    <div>
                      <a href="<%= syl.file_url %>" target="_blank" style="text-decoration: none; color: inherit;">
                        <div class="history-title"><%= syl.file_name %> <i class="fas fa-download" style="font-size: 0.7rem; color: var(--blue);"></i></div>
                      </a>
                      <div class="history-date"><%= new Date(syl.uploaded_at).toLocaleDateString() %></div>
                    </div>
                  </div>
                  <span class="badge-version">v<%= syl.version_number %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Moodle Link Card -->
        <div class="premium-card">
          <div class="card-header">
            <i class="fab fa-moodle"></i>
            <h2>Moodle Integration</h2>
          </div>
          <div class="card-body moodle-card">
            <i class="fab fa-moodle moodle-icon"></i>
            <h3>Connect to Moodle</h3>
            <p>Link this section to its Moodle page. Students will see a "Go to Moodle" button in their portal.</p>
            <form action="/sis/faculty/course-materials/<%= section.id %>/moodle" method="POST">
              <div class="form-group" style="text-align: left;">
                <input type="url" name="moodle_url" class="form-control" placeholder="https://moodle.university.edu/course/view.php?id=123" value="<%= section.moodle_url || '' %>" required>
              </div>
              <button type="submit" class="btn-submit">💾 Save Moodle Link</button>
            </form>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: LECTURE NOTES -->
      <div class="premium-card">
        <div class="card-header">
          <i class="fas fa-chalkboard"></i>
          <h2>Lecture Notes & Materials</h2>
        </div>
        <div class="card-body">
          
          <!-- Upload Form -->
          <form action="/sis/faculty/course-materials/<%= section.id %>/notes" method="POST" enctype="multipart/form-data" style="background: #f8fafc; padding: 1.2rem; border-radius: 1rem; border: 1px solid var(--frost); margin-bottom: 1.5rem;">
            <div class="form-group">
              <label>Week Number</label>
              <select name="week_number" class="form-control" required>
                <% for(let i=1; i<=14; i++) { %>
                  <option value="<%= i %>">Week <%= i %></option>
                <% } %>
              </select>
            </div>
            <div class="form-group">
              <label>Material Title</label>
              <input type="text" name="title" class="form-control" placeholder="e.g., Introduction to Algorithms" required>
            </div>
            <div class="form-group">
              <label class="dropzone" style="padding: 1.5rem;">
                <input type="file" name="material" required onchange="this.form.submit()">
                <i class="fas fa-file-upload dropzone-icon" style="font-size: 1.8rem; margin-bottom: 0.5rem;"></i>
                <div class="dropzone-text" style="font-size: 0.8rem;">Select file to upload</div>
              </label>
            </div>
            <button type="submit" class="btn-submit" style="padding: 0.7rem;">⬆️ Upload Material</button>
          </form>

          <!-- Timeline -->
          <div class="timeline">
            <% for(let i=1; i<=14; i++) { %>
              <% if (notesByWeek[i] && notesByWeek[i].length > 0) { %>
                <div class="timeline-item">
                  <div class="timeline-dot"><%= i %></div>
                  <div class="timeline-content">
                    <div class="week-header">
                      <div class="week-title">Week <%= i %> Materials</div>
                      <span style="font-size: 0.75rem; font-weight: 800; color: var(--amber);"><%= notesByWeek[i].length %> file(s)</span>
                    </div>
                    <div class="file-list">
                      <% notesByWeek[i].forEach(note => { %>
                        <div class="file-item">
                          <i class="fas fa-file-pdf file-icon"></i>
                          <div>
                            <a href="<%= note.file_url %>" target="_blank" style="text-decoration: none; color: inherit;">
                              <div style="font-weight: 800;"><%= note.title %> <i class="fas fa-download" style="font-size: 0.7rem; color: var(--blue);"></i></div>
                            </a>
                            <div style="font-size: 0.7rem; color: #64748b;"><%= note.file_name %></div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
          
        </div>
      </div>
      
    </div>
  </main>
</body>
</html>