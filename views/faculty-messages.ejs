<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Messages</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    /* Sidebar */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.6rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; }

    /* Main Content */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    /* Messaging Layout (Split) */
    .msg-layout { display: flex; gap: 2rem; align-items: flex-start; }
    .msg-form { background: #fff; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); padding: 1.5rem; width: 350px; flex-shrink: 0; }
    .msg-form h3 { font-size: 1rem; font-weight: 800; margin-bottom: 1rem; color: var(--navy); }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.75rem; font-weight: 800; margin-bottom: 0.3rem; }
    .form-control { width: 100%; padding: 0.8rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); font-size: 0.85rem; }
    textarea.form-control { resize: vertical; min-height: 100px; }
    .btn-send { background: var(--navy); color: #fff; padding: 0.8rem; border-radius: 8px; border: none; font-weight: 800; font-size: 0.85rem; cursor: pointer; width: 100%; transition: 0.2s; }
    .btn-send:hover { background: var(--blue); }

    /* Inbox List */
    .msg-inbox { flex: 1; background: #fff; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; }
    .inbox-header { background: var(--navy); color: #fff; padding: 1rem 1.5rem; font-weight: 800; font-size: 0.9rem; }
    .inbox-item { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--frost); display: flex; flex-direction: column; gap: 0.4rem; }
    .inbox-item:last-child { border-bottom: none; }
    .inbox-meta { display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 800; color: var(--blue); }
    .inbox-subject { font-size: 0.9rem; font-weight: 700; color: var(--navy); }
    .inbox-body { font-size: 0.85rem; color: #475569; line-height: 1.5; }

    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .msg-layout { flex-direction: column; }
      .msg-form { width: 100%; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-book-open main-icon"></i> My Courses</a></li>
      <li><a href="/sis/faculty/messages" class="menu-link active"><i class="fas fa-envelope main-icon"></i> Messaging</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Messaging</h1>
      <p>Send messages to students enrolled in your courses.</p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <div class="msg-layout">
      <!-- Compose Message Form -->
      <div class="msg-form">
        <h3><i class="fas fa-paper-plane" style="color: var(--amber);"></i> New Message</h3>
        <form method="POST" action="/sis/faculty/messages/send">
          <div class="form-group">
            <label>Select Student</label>
            <select name="receiver_id" class="form-control" required>
              <option value="" disabled selected>-- Choose student --</option>
              <% students.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.full_name %> (<%= s.code %> - <%= s.group_name %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="e.g. Missing Assignment" required>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea name="body" class="form-control" placeholder="Type your message here..." required></textarea>
          </div>
          <button type="submit" class="btn-send">Send Message</button>
        </form>
      </div>

      <!-- Inbox -->
      <div class="msg-inbox">
        <div class="inbox-header">Inbox (Replies from Students)</div>
        <% if (inbox.length === 0) { %>
          <div class="inbox-item" style="text-align: center; color: #64748b;">No messages yet.</div>
        <% } %>
        <% inbox.forEach(msg => { %>
          <div class="inbox-item">
            <div class="inbox-meta">
              <span><i class="fas fa-user"></i> <%= msg.sender_name %></span>
              <span><%= new Date(msg.created_at).toLocaleDateString() %></span>
            </div>
            <div class="inbox-subject"><%= msg.subject %></div>
            <div class="inbox-body"><%= msg.body %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>
</body>
</html>