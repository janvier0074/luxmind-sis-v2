<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    
    /* PREVENTS HORIZONTAL SCROLLING ON MOBILE */
    html, body { overflow-x: hidden; width: 100%; }
    
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background:
        radial-gradient(circle at 100% 0%, rgba(245,166,35,0.06), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(30,77,123,0.05), transparent 40%),
        var(--ice);
      min-height: 100vh; display: flex; color: var(--navy);
      -webkit-font-smoothing: antialiased;
    }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 30px rgba(0,0,0,0.15); z-index: 1000; scrollbar-width: thin; scrollbar-color: #1e3a5f transparent; transition: transform 0.3s ease; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); box-shadow: 0 4px 12px rgba(245,166,35,0.35); }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; margin-top: 2px; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; opacity: 0.85; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s ease; }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.18), transparent); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.18); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }
    .menu-item.open > .menu-link { color: #fff; }

    /* Main Content */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }

    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.85rem; padding: 0.4rem 0.8rem; border-radius: 8px; transition: var(--transition); }
    .btn-back:hover { background: #fff; box-shadow: var(--shadow-soft); color: var(--amber); }

    .page-header { margin-bottom: 2rem; }
    .page-title { display: flex; align-items: center; gap: 1rem; }
    .page-title-icon { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--navy), var(--blue)); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.4rem; box-shadow: 0 8px 24px -8px rgba(10,30,50,0.4); }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .page-title p { color: #64748b; font-weight: 500; font-size: 0.9rem; margin-top: 0.2rem; }

    /* Flash Messages */
    .alert { padding: 0.9rem 1.2rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.6rem; }
    .alert.success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
    .alert.error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    /* Layout */
    .profile-layout { display: grid; grid-template-columns: 320px 1fr; gap: 1.5rem; align-items: start; }

    /* Left Column: Identity Card */
    .identity-card { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; position: sticky; top: 2rem; }
    .identity-banner { height: 100px; background: linear-gradient(135deg, var(--navy), var(--blue)); }
    .identity-body { padding: 0 2rem 2rem; text-align: center; margin-top: -50px; }
    
    .avatar-wrap { position: relative; width: 100px; height: 100px; margin: 0 auto 1rem; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 8px 16px rgba(10,30,50,0.15); background: var(--navy); display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; }
    .avatar-wrap:hover .avatar-overlay { opacity: 1; }
    .avatar-img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-initials { font-size: 2.5rem; font-weight: 800; color: var(--gold); }
    .avatar-overlay { position: absolute; inset: 0; background: rgba(10,30,50,0.6); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem; opacity: 0; transition: var(--transition); }

    .identity-name { font-size: 1.3rem; font-weight: 800; color: var(--navy); margin-bottom: 0.2rem; }
    .identity-role { font-size: 0.75rem; font-weight: 800; color: var(--amber); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; }
    .identity-email { font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 1.5rem; word-break: break-all; }

    .file-upload-btn { display: block; width: 100%; padding: 0.75rem; background: #f8fafc; border: 2px dashed var(--frost); border-radius: 12px; text-align: center; font-size: 0.8rem; font-weight: 700; color: var(--blue); cursor: pointer; transition: var(--transition); }
    .file-upload-btn:hover { border-color: var(--amber); background: #fff; color: var(--amber); }
    .file-upload-input { display: none; }

    /* Right Column: Forms */
    .forms-col { display: flex; flex-direction: column; gap: 1.5rem; }
    
    .form-card { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .form-card-head { padding: 1.3rem 1.5rem; border-bottom: 1px solid #eef2f7; display: flex; align-items: center; gap: 0.8rem; }
    .form-card-head i { font-size: 1.1rem; color: var(--amber); }
    .form-card-head h2 { font-size: 1.1rem; font-weight: 800; color: var(--navy); }
    
    .form-card-body { padding: 1.5rem; }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1.2rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control { width: 100%; padding: 0.85rem 1rem; border: 2px solid var(--frost); border-radius: 10px; font-family: inherit; font-size: 0.9rem; font-weight: 600; color: var(--navy); transition: var(--transition); background: #f8fafc; outline: none; }
    .form-control:focus { border-color: var(--amber); background: #fff; box-shadow: 0 0 0 4px rgba(245,166,35,0.12); }
    .form-control:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }
    textarea.form-control { resize: vertical; min-height: 80px; }

    .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.9rem 1.8rem; background: linear-gradient(135deg, var(--amber), var(--gold)); color: var(--navy); font-family: inherit; font-size: 0.85rem; font-weight: 800; border: none; border-radius: 100px; cursor: pointer; transition: var(--transition); box-shadow: 0 4px 12px -4px rgba(245,166,35,0.4); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 16px -6px rgba(245,166,35,0.5); }

    .btn-danger { background: linear-gradient(135deg, #b33e2e, #8b2d20); color: #fff; box-shadow: 0 4px 12px -4px rgba(179,62,46,0.4); }
    .btn-danger:hover { box-shadow: 0 8px 16px -6px rgba(179,62,46,0.5); }

    /* Mobile Hamburger Menu */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow-soft); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    
    @media (max-width: 1024px) {
      .profile-layout { grid-template-columns: 1fr; }
      .identity-card { position: static; }
    }
    
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      
      /* Forces everything to stack properly on mobile to prevent overlap */
      .main-content { margin-left: 0 !important; width: 100% !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .page-title h1 { font-size: 1.3rem; }
      .page-title-icon { width: 44px; height: 44px; font-size: 1.2rem; }
      .form-grid { grid-template-columns: 1fr !important; gap: 1rem !important; }
    }
  </style>
</head>
<body>

  <!-- HAMBURGER BUTTON & OVERLAY -->
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> <%= lang.dashboard || 'Dashboard' %></a></li>
      <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-book-open main-icon"></i> <%= lang.my_courses || 'My Courses' %></a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-cog main-icon"></i> System <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/profile" class="menu-link active"><i class="fas fa-user-cog main-icon"></i> My Profile</a></li>
          <li class="menu-item"><a href="/sis/faculty/profile#security" class="menu-link"><i class="fas fa-key main-icon"></i> Change Password</a></li>
          <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> <%= lang.logout || 'Logout' %></a></li>
        </ul>
      </li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>

    <div class="page-header">
      <div class="page-title">
        <div class="page-title-icon"><i class="fas fa-user-circle"></i></div>
        <div>
          <h1>My Profile</h1>
          <p>Manage your personal information and account security</p>
        </div>
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="alert success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= flash.error[0] %></div>
    <% } %>

    <div class="profile-layout">
      
      <!-- LEFT COLUMN: IDENTITY -->
      <div class="identity-card">
        <div class="identity-banner"></div>
        <div class="identity-body">
          
          <form action="/sis/faculty/profile" method="POST" enctype="multipart/form-data" id="profilePicForm">
            <label for="profile_picture" class="avatar-wrap">
              <% if (user.profile_picture_url) { %>
                <img src="<%= user.profile_picture_url %>" alt="Profile" class="avatar-img">
              <% } else { %>
                <div class="avatar-initials"><%= user.full_name.charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="avatar-overlay"><i class="fas fa-camera"></i></div>
            </label>
            <input type="file" id="profile_picture" name="profile_picture" class="file-upload-input" accept="image/*" onchange="document.getElementById('profilePicForm').submit();">
            <!-- Hidden inputs to preserve other data when just changing picture -->
            <input type="hidden" name="phone" value="<%= user.phone || '' %>">
            <input type="hidden" name="office_hours" value="<%= user.office_hours || '' %>">
            <input type="hidden" name="bio" value="<%= user.bio || '' %>">
            <input type="hidden" name="cv_url" value="<%= user.cv_url || '' %>">
          </form>

          <div class="identity-name"><%= user.full_name %></div>
          <div class="identity-role"><%= user.role %></div>
          <div class="identity-email"><i class="fas fa-envelope"></i> <%= user.email %></div>
          
          <label for="profile_picture" class="file-upload-btn">
            <i class="fas fa-camera"></i> Change Picture
          </label>
        </div>
      </div>

      <!-- RIGHT COLUMN: FORMS -->
      <div class="forms-col">
        
        <!-- Contact & Info Form -->
        <div class="form-card">
          <div class="form-card-head">
            <i class="fas fa-address-card"></i>
            <h2>Contact & Academic Info</h2>
          </div>
          <div class="form-card-body">
            <form action="/sis/faculty/profile" method="POST" enctype="multipart/form-data">
              <div class="form-grid">
                <div class="form-group">
                  <label>Full Name (Read-only)</label>
                  <input type="text" class="form-control" value="<%= user.full_name %>" disabled>
                </div>
                <div class="form-group">
                  <label>Email (Read-only)</label>
                  <input type="text" class="form-control" value="<%= user.email %>" disabled>
                </div>
                <div class="form-group">
                  <label>Phone Number</label>
                  <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>" placeholder="+90 555 123 4567">
                </div>
                <div class="form-group">
                  <label>Office Hours</label>
                  <input type="text" name="office_hours" class="form-control" value="<%= user.office_hours || '' %>" placeholder="Mon/Wed 14:00 - 16:00">
                </div>
                <div class="form-group full">
                  <label>CV Link (URL)</label>
                  <input type="url" name="cv_url" class="form-control" value="<%= user.cv_url || '' %>" placeholder="https://example.com/my-cv.pdf">
                </div>
                <div class="form-group full">
                  <label>Short Bio</label>
                  <textarea name="bio" class="form-control" placeholder="Tell students a bit about your background..."><%= user.bio || '' %></textarea>
                </div>
              </div>
              <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Profile Info</button>
            </form>
          </div>
        </div>

        <!-- Security / Password Form -->
        <div class="form-card" id="security">
          <div class="form-card-head">
            <i class="fas fa-shield-alt"></i>
            <h2>Change Password</h2>
          </div>
          <div class="form-card-body">
            <form action="/sis/faculty/change-password" method="POST">
              <div class="form-grid">
                <div class="form-group full">
                  <label>Current Password</label>
                  <input type="password" name="current_password" class="form-control" required placeholder="Enter current password">
                </div>
                <div class="form-group">
                  <label>New Password</label>
                  <input type="password" name="new_password" class="form-control" required placeholder="Min. 8 characters">
                </div>
                <div class="form-group">
                  <label>Confirm New Password</label>
                  <input type="password" name="confirm_password" class="form-control" required placeholder="Repeat new password">
                </div>
              </div>
              <button type="submit" class="btn-primary btn-danger"><i class="fas fa-key"></i> Update Password</button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script>
    // Toggle Submenus
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }

    // Toggle Mobile Sidebar (HAMBURGER MENU)
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) { 
        sb.classList.toggle('active'); 
        ov.classList.toggle('active'); 
      }
    }
  </script>
</body>
</html>