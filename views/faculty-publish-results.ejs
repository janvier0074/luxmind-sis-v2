<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Publish Results — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background:
        radial-gradient(circle at 100% 0%, rgba(245,166,35,0.06), transparent 40%),
        radial-gradient(circle at 0% 100%, rgba(30,77,123,0.05), transparent 40%),
        var(--ice);
      min-height: 100vh; display: flex; color: var(--navy);
      -webkit-font-smoothing: antialiased;
    }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 30px rgba(0,0,0,0.15); z-index: 1000; scrollbar-width: thin; scrollbar-color: #1e3a5f transparent; transition: transform 0.3s ease; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); box-shadow: 0 4px 12px rgba(245,166,35,0.35); }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; margin-top: 2px; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; opacity: 0.85; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s ease; }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.18), transparent); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.18); border-left: 2px solid transparent; }
    .submenu.open { display: block; border-left-color: var(--amber); }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }
    .menu-item.open > .menu-link { color: #fff; }

    /* Main */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.85rem; padding: 0.4rem 0.8rem; border-radius: 8px; transition: var(--transition); }
    .btn-back:hover { background: #fff; box-shadow: var(--shadow-soft); color: var(--amber); }

    .page-header { margin-bottom: 2rem; }
    .page-title { display: flex; align-items: center; gap: 1rem; }
    .page-title-icon { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--navy), var(--blue)); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.4rem; box-shadow: 0 8px 24px -8px rgba(10,30,50,0.4); }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .page-title p { color: #64748b; font-weight: 500; font-size: 0.9rem; margin-top: 0.2rem; }

    /* Flash Messages */
    .alert { padding: 0.9rem 1.2rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.6rem; }
    .alert.success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
    .alert.error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    /* CIU Info banner */
    .ciu-banner { background: linear-gradient(135deg, #fef3c7, #fde68a); border: 1px solid #f59e0b; color: #78350f; padding: 1rem 1.3rem; border-radius: 1rem; margin-bottom: 1.5rem; display: flex; gap: 0.8rem; align-items: flex-start; font-size: 0.82rem; font-weight: 600; box-shadow: 0 4px 12px -4px rgba(245,158,11,0.2); }
    .ciu-banner i { font-size: 1.1rem; color: #b45309; margin-top: 0.1rem; }
    .ciu-banner strong { font-weight: 800; }

    /* Cards */
    .section-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.4rem; }
    .pub-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; display: flex; flex-direction: column; transition: var(--transition); }
    .pub-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); border-color: var(--amber); }
    
    .pub-head { background: linear-gradient(135deg, var(--navy), var(--deep)); padding: 1rem 1.3rem; display: flex; justify-content: space-between; align-items: center; }
    .pub-code { font-size: 0.75rem; font-weight: 800; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .pub-group { background: rgba(255,200,87,0.15); color: var(--gold); padding: 0.25rem 0.7rem; border-radius: 100px; font-size: 0.65rem; font-weight: 800; border: 1px solid rgba(255,200,87,0.3); }
    
    .pub-body { padding: 1.3rem; flex: 1; display: flex; flex-direction: column; }
    .pub-title { font-size: 1.05rem; font-weight: 800; color: var(--navy); line-height: 1.35; margin-bottom: 1rem; }
    
    .pub-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 1.2rem; }
    .pub-stat { background: #f8fafc; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #eef2f7; text-align: center; }
    .pub-stat span { display: block; font-size: 0.65rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.2rem; }
    .pub-stat strong { font-size: 1.1rem; font-weight: 800; color: var(--navy); }

    .pub-meta { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0; margin-bottom: 1rem; border-top: 1px solid #eef2f7; font-size: 0.72rem; font-weight: 700; color: #64748b; }
    .pub-meta i { color: var(--blue); margin-right: 0.3rem; }

    .badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.7rem; border-radius: 100px; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.3px; text-transform: uppercase; }
    .badge.published { background: #dcfce7; color: #15803d; }
    .badge.draft { background: #fee2e2; color: #991b1b; }
    .badge.empty { background: #f1f5f9; color: #94a3b8; }
    
    .pub-actions { display: flex; gap: 0.6rem; margin-top: auto; }
    .btn-action { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.65rem; border-radius: 10px; font-family: inherit; font-size: 0.78rem; font-weight: 800; cursor: pointer; border: none; transition: var(--transition); }
    .btn-publish { background: linear-gradient(135deg, var(--success), #16a34a); color: #fff; box-shadow: 0 4px 12px -4px rgba(22,163,74,0.3); }
    .btn-publish:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 16px -6px rgba(22,163,74,0.4); }
    .btn-unpublish { background: #f1f5f9; color: var(--danger); border: 1px solid #e2e8f0; }
    .btn-unpublish:hover:not(:disabled) { background: #fee2e2; border-color: #fca5a5; }
    .btn-action:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow-soft); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .page-title h1 { font-size: 1.3rem; }
      .page-title-icon { width: 44px; height: 44px; font-size: 1.2rem; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Faculty Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/faculty" class="menu-link"><i class="fas fa-home main-icon"></i> <%= lang.dashboard || 'Dashboard' %></a></li>
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-book-open main-icon"></i> <%= lang.my_courses || 'My Courses' %> <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/faculty/courses" class="menu-link"><i class="fas fa-list main-icon"></i> Course List</a></li>
          <li class="menu-item"><a href="/sis/faculty/class-roster" class="menu-link"><i class="fas fa-users main-icon"></i> Class Roster</a></li>
          <li class="menu-item"><a href="/sis/faculty/course-materials" class="menu-link"><i class="fas fa-folder main-icon"></i> Content & Materials</a></li>
          <li class="menu-item"><a href="/sis/faculty/course-weights" class="menu-link"><i class="fas fa-sliders main-icon"></i> Course Weights</a></li>
          <li class="menu-item"><a href="/sis/faculty/evaluations" class="menu-link"><i class="fas fa-poll main-icon"></i> <%= lang.course_evaluations || 'Course Evaluations' %></a></li>
        </ul>
      </li>
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-pen main-icon"></i> <%= lang.grading_exams || 'Grading & Exams' %> <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="/sis/faculty/grades" class="menu-link"><i class="fas fa-marker main-icon"></i> Gradebook Entry</a></li>
          <li class="menu-item"><a href="/sis/faculty/publish-results" class="menu-link active"><i class="fas fa-cloud-upload-alt main-icon"></i> Publish Results</a></li>
        </ul>
      </li>
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> <%= lang.logout || 'Logout' %></a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/faculty" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>

    <div class="page-header">
      <div class="page-title">
        <div class="page-title-icon"><i class="fas fa-cloud-upload-alt"></i></div>
        <div>
          <h1>Publish Results</h1>
          <p>Make grades visible to students once they are finalized</p>
        </div>
      </div>
    </div>

    <div class="ciu-banner">
      <i class="fas fa-info-circle"></i>
      <div>
        <strong>CIU Rule:</strong> Students cannot see their grades until you click <strong>Publish</strong>. If you make a mistake after publishing, you can Unpublish to hide them again while you fix the error.
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length) { %>
      <div class="alert success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length) { %>
      <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= flash.error[0] %></div>
    <% } %>

    <div class="section-grid">
      <% if (sections.length === 0) { %>
        <div style="grid-column: 1 / -1; background: #fff; padding: 4rem 2rem; border-radius: 1.25rem; border: 2px dashed var(--frost); text-align: center;">
          <i class="fas fa-inbox" style="font-size: 3rem; color: var(--frost); margin-bottom: 1rem; display: block;"></i>
          <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem;">No sections assigned</h3>
          <p style="color: #64748b; font-size: 0.85rem; font-weight: 500;">You are not assigned to teach any sections yet.</p>
        </div>
      <% } %>

      <% sections.forEach(sec => { %>
        <% 
          const graded = Number(sec.graded_count);
          const published = Number(sec.published_count);
          const drafts = graded - published;
          let statusBadge = 'empty';
          let statusText = 'No grades yet';
          if (graded > 0 && published === graded) { statusBadge = 'published'; statusText = 'Fully Published'; }
          else if (graded > 0 && published === 0) { statusBadge = 'draft'; statusText = 'All Drafts'; }
          else if (graded > 0 && published > 0) { statusBadge = 'draft'; statusText = 'Partially Published'; }
        %>
        <div class="pub-card">
          <div class="pub-head">
            <span class="pub-code"><%= sec.code %></span>
            <span class="pub-group"><%= sec.group_name || '—' %></span>
          </div>
          <div class="pub-body">
            <div class="pub-title"><%= sec.title %></div>
            
            <div class="pub-stats">
              <div class="pub-stat"><span>Enrolled</span><strong><%= sec.student_count %></strong></div>
              <div class="pub-stat"><span>Graded</span><strong><%= graded %> / <%= sec.student_count %></strong></div>
            </div>

            <div class="pub-meta">
              <span><i class="fas fa-chart-pie"></i> Status</span>
              <span class="badge <%= statusBadge %>"><%= statusText %></span>
            </div>
            
            <% if (sec.last_published) { %>
              <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; margin-bottom: 1rem; text-align: center;">
                Last published: <%= new Date(sec.last_published).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
              </div>
            <% } else { %>
              <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; margin-bottom: 1rem; text-align: center;">
                Never published
              </div>
            <% } %>

            <div class="pub-actions">
              <form action="/sis/faculty/grades/<%= sec.section_id %>/publish" method="POST" style="flex: 1; display: flex;">
                <button type="submit" class="btn-action btn-publish" <%= drafts === 0 ? 'disabled' : '' %> style="width: 100%;">
                  <i class="fas fa-cloud-upload-alt"></i> Publish
                </button>
              </form>
              <form action="/sis/faculty/grades/<%= sec.section_id %>/unpublish" method="POST" style="flex: 1; display: flex;" onsubmit="return confirm('Are you sure? Students will lose visibility of their grades until you publish again.');">
                <button type="submit" class="btn-action btn-unpublish" <%= published === 0 ? 'disabled' : '' %> style="width: 100%;">
                  <i class="fas fa-eye-slash"></i> Unpublish
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) { sb.classList.toggle('active'); ov.classList.toggle('active'); }
    }
  </script>
</body>
</html>