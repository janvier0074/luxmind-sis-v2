<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= thread.title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --amber: #f5a623; --frost: #d9e6f2; --ice: #f7fafd; }
    body { background: var(--ice); color: var(--navy); padding: 2rem; }
    .container { max-width: 900px; margin: 0 auto; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--navy); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }
    .thread-header { background: #fff; padding: 2rem; border-radius: 1.5rem; border: 1px solid var(--frost); margin-bottom: 2rem; border-top: 6px solid var(--amber); }
    .thread-header h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .thread-header p { color: #64748b; font-weight: 600; font-size: 0.85rem; }
    .reply-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
    .reply-card { background: #fff; padding: 1.5rem; border-radius: 1rem; border: 1px solid var(--frost); }
    .reply-meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.8rem; font-size: 0.8rem; font-weight: 700; }
    .avatar { width: 32px; height: 32px; background: var(--navy); color: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; }
    .reply-message { font-size: 0.95rem; font-weight: 500; color: #334155; line-height: 1.6; }
    .reply-form { background: #fff; padding: 1.5rem; border-radius: 1rem; border: 1px solid var(--frost); }
    .reply-form textarea { width: 100%; padding: 1rem; border: 2px solid var(--frost); border-radius: 8px; font-family: inherit; font-weight: 500; outline: none; resize: vertical; margin-bottom: 1rem; }
    .reply-form textarea:focus { border-color: var(--amber); }
    .reply-form button { background: var(--navy); color: #fff; border: none; padding: 0.8rem 2rem; border-radius: 8px; font-weight: 800; cursor: pointer; }
    @media (max-width: 768px) {
      body { padding: 1rem; }
      .thread-header { padding: 1.5rem; }
      .thread-header h1 { font-size: 1.2rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/sis/course/<%= thread.section_id %>/forum" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Forum</a>
    <div class="thread-header">
      <h1><%= thread.title %></h1>
      <p>Started by <%= thread.author_name %> (<%= thread.author_role %>) in <%= thread.code %> on <%= new Date(thread.created_at).toLocaleString() %></p>
    </div>
    <div class="reply-list">
      <% if (replies.length === 0) { %>
        <p style="text-align: center; color: #94a3b8; font-weight: 600;">No replies yet. Be the first to answer!</p>
      <% } %>
      <% replies.forEach(r => { %>
        <div class="reply-card">
          <div class="reply-meta">
            <div class="avatar"><%= r.author_name.charAt(0) %></div>
            <div>
              <div style="color: var(--navy);"><%= r.author_name %> <span style="color: var(--amber); font-size: 0.7rem; text-transform: uppercase;"><%= r.author_role %></span></div>
              <div style="color: #94a3b8; font-size: 0.7rem;"><%= new Date(r.created_at).toLocaleString() %></div>
            </div>
          </div>
          <div class="reply-message"><%= r.message %></div>
        </div>
      <% }) %>
    </div>
    <form action="/sis/course/forum/thread/<%= thread.id %>/reply" method="POST" class="reply-form">
      <textarea name="message" rows="3" required placeholder="Write your reply here..."></textarea>
      <button type="submit"><i class="fas fa-reply"></i> Post Reply</button>
    </form>
  </div>
</body>
</html>