
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HOD Withdrawal Reviews — LuxMind SIS</title>

<style>
:root {
  --green:#087f5b;
  --green2:#0e9f6e;
  --ink:#17231f;
  --muted:#718078;
  --line:#e5ece8;
  --bg:#f3f7f5;
  --red:#b42318;
  --amber:#a45b08;
  --blue:#2459a6;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Inter,"Segoe UI",Arial,sans-serif}
button,input,select,textarea{font:inherit}
.topbar{height:62px;background:#fff;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 22px;position:sticky;top:0;z-index:5}
.brand{font-size:18px;font-weight:850}
.brand span{color:var(--green2)}
.dashboard-link{border:1px solid var(--line);padding:8px 12px;border-radius:9px;font-size:12px;font-weight:750;text-decoration:none;color:var(--ink)}
main{max-width:1150px;margin:24px auto;padding:0 17px 40px}
.hero{background:linear-gradient(115deg,#123f70,#2876bd);color:white;padding:23px;border-radius:16px;margin-bottom:17px}
.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:1.3px;font-weight:800;opacity:.8}
h1{font-size:25px;letter-spacing:-.7px;margin:5px 0}
.subtitle{font-size:12px;opacity:.9;margin:0}
.notice{background:#eaf6ef;border:1px solid #d4eadf;color:#245c46;padding:13px 15px;border-radius:12px;margin-bottom:17px;font-size:12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.stat,.panel{background:white;border:1px solid var(--line);border-radius:14px}
.stat{padding:14px}
.stat small{color:var(--muted);font-size:11px;font-weight:650}
.stat strong{display:block;font-size:24px;margin-top:4px}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}
.toolbar input,.toolbar select{border:1px solid var(--line);background:white;border-radius:9px;padding:10px 12px;font-size:12px}
.toolbar input{flex:1;min-width:190px}
.toolbar select{min-width:155px}
.panel{overflow:hidden}
.panel-heading{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}
.panel-heading h2{font-size:15px;margin:0}
.record-count{color:var(--muted);font-size:11px}
.request{padding:16px 17px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:15px}
.request:last-child{border-bottom:0}
.student-name{font-size:13px;font-weight:800}
.meta{font-size:11px;color:var(--muted);margin-top:4px}
.course{font-weight:750;font-size:12px;margin-top:9px}
.detail{font-size:12px;color:#53635b;margin-top:6px}
.advisor-note{background:#f2f6fb;border-left:3px solid #73a7dc;padding:10px 12px;border-radius:0 9px 9px 0;margin-top:11px;font-size:11px;color:#42566d;overflow-wrap:anywhere}
.right{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.status{font-size:10px;font-weight:800;border-radius:20px;padding:5px 10px;background:#eaf2ff;color:var(--blue);white-space:nowrap}
.actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
button{border:0;border-radius:8px;padding:9px 12px;font-size:11px;font-weight:800;cursor:pointer}
.primary{background:var(--green);color:white}
.secondary{background:#f0f4f2;color:#304139;border:1px solid var(--line)}
button:disabled{opacity:.45;cursor:not-allowed}
.empty{padding:35px 15px;text-align:center;color:var(--muted);font-size:12px}
.workflow{margin-top:16px;padding:16px}
.workflow h3{margin:0 0 10px;font-size:13px}
.workflow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.workflow-step{background:#f4f7f5;padding:11px;border-radius:9px;font-size:11px;color:#58665f}
.workflow-step b{display:block;color:var(--ink);margin-bottom:4px}
dialog{border:0;border-radius:15px;width:min(520px,calc(100% - 25px));padding:0;box-shadow:0 20px 70px #10291f35}
dialog::backdrop{background:#10231d80}
.modal{padding:20px}
.modal h2{font-size:17px;margin:0 0 5px}
.modal p{font-size:12px;color:var(--muted);margin:0 0 13px}
.modal label{display:block;font-size:11px;font-weight:800;margin:13px 0 5px}
.modal select,.modal textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:11px;font-size:12px}
.modal textarea{min-height:105px;resize:vertical}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
@media(max-width:720px){
.topbar{height:57px;padding:0 12px}
main{margin:17px auto;padding:0 11px 28px}
h1{font-size:21px}
.hero{padding:18px}
.stats{grid-template-columns:repeat(2,1fr);gap:8px}
.stat{padding:11px}
.stat strong{font-size:21px}
.request{grid-template-columns:1fr;padding:13px}
.right{align-items:flex-start}
.actions{justify-content:flex-start}
.workflow-grid{grid-template-columns:repeat(2,1fr)}
.dashboard-link{font-size:11px;padding:7px 9px}
}
</style>
</head>

<body>

<header class="topbar">
  <div class="brand">Lux<span>Mind</span> <small style="font-size:10px;color:#829087">SIS</small></div>
  <a href="/dashboard" class="dashboard-link">← Back to Dashboard</a>
</header>

<main>

<section class="hero">
  <div class="eyebrow">Department administration</div>
  <h1>Course Withdrawal Reviews</h1>
  <p class="subtitle">Evaluate advisor recommendations and forward departmental decisions to the Registrar.</p>
</section>

<div class="notice">
  <b>HOD responsibility:</b>
  Review the academic recommendation and departmental circumstances.
  The Registrar retains final withdrawal authority.
</div>

<section class="stats">
  <div class="stat">
    <small>Awaiting HOD review</small>
    <strong><%= Array.isArray(requests) ? requests.length : 0 %></strong>
  </div>
  <div class="stat">
    <small>Review authority</small>
    <strong style="font-size:19px;color:#2876bd">HOD</strong>
  </div>
  <div class="stat">
    <small>Next authority</small>
    <strong style="font-size:19px">Registrar</strong>
  </div>
</section>

<div class="toolbar">
  <input type="search" id="searchInput" placeholder="Search student, course or request ID...">
  <select id="sortFilter">
    <option value="newest">Newest first</option>
    <option value="oldest">Oldest first</option>
  </select>
</div>

<section class="panel">
  <div class="panel-heading">
    <h2>Requests awaiting department review</h2>
    <span class="record-count" id="recordCount"><%= Array.isArray(requests) ? requests.length : 0 %> records</span>
  </div>

  <div id="requestList">

  <% if (Array.isArray(requests) && requests.length) { %>

    <% requests.forEach(function(r) {
      const requestId = r.id || r.withdrawal_id;
      const student = r.student_name || r.full_name || 'Student';
      const course = r.course_name || r.course_code || 'Course details unavailable';
      const submitted = r.requested_at || r.created_at;
      const searchText = [requestId, student, course, r.reason || '', r.advisor_comments || ''].join(' ').toLowerCase();
    %>

    <article class="request"
      data-search="<%= searchText %>"
      data-date="<%= submitted ? new Date(submitted).getTime() : 0 %>">

      <div>
        <div class="student-name"><%= student %></div>

        <div class="meta">
          Request #<%= requestId %>
          · Submitted <%= submitted ? new Date(submitted).toLocaleDateString() : 'Date unavailable' %>
          · Student ID: <%= r.student_id || 'N/A' %>
        </div>

        <div class="course">
          <%= course %>
          <% if (r.course_code && r.course_name) { %>
            · <%= r.course_code %>
          <% } %>
          <% if (r.group_name) { %>
            · Group <%= r.group_name %>
          <% } %>
        </div>

        <div class="detail">
          <b>Student's reason:</b>
          <%= r.reason || 'No reason provided.' %>
        </div>

        <div class="advisor-note">
          <b>Advisor recommendation:</b>
          <%= r.advisor_decision ? r.advisor_decision.replace(/_/g,' ') : 'Not recorded' %>
          <br><br>
          <b>Advisor comments:</b>
          <%= r.advisor_comments || 'No advisor comments available.' %>
        </div>

        <% if (r.attachment_url) { %>
          <div style="margin-top:8px;font-size:11px">
            <a href="<%= r.attachment_url %>" target="_blank" rel="noopener"
              style="color:#087f5b;font-weight:750">View student attachment</a>
          </div>
        <% } %>
      </div>

      <div class="right">
        <span class="status">Awaiting HOD review</span>

        <div class="actions">
          <button type="button" class="primary"
            data-id="<%= requestId %>"
            data-student="<%= student %>"
            data-course="<%= course %>"
            onclick="openHodReview(this)">
            Review request
          </button>
        </div>
      </div>

    </article>

    <% }); %>

  <% } else { %>

    <div class="empty">
      <div style="font-size:27px;margin-bottom:8px">✓</div>
      <b>No pending department reviews</b>
      <div>Requests recommended by Academic Advisors will appear here.</div>
    </div>

  <% } %>

  </div>

  <div class="empty" id="noMatches" hidden>
    No requests match your search.
  </div>
</section>

<section class="panel workflow">
  <h3>Withdrawal approval sequence</h3>
  <div class="workflow-grid">
    <div class="workflow-step"><b>1. Student</b>Submits a withdrawal request.</div>
    <div class="workflow-step"><b>2. Advisor</b>Reviews and records an academic recommendation.</div>
    <div class="workflow-step"><b>3. HOD</b>Reviews and forwards the departmental decision.</div>
    <div class="workflow-step"><b>4. Registrar</b>Makes the final decision and processes approved changes.</div>
  </div>
</section>

</main>

<dialog id="hodDialog">
  <form class="modal" id="hodForm" method="POST">

    <h2>HOD academic review</h2>
    <p id="reviewSubtitle">Record the department's assessment.</p>

    <label for="hodDecision">Department decision</label>
    <select id="hodDecision" name="decision" required>
      <option value="">Select a decision</option>
      <option value="recommended">Recommend withdrawal to Registrar</option>
      <option value="not_recommended">Do not recommend withdrawal</option>
      <option value="more_info">Request additional information</option>
    </select>

    <label for="hodComments">HOD comments and academic justification</label>
    <textarea id="hodComments" name="comments"
      maxlength="2000" required
      placeholder="Explain the department's academic assessment and reasoning..."></textarea>

    <div class="modal-actions">
      <button type="button" class="secondary"
        onclick="document.getElementById('hodDialog').close()">Cancel</button>

      <button type="submit" class="primary" id="submitHod">
        Submit HOD Review
      </button>
    </div>

  </form>
</dialog>

<script>
(function() {
  const search = document.getElementById('searchInput');
  const sort = document.getElementById('sortFilter');
  const list = document.getElementById('requestList');
  const count = document.getElementById('recordCount');
  const empty = document.getElementById('noMatches');
  const dialog = document.getElementById('hodDialog');
  const form = document.getElementById('hodForm');

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    const records = [...list.querySelectorAll('.request')];

    records.sort((a,b) => {
      const first = Number(a.dataset.date);
      const second = Number(b.dataset.date);
      return sort.value === 'newest' ? second-first : first-second;
    });

    records.forEach(record => list.appendChild(record));

    let visible = 0;

    records.forEach(record => {
      const matches = (record.dataset.search || '').includes(query);
      record.hidden = !matches;
      if (matches) visible++;
    });

    count.textContent = visible + ' of ' + records.length + ' records';
    empty.hidden = !(records.length && visible === 0);
  }

  window.openHodReview = function(button) {
    const id = button.dataset.id;

    if (!id) {
      alert('The withdrawal request ID is missing.');
      return;
    }

    form.action = '/sis/hod/withdrawals/' + encodeURIComponent(id) + '/review';

    document.getElementById('reviewSubtitle').textContent =
      'Student: ' + (button.dataset.student || 'Student') +
      ' · Course: ' + (button.dataset.course || 'Course');

    document.getElementById('hodDecision').value = '';
    document.getElementById('hodComments').value = '';

    dialog.showModal();
  };

  form.addEventListener('submit', function(event) {
    const decision = document.getElementById('hodDecision').value;
    const comments = document.getElementById('hodComments').value.trim();

    if (!decision || !comments) {
      event.preventDefault();
      alert('Select a decision and enter your HOD comments.');
      return;
    }

    if (!form.action.includes('/sis/hod/withdrawals/')) {
      event.preventDefault();
      alert('The withdrawal request could not be identified.');
      return;
    }

    const button = document.getElementById('submitHod');
    button.disabled = true;
    button.textContent = 'Submitting...';
  });

  search.addEventListener('input', applyFilters);
  sort.addEventListener('change', applyFilters);

  applyFilters();
})();
</script>

</body>
</html>
