<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101b32">
  <title>Applications Queue | LuxMind Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #111d35; --page: #f4f6fa; --surface: #fff; --text: #172238; --muted: #718096;
      --line: #e6ebf2; --blue: #3867e8; --blue-soft: #edf2ff; --green: #15966b; --green-soft: #e9f8f1;
      --amber: #c98212; --amber-soft: #fff5df; --red: #d34d5b; --red-soft: #fdf2f4;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; }

    /* SIDEBAR */
    .sidebar { position: fixed; inset: 0 auto 0 0; z-index: 50; width: 268px; display: flex; flex-direction: column; overflow-y: auto; color: #d9e2f2; background: linear-gradient(180deg, var(--navy), #0d172b); transition: transform .25s ease; }
    .brand { display: flex; align-items: center; gap: 12px; padding: 27px 23px 24px; border-bottom: 1px solid rgba(255,255,255,.08); }
    .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; color: #fff; font-size: 18px; background: linear-gradient(135deg, #527df2, #3157cb); }
    .brand-name { color: #fff; font: 800 16px "Manrope", sans-serif; }
    .brand-subtitle { margin-top: 4px; color: #9eacc3; font-size: 10px; font-weight: 700; letter-spacing: 1.35px; text-transform: uppercase; }
    .team-chip { margin: 17px 18px 4px; padding: 11px 12px; border: 1px solid rgba(255,255,255,.09); border-radius: 11px; background: rgba(255,255,255,.045); }
    .team-chip small { display: block; margin-bottom: 4px; color: #91a0b8; font-size: 10px; font-weight: 700; text-transform: uppercase; }
    .team-chip strong { color: #fff; font-size: 12px; font-weight: 700; }
    .nav-group { padding: 20px 13px 0; }
    .nav-label { padding: 0 12px 9px; color: #7f90ab; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .nav-link { display: flex; align-items: center; gap: 12px; min-height: 44px; margin: 3px 0; padding: 0 12px; border-radius: 10px; color: #bdc9da; font-size: 13px; font-weight: 600; }
    .nav-link i.nav-icon { width: 18px; color: #91a2bd; text-align: center; }
    .nav-link:hover { color: #fff; background: rgba(255,255,255,.07); }
    .nav-link.active { color: #fff; background: rgba(79,119,232,.2); box-shadow: inset 3px 0 #7796ff; }
    .nav-link.active i.nav-icon { color: #7796ff; }
    .sidebar-bottom { margin-top: auto; padding: 16px 13px 22px; border-top: 1px solid rgba(255,255,255,.08); }
    .nav-link.logout { color: #ffb0b6; }
    .overlay { display: none; position: fixed; inset: 0; z-index: 40; background: rgba(9,17,32,.55); backdrop-filter: blur(3px); }
    .overlay.open { display: block; }

    /* MAIN */
    .main { min-height: 100vh; margin-left: 268px; padding: 26px 38px 50px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
    .mobile-toggle { display: none; width: 42px; height: 42px; border: 0; border-radius: 11px; color: #fff; background: var(--navy); align-items: center; justify-content: center; }
    .eyebrow { margin: 0 0 7px; color: var(--blue); font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
    h1 { margin: 0 0 6px; color: #142039; font: 800 clamp(24px, 3vw, 30px) "Manrope", sans-serif; }
    .welcome-line { margin: 0; color: var(--muted); font-size: 13px; }

    /* TABS */
    .tabs { display: flex; gap: 6px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 4px; }
    .tab { padding: 10px 16px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); color: #4c5a70; font-size: 12px; font-weight: 700; white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; }
    .tab:hover { background: var(--surface-soft, #f8fafc); }
    .tab.active { background: var(--navy); color: #fff; border-color: var(--navy); }
    .tab-count { font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 20px; background: #e9edf4; color: #52627a; }
    .tab.active .tab-count { background: rgba(255,255,255,.2); color: #fff; }

    /* SEARCH */
    .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-input { flex: 1; padding: 13px 18px; border: 1px solid #dfe5ee; border-radius: 12px; font-size: 13px; outline: none; background: var(--surface); font-family: inherit; }
    .search-input:focus { border-color: var(--blue); box-shadow: 0 0 0 4px var(--blue-soft); }
    .btn-search { padding: 13px 22px; border: 0; border-radius: 12px; background: var(--navy); color: #fff; font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }

    /* APPLICATION GRID */
    .app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
    .app-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px 22px; transition: transform .2s, box-shadow .2s; display: flex; flex-direction: column; gap: 14px; }
    .app-card:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(24, 39, 75, .12); }

    .app-header { display: flex; align-items: flex-start; gap: 14px; }
    .app-avatar { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--blue-soft), #d9e6ff); color: var(--blue); display: grid; place-items: center; font: 800 16px "Manrope", sans-serif; flex-shrink: 0; }
    .app-info { flex: 1; min-width: 0; }
    .app-name { margin: 0 0 2px; color: #1c2940; font: 800 15px "Manrope", sans-serif; }
    .app-email { margin: 0; color: var(--muted); font-size: 11px; word-break: break-all; }

    .app-status { padding: 4px 10px; border-radius: 20px; font-size: 9px; font-weight: 800; text-transform: uppercase; white-space: nowrap; }
    .app-status.new             { background: var(--amber-soft); color: var(--amber); }
    .app-status.in_review       { background: var(--blue-soft); color: var(--blue); }
    .app-status.waiting_faculty { background: #fef3c7; color: #b45309; }
    .app-status.approved        { background: var(--green-soft); color: var(--green); }
    .app-status.rejected        { background: var(--red-soft); color: var(--red); }
    .app-status.waitlisted      { background: #ede9fe; color: #6d28d9; }

    .app-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 0; border-top: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
    .meta-item { display: flex; flex-direction: column; gap: 3px; }
    .meta-label { color: #7b8799; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; }
    .meta-value { color: #1c2940; font-size: 12px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; }

    .app-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .app-source { font-size: 10px; color: var(--muted); font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
    .btn-open { padding: 9px 16px; background: var(--navy); color: #fff; border-radius: 8px; font-size: 11px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }
    .btn-open:hover { background: #1c3155; }

    /* EMPTY / PAGINATION */
    .empty-state { padding: 60px 20px; text-align: center; background: var(--surface); border: 1px dashed var(--line); border-radius: var(--radius); color: var(--muted); }
    .empty-state i { font-size: 40px; color: #cbd5e1; display: block; margin-bottom: 12px; }
    .pagination { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; }
    .page-btn { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: #4c5a70; font-size: 12px; font-weight: 700; }
    .page-btn:hover { background: #f8fafc; }
    .page-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
    .page-btn:disabled { opacity: .4; cursor: not-allowed; }
    .page-info { color: var(--muted); font-size: 12px; font-weight: 600; margin: 0 8px; }

    .alert { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 20px; padding: 13px 16px; border: 1px solid #bcebd6; border-radius: 12px; color: #176b4d; background: var(--green-soft); font-size: 12px; font-weight: 600; }

    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); } .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; padding: 20px; } .mobile-toggle { display: inline-flex; }
      .app-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="overlay" id="sidebarOverlay"></div>

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-globe"></i></div>
      <div>
        <div class="brand-name">LuxMind Admin</div>
        <div class="brand-subtitle">International Office</div>
      </div>
    </div>
    <div class="team-chip">
      <small>Admissions Team</small>
      <strong><%= user.full_name %></strong>
    </div>
    <nav>
      <div class="nav-group">
        <div class="nav-label">Admissions</div>
        <a href="/sis/intl" class="nav-link"><i class="fa-solid fa-inbox nav-icon"></i><span>Ticket Desk</span></a>
        <a href="/sis/intl/admissions/queue" class="nav-link active"><i class="fa-solid fa-clipboard-list nav-icon"></i><span>Application Queue</span></a>
        <a href="/sis/intl/documents" class="nav-link"><i class="fa-solid fa-file-pdf nav-icon"></i><span>Document Generator</span></a>
        <a href="/sis/intl/inbox" class="nav-link"><i class="fa-solid fa-envelope-open-text nav-icon"></i><span>Executive Inbox</span></a>
      </div>
    </nav>
    <div class="sidebar-bottom">
      <a href="/logout" class="nav-link logout"><i class="fa-solid fa-arrow-right-from-bracket"></i><span>Secure Logout</span></a>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div style="display:flex; align-items:flex-start; gap:13px;">
        <button class="mobile-toggle" id="mobileMenuButton"><i class="fa-solid fa-bars"></i></button>
        <div>
          <p class="eyebrow">International Office / Admissions</p>
          <h1>Application Queue</h1>
          <p class="welcome-line">
            Review, approve, or reject incoming applications.
            <% if (totalCount > 0) { %><strong style="color:#142039;"><%= totalCount %></strong> matching applications.<% } %>
          </p>
        </div>
      </div>
    </header>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert"><i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %></div>
    <% } %>

    <div class="tabs">
      <%
        const tabs = [
          { key: 'new',             label: 'New' },
          { key: 'in_review',       label: 'In Review' },
          { key: 'waiting_faculty', label: 'Waiting Faculty' },
          { key: 'approved',        label: 'Approved' },
          { key: 'waitlisted',      label: 'Waitlisted' },
          { key: 'rejected',        label: 'Rejected' },
          { key: 'all',             label: 'All' }
        ];
      %>
      <% tabs.forEach(t => {
           const count = t.key === 'all' ? totalAll : (statusCounts[t.key] || 0);
           const isActive = activeStatus === t.key;
           const href = `/sis/intl/admissions/queue?status=${t.key}${searchQuery ? '&q=' + encodeURIComponent(searchQuery) : ''}`;
      %>
        <a href="<%= href %>" class="tab <%= isActive ? 'active' : '' %>">
          <%= t.label %>
          <span class="tab-count"><%= count %></span>
        </a>
      <% }); %>
    </div>

    <form method="GET" action="/sis/intl/admissions/queue" class="search-bar">
      <input type="hidden" name="status" value="<%= activeStatus %>">
      <input type="text" name="q" value="<%= searchQuery %>" placeholder="Search by name, email, or program..." class="search-input">
      <button type="submit" class="btn-search"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
    </form>

    <% if (!applications.length) { %>
      <div class="empty-state">
        <i class="fa-solid fa-folder-open"></i>
        <h3 style="margin:0 0 8px; color:#142039; font-family:Manrope,sans-serif;">
          <%= activeStatus === 'new' ? 'No new applications' : 'No matching applications' %>
        </h3>
        <p style="margin:0; font-size:13px;">
          <%= searchQuery ? 'Try a different search or clear the filter.' : 'When applicants submit the online form, they will appear here.' %>
        </p>
      </div>
    <% } else { %>
      <div class="app-grid">
        <% applications.forEach(app => {
             const initials = app.full_name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
             const timeAgo = Math.floor((Date.now() - new Date(app.created_at)) / 86400000);
        %>
          <article class="app-card">
            <div class="app-header">
              <div class="app-avatar"><%= initials %></div>
              <div class="app-info">
                <h3 class="app-name"><%= app.full_name %></h3>
                <p class="app-email"><%= app.email %></p>
              </div>
              <span class="app-status <%= app.status %>"><%= app.status.replace('_', ' ') %></span>
            </div>

            <div class="app-meta">
              <div class="meta-item">
                <span class="meta-label">Program</span>
                <span class="meta-value"><%= app.intended_program || '—' %></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">GPA</span>
                <span class="meta-value"><%= app.high_school_gpa ? Number(app.high_school_gpa).toFixed(2) : '—' %></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Nationality</span>
                <span class="meta-value"><%= app.nationality || '—' %></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">English</span>
                <span class="meta-value"><%= app.english_test_type || '—' %><%= app.english_test_score ? ' · ' + app.english_test_score : '' %></span>
              </div>
            </div>

            <div class="app-footer">
              <span class="app-source">
                <i class="fa-solid fa-<%= app.source === 'agent' ? 'handshake' : app.source === 'fair' ? 'users' : 'globe' %>"></i>
                <%= app.source %> · <%= timeAgo === 0 ? 'today' : timeAgo + 'd ago' %>
              </span>
              <a href="/sis/intl/admissions/applications/<%= app.id %>" class="btn-open">
                Open <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </article>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <a href="?status=<%= activeStatus %>&page=<%= currentPage - 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
             class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"
             style="<%= currentPage <= 1 ? 'pointer-events:none; opacity:.4;' : '' %>">
            <i class="fa-solid fa-chevron-left"></i> Prev
          </a>
          <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
          <a href="?status=<%= activeStatus %>&page=<%= currentPage + 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
             class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"
             style="<%= currentPage >= totalPages ? 'pointer-events:none; opacity:.4;' : '' %>">
            Next <i class="fa-solid fa-chevron-right"></i>
          </a>
        </div>
      <% } %>
    <% } %>
  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const menuButton = document.getElementById('mobileMenuButton');
    menuButton.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('open'); });
    overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('open'); });
  </script>
</body>
</html>