<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Directorate | LuxMind Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #0f172a; --page: #f8fafc; --surface: #fff; --text: #1e293b; --muted: #64748b;
      --line: #e2e8f0; --blue: #3b82f6; --green: #10b981; --amber: #f59e0b;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; display: flex; min-height: 100vh; }
    
    /* SIDEBAR */
    .sidebar { width: 268px; background: var(--navy); color: #cbd5e1; position: fixed; top: 0; bottom: 0; left: 0; display: flex; flex-direction: column; z-index: 50; transition: transform .25s; }
    .brand { padding: 25px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: center; }
    .brand-mark { width: 42px; height: 42px; background: linear-gradient(135deg, #10b981, #3b82f6); border-radius: 12px; display: grid; place-items: center; font-size: 18px; color: #fff; }
    .brand-name { font: 800 16px "Manrope", sans-serif; color: #fff; }
    .brand-sub { font-size: 10px; font-weight: 700; color: #10b981; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
    .team-chip { margin: 15px 15px 0; padding: 12px; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; background: rgba(255,255,255,0.03); }
    .team-chip small { display: block; font-size: 9px; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-bottom: 4px; }
    .team-chip strong { font-size: 12px; color: #fff; }
    
    .nav-group { padding: 20px 12px 0; }
    .nav-label { padding: 0 10px 8px; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    .nav-link { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 8px; color: #cbd5e1; text-decoration: none; font-size: 13px; font-weight: 600; margin-bottom: 2px; transition: 0.2s; }
    .nav-link i { width: 20px; text-align: center; color: #64748b; font-size: 14px; }
    .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.08); color: #fff; }
    .nav-link.active { background: rgba(16,185,129,0.15); color: #10b981; }
    .nav-link.active i { color: #10b981; }
    
    /* MAIN */
    .main { margin-left: 268px; padding: 30px; flex: 1; transition: margin .25s; }
    .topbar { margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; }
    h1 { font: 800 28px "Manrope", sans-serif; color: #0f172a; margin-bottom: 5px; }
    .eyebrow { font-size: 10px; font-weight: 800; color: var(--blue); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 5px; }
    .role-badge { background: #ecfdf5; color: #059669; padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 8px; text-transform: uppercase; }
    
    /* STATS */
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 30px; }
    .stat-card { background: var(--surface); padding: 20px; border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow); display: flex; align-items: center; gap: 15px; }
    .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; }
    .stat-label { font-size: 10px; font-weight: 800; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
    .stat-val { font: 800 24px "Manrope", sans-serif; color: #0f172a; }
    
    /* TICKETS */
    .section-title { font: 800 16px "Manrope", sans-serif; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
    .ticket-list { display: grid; gap: 15px; margin-bottom: 30px; }
    .ticket-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); display: grid; grid-template-columns: 1fr 300px; overflow: hidden; }
    .ticket-main { padding: 20px; }
    .ticket-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
    .ticket-title { font: 800 15px "Manrope", sans-serif; }
    .badge { padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .badge.pending { background: #fffbeb; color: #d97706; }
    .badge.unassigned { background: #f1f5f9; color: #475569; }
    .meta { font-size: 11px; color: var(--muted); margin-bottom: 15px; display: flex; gap: 15px; }
    .message { background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid var(--line); font-size: 12px; color: #334155; }
    
    .ticket-action { background: #f8fafc; padding: 20px; border-left: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; gap: 10px; }
    .control { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 12px; margin-bottom: 10px; outline: none; }
    .btn { width: 100%; padding: 10px; border: none; border-radius: 8px; color: #fff; font-weight: 800; font-size: 12px; cursor: pointer; display: flex; justify-content: center; gap: 6px; }
    .btn-resolve { background: var(--green); }
    .btn-claim { background: var(--blue); }
    
    .mobile-toggle { display: none; background: var(--navy); color: #fff; border: none; width: 40px; height: 40px; border-radius: 8px; font-size: 18px; cursor: pointer; margin-right: 15px; }
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 40; }
    
    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .overlay.open { display: block; }
      .main { margin-left: 0; padding: 20px; }
      .mobile-toggle { display: grid; place-items: center; }
      .stats { grid-template-columns: 1fr; }
      .ticket-card { grid-template-columns: 1fr; }
      .ticket-action { border-left: none; border-top: 1px solid var(--line); }
      .topbar { flex-direction: column; }
      .topbar-left { display: flex; align-items: flex-start; }
    }
  </style>
</head>
<body>
  <div class="overlay" id="sidebarOverlay"></div>
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-server"></i></div>
      <div>
        <div class="brand-name">LuxMind IT</div>
        <div class="brand-sub">Directorate</div>
      </div>
    </div>
    <div class="team-chip">
      <small><%= itRole %> Access</small>
      <strong><%= teamName %></strong>
    </div>
    
    <nav>
      <div class="nav-group">
        <div class="nav-label">Operations</div>
        <a href="/sis/it" class="nav-link active"><i class="fa-solid fa-inbox"></i><span>IT Ticket Desk</span></a>
        <a href="#" class="nav-link"><i class="fa-solid fa-magnifying-glass"></i><span>User Lookup</span></a>
      </div>

      <% if (teamName === 'Helpdesk & Support') { %>
        <div class="nav-group">
          <div class="nav-label">Helpdesk Modules</div>
          <a href="#" class="nav-link"><i class="fa-solid fa-wifi"></i><span>Wi-Fi & Network Issues</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-key"></i><span>Password Resets</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-print"></i><span>Printer & Campus IT</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-headset"></i><span>Remote Support Desk</span></a>
        </div>
      <% } else if (teamName === 'Network & Hardware') { %>
        <div class="nav-group">
          <div class="nav-label">Network Modules</div>
          <a href="#" class="nav-link"><i class="fa-solid fa-network-wired"></i><span>Router & Switch Status</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-laptop-medical"></i><span>Hardware Repair Queue</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-tower-broadcast"></i><span>Network Outages</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-boxes-stacked"></i><span>Device Inventory</span></a>
        </div>
      <% } else if (teamName === 'Software & Labs') { %>
        <div class="nav-group">
          <div class="nav-label">Software Modules</div>
          <a href="#" class="nav-link"><i class="fa-solid fa-compact-disc"></i><span>Software Licenses</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-desktop"></i><span>Computer Labs</span></a>
          <a href="#" class="nav-link"><i class="fa-brands fa-microsoft"></i><span>Microsoft 365 / Email</span></a>
        </div>
      <% } else if (teamName === 'All IT Teams') { %>
        <div class="nav-group">
          <div class="nav-label">Director Controls</div>
          <a href="#" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>System Health Dashboard</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-user-gear"></i><span>IT Staff Management</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-shield-halved"></i><span>Security & Audit Logs</span></a>
          <a href="#" class="nav-link"><i class="fa-solid fa-database"></i><span>SIS Database Backups</span></a>
        </div>
      <% } %>
    </nav>
    
    <div style="margin-top: auto; padding: 20px 15px; border-top: 1px solid rgba(255,255,255,0.05);">
      <a href="/logout" class="nav-link" style="color: #f87171;"><i class="fa-solid fa-sign-out-alt" style="color: #f87171;"></i><span>Secure Logout</span></a>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="mobile-toggle" id="mobileMenuButton"><i class="fa-solid fa-bars"></i></button>
        <div>
          <p class="eyebrow">IT Directorate / <%= teamName %></p>
          <h1>IT Workstation <% if (itRole === 'director') { %><span class="role-badge">Director</span><% } %></h1>
          <p style="color: var(--muted); font-size: 13px;">Welcome back, <strong><%= user.full_name %></strong>.</p>
        </div>
      </div>
    </header>

    <% if (flash.success && flash.success.length > 0) { %>
      <div style="background: #ecfdf5; border: 1px solid #10b981; color: #065f46; padding: 15px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; font-weight: 600;">
        <i class="fa-solid fa-check-circle"></i> <%= flash.success[0] %>
      </div>
    <% } %>

    <section class="stats">
      <article class="stat-card">
        <div class="stat-icon" style="background:#eff6ff; color:#3b82f6;"><i class="fa-solid fa-ticket"></i></div>
        <div><div class="stat-label">My Open Tickets</div><div class="stat-val"><%= stats.mine %></div></div>
      </article>
      <article class="stat-card">
        <div class="stat-icon" style="background:#fffbeb; color:#d97706;"><i class="fa-solid fa-users-viewfinder"></i></div>
        <div><div class="stat-label">IT Shared Pool</div><div class="stat-val"><%= stats.shared %></div></div>
      </article>
      <article class="stat-card">
        <div class="stat-icon" style="background:#ecfdf5; color:#10b981;"><i class="fa-solid fa-server"></i></div>
        <div><div class="stat-label">System Status</div><div class="stat-val" style="color:#10b981;">Online</div></div>
      </article>
    </section>

    <!-- MY TICKETS -->
    <section>
      <h2 class="section-title"><i class="fa-solid fa-user-check" style="color:var(--blue);"></i> My Assigned IT Tickets</h2>
      <div class="ticket-list">
        <% if (myTickets.length === 0) { %>
          <div style="padding: 30px; text-align: center; background: #fff; border: 1px dashed var(--line); border-radius: var(--radius); color: var(--muted);">No tickets assigned to you.</div>
        <% } %>
        <% myTickets.forEach(r => { %>
          <article class="ticket-card">
            <div class="ticket-main">
              <div class="ticket-header">
                <div>
                  <div style="font-size: 10px; font-weight: 800; color: var(--muted);">TICKET #<%= r.id %> · <%= r.assigned_it_team %></div>
                  <h3 class="ticket-title"><%= r.request_type %></h3>
                </div>
                <span class="badge pending">In Progress</span>
              </div>
              <div class="meta">
                <span><i class="fa-solid fa-user"></i> <%= r.student_name %> (<%= r.student_number %>)</span>
                <a href="/sis/intl/student/<%= r.student_id %>" target="_blank" style="color:var(--blue); text-decoration:none; font-weight:700;">Open Dossier</a>
              </div>
              <div class="message"><%= r.description %></div>
            </div>
            <div class="ticket-action">
              <form action="/sis/it/resolve/<%= r.id %>" method="POST" enctype="multipart/form-data">
                <textarea name="staff_reply" class="control" rows="3" placeholder="Resolution notes..." required></textarea>
                <input type="file" name="staff_attachment" class="control" style="padding: 6px;">
                <button type="submit" class="btn btn-resolve"><i class="fa-solid fa-check"></i> Resolve Ticket</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <!-- SHARED POOL -->
    <section>
      <h2 class="section-title"><i class="fa-solid fa-globe" style="color:var(--amber);"></i> IT Shared Pool</h2>
      <div class="ticket-list">
        <% if (sharedTickets.length === 0) { %>
          <div style="padding: 30px; text-align: center; background: #fff; border: 1px dashed var(--line); border-radius: var(--radius); color: var(--muted);">No unassigned IT tickets.</div>
        <% } %>
        <% sharedTickets.forEach(r => { %>
          <article class="ticket-card">
            <div class="ticket-main">
              <div class="ticket-header">
                <div>
                  <div style="font-size: 10px; font-weight: 800; color: var(--muted);">TICKET #<%= r.id %> · <%= r.assigned_it_team || 'General IT' %></div>
                  <h3 class="ticket-title"><%= r.request_type %></h3>
                </div>
                <span class="badge unassigned">Unassigned</span>
              </div>
              <div class="meta">
                <span><i class="fa-solid fa-user"></i> <%= r.student_name %> (<%= r.student_number %>)</span>
                <a href="/sis/intl/student/<%= r.student_id %>" target="_blank" style="color:var(--blue); text-decoration:none; font-weight:700;">Open Dossier</a>
              </div>
              <div class="message"><%= r.description %></div>
            </div>
            <div class="ticket-action">
              <form action="/sis/it/claim/<%= r.id %>" method="POST">
                <button type="submit" class="btn btn-claim"><i class="fa-solid fa-hand-point-up"></i> Claim IT Ticket</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const menuBtn = document.getElementById('mobileMenuButton');
    menuBtn.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('open'); });
    overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('open'); });
  </script>
</body>
</html>