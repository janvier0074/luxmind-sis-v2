<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset Console — IT Directorate</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #0f172a; --page: #f4f6fa; --surface: #fff; --text: #172238; --muted: #718096;
      --line: #e6ebf2; --blue: #3b82f6; --green: #10b981; --amber: #f59e0b; --red: #ef4444;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; display: flex; min-height: 100vh; }
    
    /* SIDEBAR */
    .sidebar { width: 268px; background: linear-gradient(180deg, var(--navy), #0d172b); color: #d9e2f2; position: fixed; top: 0; bottom: 0; left: 0; display: flex; flex-direction: column; z-index: 50; transition: transform .25s; }
    .brand { padding: 25px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: center; }
    .brand-mark { width: 42px; height: 42px; background: linear-gradient(135deg, #10b981, #3b82f6); border-radius: 12px; display: grid; place-items: center; font-size: 18px; color: #fff; }
    .brand-name { font: 800 16px "Manrope", sans-serif; color: #fff; }
    .brand-sub { font-size: 10px; font-weight: 700; color: #10b981; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
    .nav-group { padding: 20px 12px 0; }
    .nav-label { padding: 0 10px 8px; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    .nav-link { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 8px; color: #cbd5e1; text-decoration: none; font-size: 13px; font-weight: 600; margin-bottom: 2px; transition: 0.2s; }
    .nav-link i { width: 20px; text-align: center; color: #64748b; font-size: 14px; }
    .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.08); color: #fff; }
    .nav-link.active { background: rgba(16,185,129,0.15); color: #10b981; }
    .nav-link.active i { color: #10b981; }
    
    /* MAIN */
    .main { margin-left: 268px; padding: 30px; flex: 1; }
    .topbar { margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; }
    h1 { font: 800 28px "Manrope", sans-serif; color: #0f172a; margin-bottom: 5px; }
    .eyebrow { font-size: 10px; font-weight: 800; color: var(--green); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 5px; }
    
    .alert { padding: 15px 20px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
    .alert.success { background: #ecfdf5; border: 1px solid #10b981; color: #065f46; }
    .alert.error { background: #fef2f2; border: 1px solid #ef4444; color: #991b1b; }
    
    /* SEARCH */
    .search-panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 25px; margin-bottom: 25px; }
    .search-form { display: flex; gap: 12px; }
    .search-input { flex: 1; padding: 14px 18px; border: 1px solid var(--line); border-radius: 10px; font-family: inherit; font-size: 14px; outline: none; transition: 0.2s; }
    .search-input:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(16,185,129,.1); }
    .btn-search { background: var(--green); color: #fff; border: none; padding: 0 25px; border-radius: 10px; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s; }
    .btn-search:hover { background: #059669; }
    
    /* TABLE */
    .table-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: #f8fafc; padding: 15px 20px; font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase; border-bottom: 1px solid var(--line); }
    .data-table td { padding: 15px 20px; border-bottom: 1px solid var(--line); font-size: 13px; vertical-align: middle; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover { background: #f8fafc; }
    
    .role-badge { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .role-badge.student { background: #e0f2fe; color: #0284c7; }
    .role-badge.teacher { background: #fef3c7; color: #d97706; }
    .role-badge.advisor { background: #f3e8ff; color: #7c3aed; }
    .role-badge.admin { background: #fee2e2; color: #dc2626; }
    .role-badge.finance_staff { background: #dcfce7; color: #16a34a; }
    .role-badge.intl_officer { background: #e0e7ff; color: #4338ca; }
    .role-badge.it_staff { background: #ecfdf5; color: #059669; }
    .role-badge.rectorate { background: #fef9c3; color: #ca8a04; }
    
    .btn-reset { background: var(--amber); color: #fff; border: none; padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s; }
    .btn-reset:hover { background: #d97706; }
    
    .empty-state { padding: 40px; text-align: center; color: var(--muted); font-size: 13px; }
    
    /* MOBILE */
    .mobile-toggle { display: none; background: var(--navy); color: #fff; border: none; width: 40px; height: 40px; border-radius: 8px; font-size: 18px; cursor: pointer; margin-right: 15px; }
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 40; }
    
    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .overlay.open { display: block; }
      .main { margin-left: 0; padding: 20px; }
      .mobile-toggle { display: grid; place-items: center; }
      .topbar { flex-direction: column; }
      .topbar-left { display: flex; align-items: flex-start; }
      .search-form { flex-direction: column; }
      .btn-search { padding: 14px; justify-content: center; }
      .table-card { overflow-x: auto; }
    }
  </style>
</head>
<body>
  <div class="overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-server"></i></div>
      <div>
        <div class="brand-name">LuxMind IT</div>
        <div class="brand-sub">Directorate</div>
      </div>
    </div>
    <div class="nav-group">
      <div class="nav-label">Operations</div>
      <a href="/sis/it" class="nav-link"><i class="fa-solid fa-inbox"></i><span>IT Ticket Desk</span></a>
      <a href="/sis/it/password-reset" class="nav-link active"><i class="fa-solid fa-key"></i><span>Password Reset</span></a>
    </div>
    <div style="margin-top: auto; padding: 20px 15px; border-top: 1px solid rgba(255,255,255,0.05);">
      <a href="/logout" class="nav-link" style="color: #f87171;"><i class="fa-solid fa-sign-out-alt" style="color: #f87171;"></i><span>Secure Logout</span></a>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="topbar-left" style="display:flex; align-items:flex-start; gap:13px;">
        <button class="mobile-toggle" onclick="toggleMobileMenu()"><i class="fa-solid fa-bars"></i></button>
        <div>
          <p class="eyebrow">IT Directorate / Helpdesk</p>
          <h1>Password Reset Console</h1>
          <p style="color: var(--muted); font-size: 13px;">Search for a user and reset their password to the default temporary password.</p>
        </div>
      </div>
    </header>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert success"><i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %></div>
    <% } %>
    <% if (flash.error && flash.error.length > 0) { %>
      <div class="alert error"><i class="fa-solid fa-circle-exclamation"></i> <%= flash.error[0] %></div>
    <% } %>

    <div class="search-panel">
      <form action="/sis/it/password-reset" method="GET" class="search-form">
        <input type="text" name="q" class="search-input" placeholder="Search by username, full name, email, or student number..." value="<%= searchQuery %>" autofocus>
        <button type="submit" class="btn-search"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
      </form>
      <p style="margin-top: 12px; font-size: 11px; color: var(--muted);">
        <i class="fa-solid fa-info-circle"></i> Default password after reset: <strong style="color: var(--green);"><%= defaultPassword %></strong> — user should change it after login.
      </p>
    </div>

    <div class="table-card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Student No.</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0 && searchQuery) { %>
            <tr><td colspan="5" class="empty-state">No users found matching "<strong><%= searchQuery %></strong>".</td></tr>
          <% } else if (users.length === 0) { %>
            <tr><td colspan="5" class="empty-state"><i class="fa-solid fa-magnifying-glass" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 10px;"></i>Type a name, username, or student number above to search.</td></tr>
          <% } %>
          
          <% users.forEach(u => { %>
            <tr>
              <td><strong><%= u.username %></strong></td>
              <td><%= u.full_name %></td>
              <td><span class="role-badge <%= u.role %>"><%= u.role %></span></td>
              <td style="color: var(--muted); font-size: 11px;"><%= u.admission_number || '—' %></td>
              <td style="text-align: right;">
                <form action="/sis/it/password-reset/<%= u.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Reset password for <%= u.full_name %>? They will be forced to use the default password on next login.');">
                  <button type="submit" class="btn-reset">
                    <i class="fa-solid fa-key"></i> Reset Password
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('open');
    }
  </script>
</body>
</html>