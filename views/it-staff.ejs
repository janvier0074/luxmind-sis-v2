<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Staff Management | LuxMind Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #0f172a; --page: #f4f6fa; --surface: #fff; --text: #172238; --muted: #718096;
      --line: #e6ebf2; --blue: #3b82f6; --green: #10b981; --amber: #c98212;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; display: flex; min-height: 100vh; }
    
    /* SIDEBAR */
    .sidebar { width: 268px; background: linear-gradient(180deg, var(--navy), #0d172b); color: #d9e2f2; position: fixed; top: 0; bottom: 0; left: 0; display: flex; flex-direction: column; z-index: 50; transition: transform .25s; }
    .brand { padding: 25px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 12px; align-items: center; }
    .brand-mark { width: 42px; height: 42px; background: linear-gradient(135deg, #10b981, #3b82f6); border-radius: 12px; display: grid; place-items: center; font-size: 18px; color: #fff; }
    .brand-name { font: 800 16px "Manrope", sans-serif; color: #fff; }
    .brand-sub { font-size: 10px; font-weight: 700; color: #10b981; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
    .team-chip { margin: 15px 15px 0; padding: 12px; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; background: rgba(255,255,255,0.03); }
    .team-chip small { display: block; font-size: 9px; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-bottom: 4px; }
    .team-chip strong { font-size: 12px; color: #fff; }
    
    .nav-group { padding: 20px 12px 0; }
    .nav-label { padding: 0 10px 8px; font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    .nav-link { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 8px; color: #cbd5e1; text-decoration: none; font-size: 13px; font-weight: 600; margin-bottom: 2px; transition: 0.2s; }
    .nav-link i { width: 20px; text-align: center; color: #64748b; font-size: 14px; }
    .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.08); color: #fff; }
    .nav-link.active { background: rgba(16,185,129,0.15); color: #10b981; }
    .nav-link.active i { color: #10b981; }
    
    /* MAIN */
    .main { margin-left: 268px; padding: 30px; flex: 1; transition: margin .25s; }
    .topbar { margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; }
    h1 { font: 800 28px "Manrope", sans-serif; color: #0f172a; margin-bottom: 5px; }
    .eyebrow { font-size: 10px; font-weight: 800; color: var(--blue); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 5px; }
    
    .alert { background: #ecfdf5; border: 1px solid #10b981; color: #065f46; padding: 15px; border-radius: 12px; margin-bottom: 20px; font-size: 13px; font-weight: 600; display: flex; gap: 10px; align-items: center; }
    
    /* TABLE */
    .table-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--surface-soft); padding: 15px 20px; font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase; border-bottom: 1px solid var(--line); }
    .data-table td { padding: 15px 20px; border-bottom: 1px solid var(--line); font-size: 13px; vertical-align: middle; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover { background: #f8fafc; }
    
    .form-select { padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-family: inherit; font-size: 12px; outline: none; background: #fff; }
    .form-select:focus { border-color: var(--blue); }
    .btn-save { background: var(--green); color: #fff; border: none; padding: 8px 15px; border-radius: 8px; font-weight: 800; font-size: 11px; cursor: pointer; transition: 0.2s; }
    .btn-save:hover { opacity: 0.9; }
    
    .role-badge { padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .role-badge.director { background: #fef3c7; color: #d97706; }
    .role-badge.manager { background: #eff6ff; color: #2563eb; }
    .role-badge.officer { background: #f1f5f9; color: #475569; }

    .mobile-toggle { display: none; background: var(--navy); color: #fff; border: none; width: 40px; height: 40px; border-radius: 8px; font-size: 18px; cursor: pointer; margin-right: 15px; }
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 40; }
    
    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); } .sidebar.open { transform: translateX(0); } .overlay.open { display: block; }
      .main { margin-left: 0; padding: 20px; } .mobile-toggle { display: grid; place-items: center; }
      .topbar { flex-direction: column; } .topbar-left { display: flex; align-items: flex-start; }
      .table-card { overflow-x: auto; }
    }
  </style>
</head>
<body>
  <div class="overlay" id="sidebarOverlay"></div>

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-server"></i></div>
      <div>
        <div class="brand-name">LuxMind IT</div>
        <div class="brand-sub">Directorate</div>
      </div>
    </div>
    <div class="team-chip">
      <small>Director Access</small>
      <strong>All IT Teams</strong>
    </div>
    
    <nav>
      <div class="nav-group">
        <div class="nav-label">Operations</div>
        <a href="/sis/it" class="nav-link"><i class="fa-solid fa-inbox"></i><span>IT Ticket Desk</span></a>
        <a href="/sis/it/staff" class="nav-link active"><i class="fa-solid fa-users-gear"></i><span>Staff Management</span></a>
      </div>
      <div class="nav-group">
        <div class="nav-label">Director Controls</div>
        <a href="#" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>System Health Dashboard</span></a>
        <a href="#" class="nav-link"><i class="fa-solid fa-shield-halved"></i><span>Security & Audit Logs</span></a>
        <a href="#" class="nav-link"><i class="fa-solid fa-database"></i><span>SIS Database Backups</span></a>
      </div>
    </nav>

    <div style="margin-top: auto; padding: 20px 15px; border-top: 1px solid rgba(255,255,255,0.05);">
      <a href="/logout" class="nav-link" style="color: #f87171;"><i class="fa-solid fa-sign-out-alt" style="color: #f87171;"></i><span>Secure Logout</span></a>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="mobile-toggle" id="mobileMenuButton"><i class="fa-solid fa-bars"></i></button>
        <div>
          <p class="eyebrow">IT Directorate / HR Management</p>
          <h1>Staff Management</h1>
          <p style="color: var(--muted); font-size: 13px;">Assign IT staff to specific sub-teams and roles.</p>
        </div>
      </div>
    </header>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert"><i class="fa-solid fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <div class="table-card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Staff Member</th>
            <th>Current Team</th>
            <th>Current Role</th>
            <th>Assign New Team</th>
            <th>Assign New Role</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% staff.forEach(s => { %>
            <tr>
              <td>
                <div style="font-weight: 800; color: var(--text);"><%= s.full_name %></div>
                <div style="font-size: 11px; color: var(--muted);">@<%= s.username %> · <%= s.email %></div>
              </td>
              <td><span style="font-weight: 600; color: var(--blue);"><%= s.it_team %></span></td>
              <td><span class="role-badge <%= s.it_role %>"><%= s.it_role %></span></td>
              
              <!-- UPDATE FORM -->
              <td colspan="3">
                <form action="/sis/it/staff/assign" method="POST" style="display: flex; gap: 10px; align-items: center; justify-content: flex-end;">
                  <input type="hidden" name="staff_id" value="<%= s.id %>">
                  
                  <select name="new_team" class="form-select" required>
                    <option value="Helpdesk & Support" <%= s.it_team === 'Helpdesk & Support' ? 'selected' : '' %>>Helpdesk & Support</option>
                    <option value="Network & Hardware" <%= s.it_team === 'Network & Hardware' ? 'selected' : '' %>>Network & Hardware</option>
                    <option value="Software & Labs" <%= s.it_team === 'Software & Labs' ? 'selected' : '' %>>Software & Labs</option>
                    <option value="All IT Teams" <%= s.it_team === 'All IT Teams' ? 'selected' : '' %>>All IT Teams (Director)</option>
                  </select>

                  <select name="new_role" class="form-select" required>
                    <option value="officer" <%= s.it_role === 'officer' ? 'selected' : '' %>>Officer</option>
                    <option value="manager" <%= s.it_role === 'manager' ? 'selected' : '' %>>Manager</option>
                    <option value="director" <%= s.it_role === 'director' ? 'selected' : '' %>>Director</option>
                  </select>

                  <button type="submit" class="btn-save"><i class="fa-solid fa-save"></i> Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const menuBtn = document.getElementById('mobileMenuButton');
    menuBtn.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('open'); });
    overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('open'); });
  </script>
</body>
</html>