
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS | Login</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", Arial, sans-serif;
    }

    html, body {
      width: 100%;
      min-height: 100%;
    }

    body {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      isolation: isolate;
      overflow-x: hidden;
      padding: 12px 16px;
      background: #071b2c;
      color: white;
    }

    /* CAMPUS VIDEO BACKGROUND */
    .background-video {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -2;
      pointer-events: none;
      background: #071b2c;
    }

    .video-overlay {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        135deg,
        rgba(3, 18, 32, 0.78),
        rgba(4, 32, 49, 0.58),
        rgba(2, 15, 28, 0.82)
      );
    }

    /* COMPACT LOGIN PANEL */
    .login-box {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 390px;
      padding: 22px 28px;
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.13);
      border: 1px solid rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.35);
    }

    .brand {
      text-align: center;
      margin-bottom: 17px;
    }

    .brand h1 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .brand h1 span {
      color: #34d399;
    }

    .brand p {
      margin-top: 4px;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .welcome {
      text-align: center;
      margin-bottom: 17px;
    }

    .welcome h2 {
      font-size: 19px;
      margin-bottom: 4px;
    }

    .welcome p {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.78);
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-group label,
    .captcha-label {
      display: block;
      margin-bottom: 6px;
      font-size: 12px;
      font-weight: 600;
      color: white;
    }

    .form-group input {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.35);
      outline: none;
      background: rgba(0, 0, 0, 0.22);
      color: white;
      font-size: 13px;
      transition: border 0.2s, background 0.2s;
    }

    .form-group input::placeholder {
      color: rgba(255, 255, 255, 0.62);
    }

    .form-group input:focus {
      border-color: #34d399;
      background: rgba(0, 0, 0, 0.32);
    }

    /* CAPTCHA */
    .captcha-display {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 9px;
      padding: 8px 12px;
      min-height: 44px;
      border-radius: 8px;
      border: 1px dashed rgba(255, 255, 255, 0.55);
      background: rgba(0, 0, 0, 0.32);
    }

    #captchaQuestion {
      font-size: 21px;
      font-weight: 800;
      letter-spacing: 6px;
      color: #6ee7b7;
      user-select: none;
      font-family: monospace;
    }

    .refresh-captcha {
      border: none;
      border-radius: 7px;
      padding: 6px 10px;
      background: rgba(52, 211, 153, 0.2);
      color: white;
      font-size: 18px;
      cursor: pointer;
    }

    .refresh-captcha:hover {
      background: rgba(52, 211, 153, 0.4);
    }

    .captcha-error {
      display: none;
      color: #fecaca;
      font-size: 11px;
      margin-top: 6px;
    }

    /* SERVER ERROR */
    .error {
      padding: 9px;
      margin-bottom: 12px;
      border-radius: 8px;
      background: rgba(220, 38, 38, 0.25);
      border: 1px solid rgba(248, 113, 113, 0.6);
      color: #fee2e2;
      font-size: 12px;
      text-align: center;
    }

    .login-button {
      width: 100%;
      height: 44px;
      margin-top: 3px;
      border: none;
      border-radius: 8px;
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.2s, filter 0.2s;
    }

    .login-button:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }

    .security-note {
      margin-top: 12px;
      text-align: center;
      color: rgba(255, 255, 255, 0.72);
      font-size: 10px;
    }

    /* FOOTER */
    .footer {
      position: relative;
      z-index: 2;
      margin-top: 10px;
      text-align: center;
      color: rgba(255, 255, 255, 0.8);
      font-size: 11px;
      line-height: 1.6;
    }

    .developer-credit {
      margin-top: 2px;
      font-size: 10px;
      color: rgba(255, 255, 255, 0.65);
    }

    .developer-credit span {
      color: #6ee7b7;
      font-weight: 600;
    }

    /* SHORTER DESKTOP SCREENS */
    @media (max-height: 750px) {
      body {
        justify-content: flex-start;
        padding-top: 10px;
        padding-bottom: 10px;
      }

      .login-box {
        padding: 16px 25px;
      }

      .brand {
        margin-bottom: 10px;
      }

      .brand h1 {
        font-size: 25px;
      }

      .welcome {
        margin-bottom: 10px;
      }

      .form-group {
        margin-bottom: 8px;
      }

      .form-group input {
        height: 39px;
      }

      .captcha-display {
        min-height: 39px;
        padding: 6px 10px;
        margin-bottom: 7px;
      }

      #captchaQuestion {
        font-size: 19px;
      }

      .login-button {
        height: 41px;
      }

      .security-note {
        margin-top: 8px;
      }

      .footer {
        margin-top: 7px;
      }
    }

    /* MOBILE */
    @media (max-width: 480px) {
      body {
        padding: 14px 12px;
      }

      .login-box {
        max-width: 370px;
        padding: 22px 21px;
      }

      .brand h1 {
        font-size: 26px;
      }
    }

    /* VERY SMALL SCREENS */
    @media (max-height: 620px) {
      body {
        justify-content: flex-start;
        padding-top: 6px;
        padding-bottom: 6px;
      }

      .login-box {
        padding: 12px 22px;
      }

      .brand {
        margin-bottom: 7px;
      }

      .welcome {
        margin-bottom: 7px;
      }

      .form-group {
        margin-bottom: 6px;
      }

      .security-note {
        margin-top: 6px;
      }

      .footer {
        margin-top: 5px;
      }
    }
  </style>
</head>

<body>

  <!-- VIDEO: public/videos/campus-background.mp4 -->
  <video
    class="background-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src="/videos/campus-background.mp4" type="video/mp4">
  </video>

  <div class="video-overlay"></div>

  <main class="login-box">

    <div class="brand">
      <h1>Lux<span>Mind</span> SIS</h1>
      <p>Student Information System</p>
    </div>

    <div class="welcome">
      <h2>Welcome Back</h2>
      <p>Sign in to access your academic portal</p>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="error">
        <%= error[0] %>
      </div>
    <% } %>

    <form id="loginForm" action="/login" method="POST">

      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Enter your username"
          autocomplete="username"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >
      </div>

      <div class="form-group">
        <label class="captcha-label" for="captchaAnswer">
          Security Verification
        </label>

        <div class="captcha-display">
          <span id="captchaQuestion" aria-label="CAPTCHA code"></span>

          <button
            type="button"
            class="refresh-captcha"
            id="refreshCaptcha"
            aria-label="Generate a new CAPTCHA"
            title="Generate a new code"
          >↻</button>
        </div>

        <input
          type="text"
          id="captchaAnswer"
          placeholder="Enter the letters and numbers"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          maxlength="6"
          required
        >

        <div class="captcha-error" id="captchaError">
          Incorrect verification code. Please try again.
        </div>
      </div>

      <button type="submit" class="login-button">
        Sign In
      </button>

    </form>

    <div class="security-note">
      Authorized users only · Secure academic access
    </div>

  </main>

  <footer class="footer">
    © <%= new Date().getFullYear() %> LuxMind SIS
    <br>
    Student Information System

    <div class="developer-credit">
      Developed by <span>Janvier Harerimana</span>
    </div>
  </footer>

  <script>
    (function () {
      const form = document.getElementById('loginForm');
      const question = document.getElementById('captchaQuestion');
      const answer = document.getElementById('captchaAnswer');
      const error = document.getElementById('captchaError');
      const refresh = document.getElementById('refreshCaptcha');

      const characters = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let correctCode = '';

      function generateCaptcha() {
        correctCode = '';

        for (let i = 0; i < 6; i++) {
          correctCode += characters.charAt(
            Math.floor(Math.random() * characters.length)
          );
        }

        question.textContent = correctCode;
        answer.value = '';
        error.style.display = 'none';
      }

      refresh.addEventListener('click', generateCaptcha);

      answer.addEventListener('input', function () {
        answer.value = answer.value.toUpperCase();
        error.style.display = 'none';
      });

      form.addEventListener('submit', function (event) {
        const enteredCode = answer.value.trim().toUpperCase();

        if (enteredCode !== correctCode) {
          event.preventDefault();
          error.style.display = 'block';
          generateCaptcha();
          answer.focus();
        }
      });

      generateCaptcha();
    })();
  </script>

</body>
</html>
