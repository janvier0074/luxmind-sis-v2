
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS | Secure Login</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      isolation: isolate;
      overflow-x: hidden;
      background: #071b2c;
    }

    /* BACKGROUND VIDEO */
    .background-video {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -2;
    }

    /* DARK VIDEO OVERLAY */
    .video-overlay {
      position: fixed;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba(3, 15, 28, 0.68),
        rgba(3, 25, 35, 0.42)
      );
      z-index: -1;
    }

    /* GLASS LOGIN PANEL */
    .login-box {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 420px;
      padding: 38px 34px 28px;
      text-align: center;

      background: rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 18px;

      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);

      animation: appear 0.8s ease;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* BRAND */
    .brand {
      color: #ffffff;
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.8px;
      margin-bottom: 7px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .brand span {
      color: #35e0a0;
    }

    .subtitle {
      color: rgba(255,255,255,0.86);
      font-size: 0.9rem;
      margin-bottom: 28px;
    }

    /* INPUTS */
    .form-group {
      margin-bottom: 15px;
      text-align: left;
    }

    .form-group label {
      display: block;
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 600;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 14px;
      border: 1px solid rgba(255,255,255,0.35);
      border-radius: 8px;
      background: rgba(255,255,255,0.91);
      color: #102b3d;
      font-size: 0.95rem;
      outline: none;
      transition: 0.2s;
    }

    input:focus {
      border-color: #35e0a0;
      box-shadow: 0 0 0 3px rgba(53,224,160,0.18);
    }

    input::placeholder {
      color: #82909b;
    }

    /* CAPTCHA */
    .captcha-section {
      margin: 20px 0;
      text-align: left;
    }

    .captcha-label {
      display: block;
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 600;
      margin-bottom: 9px;
    }

    .captcha-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .captcha-question {
      flex: 1;
      min-height: 45px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px dashed rgba(255,255,255,0.65);
      border-radius: 8px;
      background: rgba(0,0,0,0.20);
      color: #ffffff;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .refresh-captcha {
      width: 45px;
      height: 45px;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.4);
      border-radius: 8px;
      background: rgba(255,255,255,0.15);
      color: #ffffff;
      font-size: 1.3rem;
      cursor: pointer;
    }

    .refresh-captcha:hover {
      background: rgba(255,255,255,0.28);
    }

    .captcha-input {
      width: 100%;
    }

    .captcha-error {
      display: none;
      color: #ffd0ca;
      font-size: 0.8rem;
      margin-top: 7px;
    }

    /* SIGN IN BUTTON */
    .login-button {
      width: 100%;
      padding: 14px;
      background: #0eae78;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: 0.25s;
    }

    .login-button:hover {
      background: #07865b;
      transform: translateY(-1px);
    }

    /* SERVER ERROR */
    .error {
      background: rgba(180, 40, 35, 0.85);
      color: #ffffff;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 17px;
      font-size: 0.88rem;
      text-align: left;
    }

    /* FOOTER */
    .footer {
      border-top: 1px solid rgba(255,255,255,0.23);
      margin-top: 26px;
      padding-top: 18px;
      color: rgba(255,255,255,0.75);
      font-size: 0.75rem;
      line-height: 1.8;
    }

    .developer-credit {
      color: #ffffff;
      font-weight: 600;
    }

    .developer-credit span {
      color: #35e0a0;
    }

    @media (max-width: 480px) {
      body {
        padding: 15px;
      }

      .login-box {
        padding: 30px 22px 23px;
      }

      .brand {
        font-size: 1.7rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .login-box {
        animation: none;
      }

      .background-video {
        display: none;
      }
    }
  </style>
</head>

<body>

  <!-- CAMPUS BACKGROUND VIDEO -->
  <video class="background-video"
         autoplay
         muted
         loop
         playsinline
         preload="metadata">
    <source src="/videos/campus-background.mp4" type="video/mp4">
  </video>

  <div class="video-overlay"></div>

  <!-- LOGIN PANEL -->
  <main class="login-box">

    <div class="brand">LuxMind <span>SIS</span></div>

    <p class="subtitle">
      Student Information System
      <br>
      Sign in to access your portal
    </p>

    <% if (error && error.length > 0) { %>
      <div class="error"><%= error[0] %></div>
    <% } %>

    <form id="loginForm" method="POST" action="/login">

      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Enter your username"
          autocomplete="username"
          required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required>
      </div>

      <!-- CAPTCHA -->
      <div class="captcha-section">

        <label class="captcha-label">
          Human Verification
        </label>

        <div class="captcha-row">
          <div class="captcha-question" id="captchaQuestion">
            Loading...
          </div>

          <button
            type="button"
            class="refresh-captcha"
            id="refreshCaptcha"
            aria-label="Generate a new verification question">
            ↻
          </button>
        </div>

        <input
          type="number"
          id="captchaAnswer"
          class="captcha-input"
          placeholder="Enter the answer"
          required>

        <div class="captcha-error" id="captchaError">
          Incorrect answer. Please try again.
        </div>

      </div>

      <button type="submit" class="login-button">
        Sign In
      </button>

    </form>

    <!-- FOOTER -->
    <footer class="footer">
      © <%= new Date().getFullYear() %> LuxMind SIS
      <br>
      Student Information System

      <div class="developer-credit">
        Developed by <span>Janvier Harerimana</span>
      </div>
    </footer>

  </main>

  <script>
    (function () {
      const form = document.getElementById('loginForm');
      const question = document.getElementById('captchaQuestion');
      const answer = document.getElementById('captchaAnswer');
      const error = document.getElementById('captchaError');
      const refresh = document.getElementById('refreshCaptcha');

      let correctAnswer = 0;

      function generateCaptcha() {
        const first = Math.floor(Math.random() * 9) + 1;
        const second = Math.floor(Math.random() * 9) + 1;

        correctAnswer = first + second;

        question.textContent = first + ' + ' + second + ' = ?';
        answer.value = '';
        error.style.display = 'none';
      }

      refresh.addEventListener('click', generateCaptcha);

      form.addEventListener('submit', function (event) {
        if (Number(answer.value) !== correctAnswer) {
          event.preventDefault();

          error.style.display = 'block';
          answer.value = '';
          generateCaptcha();
          answer.focus();
        }
      });

      generateCaptcha();
    })();
  </script>

</body>
</html>
