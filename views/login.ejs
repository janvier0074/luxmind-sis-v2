<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LuxMind SIS - Login</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #0a1e32; }
    .login-box { background: #fff; padding: 3rem; border-radius: 1.5rem; width: 100%; max-width: 400px; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
    h2 { color: #0a1e32; margin-bottom: 0.5rem; }
    p { color: #64748b; margin-bottom: 2rem; font-size: 0.9rem; }
    input { width: 100%; padding: 1rem; margin-bottom: 1rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 1rem; outline: none; }
    input:focus { border-color: #f5a623; }
    button { width: 100%; padding: 1rem; background: #0a1e32; color: #fff; border: none; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    button:hover { background: #1e4d7b; }
    .error { background: #fbe9e7; color: #b33e2e; padding: 0.8rem; border-radius: 8px; margin-bottom: 1rem; font-weight: bold; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="login-box">
    <h2>LuxMind SIS</h2>
    <p>Sign in to access your portal</p>
    
    <% if (error.length > 0) { %>
      <div class="error"><%= error[0] %></div>
    <% } %>

    <form method="POST" action="/login">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Sign In</button>
    </form>
    <p style="margin-top: 1.5rem; font-size: 0.8rem;">Student: (your db username) / password123<br>Advisor: advisor1 / password123</p>
  </div>
</body>
</html>

  <script>
    // 1. Toggle menu function
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
        // Save the state to browser memory
        const text = element.innerText.trim().split('\n')[0]; 
        if (parent.classList.contains('open')) {
          localStorage.setItem('menu_' + text, 'open');
        } else {
          localStorage.removeItem('menu_' + text);
        }
      }
    }

    // 2. Mobile toggle function
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    // 3. Restore open menus on page load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.menu-link').forEach(link => {
        if (link.nextElementSibling && link.nextElementSibling.classList.contains('submenu')) {
          const text = link.innerText.trim().split('\n')[0];
          if (localStorage.getItem('menu_' + text) === 'open') {
            link.parentElement.classList.add('open');
            link.nextElementSibling.classList.add('open');
          }
        }
      });
    });
  </script>
