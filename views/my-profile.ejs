```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#10243a">
  <title>Contact Information | LuxMind SIS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/mobile.css">

  <style>
    :root {
      --navy: #10243a;
      --navy-2: #193b5c;
      --blue: #2868a5;
      --blue-light: #edf5fc;
      --gold: #f4bd50;
      --green: #16845d;
      --green-bg: #ecfbf3;
      --bg: #f3f6fb;
      --white: #fff;
      --text: #1d2e42;
      --muted: #718096;
      --border: #e4eaf2;
      --shadow: 0 12px 35px rgba(24,49,78,.07);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-size: 14px;
    }

    a { text-decoration: none; }

    button, input { font: inherit; }

    .main-content {
      width: 100%;
      max-width: 1500px;
      min-height: 100vh;
      margin: 0 auto;
      padding: 38px clamp(18px, 4vw, 65px);
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 22px;
      margin-bottom: 28px;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 10px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
    }

    .breadcrumb a { color: var(--blue); }

    .breadcrumb a:hover { text-decoration: underline; }

    .page-header h1 {
      color: var(--navy);
      font-size: clamp(26px, 3vw, 35px);
      font-weight: 800;
      letter-spacing: -.9px;
    }

    .page-header p {
      margin-top: 8px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .header-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 47px;
      padding: 0 19px;
      border: 1px solid #294b6a;
      border-radius: 11px;
      background: linear-gradient(135deg, #10243a, #285781);
      color: white;
      font-size: 13px;
      font-weight: 800;
      white-space: nowrap;
      box-shadow: 0 6px 16px rgba(16,36,58,.16);
      transition: transform .2s, box-shadow .2s;
    }

    .header-action i {
      color: var(--gold);
      font-size: 14px;
    }

    .header-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 9px 21px rgba(16,36,58,.23);
    }

    .header-action:focus-visible,
    .btn-save:focus-visible {
      outline: 3px solid rgba(40,104,165,.35);
      outline-offset: 3px;
    }

    .success-alert {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 18px;
      margin-bottom: 23px;
      border: 1px solid #bce8d3;
      border-radius: 12px;
      background: var(--green-bg);
      color: #14734f;
      font-size: 13px;
      font-weight: 700;
    }

    .success-alert i { font-size: 18px; }

    .profile-grid {
      display: grid;
      grid-template-columns: minmax(260px, 330px) minmax(0, 1fr);
      align-items: start;
      gap: 23px;
    }

    .card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      box-shadow: var(--shadow);
    }

    .identity-cover {
      position: relative;
      padding: 32px 20px 28px;
      overflow: hidden;
      background: linear-gradient(135deg, #10243a, #285b87);
      color: white;
      text-align: center;
    }

    .identity-cover::before,
    .identity-cover::after {
      position: absolute;
      content: "";
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 50%;
      pointer-events: none;
    }

    .identity-cover::before {
      width: 180px;
      height: 180px;
      top: -100px;
      right: -45px;
    }

    .identity-cover::after {
      width: 130px;
      height: 130px;
      bottom: -95px;
      left: -45px;
    }

    .avatar {
      position: relative;
      z-index: 1;
      width: 84px;
      height: 84px;
      display: grid;
      place-items: center;
      margin: 0 auto 15px;
      border: 4px solid rgba(255,255,255,.25);
      border-radius: 50%;
      background: linear-gradient(135deg, #ffdc8b, #f4b83f);
      color: var(--navy);
      font-size: 30px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .identity-cover h2 {
      position: relative;
      z-index: 1;
      overflow-wrap: anywhere;
      font-size: 18px;
      font-weight: 800;
    }

    .student-number {
      position: relative;
      z-index: 1;
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      margin-top: 10px;
      padding: 7px 12px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 30px;
      background: rgba(255,255,255,.09);
      color: #ffda8a;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .5px;
    }

    .identity-body { padding: 9px 20px 17px; }

    .identity-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .identity-item:last-child { border-bottom: 0; }

    .identity-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 10px;
      background: var(--blue-light);
      color: var(--blue);
      font-size: 14px;
    }

    .identity-detail { min-width: 0; }

    .identity-detail span {
      display: block;
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .identity-detail strong {
      display: block;
      overflow-wrap: anywhere;
      color: var(--navy);
      font-size: 13px;
      font-weight: 700;
      line-height: 1.6;
    }

    .identity-note {
      display: flex;
      gap: 10px;
      margin: 0 17px 18px;
      padding: 13px;
      border-radius: 10px;
      background: #fff8e8;
      color: #86601b;
      font-size: 11px;
      line-height: 1.7;
    }

    .identity-note i {
      flex-shrink: 0;
      margin-top: 3px;
      color: #d59b28;
    }

    .form-card { padding: clamp(21px, 3vw, 32px); }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 10px;
    }

    .section-icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 12px;
      background: #fff5df;
      color: #bd851e;
      font-size: 18px;
    }

    .section-heading h3 {
      color: var(--navy);
      font-size: 17px;
      font-weight: 800;
    }

    .section-heading p {
      margin-top: 5px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .form-divider {
      height: 1px;
      margin: 23px 0;
      background: var(--border);
    }

    .form-section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 17px;
      color: var(--navy);
      font-size: 13px;
      font-weight: 800;
    }

    .form-section-title i { color: var(--blue); }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .form-group { min-width: 0; }

    .form-group.full { grid-column: 1 / -1; }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: #43556b;
      font-size: 12px;
      font-weight: 800;
    }

    .form-control {
      width: 100%;
      min-height: 48px;
      padding: 12px 14px;
      border: 1px solid #dfe6ef;
      border-radius: 10px;
      outline: none;
      background: #f8fafd;
      color: var(--text);
      font-size: 13px;
      transition: border-color .2s, box-shadow .2s, background .2s;
    }

    .form-control::placeholder { color: #a1adba; }

    .form-control:focus {
      border-color: #5b94c8;
      background: white;
      box-shadow: 0 0 0 3px rgba(40,104,165,.09);
    }

    .form-control:disabled {
      border-color: #e7ecf2;
      background: #f0f3f7;
      color: #77879a;
      cursor: not-allowed;
    }

    .field-hint {
      display: block;
      margin-top: 7px;
      color: #8996a6;
      font-size: 11px;
      line-height: 1.6;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 12px;
      margin-top: 26px;
      padding-top: 21px;
      border-top: 1px solid var(--border);
    }

    .btn-save {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 25px;
      border: 0;
      border-radius: 10px;
      background: linear-gradient(135deg, #16845d, #20a675);
      color: white;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(22,132,93,.16);
      transition: .2s;
    }

    .btn-save:hover {
      box-shadow: 0 9px 20px rgba(22,132,93,.25);
      transform: translateY(-2px);
    }

    .btn-save:active { transform: translateY(0); }

    .form-footnote {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-top: 15px;
      color: #8996a6;
      font-size: 11px;
      line-height: 1.7;
    }

    .form-footnote i {
      flex-shrink: 0;
      margin-top: 3px;
    }

    @media (max-width: 1000px) {
      .profile-grid {
        grid-template-columns: minmax(235px, 290px) minmax(0, 1fr);
        gap: 16px;
      }

      .main-content { padding: 30px 22px; }
      .form-card { padding: 22px 18px; }
    }

    @media (max-width: 800px) {
      .profile-grid { grid-template-columns: 1fr; }

      .identity-card {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      }

      .identity-cover {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .identity-body { padding: 8px 18px; }

      .identity-note { grid-column: 1 / -1; }
    }

    @media (max-width: 600px) {
      .main-content { padding: 23px 15px 30px; }

      .page-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 17px;
        margin-bottom: 22px;
      }

      .page-header h1 { font-size: 26px; }

      .page-header p {
        font-size: 13px;
        line-height: 1.7;
      }

      .header-action {
        width: 100%;
        min-height: 47px;
        font-size: 13px;
      }

      .breadcrumb { font-size: 11px; }

      .identity-card { display: block; }

      .identity-cover { padding: 25px 16px; }

      .identity-body { padding: 8px 18px; }

      .form-card { padding: 21px 16px; }

      .section-heading h3 { font-size: 16px; }

      .section-heading p { font-size: 12px; }

      .form-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .form-group.full { grid-column: auto; }

      .form-control {
        min-height: 49px;
        font-size: 14px;
      }

      .form-group label { font-size: 12px; }

      .field-hint { font-size: 11px; }

      .form-actions { justify-content: stretch; }

      .btn-save {
        width: 100%;
        min-height: 49px;
        font-size: 13px;
      }

      .success-alert {
        padding: 13px;
        font-size: 12px;
      }
    }

    @media (max-width: 360px) {
      .main-content { padding-right: 12px; padding-left: 12px; }

      .form-card { padding: 18px 13px; }

      .section-heading { gap: 10px; }

      .section-icon {
        width: 40px;
        height: 40px;
      }

      .identity-item { gap: 10px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <main class="main-content">

    <header class="page-header">
      <div>
        <div class="breadcrumb">
          <a href="/sis/my">Dashboard</a>
          <i class="fas fa-chevron-right"></i>
          <span>Contact Information</span>
        </div>

        <h1>Contact Information</h1>
        <p>Manage your contact details and review your student information.</p>
      </div>

      <a href="/sis/my" class="header-action">
        <i class="fas fa-arrow-left"></i>
        Back to Dashboard
      </a>
    </header>

    <% if (typeof flash !== 'undefined' && flash && flash.success && flash.success.length > 0) { %>
      <div class="success-alert" role="status">
        <i class="fas fa-circle-check"></i>
        <span><%= flash.success[0] %></span>
      </div>
    <% } %>

    <div class="profile-grid">

      <!-- Student identity card -->
      <section class="card identity-card">
        <div class="identity-cover">
          <div class="avatar">
            <%= profile.full_name ? profile.full_name.trim().charAt(0) : 'S' %>
          </div>

          <h2><%= profile.full_name || 'Student' %></h2>

          <span class="student-number">
            <%= profile.admission_number || profile.username || 'Student ID unavailable' %>
          </span>
        </div>

        <div class="identity-body">
          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="identity-detail">
              <span>Program / Class</span>
              <strong><%= profile.class_level || 'Not available' %></strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="identity-detail">
              <span>Current Semester</span>
              <strong>
                <%= profile.current_semester ? 'Semester ' + profile.current_semester : 'Not available' %>
              </strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-user-tie"></i>
            </div>
            <div class="identity-detail">
              <span>Academic Advisor</span>
              <strong><%= profile.advisor_name || 'Not Assigned' %></strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="identity-detail">
              <span>Email Address</span>
              <strong><%= profile.email || 'Not available' %></strong>
            </div>
          </div>
        </div>

        <div class="identity-note">
          <i class="fas fa-shield-halved"></i>
          <span>Your academic identity details are displayed for reference. Contact the appropriate university office if any official student information needs correction.</span>
        </div>
      </section>

      <!-- Contact information form -->
      <section class="card form-card">
        <div class="section-heading">
          <div class="section-icon">
            <i class="fas fa-user-pen"></i>
          </div>
          <div>
            <h3>Edit Contact Information</h3>
            <p>Keep your personal and guardian contact details up to date.</p>
          </div>
        </div>

        <form method="POST" action="/sis/my/profile/update">
          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-id-card"></i>
            Student Information
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="full_name">Full Name</label>
              <input
                id="full_name"
                type="text"
                class="form-control"
                value="<%= profile.full_name || '' %>"
                disabled
              >
              <span class="field-hint">This information is managed by the university.</span>
            </div>

            <div class="form-group">
              <label for="student_id">Student ID</label>
              <input
                id="student_id"
                type="text"
                class="form-control"
                value="<%= profile.admission_number || profile.username || '' %>"
                disabled
              >
              <span class="field-hint">Your official student identification.</span>
            </div>
          </div>

          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-address-book"></i>
            Personal Contact Details
          </div>

          <div class="form-grid">
            <div class="form-group full">
              <label for="phone">Phone Number</label>
              <input
                id="phone"
                type="tel"
                name="phone"
                class="form-control"
                value="<%= profile.phone || '' %>"
                placeholder="e.g. +90 533 123 4567"
                autocomplete="tel"
                maxlength="30"
              >
              <span class="field-hint">Provide a phone number where the university can reach you.</span>
            </div>

            <div class="form-group full">
              <label for="home_address">Home Address</label>
              <input
                id="home_address"
                type="text"
                name="home_address"
                class="form-control"
                value="<%= profile.home_address || '' %>"
                placeholder="Enter your home address"
                autocomplete="street-address"
                maxlength="255"
              >
            </div>
          </div>

          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-people-group"></i>
            Guardian Information
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="guardian_name">Guardian Name</label>
              <input
                id="guardian_name"
                type="text"
                name="guardian_name"
                class="form-control"
                value="<%= profile.guardian_name || '' %>"
                placeholder="Guardian's full name"
                autocomplete="name"
                maxlength="150"
              >
            </div>

            <div class="form-group">
              <label for="guardian_phone">Guardian Phone</label>
              <input
                id="guardian_phone"
                type="tel"
                name="guardian_phone"
                class="form-control"
                value="<%= profile.guardian_phone || '' %>"
                placeholder="Guardian's phone number"
                autocomplete="tel"
                maxlength="30"
              >
            </div>

            <div class="form-group full">
              <label for="guardian_relationship">Relationship to Guardian</label>
              <input
                id="guardian_relationship"
                type="text"
                name="guardian_relationship"
                class="form-control"
                value="<%= profile.guardian_relationship || '' %>"
                placeholder="e.g. Father, Mother, Uncle"
                maxlength="80"
              >
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-save">
              <i class="fas fa-floppy-disk"></i>
              Save Changes
            </button>
          </div>

          <p class="form-footnote">
            <i class="fas fa-lock"></i>
            Your contact information is submitted through the existing LuxMind SIS profile update process.
          </p>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
```