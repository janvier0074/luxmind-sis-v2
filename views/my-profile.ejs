```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#10243a">
  <title>Contact Information | LuxMind SIS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/mobile.css">
  <script src="/js/mobile.js" defer></script>

  <style>
    :root {
      --navy: #10243a;
      --navy-2: #193b5c;
      --blue: #2868a5;
      --blue-light: #edf5fc;
      --gold: #f4bd50;
      --green: #16845d;
      --green-bg: #ecfbf3;
      --bg: #f3f6fb;
      --white: #fff;
      --text: #1d2e42;
      --muted: #718096;
      --border: #e4eaf2;
      --shadow: 0 12px 35px rgba(24,49,78,.07);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
    }

    a { text-decoration: none; }

    button, input { font: inherit; }

    .sidebar {
      width: 260px;
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 1000;
      overflow-y: auto;
      background: linear-gradient(180deg, #10243a, #142f4b);
      color: white;
      transition: transform .3s ease;
    }

    .sidebar-brand {
      min-height: 88px;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid rgba(255,255,255,.09);
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 13px;
      background: var(--gold);
      color: var(--navy);
      font-size: 23px;
      font-weight: 800;
    }

    .brand-name {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -.3px;
    }

    .brand-name span {
      display: block;
      margin-top: 4px;
      color: var(--gold);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
    }

    .menu-heading {
      padding: 28px 24px 10px;
      color: #8497ad;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .sidebar-menu {
      list-style: none;
      padding: 0 12px 25px;
    }

    .menu-link {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 13px 14px;
      margin: 4px 0;
      border-radius: 10px;
      color: #b5c3d2;
      font-size: 13px;
      font-weight: 600;
      transition: .2s ease;
    }

    .menu-link i {
      width: 19px;
      color: var(--gold);
      text-align: center;
      font-size: 15px;
    }

    .menu-link:hover,
    .menu-link.active {
      color: white;
      background: rgba(255,255,255,.10);
    }

    .menu-link.active {
      box-shadow: inset 3px 0 var(--gold);
    }

    .sidebar-footer {
      margin: 15px 20px;
      padding: 15px 12px;
      border-top: 1px solid rgba(255,255,255,.1);
      color: #8799ad;
      font-size: 10px;
      line-height: 1.7;
    }

    .mobile-menu-btn {
      display: none;
      position: fixed;
      top: 14px;
      left: 14px;
      z-index: 1002;
      width: 43px;
      height: 43px;
      border: 0;
      border-radius: 12px;
      background: var(--navy);
      color: var(--gold);
      font-size: 17px;
      cursor: pointer;
      box-shadow: var(--shadow);
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(9,25,43,.55);
      backdrop-filter: blur(3px);
    }

    .main-content {
      min-height: 100vh;
      margin-left: 260px;
      padding: 35px clamp(20px,4vw,55px);
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 27px;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 9px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
    }

    .breadcrumb a { color: var(--blue); }

    .page-header h1 {
      color: var(--navy);
      font-size: clamp(24px,3vw,32px);
      font-weight: 800;
      letter-spacing: -.9px;
    }

    .page-header p {
      margin-top: 7px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .header-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 16px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: white;
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      transition: .2s;
    }

    .header-action:hover {
      border-color: var(--blue);
      color: var(--blue);
      transform: translateY(-1px);
    }

    .success-alert {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 15px 17px;
      margin-bottom: 22px;
      border: 1px solid #bce8d3;
      border-radius: 12px;
      background: var(--green-bg);
      color: #14734f;
      font-size: 12px;
      font-weight: 700;
    }

    .success-alert i { font-size: 17px; }

    .profile-grid {
      display: grid;
      grid-template-columns: minmax(250px,310px) minmax(0,1fr);
      align-items: start;
      gap: 22px;
    }

    .card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      box-shadow: var(--shadow);
    }

    .identity-cover {
      position: relative;
      padding: 30px 20px 26px;
      overflow: hidden;
      background: linear-gradient(135deg,#10243a,#285b87);
      color: white;
      text-align: center;
    }

    .identity-cover::before,
    .identity-cover::after {
      position: absolute;
      content: "";
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 50%;
      pointer-events: none;
    }

    .identity-cover::before {
      width: 180px;
      height: 180px;
      top: -100px;
      right: -45px;
    }

    .identity-cover::after {
      width: 130px;
      height: 130px;
      bottom: -95px;
      left: -45px;
    }

    .avatar {
      position: relative;
      z-index: 1;
      width: 82px;
      height: 82px;
      display: grid;
      place-items: center;
      margin: 0 auto 14px;
      border: 4px solid rgba(255,255,255,.25);
      border-radius: 50%;
      background: linear-gradient(135deg,#ffdc8b,#f4b83f);
      color: var(--navy);
      font-size: 29px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .identity-cover h2 {
      position: relative;
      z-index: 1;
      overflow-wrap: anywhere;
      font-size: 17px;
      font-weight: 800;
    }

    .student-number {
      position: relative;
      z-index: 1;
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      margin-top: 9px;
      padding: 6px 11px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 30px;
      background: rgba(255,255,255,.09);
      color: #ffda8a;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .5px;
    }

    .identity-body { padding: 8px 19px 16px; }

    .identity-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
    }

    .identity-item:last-child { border-bottom: 0; }

    .identity-icon {
      width: 35px;
      height: 35px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 10px;
      background: var(--blue-light);
      color: var(--blue);
      font-size: 13px;
    }

    .identity-detail { min-width: 0; }

    .identity-detail span {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .identity-detail strong {
      display: block;
      overflow-wrap: anywhere;
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
      line-height: 1.5;
    }

    .identity-note {
      display: flex;
      gap: 9px;
      margin: 0 16px 17px;
      padding: 12px;
      border-radius: 10px;
      background: #fff8e8;
      color: #86601b;
      font-size: 10px;
      line-height: 1.7;
    }

    .identity-note i {
      flex-shrink: 0;
      margin-top: 2px;
      color: #d59b28;
    }

    .form-card { padding: clamp(20px,3vw,30px); }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-bottom: 9px;
    }

    .section-icon {
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border-radius: 12px;
      background: #fff5df;
      color: #bd851e;
      font-size: 17px;
    }

    .section-heading h3 {
      color: var(--navy);
      font-size: 16px;
      font-weight: 800;
    }

    .section-heading p {
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.6;
    }

    .form-divider {
      height: 1px;
      margin: 22px 0;
      background: var(--border);
    }

    .form-section-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
      color: var(--navy);
      font-size: 12px;
      font-weight: 800;
    }

    .form-section-title i { color: var(--blue); }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 17px;
    }

    .form-group { min-width: 0; }

    .form-group.full { grid-column: 1/-1; }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: #43556b;
      font-size: 11px;
      font-weight: 800;
    }

    .form-control {
      width: 100%;
      min-height: 46px;
      padding: 11px 13px;
      border: 1px solid #dfe6ef;
      border-radius: 10px;
      outline: none;
      background: #f8fafd;
      color: var(--text);
      font-size: 12px;
      transition: border-color .2s,box-shadow .2s,background .2s;
    }

    .form-control::placeholder { color: #a1adba; }

    .form-control:focus {
      border-color: #5b94c8;
      background: white;
      box-shadow: 0 0 0 3px rgba(40,104,165,.09);
    }

    .form-control:disabled {
      border-color: #e7ecf2;
      background: #f0f3f7;
      color: #77879a;
      cursor: not-allowed;
    }

    .field-hint {
      display: block;
      margin-top: 6px;
      color: #8996a6;
      font-size: 10px;
      line-height: 1.5;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 12px;
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-save {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 46px;
      padding: 0 24px;
      border: 0;
      border-radius: 10px;
      background: linear-gradient(135deg,#10243a,#245681);
      color: white;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s;
    }

    .btn-save:hover {
      box-shadow: 0 7px 18px rgba(16,36,58,.2);
      transform: translateY(-2px);
    }

    .btn-save:active { transform: translateY(0); }

    .btn-save:focus-visible,
    .header-action:focus-visible,
    .menu-link:focus-visible,
    .mobile-menu-btn:focus-visible {
      outline: 3px solid rgba(40,104,165,.35);
      outline-offset: 3px;
    }

    .form-footnote {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      margin-top: 14px;
      color: #8996a6;
      font-size: 10px;
      line-height: 1.7;
    }

    .form-footnote i {
      flex-shrink: 0;
      margin-top: 2px;
    }

    @media (max-width: 1050px) {
      .profile-grid {
        grid-template-columns: 260px minmax(0,1fr);
        gap: 16px;
      }

      .main-content { padding: 28px 22px; }
    }

    @media (max-width: 850px) {
      .profile-grid { grid-template-columns: 1fr; }

      .identity-card {
        display: grid;
        grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr);
      }

      .identity-cover {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .identity-body { padding: 8px 18px; }

      .identity-note { grid-column: 1/-1; }
    }

    @media (max-width: 768px) {
      .mobile-menu-btn {
        display: grid;
        place-items: center;
      }

      .sidebar { transform: translateX(-100%); }

      .sidebar.active { transform: translateX(0); }

      .sidebar-overlay.active { display: block; }

      .main-content {
        margin-left: 0;
        padding: 75px 16px 25px;
      }

      .page-header { align-items: flex-start; }

      .header-action {
        padding: 10px;
        font-size: 0;
      }

      .header-action i { font-size: 14px; }
    }

    @media (max-width: 540px) {
      .identity-card { display: block; }

      .identity-cover { padding: 24px 15px; }

      .form-card { padding: 19px 15px; }

      .form-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .form-group.full { grid-column: auto; }

      .form-actions { justify-content: stretch; }

      .btn-save { width: 100%; }

      .page-header h1 { font-size: 23px; }

      .page-header p {
        max-width: 270px;
        font-size: 11px;
        line-height: 1.6;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <button
    class="mobile-menu-btn"
    type="button"
    onclick="toggleMobileMenu()"
    aria-label="Open navigation menu"
    aria-controls="sidebar"
    aria-expanded="false"
    id="mobileMenuButton"
  >
    <i class="fas fa-bars"></i>
  </button>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">
        LuxMind SIS
        <span>Student Portal</span>
      </div>
    </div>

    <div class="menu-heading">Student Workspace</div>

    <ul class="sidebar-menu">
      <li>
        <a href="/sis/my" class="menu-link">
          <i class="fas fa-house"></i>
          Dashboard
        </a>
      </li>
      <li>
        <a href="/sis/my/profile" class="menu-link active" aria-current="page">
          <i class="fas fa-address-card"></i>
          Contact Information
        </a>
      </li>
      <li>
        <a href="/logout" class="menu-link">
          <i class="fas fa-right-from-bracket"></i>
          Logout
        </a>
      </li>
    </ul>

    <div class="sidebar-footer">
      <strong>LuxMind SIS</strong><br>
      Student Information System
    </div>
  </aside>

  <main class="main-content">
    <header class="page-header">
      <div>
        <div class="breadcrumb">
          <a href="/sis/my">Dashboard</a>
          <i class="fas fa-chevron-right"></i>
          <span>Contact Information</span>
        </div>

        <h1>Contact Information</h1>
        <p>Manage your contact details and review your student information.</p>
      </div>

      <a href="/sis/my" class="header-action">
        <i class="fas fa-arrow-left"></i>
        Back to Dashboard
      </a>
    </header>

    <% if (typeof flash !== 'undefined' && flash && flash.success && flash.success.length > 0) { %>
      <div class="success-alert" role="status">
        <i class="fas fa-circle-check"></i>
        <span><%= flash.success[0] %></span>
      </div>
    <% } %>

    <div class="profile-grid">

      <!-- Student identity card -->
      <section class="card identity-card">
        <div class="identity-cover">
          <div class="avatar">
            <%= profile.full_name ? profile.full_name.trim().charAt(0) : 'S' %>
          </div>

          <h2><%= profile.full_name || 'Student' %></h2>

          <span class="student-number">
            <%= profile.admission_number || profile.username || 'Student ID unavailable' %>
          </span>
        </div>

        <div class="identity-body">
          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="identity-detail">
              <span>Program / Class</span>
              <strong><%= profile.class_level || 'Not available' %></strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="identity-detail">
              <span>Current Semester</span>
              <strong>
                <%= profile.current_semester ? 'Semester ' + profile.current_semester : 'Not available' %>
              </strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-user-tie"></i>
            </div>
            <div class="identity-detail">
              <span>Academic Advisor</span>
              <strong><%= profile.advisor_name || 'Not Assigned' %></strong>
            </div>
          </div>

          <div class="identity-item">
            <div class="identity-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="identity-detail">
              <span>Email Address</span>
              <strong><%= profile.email || 'Not available' %></strong>
            </div>
          </div>
        </div>

        <div class="identity-note">
          <i class="fas fa-shield-halved"></i>
          <span>Your academic identity details are displayed for reference. Contact the appropriate university office if any official student information needs correction.</span>
        </div>
      </section>

      <!-- Contact information form -->
      <section class="card form-card">
        <div class="section-heading">
          <div class="section-icon">
            <i class="fas fa-user-pen"></i>
          </div>
          <div>
            <h3>Edit Contact Information</h3>
            <p>Keep your personal and guardian contact details up to date.</p>
          </div>
        </div>

        <form method="POST" action="/sis/my/profile/update">
          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-id-card"></i>
            Student Information
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="full_name">Full Name</label>
              <input
                id="full_name"
                type="text"
                class="form-control"
                value="<%= profile.full_name || '' %>"
                disabled
              >
              <span class="field-hint">This information is managed by the university.</span>
            </div>

            <div class="form-group">
              <label for="student_id">Student ID</label>
              <input
                id="student_id"
                type="text"
                class="form-control"
                value="<%= profile.admission_number || profile.username || '' %>"
                disabled
              >
              <span class="field-hint">Your official student identification.</span>
            </div>
          </div>

          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-address-book"></i>
            Personal Contact Details
          </div>

          <div class="form-grid">
            <div class="form-group full">
              <label for="phone">Phone Number</label>
              <input
                id="phone"
                type="tel"
                name="phone"
                class="form-control"
                value="<%= profile.phone || '' %>"
                placeholder="e.g. +90 533 123 4567"
                autocomplete="tel"
                maxlength="30"
              >
              <span class="field-hint">Provide a phone number where the university can reach you.</span>
            </div>

            <div class="form-group full">
              <label for="home_address">Home Address</label>
              <input
                id="home_address"
                type="text"
                name="home_address"
                class="form-control"
                value="<%= profile.home_address || '' %>"
                placeholder="Enter your home address"
                autocomplete="street-address"
                maxlength="255"
              >
            </div>
          </div>

          <div class="form-divider"></div>

          <div class="form-section-title">
            <i class="fas fa-people-group"></i>
            Guardian Information
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="guardian_name">Guardian Name</label>
              <input
                id="guardian_name"
                type="text"
                name="guardian_name"
                class="form-control"
                value="<%= profile.guardian_name || '' %>"
                placeholder="Guardian's full name"
                autocomplete="name"
                maxlength="150"
              >
            </div>

            <div class="form-group">
              <label for="guardian_phone">Guardian Phone</label>
              <input
                id="guardian_phone"
                type="tel"
                name="guardian_phone"
                class="form-control"
                value="<%= profile.guardian_phone || '' %>"
                placeholder="Guardian's phone number"
                autocomplete="tel"
                maxlength="30"
              >
            </div>

            <div class="form-group full">
              <label for="guardian_relationship">Relationship to Guardian</label>
              <input
                id="guardian_relationship"
                type="text"
                name="guardian_relationship"
                class="form-control"
                value="<%= profile.guardian_relationship || '' %>"
                placeholder="e.g. Father, Mother, Uncle"
                maxlength="80"
              >
            </div>
          </div>

