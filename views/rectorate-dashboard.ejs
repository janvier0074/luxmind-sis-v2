<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rectorate Portal — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    html, body { overflow-x: hidden; max-width: 100vw; width: 100%; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: radial-gradient(circle at 100% 0%, rgba(245,166,35,0.06), transparent 40%), radial-gradient(circle at 0% 100%, rgba(30,77,123,0.05), transparent 40%), var(--ice);
      min-height: 100vh; display: flex; color: var(--navy);
      -webkit-font-smoothing: antialiased;
    }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.8rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--gold); }
    .menu-link i { width: 22px; color: var(--gold); }

    /* Main */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); max-width: calc(100vw - 280px); }
    .page-title { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
    .page-title-icon { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--navy), var(--blue)); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.4rem; }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; color: var(--navy); }
    .page-title p { color: #64748b; font-size: 0.9rem; }

    /* Grids */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-bottom: 1.5rem; }
    .stat-card { background: #fff; padding: 1.2rem; border-radius: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1rem; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .stat-icon.blue { background: #e0f2fe; color: #0284c7; }
    .stat-icon.green { background: #dcfce7; color: #16a34a; }
    .stat-icon.gold { background: #fef3c7; color: #d97706; }
    .stat-icon.red { background: #fee2e2; color: #b91c1c; }
    .stat-info h3 { font-size: 0.7rem; color: #64748b; text-transform: uppercase; font-weight: 700; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; color: var(--navy); margin-top: 0.1rem; }

    .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .card-head { padding: 1.2rem 1.4rem; border-bottom: 1px solid #eef2f7; display: flex; align-items: center; gap: 0.8rem; }
    .card-head i { color: var(--amber); font-size: 1.1rem; }
    .card-head h2 { font-size: 1.05rem; font-weight: 800; }
    .card-body { padding: 1.4rem; }

    /* Financial Bar */
    .fin-bar { display: flex; height: 24px; border-radius: 100px; overflow: hidden; margin-bottom: 0.8rem; }
    .fin-paid { background: var(--success); }
    .fin-out { background: var(--danger); }
    .fin-labels { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; }
    .fin-labels span:first-child { color: var(--success); }
    .fin-labels span:last-child { color: var(--danger); }

    /* Workload Table */
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding-bottom: 0.8rem; font-size: 0.7rem; color: #64748b; text-transform: uppercase; border-bottom: 2px solid var(--frost); }
    td { padding: 0.9rem 0; border-bottom: 1px solid #eef2f7; font-size: 0.85rem; font-weight: 600; }
    tr:last-child td { border-bottom: none; }
    .badge { background: #f1f5f9; padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; color: var(--blue); }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; }
    
    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .split-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; max-width: 100vw !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">R</div>
      <div class="brand-name">LuxMind SIS <span>Rectorate Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/rectorate" class="menu-link active"><i class="fas fa-chart-pie"></i> Executive Summary</a></li>
      <li><a href="#" class="menu-link"><i class="fas fa-file-invoice"></i> Financial Reports</a></li>
      <li><a href="#" class="menu-link"><i class="fas fa-users"></i> Staff Workload</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <header class="page-title">
      <div class="page-title-icon"><i class="fas fa-university"></i></div>
      <div>
        <h1>Executive Summary</h1>
        <p>Live institutional health and academic overview</p>
      </div>
    </header>

    <!-- Top Stats -->
    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-user-graduate"></i></div>
        <div class="stat-info"><h3>Total Students</h3><p><%= stats.students %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon gold"><i class="fas fa-chalkboard-teacher"></i></div>
        <div class="stat-info"><h3>Academic Staff</h3><p><%= stats.teachers %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-book"></i></div>
        <div class="stat-info"><h3>Active Courses</h3><p><%= stats.courses %></p></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon red"><i class="fas fa-triangle-exclamation"></i></div>
        <div class="stat-info"><h3>At-Risk Students</h3><p><%= stats.atRisk %></p></div>
      </div>
    </section>

    <!-- Split Grid: Financial & Workload -->
    <section class="split-grid">
      
      <!-- Financial Pulse -->
      <div class="card">
        <div class="card-head">
          <i class="fas fa-wallet"></i>
          <h2>Financial Pulse (USD)</h2>
        </div>
        <div class="card-body">
          <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem;">University-wide tuition collection status.</p>
          
          <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span style="font-size: 0.8rem; font-weight: 700; color: var(--navy);">Total Billed: $<%= Number(stats.billed).toLocaleString() %></span>
              <span style="font-size: 0.8rem; font-weight: 700; color: var(--navy);">Collected: $<%= Number(stats.paid).toLocaleString() %></span>
            </div>
            <% 
              const total = Number(stats.billed) || 1; 
              const paidPct = Math.round((Number(stats.paid) / total) * 100);
            %>
            <div class="fin-bar">
              <div class="fin-paid" style="width: <%= paidPct %>%;"></div>
              <div class="fin-out" style="width: <%= 100 - paidPct %>%;"></div>
            </div>
            <div class="fin-labels">
              <span><%= paidPct %>% Collected</span>
              <span>$<%= Number(stats.outstanding).toLocaleString() %> Outstanding</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Faculty Workload -->
      <div class="card">
        <div class="card-head">
          <i class="fas fa-users-cog"></i>
          <h2>Top Faculty Workload</h2>
        </div>
        <div class="card-body">
          <table>
            <thead>
              <tr>
                <th>Teacher Name</th>
                <th>Sections</th>
                <th>Students</th>
              </tr>
            </thead>
            <tbody>
              <% workload.forEach(w => { %>
                <tr>
                  <td><strong><%= w.full_name %></strong></td>
                  <td><span class="badge"><%= w.section_count %></span></td>
                  <td><span class="badge"><%= w.student_count %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </section>
  </main>

  <script>
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) { sb.classList.toggle('active'); ov.classList.toggle('active'); }
    }
  </script>
</body>
</html>