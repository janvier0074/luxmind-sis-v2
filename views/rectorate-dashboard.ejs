<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rectorate Command Center — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f4f7f9;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 30px -6px rgba(10,30,50,0.08);
      --shadow-hover: 0 16px 40px -12px rgba(10,30,50,0.15);
      --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    
    html, body { overflow-x: hidden; max-width: 100vw; width: 100%; background: var(--ice); }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      color: var(--navy); min-height: 100vh; display: flex; flex-direction: column;
      background-image: radial-gradient(circle at 100% 0%, rgba(255, 200, 87, 0.1), transparent 40%),
                        radial-gradient(circle at 0% 100%, rgba(30, 77, 123, 0.05), transparent 40%);
    }

    /* --- 1. THE WELCOME SPLASH SCREEN --- */
    .splash-screen {
      position: fixed; inset: 0; z-index: 9999;
      background: linear-gradient(135deg, #ffffff, #f4f7f9);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }
    .splash-screen.hidden { opacity: 0; visibility: hidden; }
    
    .splash-icon {
      width: 80px; height: 80px; background: var(--navy); color: var(--gold);
      border-radius: 20px; display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem; margin-bottom: 2rem;
      box-shadow: 0 20px 40px -10px rgba(10, 30, 50, 0.3);
      animation: pulse 2s infinite;
    }
    .splash-screen h1 {
      font-size: 2.5rem; font-weight: 800; color: var(--navy); letter-spacing: -1px;
      opacity: 0; animation: slideUp 0.8s ease forwards 0.3s;
    }
    .splash-screen p {
      font-size: 1rem; color: #64748b; font-weight: 600; margin-top: 0.5rem;
      letter-spacing: 2px; text-transform: uppercase;
      opacity: 0; animation: slideUp 0.8s ease forwards 0.6s;
    }

    @keyframes pulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(245, 166, 35, 0.4); }
      70% { transform: scale(1.05); box-shadow: 0 0 0 20px rgba(245, 166, 35, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(245, 166, 35, 0); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* --- 2. TOP NAVIGATION (NO SIDEBAR) --- */
    .top-nav { 
      background: rgba(255, 255, 255, 0.8); 
      backdrop-filter: blur(20px);
      padding: 0 3rem; height: 80px;
      display: flex; justify-content: space-between; align-items: center; 
      position: sticky; top: 0; z-index: 1000; 
      border-bottom: 1px solid rgba(10, 30, 50, 0.05);
    }
    .nav-brand { display: flex; align-items: center; gap: 1rem; }
    .nav-brand .mark { width: 40px; height: 40px; background: var(--navy); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.4rem; color: var(--gold); }
    .nav-brand .name { font-size: 1.2rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .nav-brand .name span { display: block; font-size: 0.6rem; color: var(--amber); text-transform: uppercase; letter-spacing: 2px; font-weight: 700; }
    
    .nav-links { display: flex; gap: 1rem; height: 100%; }
    .nav-link { 
      color: #64748b; text-decoration: none; font-size: 0.9rem; font-weight: 700; 
      padding: 0 1rem; display: flex; align-items: center; gap: 0.5rem;
      border-bottom: 3px solid transparent; transition: var(--transition);
    }
    .nav-link:hover, .nav-link.active { color: var(--navy); border-bottom-color: var(--amber); }
    .nav-link i { font-size: 1rem; color: var(--amber); }

    .nav-user { display: flex; align-items: center; gap: 1.5rem; }
    .user-badge { background: var(--navy); color: #fff; padding: 0.6rem 1.2rem; border-radius: 100px; font-size: 0.85rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
    .user-badge i { color: var(--gold); }
    .btn-logout { color: var(--danger); font-size: 1.2rem; text-decoration: none; transition: 0.2s; }
    .btn-logout:hover { transform: scale(1.1); }

    /* Mobile Nav */
    .mobile-nav-btn { display: none; background: none; border: none; color: var(--navy); font-size: 1.5rem; cursor: pointer; }
    .mobile-dropdown { display: none; background: #fff; padding: 1rem; flex-direction: column; gap: 0.5rem; border-bottom: 1px solid var(--frost); }
    .mobile-dropdown a { color: var(--navy); text-decoration: none; padding: 1rem; font-weight: 700; border-radius: 8px; background: #f8fafc; }

    /* --- 3. BENTO GRID MAIN CONTENT --- */
    .main-content { padding: 3rem; max-width: 1700px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: 2rem; }
    
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1rem; }
    .page-header h1 { font-size: 2.2rem; font-weight: 800; color: var(--navy); letter-spacing: -1px; }
    .page-header p { color: #64748b; font-size: 1rem; margin-top: 0.3rem; font-weight: 500; }

    /* Bento Grid System */
    .bento-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    
    /* Cards */
    .bento-card { 
      background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); 
      border: 1px solid rgba(255,255,255,0.5); padding: 2rem; display: flex; flex-direction: column; 
      transition: var(--transition); position: relative; overflow: hidden;
    }
    .bento-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-hover); }
    
    /* Stat Bento Cards */
    .stat-card { grid-column: span 1; }
    .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.5rem; }
    .stat-icon.blue { background: #e0f2fe; color: #0284c7; }
    .stat-icon.gold { background: #fef3c7; color: #d97706; }
    .stat-icon.red { background: #fee2e2; color: #b91c1c; }
    .stat-icon.green { background: #dcfce7; color: #16a34a; }
    .stat-card h3 { font-size: 0.8rem; color: #64748b; text-transform: uppercase; font-weight: 800; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 3rem; font-weight: 800; color: var(--navy); line-height: 1; }
    
    /* Large Panels */
    .panel-left { grid-column: span 2; grid-row: span 2; }
    .panel-right { grid-column: span 2; grid-row: span 1; }
    
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--frost); }
    .panel-header h2 { font-size: 1.3rem; font-weight: 800; color: var(--navy); display: flex; align-items: center; gap: 0.8rem; }
    .panel-header h2 i { color: var(--amber); }
    .badge-count { background: var(--navy); color: var(--gold); padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; }

    /* Task List */
    .task-list { display: flex; flex-direction: column; gap: 1rem; }
    .task-item { background: #f8fafc; border: 1px solid var(--frost); border-radius: 12px; padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; transition: 0.2s; }
    .task-item:hover { background: #fff; border-color: var(--amber); }
    .task-info h4 { font-size: 1.05rem; font-weight: 800; color: var(--navy); margin-bottom: 0.5rem; }
    .task-info p { font-size: 0.85rem; color: #64748b; margin-bottom: 1rem; line-height: 1.5; }
    .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .tag { font-size: 0.65rem; font-weight: 800; padding: 0.3rem 0.8rem; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .tag.dept { background: #e0f2fe; color: #0284c7; }
    .tag.date { background: #f1f5f9; color: #64748b; }
    .tag.status { background: #fef3c7; color: #d97706; }
    
    .btn-mark-done { background: #fff; border: 2px solid var(--success); color: var(--success); padding: 0.6rem 1.2rem; border-radius: 100px; font-weight: 800; font-size: 0.8rem; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 0.5rem; }
    .btn-mark-done:hover { background: var(--success); color: #fff; }

    /* Form */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control { padding: 1rem; border: 1px solid var(--frost); border-radius: 10px; font-family: inherit; font-size: 0.9rem; font-weight: 600; color: var(--navy); background: #f8fafc; outline: none; transition: 0.2s; }
    .form-control:focus { border-color: var(--amber); background: #fff; box-shadow: 0 0 0 4px rgba(245,166,35,0.1); }
    .btn-submit { background: linear-gradient(135deg, var(--navy), var(--deep)); color: #fff; padding: 1.2rem; border: none; border-radius: 10px; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.2s; width: 100%; display: flex; justify-content: center; gap: 0.8rem; box-shadow: 0 10px 20px -5px rgba(10,30,50,0.3); }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 15px 25px -5px rgba(10,30,50,0.4); }

    /* Mobile */
    @media (max-width: 1200px) {
      .bento-grid { grid-template-columns: 1fr 1fr; }
      .panel-left, .panel-right { grid-column: span 2; }
    }
    @media (max-width: 768px) {
      .nav-links, .nav-user { display: none; }
      .mobile-nav-btn { display: block; }
      .top-nav { padding: 0 1.5rem; }
      .main-content { padding: 1.5rem; }
      .page-header h1 { font-size: 1.8rem; }
      .bento-grid { grid-template-columns: 1fr; }
      .panel-left, .panel-right { grid-column: span 1; }
      .form-grid { grid-template-columns: 1fr; }
      .task-item { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

  <!-- 1. THE WELCOME SPLASH SCREEN -->
  <div class="splash-screen" id="splashScreen">
    <div class="splash-icon"><i class="fas fa-university"></i></div>
    <h1>Welcome to the Rectorate Portal</h1>
    <p>Executive Command Center</p>
  </div>

  <!-- 2. TOP NAVIGATION BAR -->
  <nav class="top-nav">
    <div class="nav-brand">
      <div class="mark">R</div>
      <div class="name">Rectorate <span>LuxMind SIS</span></div>
    </div>

    <div class="nav-links">
      <a href="/sis/rectorate" class="nav-link active"><i class="fas fa-satellite-dish"></i> Command Center</a>
      <a href="#" class="nav-link"><i class="fas fa-tasks"></i> SMARTASK</a>
      <a href="/sis/rectorate/graduation" class="nav-link"><i class="fas fa-graduation-cap"></i> Academics</a>
      <a href="#" class="nav-link"><i class="fas fa-building"></i> Admin Affairs</a>
      <a href="#" class="nav-link"><i class="fas fa-chart-line"></i> Reports</a>
    </div>

    <div class="nav-user">
      <div class="user-badge"><i class="fas fa-user-shield"></i> Rectorate Access</div>
      <a href="/logout" class="btn-logout" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
    </div>

    <button class="mobile-nav-btn" onclick="toggleMobileNav()"><i class="fas fa-bars"></i></button>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div class="mobile-dropdown" id="mobileDropdown">
    <a href="/sis/rectorate" class="active"><i class="fas fa-satellite-dish"></i> Command Center</a>
    <a href="#"><i class="fas fa-tasks"></i> SMARTASK</a>
    <a href="/sis/rectorate/graduation"><i class="fas fa-graduation-cap"></i> Academics</a>
    <a href="#"><i class="fas fa-building"></i> Admin Affairs</a>
    <a href="/logout" style="color: var(--danger);"><i class="fas fa-sign-out-alt"></i> Logout</a>
  </div>

  <!-- 3. MAIN BENTO GRID -->
  <main class="main-content">
    
    <header class="page-header">
      <div>
        <h1>Command Center</h1>
        <p>Coordinating university operations and strategic directives.</p>
      </div>
    </header>

    <!-- Bento Grid Layout -->
    <section class="bento-grid">
      
      <!-- 4 Stat Cards -->
      <article class="bento-card stat-card">
        <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
        <h3>Completion Rate</h3>
        <div class="value"><%= stats.completionRate %>%</div>
      </article>
      <article class="bento-card stat-card">
        <div class="stat-icon red"><i class="fas fa-clock"></i></div>
        <h3>Pending Tasks</h3>
        <div class="value"><%= stats.pendingTasks %></div>
      </article>
      <article class="bento-card stat-card">
        <div class="stat-icon blue"><i class="fas fa-user-graduate"></i></div>
        <h3>Total Students</h3>
        <div class="value"><%= stats.students %></div>
      </article>
      <article class="bento-card stat-card">
        <div class="stat-icon gold"><i class="fas fa-chalkboard-teacher"></i></div>
        <h3>Staff Members</h3>
        <div class="value"><%= stats.teachers %></div>
      </article>

      <!-- Active Tasks Panel -->
      <article class="bento-card panel-left">
        <div class="panel-header">
          <h2><i class="fas fa-satellite"></i> Active Directives</h2>
          <span class="badge-count"><%= tasks.length %> Active</span>
        </div>
        <div class="task-list">
          <% if (tasks.length === 0) { %>
            <p style="text-align: center; color: #94a3b8; padding: 2rem;">No active tasks. Issue a directive on the right.</p>
          <% } %>
          <% tasks.forEach(t => { %>
            <div class="task-item">
              <div class="task-info">
                <h4><%= t.title %></h4>
                <p><%= t.description %></p>
                <div class="tags">
                  <span class="tag dept"><i class="fas fa-building"></i> <%= t.assigned_to_dept %></span>
                  <span class="tag date"><i class="far fa-calendar-alt"></i> <%= t.deadline ? new Date(t.deadline).toLocaleDateString() : 'N/A' %></span>
                  <span class="tag status <%= t.status.toLowerCase() %>"><%= t.status %></span>
                </div>
              </div>
              <% if (t.status !== 'Completed') { %>
                <form action="/sis/rectorate/tasks/<%= t.id %>/complete" method="POST">
                  <button type="submit" class="btn-mark-done"><i class="fas fa-check"></i> Done</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </article>

      <!-- Issue Directive Form Panel -->
      <article class="bento-card panel-right">
        <div class="panel-header">
          <h2><i class="fas fa-bullhorn"></i> Issue Directive</h2>
        </div>
        <form action="/sis/rectorate/tasks/create" method="POST">
          <div class="form-grid">
            <div class="form-group full">
              <label>Directive Title</label>
              <input type="text" name="title" class="form-control" required placeholder="e.g., Speed up student registration">
            </div>
            <div class="form-group">
              <label>Assign To Department</label>
              <select name="assigned_to_dept" class="form-control" required>
                <option value="Registrar">Registrar's Office</option>
                <option value="Faculty">Faculty / Deans</option>
                <option value="Finance">Accounting</option>
                <option value="IT">Computer Center</option>
                <option value="Student Affairs">Student Services</option>
              </select>
            </div>
            <div class="form-group">
              <label>Deadline</label>
              <input type="date" name="deadline" class="form-control" required>
            </div>
            <div class="form-group full">
              <label>Expected Outcome</label>
              <textarea name="description" class="form-control" rows="2" required placeholder="Explain what needs to be done..."></textarea>
            </div>
          </div>
          <button type="submit" class="btn-submit"><i class="fas fa-paper-plane"></i> Dispatch Task</button>
        </form>
      </article>

    </section>
  </main>

  <script>
    // 1. Splash Screen Logic (Fades out after 1.5 seconds)
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        const splash = document.getElementById('splashScreen');
        if (splash) {
          splash.classList.add('hidden');
        }
      }, 1500); // 1.5 seconds
    });

    // 2. Mobile Nav Logic
    function toggleMobileNav() {
      const menu = document.getElementById('mobileDropdown');
      menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
    }
  </script>
</body>
</html>