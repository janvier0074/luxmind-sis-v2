<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rectorate Command Center — LuxMind SIS</title>
  
  <!-- ⚠️ SAFETY CHECK -->
  <% 
    const safeStats = typeof stats !== 'undefined' ? stats : { completionRate: 0, pendingTasks: 0, students: 0, teachers: 0, billed: 0, paid: 0 }; 
    const safeTasks = typeof tasks !== 'undefined' ? tasks : []; 
  %>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            navy: { 950: '#040d18', 900: '#0a1e32', 800: '#0f2a44', 700: '#153658', 600: '#1e4d7b', 500: '#2d6a9f' },
            amber: { 500: '#f5a623', 400: '#ffb73d' },
            gold: { 500: '#ffc857', 400: '#ffd57e' },
            ice: { 50: '#f8fafc', 100: '#f4f7f9', 200: '#e6edf3' }
          },
          fontFamily: { sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: rgba(10, 30, 50, 0.05); }
    .dark ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
    ::-webkit-scrollbar-thumb { background: #1e4d7b; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #f5a623; }

    .glass-panel { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    .dark .glass-panel { background: rgba(15, 42, 68, 0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-color: rgba(255, 255, 255, 0.08); }
    
    @keyframes liveBeacon { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.8); } }
    .live-beacon { animation: liveBeacon 1.6s infinite ease-in-out; }
  </style>
</head>
<body class="bg-ice-100 dark:bg-navy-950 text-navy-900 dark:text-slate-100 font-sans min-h-screen flex flex-col md:flex-row transition-colors duration-300 antialiased overflow-x-hidden">

  <!-- MOBILE HEADER -->
  <header class="md:hidden sticky top-0 z-40 bg-navy-900 text-white px-4 py-3 flex items-center justify-between border-b border-navy-800 shadow-md">
    <div class="flex items-center gap-3">
      <figure class="w-9 h-9 bg-navy-800 rounded-lg flex items-center justify-center font-black text-gold-500 border border-amber-500/30">R</figure>
      <div>
        <h1 class="font-extrabold text-sm leading-tight">Rectorate Portal</h1>
        <p class="text-[10px] text-amber-400 font-semibold tracking-wider uppercase">LuxMind SIS</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-lg bg-navy-800 text-amber-400 flex items-center justify-center text-sm"><i class="fas fa-moon dark:hidden"></i><i class="fas fa-sun hidden dark:block"></i></button>
      <button onclick="openSidebarDrawer()" class="w-9 h-9 rounded-lg bg-amber-500 text-navy-950 flex items-center justify-center text-lg font-bold"><i class="fas fa-bars"></i></button>
    </div>
  </header>

  <button id="mobileBackdrop" onclick="closeSidebarDrawer()" class="fixed inset-0 z-40 bg-navy-950/70 backdrop-blur-sm hidden md:hidden opacity-0 transition-opacity duration-300"></button>

  <!-- MASSIVE SIDEBAR -->
  <aside id="sidebar" class="fixed md:sticky top-0 inset-y-0 left-0 z-50 w-72 bg-navy-900 text-white flex flex-col justify-between border-r border-navy-800 shadow-2xl md:shadow-none transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out h-screen overflow-y-auto">
    <div class="p-6 border-b border-navy-800/80 shrink-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <figure class="w-11 h-11 bg-navy-800 rounded-xl flex items-center justify-center font-black text-xl text-gold-500 shadow-md border border-amber-500/30">R</figure>
          <div>
            <h2 class="font-extrabold text-base tracking-tight leading-tight text-white">LuxMind SIS</h2>
            <p class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mt-0.5">Rectorate Access</p>
          </div>
        </div>
        <button onclick="closeSidebarDrawer()" class="md:hidden text-slate-400 hover:text-white p-1 text-lg"><i class="fas fa-times"></i></button>
      </div>
      <div class="mt-4 px-3 py-1.5 bg-navy-800/80 rounded-lg border border-navy-700/60 flex items-center justify-between text-[11px]">
        <span class="text-slate-300 font-semibold flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-400 live-beacon"></span> Haspolat Campus</span>
        <span class="text-amber-400 font-bold">CYPRUS</span>
      </div>
    </div>

    <nav class="px-3 py-4 flex-1 overflow-y-auto space-y-2 scrollbar-thin scrollbar-thumb-navy-700 scrollbar-track-transparent">
      <div class="mb-4">
        <a href="/sis/rectorate" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-navy-950 shadow-md transition-all">
          <i class="fas fa-satellite-dish text-sm"></i> Command Center
        </a>
      </div>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-comments text-amber-500"></i> Communication</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="#" onclick="openModal('broadcastModal'); return false;" class="block py-1.5 text-amber-400 font-bold hover:text-white">Campus Broadcasts</a>
          <a href="#" class="block py-1.5 text-slate-400 hover:text-white">Message Deans</a>
          <a href="#" class="block py-1.5 text-slate-400 hover:text-white">Message Registrar</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-graduation-cap text-amber-500"></i> Academic Affairs</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/graduation" class="block py-1.5 text-slate-400 hover:text-white">Graduation Pipeline</a>
          <a href="/sis/rectorate/senate" class="block py-1.5 text-slate-400 hover:text-white">Senate Approvals</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-users text-amber-500"></i> Student Affairs</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/student-affairs" class="block py-1.5 text-slate-400 hover:text-white">Student Oversight</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-chalkboard-teacher text-amber-500"></i> Human Resources</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/hr" class="block py-1.5 text-slate-400 hover:text-white">Faculty Workload</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-wallet text-amber-500"></i> Financial Affairs</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/finance" class="block py-1.5 text-slate-400 hover:text-white">Financial Directorate</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-building text-amber-500"></i> Admin Directorates</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/registrar" class="block py-1.5 text-slate-400 hover:text-white">Registrar Oversight</a>
        </div>
      </details>

      <details class="group border-t border-navy-800 pt-2">
        <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-[11px] font-extrabold uppercase tracking-wider text-white hover:bg-navy-800 cursor-pointer list-none">
          <div class="flex items-center gap-2"><i class="fas fa-tasks text-amber-500"></i> SMARTASK Workflow</div>
          <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="pl-4 pr-1 py-1 space-y-1 text-[11px]">
          <a href="/sis/rectorate/kpis" class="block py-1.5 text-slate-400 hover:text-white">Performance KPIs</a>
        </div>
      </details>

      <div class="border-t border-navy-800 pt-2 mb-8">
        <a href="#" class="flex items-center gap-2 px-3 py-2 rounded-xl text-[11px] font-bold text-slate-300 hover:bg-navy-800 hover:text-white transition-all">
          <i class="fas fa-shield-alt text-amber-500"></i> System Audit Log
        </a>
      </div>
    </nav>

    <footer class="p-4 border-t border-navy-800 bg-navy-950/60 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <figure class="w-9 h-9 rounded-full bg-amber-500 text-navy-950 font-black flex items-center justify-center text-xs shadow-inner">RC</figure>
        <div class="truncate">
          <h4 class="text-xs font-extrabold text-white truncate">Rectorate Office</h4>
          <p class="text-[10px] text-slate-400 font-semibold truncate">Executive Council</p>
        </div>
      </div>
      <a href="/logout" class="text-slate-400 hover:text-rose-400 p-2 text-sm transition-colors" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
    </footer>
  </aside>

  <!-- MAIN DASHBOARD CONTENT -->
  <main class="flex-1 max-w-[1700px] mx-auto px-4 sm:px-6 md:px-8 py-6 w-full space-y-6">
    
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-navy-800">
      <div>
        <div class="flex items-center gap-2 text-[11px] font-extrabold text-amber-600 dark:text-amber-400 uppercase tracking-widest"><i class="fas fa-landmark"></i> University Governance</div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-900 dark:text-white tracking-tight mt-0.5">Master Command Center</h1>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">Coordinate directives, monitor performance, and communicate with the university.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button onclick="openModal('broadcastModal')" class="px-3.5 py-2 bg-navy-900 dark:bg-amber-500 text-white dark:text-navy-950 font-extrabold rounded-xl text-xs flex items-center gap-2 shadow-md hover:opacity-90 transition-all"><i class="fas fa-bullhorn"></i> Campus Broadcast</button>
        <button onclick="toggleDarkMode()" class="flex w-10 h-10 rounded-xl bg-white dark:bg-navy-800 text-slate-700 dark:text-amber-400 border border-slate-200 dark:border-navy-700 items-center justify-center hover:bg-slate-50 transition-all shadow-sm"><i class="fas fa-moon text-sm dark:hidden"></i><i class="fas fa-sun text-sm hidden dark:block"></i></button>
      </div>
    </header>

    <!-- 1. STATS ROW -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-chart-pie"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Completion Rate</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= safeStats.completionRate %>%</div>
        <div class="w-full bg-slate-100 dark:bg-navy-800 h-1.5 rounded-full mt-2 overflow-hidden"><div class="bg-emerald-500 h-full rounded-full" style="width: <%= safeStats.completionRate %>%"></div></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-clock"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Pending Tasks</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= safeStats.pendingTasks %></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-user-graduate"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Total Students</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight"><%= safeStats.students %></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-2xl border border-slate-200/80 dark:border-navy-800 shadow-sm">
        <div class="flex justify-between items-start mb-3">
          <figure class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center text-lg font-bold"><i class="fas fa-wallet"></i></figure>
        </div>
        <h3 class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-0.5">Revenue Collected</h3>
        <div class="text-2xl font-extrabold text-navy-900 dark:text-white tracking-tight">$<%= Number(safeStats.paid).toLocaleString() %></div>
      </article>
    </section>

    <!-- 2. CHARTS & FEED ROW -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-4 rounded-xl border border-slate-200/80 dark:border-navy-800 shadow-sm flex flex-col">
        <h2 class="font-extrabold text-xs text-navy-900 dark:text-white mb-2 flex items-center gap-1"><i class="fas fa-chart-bar text-amber-500"></i> Dept Workload</h2>
        <div class="flex-1 min-h-[150px] relative"><canvas id="deptChart"></canvas></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-4 rounded-xl border border-slate-200/80 dark:border-navy-800 shadow-sm flex flex-col">
        <h2 class="font-extrabold text-xs text-navy-900 dark:text-white mb-2 flex items-center gap-1"><i class="fas fa-chart-line text-emerald-500"></i> Resolution Velocity</h2>
        <div class="flex-1 min-h-[150px] relative"><canvas id="trendChart"></canvas></div>
      </article>

      <article class="glass-panel bg-white dark:bg-navy-900/80 p-4 rounded-xl border border-slate-200/80 dark:border-navy-800 shadow-sm flex flex-col">
        <div class="flex justify-between items-center mb-2">
          <h2 class="font-extrabold text-xs text-navy-900 dark:text-white flex items-center gap-1"><i class="fas fa-rss text-rose-500 live-beacon"></i> Live Campus Feed</h2>
          <button onclick="toggleFeed()" id="feedBtn" class="text-[10px] font-bold text-slate-400 hover:text-amber-500"><i class="fas fa-pause"></i> Pause</button>
        </div>
        <nav id="activityStream" class="space-y-1.5 overflow-y-auto max-h-[150px] pr-1 text-[10px]"></nav>
      </article>
    </section>

    <!-- 3. TASKS & FORM ROW -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">
      
      <!-- TASKS LIST -->
      <article class="lg:col-span-2 glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-xl border border-slate-200/80 dark:border-navy-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-navy-800">
          <h2 class="text-sm font-extrabold text-navy-900 dark:text-white flex items-center gap-2"><i class="fas fa-satellite text-amber-500"></i> Active University Directives</h2>
          <span class="bg-navy-900 dark:bg-amber-500 text-gold-500 dark:text-navy-950 text-[10px] font-black px-2 py-0.5 rounded-full"><%= safeTasks.length %> Active</span>
        </div>

        <div class="space-y-2">
          <% if (safeTasks.length === 0) { %>
            <p class="text-center text-xs text-slate-400 py-4">No active tasks. Issue a directive on the right.</p>
          <% } %>

          <% safeTasks.forEach(item => { %>
            <div class="p-3 bg-slate-50/90 dark:bg-navy-800/60 border border-slate-200/80 dark:border-navy-700/60 rounded-xl flex flex-col md:flex-row md:items-center justify-between gap-2 group">
              <div class="space-y-1 flex-1">
                <div class="flex flex-wrap items-center gap-1.5 text-[9px]">
                  <span class="font-bold px-1.5 py-0.5 rounded-full <%= item.status === 'Completed' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %> flex items-center gap-1"><i class="fas <%= item.status === 'Completed' ? 'fa-check-circle' : 'fa-clock' %>"></i> <%= item.status %></span>
                  <span class="font-bold px-1.5 py-0.5 rounded-md bg-slate-200/70 dark:bg-navy-700 text-navy-900 dark:text-slate-200"><i class="fas fa-building text-amber-500"></i> <%= item.assigned_to_dept %></span>
                </div>
                <h3 class="font-bold text-navy-900 dark:text-white text-xs group-hover:text-amber-500 transition-colors"><%= item.title %></h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-300 leading-snug line-clamp-2"><%= item.description %></p>
                <div class="text-[9px] text-slate-400 flex items-center gap-3 pt-0.5">
                  <span><i class="far fa-calendar-alt text-amber-500"></i> Due: <strong><%= item.deadline ? new Date(item.deadline).toLocaleDateString() : 'N/A' %></strong></span>
                  <span><i class="fas fa-hashtag"></i> DIR-<%= item.id %></span>
                </div>
              </div>

              <% if (item.status !== 'Completed') { %>
                <form action="/sis/rectorate/tasks/<%= item.id %>/complete" method="POST">
                  <button type="submit" class="px-2.5 py-1 bg-emerald-500/10 hover:bg-emerald-500 text-emerald-600 hover:text-white border border-emerald-500/30 rounded-lg text-[10px] font-bold transition-all whitespace-nowrap"><i class="fas fa-check"></i> Mark Done</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </article>

      <!-- ISSUE NEW DIRECTIVE FORM -->
      <article class="glass-panel bg-white dark:bg-navy-900/80 p-5 rounded-xl border border-slate-200/80 dark:border-navy-800 shadow-sm space-y-3">
        <div class="pb-2 border-b border-slate-100 dark:border-navy-800">
          <h2 class="text-sm font-extrabold text-navy-900 dark:text-white flex items-center gap-2"><i class="fas fa-bullhorn text-amber-500"></i> Dispatch Task</h2>
        </div>

        <form action="/sis/rectorate/tasks/create" method="POST" class="space-y-2.5">
          <div>
            <label class="block text-[9px] font-extrabold uppercase tracking-wider text-slate-500 mb-0.5">Task Title *</label>
            <input type="text" name="title" required placeholder="e.g. Midterm Exam Schedule" class="w-full px-2.5 py-1.5 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-lg text-xs font-semibold focus:outline-none focus:border-amber-500">
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[9px] font-extrabold uppercase tracking-wider text-slate-500 mb-0.5">Assign To *</label>
              <select name="assigned_to_dept" required class="w-full px-2 py-1.5 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-lg text-xs font-semibold focus:outline-none">
                <option value="Registrar">Registrar</option>
                <option value="Faculty">Faculty Deans</option>
                <option value="Finance">Finance</option>
                <option value="IT">IT Center</option>
                <option value="Student Affairs">Student Affairs</option>
              </select>
            </div>
            <div>
              <label class="block text-[9px] font-extrabold uppercase tracking-wider text-slate-500 mb-0.5">Deadline *</label>
              <input type="date" name="deadline" required class="w-full px-2 py-1.5 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-lg text-xs font-semibold focus:outline-none">
            </div>
          </div>

          <div>
            <label class="block text-[9px] font-extrabold uppercase tracking-wider text-slate-500 mb-0.5">Instructions *</label>
            <textarea name="description" rows="2" required placeholder="Expected outcome..." class="w-full px-2.5 py-1.5 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-lg text-xs font-semibold focus:outline-none resize-none"></textarea>
          </div>

          <button type="submit" class="w-full py-2 bg-navy-900 dark:bg-amber-500 hover:bg-navy-800 dark:hover:bg-amber-600 text-white dark:text-navy-950 font-extrabold text-xs rounded-lg shadow transition-all"><i class="fas fa-paper-plane mr-1"></i> Dispatch</button>
        </form>
      </article>
    </section>
  </main>

  <!-- BROADCAST MODAL -->
  <aside id="broadcastModal" class="fixed inset-0 z-50 bg-navy-950/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <article class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center border-b border-slate-100 dark:border-navy-800 pb-3">
        <h3 class="font-extrabold text-navy-900 dark:text-white text-sm flex items-center gap-2"><i class="fas fa-bullhorn text-amber-500"></i> Campus Broadcast</h3>
        <button onclick="closeModal('broadcastModal')" class="text-slate-400 hover:text-white"><i class="fas fa-times"></i></button>
      </div>
      <form action="/sis/rectorate/broadcast" method="POST" class="space-y-3">
        <div>
          <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Title</label>
          <input type="text" name="title" required placeholder="e.g. Campus Closure Notice" class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl text-xs font-semibold focus:outline-none">
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Message</label>
          <textarea name="message" rows="3" required placeholder="Announcement details..." class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl text-xs font-semibold focus:outline-none resize-none"></textarea>
        </div>
        <div class="flex justify-end gap-2 pt-2 border-t border-slate-100 dark:border-navy-800">
          <button type="button" onclick="closeModal('broadcastModal')" class="px-3 py-1.5 bg-slate-100 dark:bg-navy-800 font-bold text-xs rounded-xl">Cancel</button>
          <button type="submit" class="px-4 py-1.5 bg-amber-500 text-navy-950 font-extrabold text-xs rounded-xl hover:bg-amber-400 transition-all">Publish Broadcast</button>
        </div>
      </form>
    </article>
  </aside>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const deadlineInput = document.querySelector('input[name="deadline"]');
      if (deadlineInput) {
        const targetDate = new Date();
        targetDate.setDate(targetDate.getDate() + 7);
        deadlineInput.value = targetDate.toISOString().split('T')[0];
      }
      renderActivityStream();
      initCharts();
      startLiveActivityFeed();
    });

    function openSidebarDrawer() { document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('mobileBackdrop').classList.remove('hidden'); setTimeout(() => document.getElementById('mobileBackdrop').classList.remove('opacity-0'), 10); }
    function closeSidebarDrawer() { document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('mobileBackdrop').classList.add('opacity-0'); setTimeout(() => document.getElementById('mobileBackdrop').classList.add('hidden'), 300); }
    function toggleDarkMode() { document.documentElement.classList.toggle('dark'); setTimeout(initCharts, 200); }

    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

    let workloadChartInstance = null;
    let trendChartInstance = null;
    const realTasks = <%- JSON.stringify(safeTasks) %>;

    function initCharts() {
      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#94a3b8' : '#64748b';
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

      const ctx1 = document.getElementById('deptChart').getContext('2d');
      if (workloadChartInstance) workloadChartInstance.destroy();
      
      const depts = ["Registrar", "Faculty", "Finance", "IT", "Student Affairs"];
      const counts = depts.map(dept => realTasks.filter(d => d.assigned_to_dept === dept).length);

      workloadChartInstance = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: depts,
          datasets: [{ data: counts, backgroundColor: ['#f5a623', '#1e4d7b', '#10b981', '#6366f1', '#ec4899'], borderRadius: 4 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: textColor, font: { size: 8 } }, grid: { display: false } }, y: { ticks: { color: textColor, stepSize: 1 }, grid: { color: gridColor } } } }
      });

      const ctx2 = document.getElementById('trendChart').getContext('2d');
      if (trendChartInstance) trendChartInstance.destroy();
      
      trendChartInstance = new Chart(ctx2, {
        type: 'line',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{ data: [72, 75, 78, 81, 85, 87, <%= safeStats.completionRate %>], borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0.1)', fill: true, tension: 0.35, pointRadius: 2 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: textColor, font: { size: 8 } }, grid: { display: false } }, y: { ticks: { color: textColor, font: { size: 8 } }, grid: { color: gridColor } } } }
      });
    }

    let activityLog = [
      { icon: "fa-check-circle", color: "text-emerald-500", text: "Registrar approved 85 graduation files.", time: "4m ago" },
      { icon: "fa-certificate", color: "text-amber-500", text: "YÖK accreditation audit draft uploaded.", time: "18m ago" }
    ];
    let feedInterval = null;
    let isFeedPaused = false;

    function renderActivityStream() {
      const container = document.getElementById('activityStream');
      if (!container) return;
      container.innerHTML = '';
      activityLog.forEach(item => {
        container.innerHTML += `
          <div class="flex items-start gap-2 p-1.5 bg-slate-50 dark:bg-navy-800/50 rounded border border-slate-100 dark:border-navy-700/50">
            <i class="fas ${item.icon} ${item.color} mt-0.5 text-[10px]"></i>
            <div class="flex-1">
              <p class="font-bold text-navy-900 dark:text-slate-200 text-[10px] leading-tight">${item.text}</p>
              <span class="text-[8px] text-slate-400 font-semibold">${item.time}</span>
            </div>
          </div>
        `;
      });
    }

    function addActivityLog(icon, color, text) {
      activityLog.unshift({ icon, color, text, time: "Just now" });
      if (activityLog.length > 5) activityLog.pop();
      renderActivityStream();
    }

    function startLiveActivityFeed() {
      const events = [
        { icon: "fa-university", color: "text-sky-400", text: "Engineering Dean logged 35 lab waivers." },
        { icon: "fa-laptop-code", color: "text-emerald-400", text: "IT synced Haspolat Wi-Fi portal nodes." },
        { icon: "fa-coins", color: "text-amber-400", text: "Accounting finalized semester scholarship audit." },
        { icon: "fa-user-graduate", color: "text-indigo-400", text: "Registrar issued 40 degree transcripts." }
      ];

      feedInterval = setInterval(() => {
        if (!isFeedPaused) {
          const item = events[Math.floor(Math.random() * events.length)];
          addActivityLog(item.icon, item.color, item.text);
        }
      }, 14000);
    }

    function toggleFeed() {
      isFeedPaused = !isFeedPaused;
      const btn = document.getElementById('feedBtn');
      if (isFeedPaused) { btn.innerHTML = `<i class="fas fa-play"></i> Resume`; btn.classList.add('text-amber-500'); }
      else { btn.innerHTML = `<i class="fas fa-pause"></i> Pause`; btn.classList.remove('text-amber-500'); }
    }
  </script>
</body>
</html>