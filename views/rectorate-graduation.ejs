<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Graduation Pipeline — LuxMind SIS</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
    }
    html, body { overflow-x: hidden; max-width: 100vw; width: 100%; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--ice); min-height: 100vh; display: flex; color: var(--navy);
    }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.65rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.8rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.85rem; }
    .menu-link .arrow { margin-left: auto; font-size: 0.6rem; transition: transform 0.3s; }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.18); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 2.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* Main */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); display: flex; flex-direction: column; gap: 1.5rem; }
    .page-title { display: flex; align-items: center; gap: 1rem; }
    .page-title-icon { width: 56px; height: 56px; border-radius: 16px; background: var(--navy); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .page-title h1 { font-size: 1.7rem; font-weight: 800; }
    .page-title p { color: #64748b; font-size: 0.9rem; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
    .stat-card { background: #fff; padding: 1.2rem; border-radius: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); display: flex; align-items: center; gap: 1rem; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .stat-icon.blue { background: #e0f2fe; color: #0284c7; }
    .stat-icon.green { background: #dcfce7; color: #16a34a; }
    .stat-icon.gold { background: #fef3c7; color: #d97706; }
    .stat-icon.red { background: #fee2e2; color: #b91c1c; }
    .stat-info h3 { font-size: 0.7rem; color: #64748b; text-transform: uppercase; }
    .stat-info p { font-size: 1.5rem; font-weight: 800; }

    /* Table */
    .table-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .table-wrap { width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 800px; }
    th { background: #f8fafc; color: #64748b; font-size: 0.7rem; text-transform: uppercase; padding: 1rem 1.4rem; text-align: left; }
    td { padding: 1rem 1.4rem; border-bottom: 1px solid #eef2f7; font-size: 0.85rem; font-weight: 600; }
    .badge { padding: 0.3rem 0.7rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; }
    .badge.ontrack { background: #dcfce7; color: #15803d; }
    .badge.delayed { background: #fef3c7; color: #b45309; }
    .badge.atrisk { background: #fee2e2; color: #991b1b; }

    /* Mobile */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .stats-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">R</div>
      <div class="brand-name">LuxMind SIS <span>Rectorate Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/rectorate" class="menu-link"><i class="fas fa-chart-pie main-icon"></i> Command Center</a></li>
      <li class="menu-item">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-tasks main-icon"></i> SMARTASK Coordination <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu">
          <li class="menu-item"><a href="/sis/rectorate" class="menu-link">Active Directives</a></li>
        </ul>
      </li>
      <li class="menu-item open">
        <a href="#" class="menu-link" onclick="toggle(event, this)">
          <i class="fas fa-university main-icon"></i> Academic Affairs <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item"><a href="#" class="menu-link">Senate Approvals</a></li>
          <li class="menu-item"><a href="/sis/rectorate/graduation" class="menu-link active">Graduation Pipeline</a></li>
          <li class="menu-item"><a href="#" class="menu-link">Faculty Performance</a></li>
        </ul>
      </li>
      <li class="menu-item"><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <header class="page-title">
      <div class="page-title-icon"><i class="fas fa-user-graduate"></i></div>
      <div>
        <h1>Graduation Pipeline</h1>
        <p>Monitor cohorts and ensure students are on track to graduate</p>
      </div>
    </header>

    <section class="stats-grid">
      <div class="stat-card"><div class="stat-icon blue"><i class="fas fa-users"></i></div><div class="stat-info"><h3>Total Cohort</h3><p><%= stats.total %></p></div></div>
      <div class="stat-card"><div class="stat-icon green"><i class="fas fa-check-circle"></i></div><div class="stat-info"><h3>On Track</h3><p><%= stats.onTrack %></p></div></div>
      <div class="stat-card"><div class="stat-icon gold"><i class="fas fa-hourglass-half"></i></div><div class="stat-info"><h3>Delayed</h3><p><%= stats.delayed %></p></div></div>
      <div class="stat-card"><div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div><div class="stat-info"><h3>At Risk</h3><p><%= stats.atRisk %></p></div></div>
    </section>

    <section class="table-card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Student Name</th><th>ID</th><th>Semester</th><th>Earned Credits</th><th>CGPA</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% students.forEach(st => { %>
              <tr>
                <td><strong><%= st.full_name %></strong></td>
                <td><%= st.admission_number || '—' %></td>
                <td>Semester <%= st.current_semester %></td>
                <td><%= st.earned_credits %> / 120</td>
                <td><%= st.cgpa.toFixed(2) %> / 4.00</td>
                <td>
                  <% if (st.status === 'On Track') { %><span class="badge ontrack">On Track</span>
                  <% } else if (st.status === 'Delayed') { %><span class="badge delayed">Delayed</span>
                  <% } else { %><span class="badge atrisk">At Risk</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <script>
    function toggle(event, element) { event.preventDefault(); const p = element.parentElement; p.classList.toggle('open'); const s = p.querySelector('.submenu'); if(s) s.classList.toggle('open'); }
    function toggleMobileMenu() { const sb = document.getElementById('sidebar'); const ov = document.getElementById('sidebarOverlay'); if (sb && ov) { sb.classList.toggle('active'); ov.classList.toggle('active'); } }
  </script>
</body>
</html>