
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#087f5b">
  <title>Registrar Withdrawal Office — LuxMind SIS</title>

  <style>
    :root {
      --green:#087f5b;
      --green-dark:#066747;
      --green-light:#eaf7f1;
      --ink:#172b24;
      --muted:#73827b;
      --line:#e5ede8;
      --bg:#f4f8f5;
      --white:#fff;
      --red:#c0392b;
      --red-light:#fff0ee;
      --amber:#a45b08;
      --amber-light:#fff5e5;
      --blue:#2459a6;
      --blue-light:#edf3ff;
      --shadow:0 8px 25px rgba(20,55,38,.055);
    }

    * { box-sizing:border-box; }

    body {
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font-family:Inter,"Segoe UI",Arial,sans-serif;
      font-size:14px;
    }

    button,input,select,textarea { font:inherit; }
    button { cursor:pointer; }

    .topbar {
      min-height:64px;
      background:#fff;
      border-bottom:1px solid var(--line);
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:0 25px;
      position:sticky;
      top:0;
      z-index:10;
    }

    .brand {
      font-size:19px;
      font-weight:850;
      letter-spacing:-.5px;
    }

    .brand span { color:#0e9f6e; }

    .brand small {
      color:#87958e;
      font-size:10px;
      letter-spacing:1px;
      margin-left:3px;
    }

    .back {
      text-decoration:none;
      color:var(--ink);
      border:1px solid var(--line);
      background:#fff;
      padding:9px 13px;
      border-radius:9px;
      font-size:12px;
      font-weight:750;
      transition:.2s;
    }

    .back:hover {
      background:var(--green-light);
      border-color:#b8dfca;
      color:var(--green-dark);
    }

    main {
      width:min(1200px,100%);
      margin:27px auto;
      padding:0 19px 45px;
    }

    .hero {
      background:linear-gradient(120deg,#075d43,#0b9569 68%,#19a879);
      color:#fff;
      padding:25px;
      border-radius:17px;
      margin-bottom:18px;
      position:relative;
      overflow:hidden;
      box-shadow:0 12px 30px rgba(8,127,91,.14);
    }

    .hero:after {
      content:"";
      position:absolute;
      width:220px;
      height:220px;
      border:35px solid rgba(255,255,255,.08);
      border-radius:50%;
      right:-65px;
      top:-105px;
    }

    .eyebrow {
      font-size:10px;
      font-weight:850;
      letter-spacing:1.6px;
      text-transform:uppercase;
      opacity:.85;
    }

    h1 {
      font-size:27px;
      letter-spacing:-.8px;
      margin:7px 0;
    }

    .subtitle {
      max-width:650px;
      color:#e0f5e9;
      font-size:12px;
      line-height:1.7;
      margin:0;
    }

    .notice {
      display:flex;
      gap:11px;
      align-items:flex-start;
      background:#eaf6f0;
      border:1px solid #d2e9dc;
      color:#245c46;
      padding:13px 15px;
      border-radius:12px;
      margin-bottom:17px;
      font-size:12px;
      line-height:1.6;
    }

    .notice-icon {
      flex:0 0 27px;
      width:27px;
      height:27px;
      display:grid;
      place-items:center;
      background:#d5eddf;
      border-radius:8px;
      font-weight:900;
    }

    .stats {
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
      margin-bottom:18px;
    }

    .stat {
      background:#fff;
      border:1px solid var(--line);
      border-radius:13px;
      padding:15px;
      box-shadow:var(--shadow);
      position:relative;
      overflow:hidden;
    }

    .stat:before {
      content:"";
      position:absolute;
      left:0;
      top:0;
      bottom:0;
      width:4px;
      background:var(--green);
    }

    .stat.blue:before { background:#4779d1; }
    .stat.amber:before { background:#e4a13b; }
    .stat.red:before { background:#d45a50; }

    .stat small {
      display:block;
      color:var(--muted);
      font-size:10px;
      font-weight:700;
    }

    .stat strong {
      display:block;
      font-size:25px;
      letter-spacing:-.7px;
      margin-top:6px;
    }

    .stat .hint {
      display:block;
      font-size:10px;
      color:#91a097;
      margin-top:3px;
    }

    .toolbar {
      display:flex;
      gap:9px;
      flex-wrap:wrap;
      margin:17px 0 13px;
    }

    .toolbar input,.toolbar select {
      min-height:40px;
      padding:9px 12px;
      border:1px solid var(--line);
      background:#fff;
      border-radius:9px;
      color:var(--ink);
      font-size:12px;
      outline:none;
    }

    .toolbar input {
      flex:1;
      min-width:210px;
    }

    .toolbar select { min-width:175px; }

    .toolbar input:focus,.toolbar select:focus,
    .modal input:focus,.modal select:focus,.modal textarea:focus {
      border-color:#72b99a;
      box-shadow:0 0 0 3px rgba(8,127,91,.09);
      outline:none;
    }

    .panel {
      background:#fff;
      border:1px solid var(--line);
      border-radius:14px;
      overflow:hidden;
      box-shadow:var(--shadow);
    }

    .panel-heading {
      padding:15px 17px;
      border-bottom:1px solid var(--line);
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
    }

    .panel-heading h2 {
      margin:0;
      font-size:14px;
    }

    .record-count {
      color:var(--muted);
      font-size:10px;
      font-weight:700;
    }

    .request {
      padding:17px;
      border-bottom:1px solid var(--line);
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:18px;
      transition:background .15s;
    }

    .request:hover { background:#fcfefd; }
    .request:last-child { border-bottom:0; }
    .request[hidden] { display:none; }

    .student {
      font-size:13px;
      font-weight:850;
    }

    .meta {
      color:var(--muted);
      font-size:10px;
      margin-top:5px;
      line-height:1.6;
    }

    .course {
      font-weight:800;
      font-size:12px;
      margin-top:11px;
    }

    .detail {
      color:#58685f;
      font-size:11px;
      line-height:1.65;
      margin-top:7px;
      overflow-wrap:anywhere;
    }

    .review-summary {
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:8px;
      margin-top:12px;
    }

    .review-item {
      background:#f5f8f6;
      border:1px solid #edf2ee;
      padding:10px;
      border-radius:9px;
      font-size:10px;
      color:#65736b;
      min-width:0;
      overflow-wrap:anywhere;
    }

    .review-item b {
      display:block;
      color:#293b32;
      margin-bottom:5px;
      font-size:10px;
    }

    .review-value {
      text-transform:capitalize;
      font-weight:750;
    }

    .right {
      display:flex;
      flex-direction:column;
      align-items:flex-end;
      justify-content:space-between;
      gap:13px;
      min-width:145px;
    }

    .status {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size:10px;
      font-weight:850;
      border-radius:30px;
      padding:6px 10px;
      background:var(--amber-light);
      color:var(--amber);
      white-space:nowrap;
      text-transform:capitalize;
    }

    .status.review {
      background:var(--blue-light);
      color:var(--blue);
    }

    .status.done {
      background:var(--green-light);
      color:var(--green);
    }

    .status.rejected {
      background:var(--red-light);
      color:var(--red);
    }

    .status.neutral {
      background:#f0f2f1;
      color:#65736b;
    }

    .actions {
      display:flex;
      gap:7px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .btn {
      border:0;
      border-radius:8px;
      padding:9px 12px;
      font-size:10px;
      font-weight:800;
      transition:.18s;
    }

    .btn:hover { transform:translateY(-1px); }

    .primary {
      background:var(--green);
      color:#fff;
    }

    .primary:hover { background:var(--green-dark); }

    .secondary {
      background:#f1f5f2;
      color:#34463c;
      border:1px solid var(--line);
    }

    .secondary:hover { background:#e8efea; }

    .empty {
      padding:38px 15px;
      text-align:center;
      color:var(--muted);
      font-size:12px;
      line-height:1.7;
    }

    .empty-icon {
      display:block;
      font-size:25px;
      margin-bottom:8px;
    }

    .guide {
      margin-top:17px;
      padding:17px;
    }

    .guide h3 {
      margin:0 0 12px;
      font-size:13px;
    }

    .guide-grid {
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:9px;
    }

    .guide-item {
      background:#f5f8f6;
      border:1px solid #edf2ee;
      padding:12px;
      border-radius:10px;
      font-size:10px;
      color:#65736b;
      line-height:1.6;
    }

    .guide-item b {
      display:block;
      color:var(--ink);
      margin-bottom:5px;
      font-size:11px;
    }

    dialog {
      border:0;
      border-radius:16px;
      width:min(530px,calc(100% - 24px));
      padding:0;
      box-shadow:0 20px 70px #10291f35;
      max-height:90vh;
      overflow-y:auto;
    }

    dialog::backdrop {
      background:rgba(12,31,23,.65);
      backdrop-filter:blur(3px);
    }

    .modal { padding:22px; }

    .modal-top {
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:17px;
    }

    .modal h2 {
      font-size:17px;
      margin:0 0 5px;
    }

    .modal p {
      font-size:11px;
      color:var(--muted);
      line-height:1.6;
      margin:0;
    }

    .modal-label {
      display:block;
      font-size:11px;
      font-weight:800;
      margin:14px 0 6px;
    }

    .modal select,.modal textarea,.modal input[type="date"] {
      width:100%;
      border:1px solid var(--line);
      border-radius:9px;
      padding:11px;
      background:#fff;
      color:var(--ink);
      font-size:12px;
    }

    .modal textarea {
      min-height:95px;
      resize:vertical;
      line-height:1.6;
    }

    .warning {
      background:var(--amber-light);
      border:1px solid #f0dfba;
      color:#80520e;
      border-radius:10px;
      padding:11px;
      margin-top:13px;
      font-size:11px;
      line-height:1.6;
    }

    .info {
      background:var(--blue-light);
      border:1px solid #dce7fb;
      color:#31578d;
      border-radius:10px;
      padding:11px;
      margin-top:12px;
      font-size:11px;
      line-height:1.6;
    }

    .modal-actions {
      display:flex;
      justify-content:flex-end;
      gap:8px;
      margin-top:18px;
      padding-top:14px;
      border-top:1px solid var(--line);
    }

    .modal-actions .btn {
      min-height:38px;
      padding:10px 15px;
    }

    .required { color:var(--red); }

    @media(max-width:760px) {
      .topbar {
        min-height:57px;
        padding:0 13px;
      }

      main {
        margin:17px auto;
        padding:0 12px 30px;
      }

      .hero {
        padding:20px 17px;
        border-radius:13px;
      }

      h1 { font-size:22px; }

      .stats {
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:8px;
      }

      .stat { padding:12px; }
      .stat strong { font-size:22px; }

      .request {
        grid-template-columns:1fr;
        padding:14px;
        gap:12px;
      }

      .right {
        align-items:flex-start;
        min-width:0;
      }

      .actions { justify-content:flex-start; }

      .review-summary { grid-template-columns:1fr; }

      .guide-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }

      .back {
        font-size:10px;
        padding:8px 9px;
      }

      .panel-heading { padding:13px; }
    }

    @media(max-width:390px) {
      .brand { font-size:16px; }
      .guide-grid { grid-template-columns:1fr; }
      .toolbar input,.toolbar select { width:100%; min-width:0; }
      .modal { padding:17px; }
      .modal-actions { flex-direction:column-reverse; }
      .modal-actions button { width:100%; }
    }
  </style>
</head>

<body>

<header class="topbar">
  <div class="brand">
    Lux<span>Mind</span><small>SIS</small>
  </div>
  <a href="/dashboard" class="back">← Back to Dashboard</a>
</header>

<main>

  <section class="hero">
    <div class="eyebrow">Office of the Registrar</div>
    <h1>Course withdrawal administration</h1>
    <p class="subtitle">
      Review completed recommendations, make the final administrative decision,
      and process approved course withdrawals.
    </p>
  </section>

  <div class="notice">
    <div class="notice-icon">i</div>
    <div>
      <b>Registrar authority and record protection</b><br>
      The Registrar makes the final decision. Approval alone does not change
      a student's registration. The official withdrawal takes effect only after
      the separate processing action is completed and recorded. Original
      registration history must be preserved.
    </div>
  </div>

  <%
    const withdrawalRequests =
      (typeof requests !== 'undefined' && Array.isArray(requests)) ? requests : [];

    const countByStatus = function (statuses) {
      return withdrawalRequests.filter(function (r) {
        return statuses.includes(String(r.status || '').toLowerCase());
      }).length;
    };
  %>

  <section class="stats">
    <div class="stat blue">
      <small>Awaiting final decision</small>
      <strong><%= countByStatus(['registrar_review','pending_registrar']) %></strong>
      <span class="hint">Requests requiring Registrar review</span>
    </div>

    <div class="stat amber">
      <small>Approved, not processed</small>
      <strong><%= countByStatus(['approved']) %></strong>
      <span class="hint">Ready for official processing</span>
    </div>

    <div class="stat red">
      <small>Finance clearance pending</small>
      <strong><%= withdrawalRequests.filter(function(r) {
        return r.finance_required === true &&
          String(r.finance_decision || '').toLowerCase() !== 'cleared' &&
          !['processed','rejected'].includes(String(r.status || '').toLowerCase());
      }).length %></strong>
      <span class="hint">Requests requiring financial clearance</span>
    </div>

    <div class="stat">
      <small>Successfully processed</small>
      <strong><%= countByStatus(['processed']) %></strong>
      <span class="hint">Official withdrawal records completed</span>
    </div>
  </section>

  <div class="toolbar">
    <input
      type="search"
      id="searchInput"
      placeholder="Search student, course or request ID..."
      aria-label="Search withdrawal requests">

    <select id="statusFilter" aria-label="Filter by status">
      <option value="all">All requests</option>
      <option value="review">Awaiting final decision</option>
      <option value="approved">Approved, not processed</option>
      <option value="processed">Processed</option>
      <option value="rejected">Rejected</option>
      <option value="other">Other statuses</option>
    </select>
  </div>

  <section class="panel">
    <div class="panel-heading">
      <h2>Registrar request queue</h2>
      <span class="record-count" id="recordCount">
        <%= withdrawalRequests.length %> records
      </span>
    </div>

    <div id="requestList">

      <% if (withdrawalRequests.length) { %>

        <% withdrawalRequests.forEach(function(r) {
          const requestId = r.id || r.request_id || '';
          const student = r.student_name || r.full_name || r.student_email || 'Student';
          const course = r.course_name || r.section_name || r.course_code || 'Course details unavailable';
          const status = String(r.status || '').toLowerCase();

          const advisor = String(r.advisor_decision || 'Not recorded').replace(/_/g,' ');
          const hod = String(r.hod_decision || 'Not recorded').replace(/_/g,' ');
          const finance = String(r.finance_decision || (r.finance_required ? 'Pending' : 'Not required')).replace(/_/g,' ');

          const category =
            status === 'processed' ? 'processed' :
            status === 'approved' || status === 'processing' ? 'approved' :
            status === 'rejected' ? 'rejected' :
            ['registrar_review','pending_registrar'].includes(status) ? 'review' :
            'other';

          const canDecide = ['registrar_review','pending_registrar'].includes(status);
          const canProcess = status === 'approved';

          const searchable = [
            requestId, student, course, r.reason || '', status,
            advisor, hod, finance, r.student_number || ''
          ].join(' ').toLowerCase();

          const financeRequired = r.finance_required === true;
          const financeCleared = String(r.finance_decision || '').toLowerCase() === 'cleared';
        %>

        <article class="request"
          data-search="<%= searchable %>"
          data-status="<%= category %>">

          <div>
            <div class="student"><%= student %></div>

            <div class="meta">
              Request #<%= requestId || '—' %>
              · <%= r.requested_at || r.created_at
                ? new Date(r.requested_at || r.created_at).toLocaleDateString()
                : 'Date unavailable' %>
              · Student ID: <%= r.student_number || r.student_id || 'Unavailable' %>
            </div>

            <div class="course"><%= course %></div>

            <div class="detail">
              <b>Student's reason:</b>
              <%= r.reason || 'No reason provided.' %>
            </div>

            <% if (r.attachment_url) { %>
              <div class="detail">
                <b>Supporting document:</b>
                <a href="<%= r.attachment_url %>" target="_blank" rel="noopener noreferrer">
                  View attachment
                </a>
              </div>
            <% } %>

            <div class="review-summary">
              <div class="review-item">
                <b>Academic Advisor</b>
                <span class="review-value"><%= advisor %></span>
                <% if (r.advisor_comments) { %>
                  <div><%= r.advisor_comments %></div>
                <% } %>
              </div>

              <div class="review-item">
                <b>Head of Department</b>
                <span class="review-value"><%= hod %></span>
                <% if (r.hod_comments) { %>
                  <div><%= r.hod_comments %></div>
                <% } %>
              </div>

              <div class="review-item">
                <b>Finance clearance</b>
                <span class="review-value"><%= finance %></span>
                <% if (r.finance_comments) { %>
                  <div><%= r.finance_comments %></div>
                <% } %>
                <% if (financeRequired && !financeCleared) { %>
                  <div style="color:#a45b08;margin-top:5px;font-weight:800">
                    Clearance required
                  </div>
                <% } %>
              </div>
            </div>

            <% if (r.registrar_comments) { %>
              <div class="detail">
                <b>Previous Registrar note:</b>
                <%= r.registrar_comments %>
              </div>
            <% } %>

            <% if (r.effective_date) { %>
              <div class="detail">
                <b>Effective date:</b>
                <%= new Date(r.effective_date).toLocaleDateString() %>
              </div>
            <% } %>
          </div>

          <div class="right">
            <span class="status <%= category === 'processed' ? 'done' : category === 'rejected' ? 'rejected' : category === 'review' ? 'review' : category === 'other' ? 'neutral' : '' %>">
              <%= status.replace(/_/g,' ') || 'Pending' %>
            </span>

            <div class="actions">

              <% if (canDecide) { %>
                <button
                  type="button"
                  class="btn primary"
                  onclick="openDecision(this)"
                  data-id="<%= requestId %>"
                  data-student="<%= student %>"
                  data-course="<%= course %>"
                  data-finance-required="<%= financeRequired ? 'yes' : 'no' %>"
                  data-finance-cleared="<%= financeCleared ? 'yes' : 'no' %>">
                  Final decision
                </button>
              <% } %>

              <% if (canProcess) { %>
                <button
                  type="button"
                  class="btn primary"
                  onclick="openProcessing(this)"
                  data-id="<%= requestId %>"
                  data-student="<%= student %>"
                  data-course="<%= course %>"
                  data-finance-required="<%= financeRequired ? 'yes' : 'no' %>"
                  data-finance-cleared="<%= financeCleared ? 'yes' : 'no' %>">
                  Process withdrawal
                </button>
              <% } %>

              <% if (!canDecide && !canProcess) { %>
                <span class="record-count">
                  No action available
                </span>
              <% } %>

            </div>
          </div>

        </article>

        <% }); %>

      <% } else { %>

        <div class="empty">
          <span class="empty-icon">▤</span>
          <b>No withdrawal requests found</b><br>
          There are currently no course withdrawal records in the Registrar queue.
        </div>

      <% } %>

    </div>

    <div class="empty" id="noMatches" style="display:none">
      <span class="empty-icon">⌕</span>
      No requests match your search or selected filter.
    </div>
  </section>

  <section class="panel guide">
    <h3>Official withdrawal workflow</h3>

    <div class="guide-grid">
      <div class="guide-item">
        <b>01 · Review the file</b>
        Examine the student's reason, supporting documents and academic recommendations.
      </div>

      <div class="guide-item">
        <b>02 · Final decision</b>
        Approve, reject or return the request for clarification.
      </div>

      <div class="guide-item">
        <b>03 · Process approval</b>
        Confirm the effective date and submit the official registration change.
      </div>

      <div class="guide-item">
        <b>04 · Preserve history</b>
        Retain the original registration record and create an auditable withdrawal event.
      </div>
    </div>
  </section>

</main>

<!-- FINAL DECISION DIALOG -->
<dialog id="decisionDialog">
  <form class="modal" id="decisionForm" method="POST">

    <div class="modal-top">
      <div>
        <h2>Registrar final decision</h2>
        <p id="decisionSubtitle">Record the official decision for this request.</p>
      </div>
    </div>

    <input type="hidden" id="decisionRequestId">

    <div class="info" id="decisionFinanceNotice" hidden>
      This request requires Finance clearance. The backend will prevent approval
      until the required clearance has been recorded.
    </div>

    <label class="modal-label" for="finalDecision">
      Final decision <span class="required">*</span>
    </label>

    <select id="finalDecision" name="decision" required>
      <option value="">Select a decision</option>
      <option value="approved">Approve withdrawal</option>
      <option value="rejected">Reject withdrawal</option>
      <option value="more_info">Return for clarification</option>
    </select>

    <label class="modal-label" for="decisionComments">
      Registrar comments <span class="required">*</span>
    </label>

    <textarea
      id="decisionComments"
      name="comments"
      maxlength="2000"
      minlength="3"
      placeholder="Enter the reason for the decision or official notes..."
      required></textarea>

    <div class="modal-actions">
      <button type="button" class="btn secondary"
        onclick="document.getElementById('decisionDialog').close()">
        Cancel
      </button>

      <button type="submit" class="btn primary">
        Record decision
      </button>
    </div>

  </form>
</dialog>

<!-- OFFICIAL PROCESSING DIALOG -->
<dialog id="processingDialog">
  <form class="modal" id="processingForm" method="POST">

    <div class="modal-top">
      <div>
        <h2>Official withdrawal processing</h2>
        <p id="processingSubtitle">
          Confirm the details before processing the approved request.
        </p>
      </div>
    </div>

    <input type="hidden" id="processingRequestId">

    <div class="warning">
      <b>Important:</b> This action changes the official registration status.
      It must only be completed after final approval and all required clearances.
      The original registration history must not be deleted.
    </div>

    <div class="info" id="processingFinanceNotice" hidden>
      Finance clearance is required for this request. Processing must not continue
      until the Finance decision is recorded as cleared.
    </div>

    <label class="modal-label" for="effectiveDate">
      Official effective date <span class="required">*</span>
    </label>

    <input
      type="date"
      id="effectiveDate"
      name="effective_date"
      required>

    <label class="modal-label" for="processingComments">
      Processing notes
    </label>

    <textarea
      id="processingComments"
      name="processing_notes"
      maxlength="2000"
      placeholder="Enter official processing notes..."></textarea>

    <div class="modal-actions">
      <button type="button" class="btn secondary"
        onclick="document.getElementById('processingDialog').close()">
        Cancel
      </button>

      <button type="submit" class="btn primary">
        Confirm processing
      </button>
    </div>

  </form>
</dialog>

<script>
(function () {
  const search = document.getElementById('searchInput');
  const filter = document.getElementById('statusFilter');
  const list = document.getElementById('requestList');
  const count = document.getElementById('recordCount');
  const empty = document.getElementById('noMatches');

  const decisionForm = document.getElementById('decisionForm');
  const processingForm = document.getElementById('processingForm');

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    const selected = filter.value;
    const records = [...list.querySelectorAll('.request')];

    let visible = 0;

    records.forEach(function (record) {
      const matchesText = (record.dataset.search || '').includes(query);
      const matchesStatus =
        selected === 'all' || record.dataset.status === selected;

      record.hidden = !(matchesText && matchesStatus);

      if (!record.hidden) visible++;
    });

    count.textContent = visible + ' of ' + records.length + ' records';

    empty.style.display =
      records.length > 0 && visible === 0 ? 'block' : 'none';
  }

  search.addEventListener('input', applyFilters);
  filter.addEventListener('change', applyFilters);

  window.openDecision = function (button) {
    const id = button.dataset.id || '';

    document.getElementById('decisionRequestId').value = id;

    document.getElementById('decisionSubtitle').textContent =
      'Student: ' + (button.dataset.student || 'Student') +
      ' · Course: ' + (button.dataset.course || 'Course');

    document.getElementById('finalDecision').value = '';
    document.getElementById('decisionComments').value = '';

    const financeRequired = button.dataset.financeRequired === 'yes';
    const financeCleared = button.dataset.financeCleared === 'yes';

    document.getElementById('decisionFinanceNotice').hidden =
      !(financeRequired && !financeCleared);

    document.getElementById('decisionDialog').showModal();
  };

  window.openProcessing = function (button) {
    const id = button.dataset.id || '';

    document.getElementById('processingRequestId').value = id;

    document.getElementById('processingSubtitle').textContent =
      'Student: ' + (button.dataset.student || 'Student') +
      ' · Course: ' + (button.dataset.course || 'Course');

    document.getElementById('effectiveDate').value = '';
    document.getElementById('processingComments').value = '';

    const financeRequired = button.dataset.financeRequired === 'yes';
    const financeCleared = button.dataset.financeCleared === 'yes';

    document.getElementById('processingFinanceNotice').hidden =
      !(financeRequired && !financeCleared);

    document.getElementById('processingDialog').showModal();
  };

  // Submit the Registrar's final decision to the protected admin route.
  decisionForm.addEventListener('submit', function (event) {
    const id = document.getElementById('decisionRequestId').value;
    const decision = document.getElementById('finalDecision').value;
    const comments = document.getElementById('decisionComments').value.trim();

    if (!id || !decision || !comments) {
      event.preventDefault();
      alert('Select a decision and enter the Registrar comments.');
      return;
    }

    this.action =
      '/sis/admin/withdrawals/' + encodeURIComponent(id) + '/decision';
  });

  // Submit official processing separately from the approval decision.
  processingForm.addEventListener('submit', function (event) {
    const id = document.getElementById('processingRequestId').value;
    const date = document.getElementById('effectiveDate').value;

    if (!id || !date) {
      event.preventDefault();
      alert('Select the official effective date.');
      return;
    }

    const confirmed = confirm(
      'You are about to process this approved course withdrawal. ' +
      'The official registration status will be changed. ' +
      'The original registration history must be preserved. Continue?'
    );

    if (!confirmed) {
      event.preventDefault();
      return;
    }

    this.action =
      '/sis/admin/withdrawals/' + encodeURIComponent(id) + '/process';
  });

  // Close a dialog when the user clicks its backdrop.
  [document.getElementById('decisionDialog'),
   document.getElementById('processingDialog')].forEach(function (dialog) {
    dialog.addEventListener('click', function (event) {
      if (event.target === dialog) dialog.close();
    });
  });

  applyFilters();
})();
</script>

</body>
</html>
