<%
  if (typeof courses === 'undefined') courses = [];
  if (typeof cart === 'undefined') cart = [];
  if (typeof pending === 'undefined') pending = [];
  if (typeof studentSemester === 'undefined') studentSemester = 1;
  if (typeof minCredits === 'undefined') minCredits = 12;
  if (typeof maxCredits === 'undefined') maxCredits = 21;
  if (typeof totalCartCredits === 'undefined') totalCartCredits = 0;

  // Group courses by semester_number — fully dynamic, no upper limit
  const bySem = {};
  courses.forEach(c => {
    const sem = Number(c.semester_number) || 1;
    if (!bySem[sem]) bySem[sem] = [];
    bySem[sem].push(c);
  });

  // Sort each semester's courses alphabetically by code
  Object.keys(bySem).forEach(s => {
    bySem[s].sort((a, b) => (a.code || '').localeCompare(b.code || ''));
  });

  // Determine max semester actually present, so nothing is hidden
  const allSemNumbers = Object.keys(bySem).map(Number);
  const maxSemester = allSemNumbers.length > 0 ? Math.max(...allSemNumbers) : 2;
  const maxYear = Math.max(1, Math.ceil(maxSemester / 2));

  // Helpers
  const yearLabel = (y) => y === 1 ? 'Freshman' : y === 2 ? 'Sophomore' : y === 3 ? 'Junior' : y === 4 ? 'Senior' : 'Year ' + y;
  const seasonOf  = (sem) => (Number(sem) % 2 === 1) ? 'Fall' : 'Spring';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Course Registration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --radius-card: 2rem; --radius-inner: 1rem;
      --shadow-card: 0 30px 60px -20px rgba(10, 30, 50, 0.4), 0 8px 24px -6px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: radial-gradient(circle at 20% 20%, #e5eef9, #cedbe9); min-height: 100vh; display: flex; align-items: flex-start; justify-content: center; padding: 1.5rem; color: var(--navy); line-height: 1.5; }

    .endeavor-card { max-width: 1400px; width: 100%; background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); overflow: hidden; }

    .endeavor-header { background: linear-gradient(105deg, var(--navy) 0%, var(--deep) 55%, var(--blue) 100%); padding: 1.8rem 2.5rem; display: flex; align-items: center; justify-content: space-between; position: relative; gap: 1rem; flex-wrap: wrap; }
    .endeavor-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--amber), var(--gold), var(--amber)); }
    .brand-block { display: flex; align-items: center; gap: 1.2rem; }
    .brand-mark { width: 58px; height: 58px; background: var(--amber); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--navy); }
    .brand-text h1 { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1.2; }
    .brand-text span { display: block; font-size: 0.8rem; font-weight: 600; color: var(--gold); letter-spacing: 2.5px; text-transform: uppercase; margin-top: 0.15rem; }
    .user-pill { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px); padding: 0.6rem 1.6rem; border-radius: 100px; display: flex; align-items: center; gap: 0.8rem; font-size: 0.95rem; font-weight: 600; color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); }
    .user-pill i { color: var(--gold); font-size: 1.2rem; }

    .endeavor-body { padding: 2rem 2.5rem; background: var(--ice); }

    /* --- BACK BUTTON --- */
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; padding: 0.6rem 1.1rem; background: #fff; border-radius: 100px; border: 1px solid var(--frost); box-shadow: var(--shadow-soft); transition: all 0.15s ease; }
    .btn-back:hover { background: var(--navy); color: #fff; transform: translateY(-1px); }

    /* --- YEAR BOX LAYOUT --- */
    .year-box { background: #fff; border-radius: 1.25rem; border: 1px solid var(--frost); box-shadow: var(--shadow-soft); margin-bottom: 2rem; overflow: hidden; }
    .year-header { background: var(--navy); color: #fff; padding: 1rem 1.5rem; font-size: 1.2rem; font-weight: 800; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--amber); }

    .semesters-container { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--frost); }
    .semester-column { background: #fff; padding: 1.5rem; }
    .semester-column.current-highlight { background: linear-gradient(135deg, #eff6ff, #e0f2fe); }

    .semester-title { font-size: 0.9rem; font-weight: 800; color: var(--blue); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--mist); padding-bottom: 0.5rem; }
    .semester-title .badge-current { background: var(--navy); color: #fff; font-size: 0.65rem; padding: 0.2rem 0.55rem; border-radius: 100px; letter-spacing: 0.5px; }
    .semester-title .badge-future { background: #fef3c7; color: #92400e; font-size: 0.65rem; padding: 0.2rem 0.55rem; border-radius: 100px; letter-spacing: 0.5px; }
    .semester-title .badge-past { background: #e0e7ff; color: #3730a3; font-size: 0.65rem; padding: 0.2rem 0.55rem; border-radius: 100px; letter-spacing: 0.5px; }

    .course-list { display: flex; flex-direction: column; gap: 0.8rem; }

    /* --- COURSE TILES --- */
    .course-tile { display: block; padding: 0.9rem 1rem; border-radius: 10px; border: 1.5px solid transparent; transition: all 0.15s ease; cursor: pointer; text-align: left; width: 100%; background: #fff; font-family: inherit; }
    .course-tile:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(10, 30, 50, 0.1); }
    .course-tile:focus { outline: 2px solid var(--amber); outline-offset: 2px; }

    .tile-selected { background: #d4f0e3; border-color: var(--success); cursor: pointer; }
    .tile-selected:hover { background: #c1ebd8; }
    .tile-available { background: #f8fafc; border: 1.5px dashed var(--frost); }
    .tile-pending { background: #fef3c7; border-color: #f59e0b; cursor: not-allowed; }

    .tile-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.3rem; }
    .tile-code { font-size: 0.75rem; font-weight: 800; color: var(--blue); text-transform: uppercase; }
    .tile-title { display: block; font-size: 0.9rem; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 0.5rem; }

    /* INLINE BADGES */
    .badge-row { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
    .badge { padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; display: inline-flex; align-items: center; gap: 0.3rem; }
    .badge-credit { background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
    .badge-quota { background: #fef3c7; color: #d97706; border: 1px solid #fde68a; }
    .badge-quota.full { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .badge-warn { background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }

    .status-text { display: block; font-size: 0.75rem; font-weight: 800; margin-top: 0.5rem; }
    .status-available { color: var(--blue); }
    .status-selected { color: var(--success); }
    .status-pending { color: #b45309; }

    .summary-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: #fff; border-radius: 100px; padding: 1rem 2rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); position: sticky; bottom: 1.5rem; z-index: 10; margin-top: 1.5rem; }
    .selected-stats { display: flex; align-items: center; gap: 1rem; font-weight: 500; color: var(--deep); }
    .selected-stats strong { font-weight: 800; color: var(--navy); font-size: 1.1rem; }

    .submit-action { background: var(--navy); border: none; padding: 0.8rem 2.4rem; border-radius: 100px; font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 0.75rem; cursor: pointer; transition: all 0.15s ease; }
    .submit-action:hover { background: var(--deep); transform: translateY(-2px); }
    .submit-action:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    /* --- HAMBURGER / MOBILE MENU --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: 0 8px 20px -6px rgba(10,30,50,0.12); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .sidebar-overlay.active { display: block; }

    @media (max-width: 768px) {
      body { padding: 0.75rem; }
      .mobile-menu-btn { display: flex; }
      .endeavor-header { padding: 1.2rem 1.2rem; }
      .brand-mark { width: 44px; height: 44px; font-size: 1.4rem; border-radius: 12px; }
      .brand-text h1 { font-size: 1.2rem; }
      .brand-text span { font-size: 0.65rem; letter-spacing: 1.5px; }
      .user-pill { font-size: 0.75rem; padding: 0.45rem 0.9rem; }
      .endeavor-body { padding: 1.25rem 1rem; padding-top: 4.5rem; }
      .semesters-container { grid-template-columns: 1fr; }
      .summary-footer { flex-direction: column; border-radius: 20px; padding: 1rem; }
      .submit-action { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

  <!-- HAMBURGER (mobile only) -->
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Open menu">
    <i class="fas fa-bars"></i>
  </button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <div class="endeavor-card">
    <header class="endeavor-header">
      <div class="brand-block">
        <div class="brand-mark">L</div>
        <div class="brand-text">
          <h1>LuxMind Endeavor</h1>
          <span>Course Registration</span>
        </div>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-graduate"></i>
        <span><%= user.full_name %> · ID <%= user.admission_number || user.username %></span>
      </div>
    </header>

    <main class="endeavor-body">

      <!-- BACK BUTTON -->
      <a href="/sis/my" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
      </a>

      <!-- SEMESTER / CREDIT BAR -->
      <div style="background: linear-gradient(135deg, #0a1e32, #1e4d7b); color: white; padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; box-shadow: 0 4px 12px rgba(10,30,50,0.15);">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <i class="fas fa-graduation-cap" style="font-size: 1.5rem; color: #ffc857;"></i>
          <div>
            <div style="font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #ffc857;">Semester <%= studentSemester %> Student</div>
            <div style="font-size: 0.9rem; font-weight: 600;">Courses from your department only</div>
          </div>
        </div>
        <div style="display: flex; gap: 1.5rem; font-size: 0.85rem; flex-wrap: wrap;">
          <div><strong style="color: #ffc857;">Min:</strong> <%= minCredits %> cr</div>
          <div><strong style="color: #ffc857;">Max:</strong> <%= maxCredits %> cr</div>
          <div><strong style="color: #ffc857;">Now:</strong> <%= totalCartCredits %> cr</div>
        </div>
      </div>

      <% if (typeof hasRegistered !== 'undefined' && hasRegistered) { %>

        <!-- ALREADY REGISTERED MESSAGE -->
        <div style="background: #fff; border-radius: 1.5rem; padding: 4rem 2rem; text-align: center; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); max-width: 600px; margin: 0 auto;">
          <i class="fas fa-check-circle" style="font-size: 4rem; color: var(--success); margin-bottom: 1.5rem;"></i>
          <h2 style="color: var(--navy); font-size: 1.8rem; margin-bottom: 1rem;">You are already registered!</h2>
          <p style="color: #64748b; font-size: 1rem; margin-bottom: 2rem;">Your courses have been approved by your advisor. You can view your schedule on the Timetable page.</p>
          <a href="/sis/my/timetable" style="background: var(--navy); color: #fff; padding: 0.9rem 2rem; border-radius: 100px; text-decoration: none; font-weight: 700;">Go to My Timetable</a>
        </div>

      <% } else { %>

        <% if (pending.length > 0) { %>
          <div style="background: #fef3c7; color: #92400e; padding: 1rem; border-radius: 12px; margin-bottom: 2rem; text-align: center; font-weight: 800; border: 1px solid #fcd34d;">
            <i class="fas fa-clock"></i> Your registration is pending Advisor approval.
          </div>
        <% } %>

        <% if (courses.length === 0) { %>
          <!-- No courses in department -->
          <div style="background: #fff; border-radius: 1.5rem; padding: 3rem 2rem; text-align: center; box-shadow: var(--shadow-soft); border: 1px solid var(--frost);">
            <i class="fas fa-inbox" style="font-size: 3rem; color: var(--frost); margin-bottom: 1rem;"></i>
            <h2 style="color: var(--navy); font-size: 1.4rem; margin-bottom: 0.5rem;">No courses available</h2>
            <p style="color: #64748b;">There are no courses listed for your department. Please contact the registrar.</p>
          </div>
        <% } else { %>

          <!-- YEAR BOXES — dynamic, supports any semester number -->
          <% for (let year = 1; year <= maxYear; year++) {
               const sem1 = (year * 2) - 1;
               const sem2 = year * 2;

               const has1 = bySem[sem1] && bySem[sem1].length > 0;
               const has2 = bySem[sem2] && bySem[sem2].length > 0;
               if (!has1 && !has2) continue;
          %>
            <div class="year-box">
              <div class="year-header">
                <span>Year <%= year %></span>
                <span style="font-size: 0.9rem; font-weight: 600; color: #94a3b8;"><%= yearLabel(year) %></span>
              </div>

              <div class="semesters-container">
                <!-- SEMESTER 1 (Odd) -->
                <div class="semester-column <%= Number(studentSemester) === sem1 ? 'current-highlight' : '' %>">
                  <div class="semester-title">
                    <span><%= seasonOf(sem1) %> (Semester <%= sem1 %>)</span>
                    <% if (Number(studentSemester) === sem1) { %><span class="badge-current">CURRENT</span>
                    <% } else if (sem1 > Number(studentSemester)) { %><span class="badge-future">FUTURE</span>
                    <% } else { %><span class="badge-past">PAST</span><% } %>
                  </div>
                  <div class="course-list">
                    <% if (!bySem[sem1] || bySem[sem1].length === 0) { %>
                      <div style="color: #94a3b8; font-size: 0.8rem; text-align: center; padding: 1rem;">No courses this semester</div>
                    <% } %>
                    <% (bySem[sem1] || []).forEach(course => {
                         const cartItem = cart.find(c => Number(c.course_id) === Number(course.id));
                         const pendingItem = pending.find(p => Number(p.course_id) === Number(course.id));
                         const isQuotaFull = Number(course.enrolled_count) >= Number(course.quota);

                         let tileClass = 'tile-available';
                         let statusText = '+ Add to Cart';
                         let statusClass = 'status-available';
                         let action = 'add';

                         if (pendingItem) {
                           tileClass = 'tile-pending'; statusText = '✓ Pending Approval'; statusClass = 'status-pending'; action = 'pending';
                         } else if (cartItem) {
                           tileClass = 'tile-selected'; statusText = '✓ In Cart (Click to remove)'; statusClass = 'status-selected'; action = 'remove';
                         }
                    %>
                      <% if (action === 'remove') { %>
                        <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                          <input type="hidden" name="cart_id" value="<%= cartItem.cart_id %>">
                          <button type="submit" class="course-tile <%= tileClass %>" title="Click to remove from cart">
                      <% } else if (action === 'add') { %>
                        <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                          <input type="hidden" name="course_id" value="<%= course.id %>">
                          <button type="submit" class="course-tile <%= tileClass %>">
                      <% } else { %>
                        <div class="course-tile <%= tileClass %>">
                      <% } %>

                            <span class="tile-header">
                              <span class="tile-code"><%= course.code %></span>
                            </span>
                            <span class="tile-title"><%= course.title %></span>

                            <span class="badge-row">
                              <span class="badge badge-credit"><i class="fas fa-star"></i> <%= course.credits %> CR</span>
                              <span class="badge badge-quota <%= isQuotaFull ? 'full' : '' %>"><i class="fas fa-users"></i> Q: <%= course.enrolled_count %>/<%= course.quota %></span>
                              <% if (course.reason) { %>
                                <span class="badge badge-warn"><i class="fas fa-info-circle"></i> <%= course.reason %></span>
                              <% } %>
                            </span>

                            <span class="status-text <%= statusClass %>"><%= statusText %></span>

                      <% if (action === 'remove' || action === 'add') { %>
                          </button>
                        </form>
                      <% } else { %>
                        </div>
                      <% } %>
                    <% }) %>
                  </div>
                </div>

                <!-- SEMESTER 2 (Even) -->
                <div class="semester-column <%= Number(studentSemester) === sem2 ? 'current-highlight' : '' %>" style="background: var(--ice);">
                  <div class="semester-title" style="color: var(--amber);">
                    <span><%= seasonOf(sem2) %> (Semester <%= sem2 %>)</span>
                    <% if (Number(studentSemester) === sem2) { %><span class="badge-current">CURRENT</span>
                    <% } else if (sem2 > Number(studentSemester)) { %><span class="badge-future">FUTURE</span>
                    <% } else { %><span class="badge-past">PAST</span><% } %>
                  </div>
                  <div class="course-list">
                    <% if (!bySem[sem2] || bySem[sem2].length === 0) { %>
                      <div style="color: #94a3b8; font-size: 0.8rem; text-align: center; padding: 1rem;">No courses this semester</div>
                    <% } %>
                    <% (bySem[sem2] || []).forEach(course => {
                         const cartItem = cart.find(c => Number(c.course_id) === Number(course.id));
                         const pendingItem = pending.find(p => Number(p.course_id) === Number(course.id));
                         const isQuotaFull = Number(course.enrolled_count) >= Number(course.quota);

                         let tileClass = 'tile-available';
                         let statusText = '+ Add to Cart';
                         let statusClass = 'status-available';
                         let action = 'add';

                         if (pendingItem) {
                           tileClass = 'tile-pending'; statusText = '✓ Pending Approval'; statusClass = 'status-pending'; action = 'pending';
                         } else if (cartItem) {
                           tileClass = 'tile-selected'; statusText = '✓ In Cart (Click to remove)'; statusClass = 'status-selected'; action = 'remove';
                         }
                    %>
                      <% if (action === 'remove') { %>
                        <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                          <input type="hidden" name="cart_id" value="<%= cartItem.cart_id %>">
                          <button type="submit" class="course-tile <%= tileClass %>" title="Click to remove from cart">
                      <% } else if (action === 'add') { %>
                        <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                          <input type="hidden" name="course_id" value="<%= course.id %>">
                          <button type="submit" class="course-tile <%= tileClass %>">
                      <% } else { %>
                        <div class="course-tile <%= tileClass %>">
                      <% } %>

                            <span class="tile-header">
                              <span class="tile-code"><%= course.code %></span>
                            </span>
                            <span class="tile-title"><%= course.title %></span>

                            <span class="badge-row">
                              <span class="badge badge-credit"><i class="fas fa-star"></i> <%= course.credits %> CR</span>
                              <span class="badge badge-quota <%= isQuotaFull ? 'full' : '' %>"><i class="fas fa-users"></i> Q: <%= course.enrolled_count %>/<%= course.quota %></span>
                              <% if (course.reason) { %>
                                <span class="badge badge-warn"><i class="fas fa-info-circle"></i> <%= course.reason %></span>
                              <% } %>
                            </span>

                            <span class="status-text <%= statusClass %>"><%= statusText %></span>

                      <% if (action === 'remove' || action === 'add') { %>
                          </button>
                        </form>
                      <% } else { %>
                        </div>
                      <% } %>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

        <% } %>

        <!-- STICKY SUMMARY FOOTER -->
        <div class="summary-footer">
          <div class="selected-stats">
            <i class="fas fa-check-double" style="color: var(--amber); font-size: 1.5rem;"></i>
            <span>
              <strong><%= totalCartCredits %></strong> / <%= maxCredits %> credits
              (<%= cart.length %> course<%= cart.length === 1 ? '' : 's' %>)
              <% if (totalCartCredits < minCredits) { %>
                · <span style="color: #f59e0b; font-weight: 800;">⚠️ Need <%= minCredits - totalCartCredits %> more</span>
              <% } else if (totalCartCredits > maxCredits) { %>
                · <span style="color: #dc2626; font-weight: 800;">⚠️ Over by <%= totalCartCredits - maxCredits %></span>
              <% } else { %>
                · <span style="color: #10b981; font-weight: 800;">✓ OK</span>
              <% } %>
            </span>
          </div>
          <div>
            <% if (cart.length > 0 && pending.length === 0) { %>
              <% if (totalCartCredits < minCredits) { %>
                <button class="submit-action" disabled style="background: #f59e0b; cursor: not-allowed;"><i class="fas fa-exclamation-triangle"></i> Need <%= minCredits - totalCartCredits %> More</button>
              <% } else if (totalCartCredits > maxCredits) { %>
                <button class="submit-action" disabled style="background: #dc2626; cursor: not-allowed;"><i class="fas fa-ban"></i> Over Limit</button>
              <% } else { %>
                <form method="POST" action="/sis/my/registration/submit" style="margin: 0;">
                  <button type="submit" class="submit-action"><i class="fas fa-rocket"></i> Submit to Advisor</button>
                </form>
              <% } %>
            <% } else if (pending.length > 0) { %>
              <button class="submit-action" disabled style="background: #64748b;"><i class="fas fa-clock"></i> Awaiting Advisor</button>
            <% } %>
          </div>
        </div>

      <% } %> <!-- END ELSE -->
    </main>
  </div>

  <script>
    function toggleMobileMenu() {
      const ov = document.getElementById('sidebarOverlay');
      if (ov) ov.classList.toggle('active');
    }
  </script>

</body>
</html>