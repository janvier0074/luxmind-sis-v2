<%
  if (typeof courses === 'undefined') courses = [];
  if (typeof cart === 'undefined') cart = [];
  if (typeof pending === 'undefined') pending = [];
  const currentSem = 1; // Student is in Semester 1
  if (typeof hasRegistered !== 'undefined' && hasRegistered) {
    // If registered, we don't need the rest of the data
  }

  const bySem = {};
  for (let i = 1; i <= 8; i++) bySem[i] = [];
  courses.forEach(c => { 
    const sem = c.semester_number || 1;
    if (bySem[sem]) bySem[sem].push(c); 
  });
  
  const labels = {1:'Fall', 2:'Spring', 3:'Fall', 4:'Spring', 5:'Fall', 6:'Spring', 7:'Fall', 8:'Spring'};
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Course Registration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --radius-card: 2rem; --radius-inner: 1rem;
      --shadow-card: 0 30px 60px -20px rgba(10, 30, 50, 0.4), 0 8px 24px -6px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: radial-gradient(circle at 20% 20%, #e5eef9, #cedbe9); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem; color: var(--navy); line-height: 1.5; }

    .endeavor-card { max-width: 1400px; width: 100%; background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); overflow: hidden; }
    
    .endeavor-header { background: linear-gradient(105deg, var(--navy) 0%, var(--deep) 55%, var(--blue) 100%); padding: 1.8rem 2.5rem; display: flex; align-items: center; justify-content: space-between; position: relative; }
    .endeavor-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--amber), var(--gold), var(--amber)); }
    .brand-block { display: flex; align-items: center; gap: 1.2rem; }
    .brand-mark { width: 58px; height: 58px; background: var(--amber); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--navy); }
    .brand-text h1 { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1.2; }
    .brand-text span { display: block; font-size: 0.8rem; font-weight: 600; color: var(--gold); letter-spacing: 2.5px; text-transform: uppercase; margin-top: 0.15rem; }
    .user-pill { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px); padding: 0.6rem 1.6rem; border-radius: 100px; display: flex; align-items: center; gap: 0.8rem; font-size: 0.95rem; font-weight: 600; color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); }
    .user-pill i { color: var(--gold); font-size: 1.2rem; }

    .endeavor-body { padding: 2rem 2.5rem; background: var(--ice); }

    /* --- NEW YEAR BOX LAYOUT --- */
    .year-box { background: #fff; border-radius: 1.25rem; border: 1px solid var(--frost); box-shadow: var(--shadow-soft); margin-bottom: 2rem; overflow: hidden; }
    .year-header { background: var(--navy); color: #fff; padding: 1rem 1.5rem; font-size: 1.2rem; font-weight: 800; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--amber); }
    
    .semesters-container { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--frost); }
    .semester-column { background: #fff; padding: 1.5rem; }
    
    .semester-title { font-size: 0.9rem; font-weight: 800; color: var(--blue); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--mist); padding-bottom: 0.5rem; }
    
    .course-list { display: flex; flex-direction: column; gap: 0.8rem; }

    /* --- COURSE TILES --- */
    .course-tile { padding: 0.8rem 1rem; border-radius: 10px; border: 1.5px solid transparent; transition: all 0.15s ease; cursor: pointer; text-align: left; width: 100%; background: #fff; }
    .course-tile:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(10, 30, 50, 0.1); }
    
    .tile-selected { background: #d4f0e3; border-color: var(--success); cursor: default; }
    .tile-available { background: #f8fafc; border: 1.5px dashed var(--frost); }
    
    .tile-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.3rem; }
    .tile-code { font-size: 0.75rem; font-weight: 800; color: var(--blue); text-transform: uppercase; }
    .tile-title { font-size: 0.9rem; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 0.5rem; }
    
    /* NEW INLINE BADGES */
    .badge-row { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; }
    .badge { padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; display: inline-flex; align-items: center; gap: 0.3rem; }
    .badge-credit { background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
    .badge-quota { background: #fef3c7; color: #d97706; border: 1px solid #fde68a; }
    .badge-quota.full { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }

    .status-text { font-size: 0.75rem; font-weight: 800; margin-top: 0.5rem; }
    .status-available { color: var(--blue); }
    .status-selected { color: var(--success); }
    .status-restricted { color: var(--danger); }

    .summary-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: #fff; border-radius: 100px; padding: 1rem 2rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); position: sticky; bottom: 1.5rem; z-index: 10; }
    .selected-stats { display: flex; align-items: center; gap: 1rem; font-weight: 500; color: var(--deep); }
    .selected-stats strong { font-weight: 800; color: var(--navy); font-size: 1.1rem; }
    
    .submit-action { background: var(--navy); border: none; padding: 0.8rem 2.4rem; border-radius: 100px; font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 0.75rem; cursor: pointer; transition: all 0.15s ease; }
    .submit-action:hover { background: var(--deep); transform: translateY(-2px); }
    .submit-action:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  </style>
</head>
<body>
  <div class="endeavor-card">
    <header class="endeavor-header">
      <div class="brand-block">
        <div class="brand-mark">L</div>
        <div class="brand-text">
          <h1>LuxMind Endeavor</h1>
          <span>Course Registration</span>
        </div>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-graduate"></i>
        <span><%= user.full_name %> · ID <%= user.admission_number || user.username %></span>
      </div>
    </header>

    <main class="endeavor-body">
      
      <% if (typeof hasRegistered !== 'undefined' && hasRegistered) { %>
        
        <!-- ALREADY REGISTERED MESSAGE -->
        <div style="background: #fff; border-radius: 1.5rem; padding: 4rem 2rem; text-align: center; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); max-width: 600px; margin: 0 auto;">
          <i class="fas fa-check-circle" style="font-size: 4rem; color: var(--success); margin-bottom: 1.5rem;"></i>
          <h2 style="color: var(--navy); font-size: 1.8rem; margin-bottom: 1rem;">You are already registered!</h2>
          <p style="color: #64748b; font-size: 1rem; margin-bottom: 2rem;">Your courses have been approved by your advisor. You can view your schedule on the Timetable page.</p>
          <a href="/sis/my/timetable" style="background: var(--navy); color: #fff; padding: 0.9rem 2rem; border-radius: 100px; text-decoration: none; font-weight: 700;">Go to My Timetable</a>
        </div>

      <% } else { %>


      <% if (pending.length > 0) { %>
        <div style="background: #fef3c7; color: #92400e; padding: 1rem; border-radius: 12px; margin-bottom: 2rem; text-align: center; font-weight: 800; border: 1px solid #fcd34d;">
          <i class="fas fa-clock"></i> Your registration is pending Advisor approval.
        </div>
      <% } %>

      <!-- YEAR BOXES -->
      <% for (let year = 1; year <= 4; year++) { 
           const sem1 = (year * 2) - 1;
           const sem2 = year * 2;
      %>
        <div class="year-box">
          <div class="year-header">
            <span>Year <%= year %></span>
            <span style="font-size: 0.9rem; font-weight: 600; color: #94a3b8;"><%= year === 1 ? 'Freshman' : year === 2 ? 'Sophomore' : year === 3 ? 'Junior' : 'Senior' %></span>
          </div>
          
          <div class="semesters-container">
            <!-- Semester 1 (Odd) -->
            <div class="semester-column">
              <div class="semester-title">Fall (Semester <%= sem1 %>)</div>
              <div class="course-list">
                <% if (bySem[sem1].length === 0) { %><div style="color: #94a3b8; font-size: 0.8rem;">No courses</div><% } %>
                <% bySem[sem1].forEach(course => { 
                  const cartItem = cart.find(c => c.course_id === course.id);
                  const pendingItem = pending.find(p => p.course_id === course.id);
                  const isSemAllowed = sem1 <= (currentSem + 1);
                  const isQuotaFull = course.enrolled_count >= course.quota;

                  let tileClass = 'tile-available';
                  let statusText = '+ Add to Cart';
                  let statusClass = 'status-available';
                  let clickable = true;

                  if (pendingItem) { tileClass = 'tile-selected'; statusText = '✓ Pending Approval'; statusClass = 'status-selected'; clickable = false; }
                  else if (cartItem) { tileClass = 'tile-selected'; statusText = '✓ In Cart (Click to remove)'; statusClass = 'status-selected'; }
                  else if (isQuotaFull) { statusText = 'Quota Full'; statusClass = 'status-restricted'; }
                  else if (!isSemAllowed) { statusText = '🔒 Registration Restricted'; statusClass = 'status-restricted'; }
                %>
                  
                  <% if (cartItem && !pendingItem) { %>
                    <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                      <input type="hidden" name="cart_id" value="<%= cartItem.cart_id %>">
                      <button type="submit" class="course-tile <%= tileClass %>">
                  <% } else if (clickable) { %>
                    <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                      <input type="hidden" name="course_id" value="<%= course.id %>">
                      <button type="submit" class="course-tile <%= tileClass %>" 
                        <% if (!isSemAllowed) { %> onclick="event.preventDefault(); showSemesterWarning(<%= sem1 %>, <%= currentSem %>);"
                        <% } else if (isQuotaFull) { %> onclick="event.preventDefault(); showQuotaWarning('<%= course.title %>');"
                        <% } %>>
                  <% } else { %>
                    <div class="course-tile <%= tileClass %>">
                  <% } %>

                      <div class="tile-header">
                        <span class="tile-code"><%= course.code %></span>
                      </div>
                      <div class="tile-title"><%= course.title %></div>
                      
                      <!-- INLINE BADGES (CREDIT & QUOTA) -->
                      <div class="badge-row">
                        <span class="badge badge-credit"><i class="fas fa-star"></i> <%= course.credits %> CR</span>
                        <span class="badge badge-quota <%= isQuotaFull ? 'full' : '' %>"><i class="fas fa-users"></i> Q: <%= course.enrolled_count %>/<%= course.quota %></span>
                      </div>

                      <div class="status-text <%= statusClass %>"><%= statusText %></div>

                  <% if (clickable || cartItem) { %>
                      </button>
                    </form>
                  <% } else { %>
                    </div>
                  <% } %>

                <% }) %>
              </div>
            </div>

            <!-- Semester 2 (Even) -->
            <div class="semester-column" style="background: var(--ice);">
              <div class="semester-title" style="color: var(--amber);">Spring (Semester <%= sem2 %>)</div>
              <div class="course-list">
                <% if (bySem[sem2].length === 0) { %><div style="color: #94a3b8; font-size: 0.8rem;">No courses</div><% } %>
                <% bySem[sem2].forEach(course => { 
                  const cartItem = cart.find(c => c.course_id === course.id);
                  const pendingItem = pending.find(p => p.course_id === course.id);
                  const isSemAllowed = sem2 <= (currentSem + 1);
                  const isQuotaFull = course.enrolled_count >= course.quota;

                  let tileClass = 'tile-available';
                  let statusText = '+ Add to Cart';
                  let statusClass = 'status-available';
                  let clickable = true;

                  if (pendingItem) { tileClass = 'tile-selected'; statusText = '✓ Pending Approval'; statusClass = 'status-selected'; clickable = false; }
                  else if (cartItem) { tileClass = 'tile-selected'; statusText = '✓ In Cart (Click to remove)'; statusClass = 'status-selected'; }
                  else if (isQuotaFull) { statusText = 'Quota Full'; statusClass = 'status-restricted'; }
                  else if (!isSemAllowed) { statusText = '🔒 Registration Restricted'; statusClass = 'status-restricted'; }
                %>
                  
                  <% if (cartItem && !pendingItem) { %>
                    <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                      <input type="hidden" name="cart_id" value="<%= cartItem.cart_id %>">
                      <button type="submit" class="course-tile <%= tileClass %>">
                  <% } else if (clickable) { %>
                    <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                      <input type="hidden" name="course_id" value="<%= course.id %>">
                      <button type="submit" class="course-tile <%= tileClass %>" 
                        <% if (!isSemAllowed) { %> onclick="event.preventDefault(); showSemesterWarning(<%= sem2 %>, <%= currentSem %>);"
                        <% } else if (isQuotaFull) { %> onclick="event.preventDefault(); showQuotaWarning('<%= course.title %>');"
                        <% } %>>
                  <% } else { %>
                    <div class="course-tile <%= tileClass %>">
                  <% } %>

                      <div class="tile-header">
                        <span class="tile-code"><%= course.code %></span>
                      </div>
                      <div class="tile-title"><%= course.title %></div>
                      
                      <!-- INLINE BADGES -->
                      <div class="badge-row">
                        <span class="badge badge-credit"><i class="fas fa-star"></i> <%= course.credits %> CR</span>
                        <span class="badge badge-quota <%= isQuotaFull ? 'full' : '' %>"><i class="fas fa-users"></i> Q: <%= course.enrolled_count %>/<%= course.quota %></span>
                      </div>

                      <div class="status-text <%= statusClass %>"><%= statusText %></div>

                  <% if (clickable || cartItem) { %>
                      </button>
                    </form>
                  <% } else { %>
                    </div>
                  <% } %>

                <% }) %>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- STICKY SUMMARY FOOTER -->
      <div class="summary-footer">
        <div class="selected-stats">
          <i class="fas fa-check-double" style="color: var(--amber); font-size: 1.5rem;"></i>
          <span>Selected: <strong><%= cart.length %></strong> courses</span>
        </div>
        
        <div>
          <% if (cart.length > 0 && pending.length === 0) { %>
            <form method="POST" action="/sis/my/registration/submit" style="margin: 0;">
              <button type="submit" class="submit-action"><i class="fas fa-rocket"></i> Submit to Advisor</button>
            </form>
          <% } else if (pending.length > 0) { %>
            <button class="submit-action" disabled style="background: #64748b;"><i class="fas fa-clock"></i> Awaiting Advisor</button>
          <% } %>
        </div>
      </div>
      <% } %> <!-- END ELSE -->
    </main>
    </main>
  </div>

  <!-- POP-UP LOGIC -->
  <script>
    function showSemesterWarning(targetSem, currentSem) {
      alert("⚠️ Registration Restriction\n\nYou are currently in Semester " + currentSem + ".\nYou are only allowed to register for Semester " + currentSem + " or " + (currentSem + 1) + ".\n\nYou cannot register for Semester " + targetSem + " yet.");
    }

    function showQuotaWarning(courseName) {
      alert("⚠️ Quota Full\n\nThe course '" + courseName + "' has reached its maximum capacity.\n\nPlease wait until a new group is created or the quota is increased by your Advisor.");
    }
  </script>
</body>
</html>