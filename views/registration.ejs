<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind Course Registration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --radius-card: 2rem; --radius-inner: 1.25rem;
      --shadow-card: 0 30px 60px -20px rgba(10, 30, 50, 0.4), 0 8px 24px -6px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: radial-gradient(circle at 20% 20%, #e5eef9, #cedbe9); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem; color: var(--navy); line-height: 1.5; }

    .endeavor-card { max-width: 1500px; width: 100%; background: #fff; border-radius: var(--radius-card); box-shadow: var(--shadow-card); overflow: hidden; animation: cardFloat 0.6s ease-out; }
    @keyframes cardFloat { from { opacity: 0; transform: translateY(20px) scale(0.99); } to { opacity: 1; transform: translateY(0) scale(1); } }

    .endeavor-header { background: linear-gradient(105deg, var(--navy) 0%, var(--deep) 55%, var(--blue) 100%); padding: 1.8rem 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem; position: relative; }
    .endeavor-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--amber), var(--gold), var(--amber)); }
    .brand-block { display: flex; align-items: center; gap: 1.2rem; }
    .brand-mark { width: 58px; height: 58px; background: var(--amber); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--navy); box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.3); }
    .brand-text h1 { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1.2; }
    .brand-text span { display: block; font-size: 0.8rem; font-weight: 600; color: var(--gold); letter-spacing: 2.5px; text-transform: uppercase; margin-top: 0.15rem; }
    .user-pill { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px); padding: 0.6rem 1.6rem; border-radius: 100px; display: flex; align-items: center; gap: 0.8rem; font-size: 0.95rem; font-weight: 600; color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); }
    .user-pill i { color: var(--gold); font-size: 1.2rem; }

    .endeavor-body { padding: 2.2rem 2.5rem 2rem; background: var(--ice); }

    .semester-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
    @media (max-width: 1200px) { .semester-grid { grid-template-columns: repeat(2, 1fr); } }
    
    .semester-panel { background: #fff; border-radius: var(--radius-inner); border: 1px solid var(--frost); overflow: hidden; box-shadow: var(--shadow-soft); display: flex; flex-direction: column; }
    .semester-header { background: var(--mist); padding: 0.9rem 1.2rem; border-bottom: 2px solid var(--frost); display: flex; align-items: center; justify-content: space-between; }
    .semester-header h3 { font-size: 1rem; font-weight: 800; color: var(--navy); }
    .year-badge { background: var(--blue); color: #fff; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.7rem; border-radius: 100px; }
    .course-list { padding: 0.8rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }

    .course-tile { padding: 0.75rem 1rem 0.75rem 2.4rem; border-radius: 12px; border: 1.5px solid transparent; transition: all 0.15s ease; cursor: pointer; position: relative; display: flex; flex-direction: column; gap: 0.2rem; text-align: left; width: 100%; background: #fff; }
    .course-tile:hover { transform: translateY(-2px); box-shadow: 0 6px 14px -6px rgba(10, 30, 50, 0.2); }

    .tile-selected { background: #d4f0e3; border-color: var(--success); cursor: default; }
    .tile-available { background: #fff; border: 1.5px dashed var(--blue); }
    .tile-locked { background: #f3f4f6; border: 1px solid #cbd5e1; opacity: 0.75; cursor: not-allowed; }

    .tile-credit-front { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); padding: 0.35rem; border-radius: 8px; background: var(--navy); color: var(--gold); font-size: 0.7rem; font-weight: 800; display: flex; flex-direction: column; align-items: center; }
    .tile-credit-front small { font-size: 0.55rem; color: #cfd9e6; margin-top: 2px; }

    .tile-code { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
    .tile-title { font-size: 0.82rem; font-weight: 700; color: var(--navy); line-height: 1.3; }
    .tile-meta { display: flex; justify-content: space-between; margin-top: 0.2rem; font-size: 0.68rem; font-weight: 600; color: #4a6785; }

    .tile-selected::after { content: '✓'; position: absolute; top: 8px; right: 10px; font-size: 0.8rem; font-weight: 800; color: var(--success); }
    .tile-locked::after { content: '🔒'; position: absolute; top: 8px; right: 10px; font-size: 0.75rem; }

    .summary-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: #fff; border-radius: 100px; padding: 1.1rem 2rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); }
    .selected-stats { display: flex; align-items: center; gap: 1rem; font-weight: 500; color: var(--deep); }
    .selected-stats i { color: var(--amber); font-size: 1.5rem; }
    .selected-stats strong { font-weight: 800; color: var(--navy); font-size: 1.1rem; margin: 0 0.15rem; }
    
    .submit-action { background: var(--navy); border: none; padding: 0.9rem 2.4rem; border-radius: 100px; font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 0.75rem; cursor: pointer; transition: all 0.15s ease; box-shadow: 0 12px 24px -10px var(--navy); }
    .submit-action:hover { background: var(--deep); transform: translateY(-2px); }
    .submit-action:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .submit-action i { color: var(--gold); }
  </style>
</head>
<body>
  <div class="endeavor-card">
    <header class="endeavor-header">
      <div class="brand-block">
        <div class="brand-mark">L</div>
        <div class="brand-text">
          <h1>LuxMind Endeavor</h1>
          <span>4-Year Curriculum · 8 Semesters</span>
        </div>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-graduate"></i>
        <span><%= user.full_name %> · ID <%= user.admission_number || 'N/A' %></span>
      </div>
    </header>

    <main class="endeavor-body">
      
      <% if (pending.length > 0) { %>
        <div style="background: #fef3c7; color: #92400e; padding: 1rem; border-radius: 12px; margin-bottom: 2rem; text-align: center; font-weight: 800; border: 1px solid #fcd34d;">
          <i class="fas fa-clock"></i> Your registration is pending Advisor approval.
        </div>
      <% } %>

      <div class="semester-grid">
        <% 
          const bySem = {};
          for (let i = 1; i <= 8; i++) bySem[i] = [];
          courses.forEach(c => { 
            const sem = c.semester_number || c.semester || 1;
            if (bySem[sem]) bySem[sem].push(c); 
          });
          const labels = {1:'Year 1 · Fall',2:'Year 1 · Spring',3:'Year 2 · Fall',4:'Year 2 · Spring',5:'Year 3 · Fall',6:'Year 3 · Spring',7:'Year 4 · Fall',8:'Year 4 · Spring'};
          
          for (let semNum = 1; semNum <= 8; semNum++) {
        %>
          <div class="semester-panel">
            <div class="semester-header">
              <h3><%= labels[semNum] %></h3>
              <span class="year-badge">Sem <%= semNum %></span>
            </div>
            <div class="course-list">
              <% if (bySem[semNum].length === 0) { %>
                <div style="padding: 1rem; text-align: center; color: #94a3b8; font-size: 0.8rem;">No courses</div>
              <% } %>

              <% bySem[semNum].forEach(course => {
                const cartItem = cart.find(c => c.course_id === course.id);
                const pendingItem = pending.find(p => p.course_id === course.id);
                const isLocked = semNum > (currentSem + 1);

                let tileClass = 'tile-available';
                let statusLabel = 'Available';
                let clickable = true;

                if (pendingItem) { tileClass = 'tile-selected'; statusLabel = 'Pending'; clickable = false; }
                else if (cartItem) { tileClass = 'tile-selected'; statusLabel = 'Selected'; clickable = false; }
                else if (isLocked) { tileClass = 'tile-locked'; statusLabel = 'Locked'; clickable = false; }
              %>
                <% if (clickable && pending.length === 0) { %>
                  <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                    <input type="hidden" name="course_id" value="<%= course.id %>">
                    <button type="submit" class="course-tile <%= tileClass %>">
                      <div class="tile-credit-front"><%= course.credits || 3 %><small>CR</small></div>
                      <div class="tile-code"><%= course.code || 'N/A' %></div>
                      <div class="tile-title"><%= course.title %></div>
                      <div class="tile-meta"><span>Add to Cart</span></div>
                    </button>
                  </form>
                <% } else { %>
                  <div class="course-tile <%= tileClass %>">
                    <div class="tile-credit-front"><%= course.credits || 3 %><small>CR</small></div>
                    <div class="tile-code"><%= course.code || 'N/A' %></div>
                    <div class="tile-title"><%= course.title %></div>
                    <div class="tile-meta"><span><%= statusLabel %></span></div>
                  </div>
                <% } %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <div class="summary-footer">
        <div class="selected-stats">
          <i class="fas fa-check-double"></i>
          <span>Selected: <strong><%= cart.length %></strong> courses</span>
        </div>
        
        <div style="display: flex; gap: 1rem;">
          <% if (cart.length > 0 && pending.length === 0) { %>
            <form method="POST" action="/sis/my/registration/submit" style="margin: 0;">
              <button type="submit" class="submit-action"><i class="fas fa-rocket"></i> Submit to Advisor</button>
            </form>
          <% } else if (pending.length > 0) { %>
            <button class="submit-action" disabled style="background: #64748b;"><i class="fas fa-clock"></i> Awaiting Advisor</button>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>