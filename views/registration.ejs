<%
  // Safety checks so it never crashes
  if (typeof courses === 'undefined') courses = [];
  if (typeof cart === 'undefined') cart = [];
  if (typeof pending === 'undefined') pending = [];

  const bySem = { 1: [], 2: [] };
  courses.forEach(c => { 
    if (c.semester_number && bySem[c.semester_number]) {
      bySem[c.semester_number].push(c); 
    }
  });
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Course Registration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }

    /* Registration UI */
    .status-banner { padding: 1rem 1.5rem; border-radius: 1rem; font-weight: 700; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.8rem; }
    .status-pending { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }
    
    .semester-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-bottom: 6rem; }
    @media (max-width: 900px) { .semester-grid { grid-template-columns: 1fr; } }

    .semester-panel { background: #fff; border-radius: 1.25rem; border: 1px solid var(--frost); box-shadow: var(--shadow-soft); overflow: hidden; }
    .semester-header { background: var(--mist); padding: 1rem 1.5rem; border-bottom: 2px solid var(--frost); font-weight: 800; color: var(--navy); display: flex; justify-content: space-between; align-items: center; }
    .course-list { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }

    .course-tile { padding: 1rem 1rem 1rem 3rem; border-radius: 12px; border: 1.5px solid transparent; text-align: left; position: relative; display: flex; flex-direction: column; gap: 0.2rem; width: 100%; background: #fff; cursor: pointer; transition: 0.2s; }
    .course-tile:hover { transform: translateY(-2px); box-shadow: 0 6px 14px -6px rgba(10, 30, 50, 0.2); }
    .tile-available { border: 1.5px dashed var(--blue); }
    .tile-selected { background: #d4f0e3; border-color: var(--success); cursor: default; }
    .tile-credit { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); background: var(--navy); color: var(--gold); padding: 0.4rem 0.3rem; border-radius: 8px; font-size: 0.75rem; font-weight: 800; display: flex; flex-direction: column; align-items: center; line-height: 1; }
    .tile-credit small { font-size: 0.55rem; color: #cbd5e1; margin-top: 2px; }
    .tile-code { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: var(--blue); }
    .tile-title { font-size: 0.85rem; font-weight: 700; color: var(--navy); }

    /* Sticky Cart Footer */
    .summary-footer { position: fixed; bottom: 0; left: 280px; right: 0; background: #fff; padding: 1.2rem 2.5rem; border-top: 1px solid var(--frost); box-shadow: 0 -10px 30px rgba(10,30,50,0.05); display: flex; justify-content: space-between; align-items: center; z-index: 50; }
    .summary-text { font-size: 1.1rem; font-weight: 800; color: var(--navy); }
    .btn-submit { background: var(--navy); color: #fff; padding: 1rem 2.5rem; border-radius: 100px; border: none; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 10px; }
    .btn-submit:hover { background: var(--deep); transform: scale(1.02); }
    .btn-submit:disabled { background: #cbd5e1; cursor: not-allowed; transform: none; }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/my" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i> Student <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i> Course <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu open">
              <li class="menu-item"><a href="/sis/my/registration" class="menu-link active"><i class="fas fa-edit main-icon"></i> Course Registration</a></li>
              <li class="menu-item"><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt main-icon"></i> Timetable</a></li>
              <li class="menu-item"><a href="/sis/my/attendance" class="menu-link"><i class="fas fa-check-circle main-icon"></i> Attendance Detail</a></li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
  </aside>

  <main class="main-content">
    <div class="top-bar">
      <div class="greeting">
        <h1>Course Registration</h1>
        <p>Select your courses for the upcoming semester.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-circle"></i>
        <%= user.admission_number || user.username %>
      </div>
    </div>

    <% if (pending.length > 0) { %>
      <div class="status-banner status-pending">
        <i class="fas fa-clock"></i> Your registration has been submitted and is pending Advisor approval. You cannot edit it right now.
      </div>
    <% } %>

    <div class="semester-grid">
      <!-- Current Semester -->
      <div class="semester-panel">
        <div class="semester-header">
          <span>Current Semester (Sem 1)</span>
          <span style="background: var(--blue); color: white; padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem;">Available</span>
        </div>
        <div class="course-list">
          <% if (bySem[1].length === 0) { %>
             <div style="text-align: center; color: #94a3b8; padding: 1rem;">No courses available.</div>
          <% } %>
          <% bySem[1].forEach(course => { 
            const inCart = cart.find(c => c.course_id === course.id);
            const isPending = pending.find(p => p.course_id === course.id);
          %>
            <% if (isPending) { %>
              <div class="course-tile tile-selected">
                <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                <div class="tile-code"><%= course.code %></div>
                <div class="tile-title"><%= course.title %></div>
                <div style="font-size: 0.7rem; font-weight: 800; color: var(--success); margin-top: 5px;">✓ Pending Approval</div>
              </div>
            <% } else if (inCart) { %>
              <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                <input type="hidden" name="cart_id" value="<%= inCart.cart_id %>">
                <button type="submit" class="course-tile tile-selected">
                  <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                  <div class="tile-code"><%= course.code %></div>
                  <div class="tile-title"><%= course.title %></div>
                  <div style="font-size: 0.7rem; font-weight: 800; color: var(--success); margin-top: 5px;">✓ In Cart (Click to remove)</div>
                </button>
              </form>
            <% } else { %>
              <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                <input type="hidden" name="course_id" value="<%= course.id %>">
                <button type="submit" class="course-tile tile-available" <%= pending.length > 0 ? 'disabled' : '' %>>
                  <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                  <div class="tile-code"><%= course.code %></div>
                  <div class="tile-title"><%= course.title %></div>
                  <div style="font-size: 0.7rem; font-weight: 800; color: var(--blue); margin-top: 5px;">+ Add to Cart</div>
                </button>
              </form>
            <% } %>
          <% }) %>
        </div>
      </div>

      <!-- Next Semester -->
      <div class="semester-panel">
        <div class="semester-header">
          <span>Next Semester (Sem 2)</span>
          <span style="background: var(--amber); color: var(--navy); padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem;">Allowed</span>
        </div>
        <div class="course-list">
          <% if (bySem[2].length === 0) { %>
             <div style="text-align: center; color: #94a3b8; padding: 1rem;">No courses available.</div>
          <% } %>
          <% bySem[2].forEach(course => { 
            const inCart = cart.find(c => c.course_id === course.id);
            const isPending = pending.find(p => p.course_id === course.id);
          %>
            <% if (isPending) { %>
              <div class="course-tile tile-selected">
                <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                <div class="tile-code"><%= course.code %></div>
                <div class="tile-title"><%= course.title %></div>
                <div style="font-size: 0.7rem; font-weight: 800; color: var(--success); margin-top: 5px;">✓ Pending Approval</div>
              </div>
            <% } else if (inCart) { %>
              <form method="POST" action="/sis/my/registration/remove" style="margin: 0;">
                <input type="hidden" name="cart_id" value="<%= inCart.cart_id %>">
                <button type="submit" class="course-tile tile-selected">
                  <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                  <div class="tile-code"><%= course.code %></div>
                  <div class="tile-title"><%= course.title %></div>
                  <div style="font-size: 0.7rem; font-weight: 800; color: var(--success); margin-top: 5px;">✓ In Cart (Click to remove)</div>
                </button>
              </form>
            <% } else { %>
              <form method="POST" action="/sis/my/registration/add" style="margin: 0;">
                <input type="hidden" name="course_id" value="<%= course.id %>">
                <button type="submit" class="course-tile tile-available" <%= pending.length > 0 ? 'disabled' : '' %>>
                  <div class="tile-credit"><%= course.credits %><small>CR</small></div>
                  <div class="tile-code"><%= course.code %></div>
                  <div class="tile-title"><%= course.title %></div>
                  <div style="font-size: 0.7rem; font-weight: 800; color: var(--blue); margin-top: 5px;">+ Add to Cart</div>
                </button>
              </form>
            <% } %>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="summary-footer">
      <div class="summary-text">Selected: <%= cart.length %> courses</div>
      <% if (pending.length > 0) { %>
        <button class="btn-submit" disabled><i class="fas fa-clock"></i> Awaiting Advisor</button>
      <% } else { %>
        <form method="POST" action="/sis/my/registration/submit" style="margin: 0;">
          <button type="submit" class="btn-submit" <%= cart.length === 0 ? 'disabled' : '' %>>
            Submit to Advisor <i class="fas fa-rocket"></i>
          </button>
        </form>
      <% } %>
    </div>
  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
  </script>
</body>
</html>