<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Document Requests</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .layout { display: grid; grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; }
    
    .form-card { background: #fff; padding: 2rem; border-radius: 1.5rem; box-shadow: var(--shadow); border: 1px solid var(--frost); position: sticky; top: 2rem; }
    .form-card h3 { margin-bottom: 1.5rem; color: var(--navy); font-size: 1.2rem; display: flex; align-items: center; gap: 0.5rem; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--navy); }
    .form-control { width: 100%; padding: 1rem; border: 1px solid var(--frost); border-radius: 10px; font-family: inherit; background: var(--ice); outline: none; transition: 0.2s; font-size: 0.95rem; color: var(--navy); }
    .form-control:focus { border-color: var(--amber); background: #fff; box-shadow: 0 0 0 3px rgba(245,166,35,0.1); }
    .btn-submit { background: var(--navy); color: #fff; padding: 1rem; border-radius: 10px; border: none; font-weight: 800; font-size: 1rem; cursor: pointer; width: 100%; transition: 0.2s; display: flex; justify-content: center; align-items: center; gap: 0.5rem; }
    .btn-submit:hover { background: var(--blue); transform: translateY(-2px); }

    .requests-list { display: flex; flex-direction: column; gap: 1rem; }
    .request-card { background: #fff; padding: 1.5rem; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); display: flex; align-items: center; justify-content: space-between; transition: 0.2s; position: relative; overflow: hidden; flex-wrap: wrap; gap: 1rem; }
    .request-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; }
    .request-card.pending::before { background: var(--amber); }
    .request-card.ready::before { background: var(--success); }
    .request-card.rejected::before { background: var(--danger); }

    .req-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-right: 1.5rem; flex-shrink: 0; }
    .req-icon.pending { background: #fef3c7; color: #d97706; }
    .req-icon.ready { background: #dcfce7; color: #16a34a; }
    .req-icon.rejected { background: #fee2e2; color: #dc2626; }

    .req-info h4 { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.3rem; }
    .req-info p { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .req-info .notes { font-size: 0.8rem; color: #94a3b8; font-style: italic; margin-top: 0.3rem; }
    
    .req-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 0.8rem; }
    .badge { padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge.pending { background: #fef3c7; color: #d97706; }
    .badge.ready { background: #dcfce7; color: #16a34a; }
    .badge.rejected { background: #fee2e2; color: #dc2626; }
    
    .btn-download { background: var(--gold); color: var(--navy); padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none; font-weight: 800; font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; transition: 0.2s; }
    .btn-download:hover { background: var(--amber); transform: scale(1.05); }
    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .btn-back { display: inline-flex; }
      .layout { grid-template-columns: 1fr; gap: 1rem; }
      .request-card { flex-direction: column; align-items: flex-start; }
      .req-actions { align-items: flex-start; width: 100%; margin-top: 1rem; }
      .form-card { position: static; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit"></i> Course Registration</a></li>
      <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
      <li><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol"></i> Transcript</a></li>
      <li><a href="/sis/my/finance" class="menu-link"><i class="fas fa-wallet"></i> Accounting</a></li>
      <li><a href="/sis/my/documents" class="menu-link active"><i class="fas fa-file-alt"></i> Document Requests</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Document Requests</h1>
      <p>Request official documents from the Registrar's Office.</p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <div class="layout">
      <div class="form-card">
        <h3><i class="fas fa-file-signature" style="color: var(--amber);"></i> New Request</h3>
        <form method="POST" action="/sis/my/documents/request">
          <div class="form-group">
            <label>Select Document Type</label>
            <select name="document_type" class="form-control" required>
              <option value="" disabled selected>-- Choose a document --</option>
              <option value="Enrollment Certificate">Enrollment Certificate</option>
              <option value="Official Transcript">Official Transcript</option>
              <option value="Student ID Letter">Student ID Letter</option>
              <option value="Recommendation Letter">Recommendation Letter</option>
              <option value="Graduation Letter">Graduation Letter</option>
            </select>
          </div>
          <div class="form-group">
            <label>Reason / Special Instructions (Optional)</label>
            <textarea name="notes" class="form-control" rows="3" placeholder="e.g., Needed for a visa application..."></textarea>
          </div>
          <button type="submit" class="btn-submit"><i class="fas fa-paper-plane"></i> Submit Request</button>
        </form>
      </div>

      <div class="requests-list">
        <% if (requests.length === 0) { %>
          <div style="background:#fff; padding: 3rem; border-radius: 1.25rem; text-align: center; color: #64748b; border: 1px solid var(--frost);">
            <i class="fas fa-folder-open" style="font-size: 3rem; color: var(--frost); margin-bottom: 1rem;"></i>
            <h3>No requests yet</h3>
            <p>Submit a form on the left to request your first document.</p>
          </div>
        <% } %>
        
        <% requests.forEach(req => { %>
          <div class="request-card <%= req.status %>">
            <div style="display: flex; align-items: center;">
              <div class="req-icon <%= req.status %>">
                <% if(req.status === 'pending') { %><i class="fas fa-clock"></i><% } %>
                <% if(req.status === 'ready') { %><i class="fas fa-check-circle"></i><% } %>
                <% if(req.status === 'rejected') { %><i class="fas fa-times-circle"></i><% } %>
              </div>
              <div class="req-info">
                <h4><%= req.document_type %></h4>
                <p>Requested on: <%= new Date(req.requested_at).toLocaleDateString() %></p>
                <% if (req.notes) { %>
                  <div class="notes">Note: "<%= req.notes %>"</div>
                <% } %>
              </div>
            </div>
            
            <div class="req-actions">
              <span class="badge <%= req.status %>"><%= req.status %></span>
              
              <% if (req.admin_notes) { %>
                <div style="font-size: 0.8rem; color: #475569; font-weight: 600; margin-top: 0.5rem; background: var(--ice); padding: 0.5rem; border-radius: 6px; max-width: 250px;">
                  <i class="fas fa-comment-dots" style="color: var(--blue);"></i> <%= req.admin_notes %>
                </div>
              <% } %>

              <% if (req.status === 'pending') { %>
                <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 600;">Est. time: 2-3 days</span>
              <% } else if (req.status === 'ready') { %>
                <a href="/sis/my/documents/view/<%= req.id %>" target="_blank" class="btn-download"><i class="fas fa-eye"></i> View Document</a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>
</body>
</html>