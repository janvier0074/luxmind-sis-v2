<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Finance</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
    
    .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .summary-box { background: #fff; padding: 1.2rem; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--frost); border-top: 4px solid var(--navy); }
    .summary-box h4 { font-size: 0.75rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.5rem; font-weight: 800; }
    .summary-box .val { font-size: 1.2rem; font-weight: 800; color: var(--navy); }
    
    .summary-box.debt { border-top-color: var(--danger); }
    .summary-box.debt .val { color: var(--danger); }
    .summary-box.approaching { border-top-color: var(--amber); }
    .summary-box.approaching .val { color: var(--amber); }
    
    .exchange-rate { font-size: 0.85rem; font-weight: 700; color: var(--blue); margin-bottom: 2rem; }

    .table-controls { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .table-controls select, .table-controls input { padding: 0.6rem; border: 1px solid var(--frost); border-radius: 6px; font-family: inherit; font-size: 0.85rem; background: #fff; outline: none; }
    .table-controls input { flex: 1; min-width: 200px; }
    .table-controls button { padding: 0.6rem 1rem; background: var(--navy); color: #fff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; }

    .table-container { background: #fff; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow-x: auto; margin-bottom: 2rem; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; min-width: 1000px; }
    .data-table th { background: var(--navy); color: #fff; padding: 1rem; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; white-space: nowrap; }
    .data-table td { padding: 1rem; border-bottom: 1px solid var(--frost); font-size: 0.85rem; font-weight: 600; }
    .data-table tr:hover { background: #f8fafc; }
    .data-table .charges { color: var(--danger); font-weight: 800; }
    .data-table .payments { color: var(--success); font-weight: 800; }
    
    .installment-card { background: #fff; padding: 1.5rem; border-radius: 10px; box-shadow: var(--shadow); border: 1px solid var(--frost); margin-bottom: 2rem; }
    .form-control { width: 100%; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); outline: none; font-size: 0.9rem; margin-bottom: 0.5rem;}
    .btn-pay { background: var(--navy); color: #fff; padding: 0.7rem 1.2rem; border-radius: 8px; border: none; font-weight: 800; font-size: 0.85rem; cursor: pointer; width: 100%; transition: 0.2s; }
    .btn-pay:hover { opacity: 0.9; }

    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }

    @media (max-width: 1024px) { .summary-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 900px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); width: 280px; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
    }
    @media (max-width: 500px) { .summary-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit"></i> Course Registration</a></li>
      <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
      <li><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol"></i> Transcript</a></li>
      <li><a href="/sis/my/finance" class="menu-link active"><i class="fas fa-wallet"></i> Accounting</a></li>
      <li><a href="/sis/my/guidance" class="menu-link"><i class="fas fa-hands-helping"></i> Guidance Requests</a></li>
      <li><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-alt"></i> Document Requests</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Student Account</h1>
      <p><%= student.full_name %> · <%= student.class_level %> · <%= student.username %></p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div style="background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700;">
        <i class="fas fa-check-circle"></i> <%= flash.success[0] %>
      </div>
    <% } %>
    <% if (flash.error && flash.error.length > 0) { %>
      <div style="background: #fee2e2; color: #dc2626; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700;">
        <i class="fas fa-exclamation-circle"></i> <%= flash.error[0] %>
      </div>
    <% } %>

    <!-- ✅ OVERDUE PAYMENT ALERT (MUST PAY NOW) -->
    <% if (typeof overdueAmount !== 'undefined' && overdueAmount > 0) { %>
      <div style="background: #fee2e2; border: 2px solid var(--danger); color: var(--danger); padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem;">
        <i class="fas fa-exclamation-triangle" style="font-size: 1.5rem;"></i>
        <div>
          <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.2rem;">Overdue Payment</div>
          <div style="font-size: 1.3rem;">$<%= Number(overdueAmount).toFixed(2) %> is now overdue</div>
          <div style="font-size: 0.75rem; font-weight: 500; margin-top: 0.2rem;">Please pay immediately to unlock registration.</div>
        </div>
      </div>
    <% } %>

    <!-- CIU ACCESS & DEBT SUMMARY -->
    <div class="summary-grid">
      <div class="summary-box">
        <h4>General Access</h4>
        <div class="val">Active</div>
      </div>
      <div class="summary-box">
        <h4>Provisional Access</h4>
        <div class="val">200 EUR</div>
      </div>
      <div class="summary-box">
        <h4>Full Access Limit</h4>
        <div class="val">400 EUR</div>
      </div>
      <div class="summary-box">
        <h4>Current Debt</h4>
        <div class="val <%= currentDebt > 0 ? 'text-danger' : '' %>">$<%= Number(currentDebt).toFixed(2) %></div>
      </div>
      <div class="summary-box approaching">
        <h4>Approaching Debt</h4>
        <div class="val">$<%= Number(approachingDebt).toFixed(2) %></div>
      </div>
      <div class="summary-box debt">
        <h4>Total Debt</h4>
        <div class="val">$<%= Number(totalDebt).toFixed(2) %></div>
      </div>
    </div>

    <div class="exchange-rate">
      <i class="fas fa-info-circle"></i> Current exchange rate: 1 EUR = 57.3775 TRY (Mocked)
    </div>

    <% if (hasApprovedInstallment && currentDebt > 0) { %>
      <div style="background: #e0f2fe; color: #0284c7; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; border: 1px solid #bae6fd; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-info-circle"></i> 
        <span>You have an <strong>Approved Installment Plan</strong>. You are cleared for <strong>Temporary Registration</strong>.</span>
      </div>
    <% } %>

    <!-- TRANSACTIONS TABLE CONTROLS -->
    <div class="table-controls">
      <select>
        <option>All terms / years</option>
        <option>2026-27 Fall</option>
        <option>2025-26 Spring</option>
      </select>
      <input type="text" id="searchInput" placeholder="Search transactions..." onkeyup="filterTable()">
      <button><i class="fas fa-search"></i> Search</button>
    </div>

    <!-- INVOICE CATEGORIES / LEDGER TABLE -->
    <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--navy);">Invoice Categories</h3>
    <div class="table-container">
      <table class="data-table" id="ledgerTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Description</th>
            <th>Charges (+)</th>
            <th>Payments / Credits (-)</th>
            <th>Installment</th>
            <th>Term/Year</th>
            <th>Created At</th>
          </tr>
        </thead>
        <tbody>
          <% if (!transactions || transactions.length === 0) { %>
            <tr><td colspan="8" style="text-align: center; color: #94a3b8; font-style: italic;">No transactions found.</td></tr>
          <% } %>
          <% transactions.forEach(t => { %>
            <tr>
              <td><%= t.date %></td>
              <td><span style="background: <%= t.type === 'Payment' ? '#dcfce7' : '#fee2e2' %>; color: <%= t.type === 'Payment' ? '#16a34a' : '#dc2626' %>; padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800;"><%= t.type %></span></td>
              <td><%= t.description %></td>
              <td class="charges"><%= t.charges ? '$' + Number(t.charges).toFixed(2) : '-' %></td>
              <td class="payments"><%= t.payments ? '-$' + Number(t.payments).toFixed(2) : '-' %></td>
              <td><%= t.installment %></td>
              <td><%= t.term %></td>
              <td style="color: #64748b; font-size: 0.75rem;"><%= t.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ✅ STEP 2: INSTALLMENT SCHEDULE TABLE WITH PAY BUTTONS -->
    <% if (typeof schedule !== 'undefined' && schedule.length > 0) { %>
      <div class="table-container" style="margin-top: 2rem; border-color: <%= hasOverdue ? 'var(--danger)' : 'var(--frost)' %>;">
        <div style="padding: 1rem; border-bottom: 1px solid var(--frost); background: <%= hasOverdue ? '#fef2f2' : '#f8fafc' %>; display: flex; justify-content: space-between; align-items: center;">
          <h3 style="font-size: 1rem; font-weight: 800; color: <%= hasOverdue ? 'var(--danger)' : 'var(--navy)' %>;">
            <i class="fas fa-calendar-alt"></i> Payment Schedule
          </h3>
          <% if (hasOverdue) { %>
            <span style="background: var(--danger); color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">ACTION REQUIRED: OVERDUE</span>
          <% } %>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Installment</th>
              <th>Due Date</th>
              <th>Amount</th>
              <th>Status / Action</th>
            </tr>
          </thead>
          <tbody>
            <% schedule.forEach((s, index) => { %>
              <tr style="<%= s.status === 'overdue' ? 'background: #fef2f2;' : (s.status === 'paid' ? 'background: #f0fdf4;' : '') %>">
                <td><strong>#<%= index + 1 %></strong></td>
                <td><%= new Date(s.due_date).toLocaleDateString() %></td>
                <td><strong>$<%= Number(s.amount).toFixed(2) %></strong></td>
                <td>
                  <% if (s.status === 'unpaid') { %>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                      <span style="color: var(--amber); font-weight: 800; font-size: 0.8rem;"><i class="fas fa-clock"></i> Unpaid</span>
                      <form method="POST" action="/sis/my/finance/pay" style="display: inline;">
                        <input type="hidden" name="installment_id" value="<%= s.id %>">
                        <button type="submit" style="background: var(--blue); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 700; font-size: 0.7rem; cursor: pointer; white-space: nowrap;">
                          <i class="fas fa-credit-card"></i> Pay $<%= Number(s.amount).toFixed(2) %>
                        </button>
                      </form>
                    </div>
                  <% } else if (s.status === 'overdue') { %>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                      <span style="color: var(--danger); font-weight: 800; font-size: 0.8rem;"><i class="fas fa-exclamation-triangle"></i> Overdue</span>
                      <form method="POST" action="/sis/my/finance/pay" style="display: inline;">
                        <input type="hidden" name="installment_id" value="<%= s.id %>">
                        <button type="submit" style="background: var(--danger); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 700; font-size: 0.7rem; cursor: pointer; white-space: nowrap;">
                          <i class="fas fa-credit-card"></i> Pay Now $<%= Number(s.amount).toFixed(2) %>
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span style="color: var(--success); font-weight: 800; font-size: 0.8rem;"><i class="fas fa-check-circle"></i> Paid</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <!-- ACTIONS: PAY & INSTALLMENTS -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
      
      <!-- ✅ STEP 3: IMPROVED QUICK PAYMENT CARD -->
      <% if (currentDebt > 0) { %>
        <div class="installment-card">
          <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.25rem; color: var(--navy);">
            <i class="fas fa-bolt" style="color: var(--amber);"></i> Quick Payment
          </h3>
          <p style="font-size: 0.75rem; color: #64748b; margin-bottom: 1rem;">
            <% if (typeof schedule !== 'undefined' && schedule.some(s => s.status !== 'paid')) { %>
              You have <strong><%= schedule.filter(s => s.status !== 'paid').length %> unpaid installment(s)</strong>. Pay them individually in the schedule above, or make a general payment below.
            <% } else { %>
              Make a general payment toward your tuition balance.
            <% } %>
          </p>
          <form method="POST" action="/sis/my/finance/pay" style="display: flex; gap: 1rem;">
           <input type="number" name="amount" value="<%= Number(currentDebt).toFixed(2) %>" max="<%= Number(currentDebt).toFixed(2) %>" min="0.01" step="0.01" required style="flex: 1; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit;">
            <button type="submit" class="btn-pay" style="width: auto; padding: 0 1.5rem; white-space: nowrap;">
              <i class="fas fa-credit-card"></i> Pay Now
            </button>
          </form>
          <div style="margin-top: 0.75rem; padding: 0.6rem 0.75rem; background: #fef3c7; border-radius: 6px; font-size: 0.7rem; color: #92400e; font-weight: 600;">
            <i class="fas fa-info-circle"></i> General payments do not automatically mark installments as paid. Use the Pay buttons in the schedule above for accurate tracking.
          </div>
        </div>
      <% } else { %>
        <div class="installment-card" style="background: #ecfdf5; border-color: var(--success);">
          <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--success);">
            <i class="fas fa-check-circle"></i> Account Fully Paid
          </h3>
          <p style="font-size: 0.85rem; color: #065f46; font-weight: 600;">
            Your tuition balance is clear. You have no outstanding debt at this time.
          </p>
        </div>
      <% } %>

      <!-- INSTALLMENTS (Calendar-Based, 2-8 Options) -->
      <div class="installment-card">
        <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 1rem; color: var(--navy);">Installment Plans</h3>
        
        <% if (semesterEndDate) { %>
          <div style="background: #eff6ff; color: #1e40af; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.8rem; font-weight: 600; border: 1px solid #bfdbfe;">
            <i class="fas fa-calendar-alt"></i> Current semester ends on <strong><%= new Date(semesterEndDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>. All installments must be paid before finals week.
          </div>
        <% } %>

        <% if (installments.length > 0) { %>
          <div style="margin-bottom: 1rem;">
            <% installments.forEach(inst => { %>
              <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 0.75rem; border-radius: 8px; margin-bottom: 0.5rem; font-size: 0.85rem;">
                <span><strong>$<%= Number(inst.total_amount).toFixed(2) %></strong> - <%= inst.installments_count %> Payments</span>
                <span style="padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; background: <%= inst.status === 'approved' ? '#dcfce7' : (inst.status === 'rejected' ? '#fee2e2' : '#fef3c7') %>; color: <%= inst.status === 'approved' ? '#16a34a' : (inst.status === 'rejected' ? '#dc2626' : '#d97706') %>;"><%= inst.status %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="font-size: 0.85rem; color: #64748b; font-style: italic; margin-bottom: 1rem;">No installment plans requested yet.</p>
        <% } %>

        <% if (currentDebt > 0 && !hasApprovedInstallment) { %>
          <form method="POST" action="/sis/my/finance/installment/request" style="border-top: 1px dashed var(--frost); padding-top: 1rem;">
            <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 0.5rem; font-weight: 600;">Request an installment plan to unlock Temporary Registration. Payments will be scheduled before finals week.</p>
            <input type="hidden" name="total_amount" value="<%= currentDebt %>">
            
            <label style="font-size: 0.75rem; font-weight: 800; color: var(--navy); display: block; margin-bottom: 0.4rem;">How many installments do you want?</label>
            <div style="display: flex; gap: 0.5rem;">
              <select name="installments_count" id="instSelect" required onchange="updatePreview()" style="flex: 1; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; font-size: 0.9rem; background: var(--ice);">
                <option value="2">2 Payments</option>
                <option value="3" selected>3 Payments</option>
                <option value="4">4 Payments</option>
                <option value="5">5 Payments</option>
                <option value="6">6 Payments</option>
                <option value="7">7 Payments</option>
                <option value="8">8 Payments</option>
              </select>
              <button type="submit" class="btn-pay" style="width: auto; padding: 0 1.5rem; background: var(--blue);">Request</button>
            </div>
            
            <div id="installmentPreview" style="margin-top: 0.75rem; padding: 0.75rem; background: #fef3c7; border-radius: 8px; font-size: 0.75rem; color: #92400e; font-weight: 600; border: 1px solid #fde68a;">
              <div id="previewText">Loading preview...</div>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    function filterTable() {
      const input = document.getElementById('searchInput');
      const filter = input.value.toUpperCase();
      const table = document.getElementById('ledgerTable');
      const tr = table.getElementsByTagName('tr');

      for (let i = 1; i < tr.length; i++) {
        let txtValue = tr[i].textContent || tr[i].innerText;
        if (txtValue.toUpperCase().indexOf(filter) > -1) {
          tr[i].style.display = "";
        } else {
          tr[i].style.display = "none";
        }
      }
    }

    const SEMESTER_END = '<%= semesterEndDate || "" %>';
    const CURRENT_DEBT = <%= Number(currentDebt) || 0 %>;

    function updatePreview() {
      if (!SEMESTER_END) {
        document.getElementById('previewText').innerHTML = 'Semester end date not set. Contact Registrar.';
        return;
      }

      const count = parseInt(document.getElementById('instSelect').value);
      const perPayment = CURRENT_DEBT / count;
      
      const lastDate = new Date(SEMESTER_END);
      lastDate.setDate(lastDate.getDate() - 14);
      
      const firstDate = new Date();
      firstDate.setDate(firstDate.getDate() + 7);
      
      const totalDays = Math.floor((lastDate - firstDate) / (1000 * 60 * 60 * 24));
      const interval = count > 1 ? totalDays / (count - 1) : 0;
      
      let dates = [];
      for (let i = 0; i < count; i++) {
        const d = new Date(firstDate);
        d.setDate(d.getDate() + Math.round(i * interval));
        dates.push(d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }));
      }
      
      document.getElementById('previewText').innerHTML = 
        `<strong>${count} payments of $${perPayment.toFixed(2)} each</strong><br>` +
        `<span style="font-weight: 600;">Due dates: ${dates.join(' · ')}</span><br>` +
        `<span style="font-weight: 500; color: #78350f; font-size: 0.7rem;">All payments fall before finals week.</span>`;
    }
    
    if (document.getElementById('instSelect')) {
      updatePreview();
    }
  </script>

</body>
</html>