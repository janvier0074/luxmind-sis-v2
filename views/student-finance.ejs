<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Finance</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;}
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    /* Debt Stats */
    .debt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
    .debt-card { background: #fff; padding: 1.5rem; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); text-align: center; }
    .debt-card h3 { font-size: 0.8rem; text-transform: uppercase; color: #64748b; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .debt-card .amount { font-size: 1.8rem; font-weight: 800; }
    .debt-card.current .amount { color: var(--danger); }
    .debt-card.approaching .amount { color: var(--amber); }
    .debt-card.total .amount { color: var(--navy); }

    /* Layout */
    .finance-layout { display: grid; grid-template-columns: 1fr 350px; gap: 2rem; align-items: start; }
    
    .invoice-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; margin-bottom: 1.5rem;}
    .invoice-header { background: var(--navy); color: #fff; padding: 1.5rem 2rem; border-bottom: 4px solid var(--amber); display: flex; justify-content: space-between; align-items: center;}
    .invoice-header h2 { font-size: 1.3rem; font-weight: 800; }
    .invoice-body { padding: 2rem; }
    .invoice-row { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px dashed var(--frost); font-size: 0.95rem; font-weight: 600; }
    .invoice-row.total { border-bottom: none; font-size: 1.1rem; font-weight: 800; color: var(--navy); padding-top: 1rem; }
    
    .payment-card { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); padding: 2rem; text-align: center; }
    .form-control { width: 100%; padding: 1rem; border: 1px solid var(--frost); border-radius: 10px; font-family: inherit; background: var(--ice); outline: none; font-size: 1rem; margin-bottom: 1rem;}
    .btn-pay { background: var(--navy); color: #fff; padding: 1rem; border-radius: 10px; border: none; font-weight: 800; font-size: 1rem; cursor: pointer; width: 100%; transition: 0.2s; }
    
    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
    .alert-info { background: #e0f2fe; color: #0284c7; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; border: 1px solid #bae6fd; }

    /* Installments */
    .installment-section { background: #fff; padding: 2rem; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); margin-top: 2rem;}
    .installment-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .installment-table th, .installment-table td { padding: 1rem; text-align: left; border-bottom: 1px solid var(--frost); font-size: 0.85rem; }
    
    .btn { padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-block; cursor: pointer; border: none; font-size: 0.9rem;}
    .btn-print { background: var(--gold); color: var(--navy); }
    .btn-request { background: var(--blue); color: #fff; width: 100%; margin-top: 1rem;}

    /* Print Media Query */
    @media print {
      .sidebar, .top-bar, .btn-print, .payment-card, .installment-section, .debt-grid, .alert-success, .alert-info { display: none !important; }
      .main-content { margin-left: 0; padding: 0; width: 100%; }
      .invoice-card { box-shadow: none; border: 1px solid #000; border-radius: 0; }
      .invoice-header { border-bottom: 2px solid #000; background: #fff; color: #000; }
    }

    /* Mobile */
    @media (max-width: 900px) {
      .debt-grid { grid-template-columns: 1fr; }
      .finance-layout { grid-template-columns: 1fr; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .sidebar { transform: translateX(-100%); width: 280px; }
      .sidebar.active { transform: translateX(0); }
    }
  </style>
</head>
<body>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit"></i> Course Registration</a></li>
      <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
      <li><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol"></i> Transcript</a></li>
      <li><a href="/sis/my/finance" class="menu-link active"><i class="fas fa-wallet"></i> Accounting</a></li>
      <li><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-alt"></i> Document Requests</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <div class="top-bar">
      <div>
        <h1>Finance & Accounting</h1>
        <p>Manage your tuition, scholarships, and installments.</p>
      </div>
      <button class="btn btn-print" onclick="window.print()"><i class="fas fa-print"></i> Print Invoice</button>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <!-- CIU TEMPORARY REGISTRATION BANNER -->
    <% if (hasApprovedInstallment && currentDebt > 0) { %>
      <div class="alert-info">
        <i class="fas fa-info-circle text-lg"></i> 
        <span>You have an <strong>Approved Installment Plan</strong>. You are cleared for <strong>Temporary Registration</strong> for this semester.</span>
      </div>
    <% } %>

    <!-- DEBT OVERVIEW CARDS -->
    <div class="debt-grid">
      <div class="debt-card current">
        <h3>Current Debt</h3>
        <div class="amount">$<%= Number(currentDebt).toFixed(2) %></div>
      </div>
      <div class="debt-card approaching">
        <h3>Approaching Debt (Next Sem)</h3>
        <div class="amount">$<%= Number(approachingDebt).toFixed(2) %></div>
      </div>
      <div class="debt-card total">
        <h3>Total Liability</h3>
        <div class="amount">$<%= Number(totalDebt).toFixed(2) %></div>
      </div>
    </div>

    <div class="finance-layout">
      
      <!-- INVOICE -->
      <div>
        <div class="invoice-card">
          <div class="invoice-header">
            <div>
              <h2>Semester <%= student.current_semester %> Tuition Invoice</h2>
              <p><%= student.full_name %> · <%= student.class_level %></p>
            </div>
          </div>
          
          <div class="invoice-body">
            <div class="invoice-row">
              <span>Base Tuition</span>
              <span>$<%= Number(baseTuition).toFixed(2) %></span>
            </div>
            <div class="invoice-row" style="color: var(--success);">
              <span>Scholarship (<%= scholarshipName %> - <%= scholarshipPercentage %>%)</span>
              <span>- $<%= Number(scholarshipAmount).toFixed(2) %></span>
            </div>
            <div class="invoice-row" style="background: var(--ice); padding: 1rem; border-radius: 8px; margin: 0.5rem 0; border-bottom: none;">
              <span style="font-weight: 800;">Net Tuition (After Scholarship)</span>
              <span style="font-weight: 800;">$<%= Number(netTuition).toFixed(2) %></span>
            </div>
            <div class="invoice-row">
              <span>Total Paid</span>
              <span style="color: var(--success);">- $<%= Number(totalPaid).toFixed(2) %></span>
            </div>
            <div class="invoice-row total">
              <span>Remaining Balance Due</span>
              <span style="color: <%= currentDebt > 0 ? 'var(--danger)' : 'var(--success)' %>;">$<%= Number(currentDebt).toFixed(2) %></span>
            </div>
          </div>
        </div>

        <!-- INSTALLMENT SECTION -->
        <div class="installment-section">
          <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 0.5rem;"><i class="fas fa-handshake" style="color: var(--blue);"></i> Installment Plans</h3>
          <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">Can't pay the full amount? Request an installment plan to unlock Temporary Registration.</p>
          
          <% if (installments.length > 0) { %>
            <table class="installment-table">
              <thead>
                <tr>
                  <th>Requested Amount</th>
                  <th>Plan</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% installments.forEach(inst => { %>
                  <tr>
                    <td><strong>$<%= Number(inst.total_amount).toFixed(2) %></strong></td>
                    <td><%= inst.installments_count %> Months</td>
                    <td>
                      <% if (inst.status === 'approved') { %>
                        <span style="color: var(--success); font-weight: 800;"><i class="fas fa-check-circle"></i> Approved</span>
                      <% } else if (inst.status === 'rejected') { %>
                        <span style="color: var(--danger); font-weight: 800;"><i class="fas fa-times-circle"></i> Rejected</span>
                      <% } else { %>
                        <span style="color: var(--amber); font-weight: 800;"><i class="fas fa-clock"></i> Pending Review</span>
                      <% } %>
                    </td>
                    <td><%= new Date(inst.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <p style="font-size: 0.9rem; color: #94a3b8; font-style: italic;">No installment plans requested yet.</p>
          <% } %>

          <% if (currentDebt > 0 && !hasApprovedInstallment) { %>
            <form method="POST" action="/sis/my/finance/installment/request" style="margin-top: 1.5rem; background: var(--ice); padding: 1.5rem; border-radius: 10px; border: 1px solid var(--frost);">
              <input type="hidden" name="total_amount" value="<%= currentDebt %>">
              <label style="font-size: 0.8rem; font-weight: 800; display: block; margin-bottom: 0.5rem;">Select Installment Plan for $<%= Number(currentDebt).toFixed(2) %></label>
              <select name="installments_count" class="form-control" required>
                <option value="2">2 Months (50% / 50%)</option>
                <option value="3">3 Months (33% each)</option>
                <option value="4">4 Months (25% each)</option>
              </select>
              <button type="submit" class="btn btn-request">Submit Installment Request</button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- PAY NOW CARD -->
      <div class="payment-card">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 0.5rem;">Quick Payment</h3>
        <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">Current Balance Due</p>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--danger); margin-bottom: 1.5rem;">$<%= Number(currentDebt).toFixed(2) %></div>
        
        <% if (currentDebt > 0) { %>
          <form method="POST" action="/sis/my/finance/pay">
            <input type="number" name="amount" class="form-control" value="<%= currentDebt %>" max="<%= currentDebt %>" min="1" required>
            <button type="submit" class="btn-pay"><i class="fas fa-credit-card"></i> Pay Now</button>
          </form>
        <% } else { %>
          <div style="background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; font-weight: 700;">
            <i class="fas fa-check-circle"></i> Account Fully Paid
          </div>
        <% } %>
      </div>
      
    </div>
  </main>
</body>
</html>