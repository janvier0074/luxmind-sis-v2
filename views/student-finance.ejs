<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Finance</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
    .btn-print { background: var(--gold); color: var(--navy); padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 800; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }

    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
    .alert-info { background: #e0f2fe; color: #0284c7; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; border: 1px solid #bae6fd; display: flex; align-items: center; gap: 0.5rem; }

    /* VERTICAL INVOICE LAYOUT */
    .invoice-wrapper { max-width: 800px; margin: 0 auto; }
    
    .invoice-card { background: #fff; border-radius: 1rem; box-shadow: var(--shadow); border: 1px solid var(--frost); padding: 2.5rem; margin-bottom: 2rem; }
    
    .invoice-header { text-align: center; border-bottom: 2px dashed var(--frost); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
    .invoice-header h2 { font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .invoice-header p { color: #64748b; font-size: 0.9rem; margin-top: 0.3rem; }

    /* RECEIPT LINES */
    .receipt-row { display: flex; justify-content: space-between; padding: 0.75rem 0; font-size: 1rem; font-weight: 600; border-bottom: 1px solid #f1f5f9; }
    .receipt-row:last-child { border-bottom: none; }
    .receipt-row.total { font-size: 1.2rem; font-weight: 800; color: var(--navy); border-top: 2px solid var(--frost); border-bottom: none; padding-top: 1rem; margin-top: 1rem; }
    .receipt-row.debt { color: var(--danger); font-weight: 800; }
    .receipt-row.credit { color: var(--success); }

    .form-control { width: 100%; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); outline: none; font-size: 0.9rem; margin-bottom: 0.5rem;}
    .btn-pay { background: var(--navy); color: #fff; padding: 0.7rem 1.2rem; border-radius: 8px; border: none; font-weight: 800; font-size: 0.85rem; cursor: pointer; width: 100%; transition: 0.2s; }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }

    @media (max-width: 900px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); width: 280px; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .invoice-card { padding: 1.5rem; }
    }

    /* PRINT ONLY INVOICE */
    @media print {
      body * { visibility: hidden; }
      .invoice-card, .invoice-card * { visibility: visible; }
      .invoice-card { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; border: none; padding: 0; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>

  <button class="mobile-menu-btn no-print" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay no-print" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar no-print" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit"></i> Course Registration</a></li>
      <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
      <li><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol"></i> Transcript</a></li>
      <li><a href="/sis/my/finance" class="menu-link active"><i class="fas fa-wallet"></i> Accounting</a></li>
      <li><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-alt"></i> Document Requests</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <div class="no-print">
      <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>
      <div class="top-bar" style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
          <h1>Financial Statement</h1>
          <p><%= student.full_name %> · <%= student.class_level %> · Semester <%= student.current_semester %></p>
        </div>
        <button class="btn-print" onclick="window.print()"><i class="fas fa-print"></i> Print Only Invoice</button>
      </div>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success no-print"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <!-- CIU TEMPORARY REGISTRATION BANNER -->
    <% if (hasApprovedInstallment && currentDebt > 0) { %>
      <div class="alert-info no-print">
        <i class="fas fa-info-circle text-lg"></i> 
        <span>You have an <strong>Approved Installment Plan</strong>. You are cleared for <strong>Temporary Registration</strong> for this semester.</span>
      </div>
    <% } %>

    <div class="invoice-wrapper">
      
      <!-- THIS IS WHAT GETS PRINTED -->
      <div class="invoice-card">
        <div class="invoice-header">
          <h2>Official Tuition Invoice</h2>
          <p><%= student.full_name %> · ID: <%= student.username %></p>
          <p>Date: <%= new Date().toLocaleDateString('en-GB') %></p>
        </div>

        <!-- INVOICE BREAKDOWN -->
        <div class="receipt-row">
          <span>Base Tuition (Semester <%= student.current_semester %>)</span>
          <span>$<%= Number(baseTuition).toFixed(2) %></span>
        </div>
        <div class="receipt-row credit">
          <span>Scholarship (<%= scholarshipName %> - <%= scholarshipPercentage %>%)</span>
          <span>- $<%= Number(scholarshipAmount).toFixed(2) %></span>
        </div>
        <div class="receipt-row" style="font-weight: 800; background: #f8fafc; padding: 0.75rem;">
          <span>Net Tuition</span>
          <span>$<%= Number(netTuition).toFixed(2) %></span>
        </div>
        <div class="receipt-row credit">
          <span>Total Payments Made</span>
          <span>- $<%= Number(totalPaid).toFixed(2) %></span>
        </div>
        
        <div class="receipt-row total debt">
          <span>Current Remaining Balance</span>
          <span>$<%= Number(currentDebt).toFixed(2) %></span>
        </div>

        <div class="receipt-row" style="font-size: 0.85rem; color: #64748b; border-top: 1px dashed var(--frost); margin-top: 1rem;">
          <span>Approaching Debt (Next Semester)</span>
          <span>$<%= Number(approachingDebt).toFixed(2) %></span>
        </div>
        <div class="receipt-row" style="font-size: 0.85rem; color: #64748b; border-bottom: none;">
          <span>Total Liability</span>
          <span>$<%= Number(totalDebt).toFixed(2) %></span>
        </div>
      </div>
      
      <!-- ACTIONS AND INSTALLMENTS (NOT PRINTED) -->
      <div class="no-print">
        
        <% if (currentDebt > 0) { %>
          <div class="invoice-card" style="padding: 1.5rem;">
            <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 1rem; color: var(--navy);">Quick Payment</h3>
            <form method="POST" action="/sis/my/finance/pay" style="display: flex; gap: 1rem;">
              <input type="number" name="amount" value="<%= currentDebt %>" max="<%= currentDebt %>" min="1" required style="flex: 1; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit;">
              <button type="submit" class="btn-pay" style="width: auto; padding: 0 1.5rem;">Pay Now</button>
            </form>
          </div>
        <% } %>

        <div class="invoice-card" style="padding: 1.5rem;">
          <h3 style="font-size: 1rem; font-weight: 800; margin-bottom: 1rem; color: var(--navy);">Installment Plans</h3>
          
          <% if (installments.length === 0) { %>
            <p style="font-size: 0.85rem; color: #64748b; font-style: italic; margin-bottom: 1rem;">No installment plans requested yet.</p>
          <% } %>
          
          <% installments.forEach(inst => { %>
            <div class="receipt-row" style="background: #f8fafc; padding: 0.75rem; border-radius: 8px; margin-bottom: 0.5rem; border: none;">
              <span style="font-size: 0.85rem;"><strong>$<%= Number(inst.total_amount).toFixed(2) %></strong> - <%= inst.installments_count %> Months Plan</span>
              <span class="badge <%= inst.status %>" style="padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; background: <%= inst.status === 'approved' ? '#dcfce7' : (inst.status === 'rejected' ? '#fee2e2' : '#fef3c7') %>; color: <%= inst.status === 'approved' ? '#16a34a' : (inst.status === 'rejected' ? '#dc2626' : '#d97706') %>;"><%= inst.status %></span>
            </div>
          <% }) %>

          <% if (currentDebt > 0 && !hasApprovedInstallment) { %>
            <div style="margin-top: 1.5rem; border-top: 1px dashed var(--frost); padding-top: 1.5rem;">
              <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 0.5rem; font-weight: 600;">Can't pay the full amount? Request an installment plan to unlock Temporary Registration.</p>
              <form method="POST" action="/sis/my/finance/installment/request" style="display: flex; gap: 0.5rem;">
                <input type="hidden" name="total_amount" value="<%= currentDebt %>">
                <select name="installments_count" required style="flex: 1; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; font-size: 0.9rem; background: var(--ice);">
                  <option value="2">2 Months (50% / 50%)</option>
                  <option value="3">3 Months (33% each)</option>
                  <option value="4">4 Months (25% each)</option>
                </select>
                <button type="submit" class="btn-pay" style="width: auto; padding: 0 1.5rem; background: var(--blue);">Request Plan</button>
              </form>
            </div>
          <% } %>
        </div>

      </div>

    </div>

  </main>

  <script>
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }
  </script>

</body>
</html>