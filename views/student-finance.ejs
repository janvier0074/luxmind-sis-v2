<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Finance</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --success: #1f8a5f; --danger: #b33e2e; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i { width: 25px; color: var(--gold); }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }
    .btn-print { background: var(--gold); color: var(--navy); padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 800; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1rem; }

    .alert-success { background: #dcfce7; color: #16a34a; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
    .alert-info { background: #e0f2fe; color: #0284c7; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-weight: 700; border: 1px solid #bae6fd; display: flex; align-items: center; gap: 0.5rem; }

    /* SINGLE MASTER TABLE STYLES */
    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow-x: auto; margin-bottom: 2rem; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; min-width: 600px; }
    .data-table th { background: var(--navy); color: #fff; padding: 1.2rem 1rem; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; }
    .data-table td { padding: 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; }
    
    .badge { padding: 0.3rem 0.8rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
    .badge.pending { background: #fef3c7; color: #d97706; }
    .badge.approved { background: #dcfce7; color: #16a34a; }
    .badge.rejected { background: #fee2e2; color: #dc2626; }

    .form-control { width: 100%; padding: 0.7rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); outline: none; font-size: 0.9rem; margin-bottom: 0.5rem;}
    .btn-pay { background: var(--navy); color: #fff; padding: 0.7rem 1.2rem; border-radius: 8px; border: none; font-weight: 800; font-size: 0.85rem; cursor: pointer; width: 100%; transition: 0.2s; }

    /* --- MOBILE FIXES --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }

    @media (max-width: 900px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); width: 280px; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
    }

    @media print {
      .sidebar, .top-bar, .btn-print, .btn-back, .alert-success, .alert-info, .no-print { display: none !important; }
      .main-content { margin-left: 0; padding: 0; width: 100%; }
      .table-container { box-shadow: none; border: none; }
      .data-table th { background: #fff; color: #000; border-bottom: 2px solid #000; }
    }
  </style>
</head>
<body>

  <!-- Mobile Hamburger Button & Overlay -->
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit"></i> Course Registration</a></li>
      <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
      <li><a href="/sis/my/transcript" class="menu-link"><i class="fas fa-list-ol"></i> Transcript</a></li>
      <li><a href="/sis/my/finance" class="menu-link active"><i class="fas fa-wallet"></i> Accounting</a></li>
      <li><a href="/sis/my/documents" class="menu-link"><i class="fas fa-file-alt"></i> Document Requests</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Financial Statement</h1>
      <p><%= student.full_name %> · <%= student.class_level %> · Semester <%= student.current_semester %></p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %>
      <div class="alert-success"><i class="fas fa-check-circle"></i> <%= flash.success[0] %></div>
    <% } %>

    <!-- CIU TEMPORARY REGISTRATION BANNER -->
    <% if (hasApprovedInstallment && currentDebt > 0) { %>
      <div class="alert-info">
        <i class="fas fa-info-circle text-lg"></i> 
        <span>You have an <strong>Approved Installment Plan</strong>. You are cleared for <strong>Temporary Registration</strong> for this semester.</span>
      </div>
    <% } %>

    <div style="display: flex; justify-content: flex-end;" class="no-print">
      <button class="btn-print" onclick="window.print()"><i class="fas fa-print"></i> Print Statement</button>
    </div>

    <!-- ONE MASTER TABLE -->
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Financial Item</th>
            <th style="text-align: right;">Amount</th>
            <th style="text-align: right;">Status / Action</th>
          </tr>
        </thead>
        <tbody>
          <!-- SUMMARY SECTION -->
          <tr>
            <td style="font-weight: 800; color: var(--danger);">Current Semester Debt</td>
            <td style="text-align: right; color: var(--danger); font-weight: 800;">$<%= Number(currentDebt).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr>
            <td style="font-weight: 800; color: var(--amber);">Approaching Debt (Next Sem)</td>
            <td style="text-align: right; color: var(--amber); font-weight: 800;">$<%= Number(approachingDebt).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr style="background: var(--ice);">
            <td style="font-weight: 800; font-size: 1.05rem;">Total Liability</td>
            <td style="text-align: right; font-weight: 800; font-size: 1.05rem; color: var(--navy);">$<%= Number(totalDebt).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>

          <!-- INVOICE SECTION -->
          <tr>
            <td>Base Tuition (Semester <%= student.current_semester %>)</td>
            <td style="text-align: right;">$<%= Number(baseTuition).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr>
            <td>Scholarship (<%= scholarshipName %> - <%= scholarshipPercentage %>%)</td>
            <td style="text-align: right; color: var(--success);">- $<%= Number(scholarshipAmount).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr>
            <td style="font-weight: 800;">Net Tuition</td>
            <td style="text-align: right; font-weight: 800;">$<%= Number(netTuition).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr>
            <td>Total Payments Made</td>
            <td style="text-align: right; color: var(--success);">- $<%= Number(totalPaid).toFixed(2) %></td>
            <td style="text-align: right;"></td>
          </tr>
          <tr>
            <td style="font-weight: 800; color: var(--danger);">Remaining Balance Due</td>
            <td style="text-align: right; font-weight: 800; color: var(--danger);">$<%= Number(currentDebt).toFixed(2) %></td>
            <td style="text-align: right;" class="no-print">
              <% if (currentDebt > 0) { %>
                <form method="POST" action="/sis/my/finance/pay" style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                  <input type="number" name="amount" value="<%= currentDebt %>" max="<%= currentDebt %>" min="1" required style="width: 100px; padding: 0.5rem; border: 1px solid var(--frost); border-radius: 6px;">
                  <button type="submit" class="btn-pay" style="width: auto; padding: 0.5rem 1rem;">Pay</button>
                </form>
              <% } %>
            </td>
          </tr>

          <!-- INSTALLMENT SECTION -->
          <tr>
            <td colspan="3" style="background: var(--navy); color: var(--gold); font-weight: 800; padding: 0.75rem 1rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">Installment Plans</td>
          </tr>
          <% if (installments.length === 0) { %>
            <tr>
              <td colspan="3" style="text-align: center; color: #94a3b8; font-style: italic;">No installment plans requested yet.</td>
            </tr>
          <% } %>
          <% installments.forEach(inst => { %>
            <tr>
              <td><strong>$<%= Number(inst.total_amount).toFixed(2) %></strong> - <%= inst.installments_count %> Months Plan</td>
              <td style="text-align: right;"><%= new Date(inst.created_at).toLocaleDateString() %></td>
              <td style="text-align: right;"><span class="badge <%= inst.status %>"><%= inst.status %></span></td>
            </tr>
          <% }) %>
          
          <% if (currentDebt > 0 && !hasApprovedInstallment) { %>
            <tr class="no-print">
              <td colspan="3" style="background: var(--ice);">
                <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 0.5rem; font-weight: 600;">Can't pay the full amount? Request an installment plan to unlock Temporary Registration.</p>
                <form method="POST" action="/sis/my/finance/installment/request" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  <input type="hidden" name="total_amount" value="<%= currentDebt %>">
                  <select name="installments_count" required style="flex: 1; padding: 0.5rem; border: 1px solid var(--frost); border-radius: 6px; font-family: inherit; font-size: 0.85rem;">
                    <option value="2">2 Months (50% / 50%)</option>
                    <option value="3">3 Months (33% each)</option>
                    <option value="4">4 Months (25% each)</option>
                  </select>
                  <button type="submit" class="btn-pay" style="width: auto; padding: 0.5rem 1rem; background: var(--blue);">Request Plan</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>

  <script>
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }
  </script>

</body>
</html>