<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - Makeup Exam Application</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
    :root { --navy: #0a1e32; --blue: #1e4d7b; --gold: #ffc857; --ice: #f7fafd; --frost: #d9e6f2; --amber: #f5a623; --shadow: 0 8px 20px -6px rgba(10,30,50,0.12); --danger: #b33e2e; --success: #1f8a5f; }
    body { background: var(--ice); display: flex; min-height: 100vh; color: var(--navy); }
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .brand-mark { width: 35px; height: 35px; background: var(--amber); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0 2rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.7rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; border-left: 3px solid transparent; }
    .menu-link:hover, .menu-link.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: var(--gold); }
    .menu-link i.main-icon { width: 22px; color: var(--gold); font-size: 0.9rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); transition: margin 0.3s ease; }
    .top-bar { margin-bottom: 2rem; }
    .top-bar h1 { font-size: 1.8rem; font-weight: 800; }
    .top-bar p { color: #64748b; font-size: 0.95rem; }

    .layout { display: grid; grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; }
    .form-card { background: #fff; padding: 2rem; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); }
    .form-card h3 { margin-bottom: 1.5rem; font-size: 1.1rem; font-weight: 800; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-size: 0.8rem; font-weight: 800; margin-bottom: 0.5rem; }
    .form-control { width: 100%; padding: 0.9rem; border: 1px solid var(--frost); border-radius: 8px; font-family: inherit; background: var(--ice); font-size: 0.9rem; }
    textarea.form-control { resize: vertical; min-height: 100px; }
    .btn-submit { background: var(--navy); color: #fff; padding: 0.9rem; border-radius: 8px; border: none; font-weight: 800; cursor: pointer; width: 100%; transition: 0.2s; }
    .btn-submit:hover { background: var(--blue); }

    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow); border: 1px solid var(--frost); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1rem; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; }
    .data-table td { padding: 1rem; border-bottom: 1px solid var(--frost); font-size: 0.85rem; font-weight: 600; vertical-align: top; }
    
    .badge { padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
    .badge.pending { background: #fef3c7; color: #d97706; }
    .badge.approved { background: #dcfce7; color: #16a34a; }
    .badge.rejected { background: #fee2e2; color: #dc2626; }

    .alert { padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 700; font-size: 0.85rem; }
    .alert-success { background: #dcfce7; color: #16a34a; }
    .alert-error { background: #fee2e2; color: #dc2626; }

    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy); color: var(--gold); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0; width: 100%; padding: 1.5rem; padding-top: 5rem; }
      .layout { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li><a href="/sis/my/makeup-exams" class="menu-link active"><i class="fas fa-undo main-icon"></i> Makeup Exams</a></li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt main-icon"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    <div class="top-bar">
      <h1>Makeup Exam Application</h1>
      <p>Apply to retake an exam you missed due to valid reasons.</p>
    </div>

    <% if (flash.success && flash.success.length > 0) { %><div class="alert alert-success"><%= flash.success[0] %></div><% } %>
    <% if (flash.error && flash.error.length > 0) { %><div class="alert alert-error"><%= flash.error[0] %></div><% } %>

    <div class="layout">
      <div class="form-card">
        <h3><i class="fas fa-plus-circle" style="color: var(--amber);"></i> New Application</h3>
        <form method="POST" action="/sis/my/makeup-exams/request">
          <div class="form-group">
            <label>Select Course</label>
            <select name="course_id" class="form-control" required>
              <option value="" disabled selected>-- Choose a course --</option>
              <% enrolled.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.code %> - <%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Exam Type</label>
            <select name="exam_type" class="form-control" required>
              <option value="Midterm">Midterm Exam</option>
              <option value="Final">Final Exam</option>
            </select>
          </div>
          <div class="form-group">
            <label>Reason for Missing Exam</label>
            <textarea name="reason" class="form-control" placeholder="e.g. Medical emergency, family issue..." required></textarea>
          </div>
          <button type="submit" class="btn-submit">Submit Application</button>
        </form>
      </div>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Type</th>
              <th>Status</th>
              <th>Scheduled Date & Room</th>
            </tr>
          </thead>
          <tbody>
            <% if (requests.length === 0) { %>
              <tr><td colspan="4" style="text-align: center; padding: 2rem;">No makeup requests yet.</td></tr>
            <% } %>
            <% requests.forEach(r => { %>
              <tr>
                <td><strong style="color: var(--blue);"><%= r.code %></strong><br><%= r.title %></td>
                <td><%= r.exam_type %></td>
                <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
                <td>
                  <% if (r.status === 'approved' && r.scheduled_date) { %>
                    <strong style="color: var(--success);"><%= new Date(r.scheduled_date).toLocaleDateString() %></strong><br>
                    Room: <%= r.scheduled_room %>
                  <% } else { %>
                    —
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>
</body>
</html>