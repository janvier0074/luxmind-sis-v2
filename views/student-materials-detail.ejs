
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= section.code %> Materials — LuxMind SIS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --navy: #0a1e32;
      --deep: #0f2a44;
      --blue: #1e4d7b;
      --amber: #f5a623;
      --gold: #ffc857;
      --frost: #d9e6f2;
      --ice: #f7fafd;
      --shadow-soft: 0 5px 16px -6px rgba(10,30,50,0.12);
      --transition: all 0.25s ease;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--ice);
      min-height: 100vh;
      color: var(--navy);
      width: 100%;
    }

    /* Main content */
    .main-content {
      width: 100%;
      max-width: 1150px;
      margin: 0 auto;
      padding: 24px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--blue);
      font-weight: 800;
      text-decoration: none;
      margin-bottom: 18px;
      font-size: 0.82rem;
      transition: var(--transition);
    }

    .btn-back:hover {
      color: var(--amber);
      transform: translateX(-3px);
    }

    /* Course header */
    .hero {
      background: linear-gradient(135deg, var(--navy), var(--deep));
      border-radius: 14px;
      padding: 1.6rem;
      color: #fff;
      margin-bottom: 1.4rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 12px 25px -10px rgba(10,30,50,0.35);
    }

    .hero::before {
      content: '📖';
      position: absolute;
      right: -15px;
      bottom: -35px;
      font-size: 10rem;
      opacity: 0.05;
      pointer-events: none;
      transform: rotate(-15deg);
    }

    .hero-code {
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--gold);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .hero-title {
      font-size: 1.55rem;
      font-weight: 800;
      margin-bottom: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .hero-meta {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      font-size: 0.8rem;
      font-weight: 600;
      color: #cbd5e1;
    }

    .hero-meta span {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .hero-meta i {
      color: var(--gold);
    }

    /* Main two-column layout */
    .layout {
      display: grid;
      grid-template-columns: minmax(250px, 0.85fr) minmax(0, 1.65fr);
      gap: 18px;
      align-items: start;
    }

    /* Cards */
    .premium-card {
      background: #fff;
      border-radius: 13px;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      overflow: hidden;
      margin-bottom: 16px;
      min-width: 0;
    }

    .card-head {
      padding: 1rem 1.2rem;
      background: #f8fafc;
      border-bottom: 1px solid var(--frost);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .card-head i {
      font-size: 1.1rem;
      color: var(--amber);
    }

    .card-head h2 {
      font-size: 1rem;
      font-weight: 800;
      color: var(--navy);
    }

    .card-body {
      padding: 1.2rem;
      min-width: 0;
    }

    /* Syllabus */
    .syllabus-box {
      text-align: center;
      padding: 0.8rem;
    }

    .pdf-icon {
      font-size: 2.5rem;
      color: #dc2626;
      margin-bottom: 12px;
    }

    .syllabus-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--navy);
      overflow-wrap: anywhere;
      margin-bottom: 8px;
    }

    .btn-download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 11px;
      background: linear-gradient(135deg, var(--blue), #2563eb);
      color: #fff;
      text-decoration: none;
      border-radius: 9px;
      font-size: 0.82rem;
      font-weight: 800;
      transition: var(--transition);
      box-shadow: 0 4px 12px rgba(37,99,235,0.2);
    }

    .btn-download:hover {
      transform: translateY(-2px);
    }

    /* Moodle */
    .moodle-box {
      text-align: center;
      padding: 0.8rem;
      background: linear-gradient(135deg, #fff, #f8fafc);
    }

    .moodle-icon {
      font-size: 2.5rem;
      color: #f98012;
      margin-bottom: 12px;
    }

    .btn-moodle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 11px;
      background: linear-gradient(135deg, #f98012, #f97316);
      color: #fff;
      text-decoration: none;
      border-radius: 9px;
      font-size: 0.82rem;
      font-weight: 800;
      transition: var(--transition);
      box-shadow: 0 4px 12px rgba(249,128,18,0.2);
    }

    .btn-moodle:hover {
      transform: translateY(-2px);
    }

    /* Lecture timeline */
    .timeline {
      position: relative;
      padding-left: 1.7rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 0.65rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--frost);
    }

    .timeline-item {
      position: relative;
      margin-bottom: 1.2rem;
    }

    .timeline-dot {
      position: absolute;
      left: -1.55rem;
      top: 0.2rem;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 50%;
      background: #fff;
      border: 3px solid var(--amber);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.58rem;
      font-weight: 800;
      color: var(--navy);
      z-index: 1;
    }

    .timeline-content {
      background: #f8fafc;
      padding: 1rem;
      border-radius: 11px;
      border: 1px solid var(--frost);
      transition: var(--transition);
      min-width: 0;
    }

    .timeline-content:hover {
      border-color: var(--amber);
      box-shadow: 0 4px 12px rgba(245,166,35,0.05);
    }

    .week-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .week-title {
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--navy);
    }

    /* Files */
    .file-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .file-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px;
      background: #fff;
      border-radius: 8px;
      border: 1px solid #eef2f7;
      transition: var(--transition);
      min-width: 0;
    }

    .file-item:hover {
      border-color: var(--amber);
    }

    .file-info {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex: 1;
    }

    .file-info > i {
      font-size: 1.1rem;
      color: var(--blue);
      flex-shrink: 0;
    }

    .file-title {
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--navy);
      overflow-wrap: anywhere;
    }

    .file-name {
      font-size: 0.68rem;
      color: #94a3b8;
      font-weight: 600;
      margin-top: 3px;
      overflow-wrap: anywhere;
    }

    .btn-file-download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #f1f5f9;
      color: var(--blue);
      text-decoration: none;
      transition: var(--transition);
    }

    .btn-file-download:hover {
      background: var(--amber);
      color: #fff;
    }

    /* Empty states */
    .empty-box {
      text-align: center;
      padding: 1.5rem 1rem;
      color: #94a3b8;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .empty-box i {
      font-size: 2rem;
      color: var(--frost);
      display: block;
      margin-bottom: 8px;
    }

    /* Tablet */
    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
        gap: 12px;
      }
    }

    /* Mobile */
    @media (max-width: 600px) {
      .main-content {
        padding: 12px;
      }

      .btn-back {
        margin-bottom: 12px;
        font-size: 0.78rem;
      }

      .hero {
        padding: 1.2rem;
        border-radius: 12px;
        margin-bottom: 1rem;
      }

      .hero-title {
        font-size: 1.2rem;
      }

      .hero-code {
        font-size: 0.65rem;
        letter-spacing: 1px;
      }

      .hero-meta {
        flex-direction: column;
        gap: 7px;
        font-size: 0.75rem;
      }

      .card-head {
        padding: 0.85rem;
      }

      .card-head h2 {
        font-size: 0.9rem;
      }

      .card-body {
        padding: 0.85rem;
      }

      .timeline {
        padding-left: 1.5rem;
      }

      .timeline-dot {
        left: -1.4rem;
      }

      .timeline-content {
        padding: 0.8rem;
      }

      .week-title {
        font-size: 0.8rem;
      }

      .file-item {
        padding: 8px;
      }

      .file-title {
        font-size: 0.75rem;
      }

      .file-name {
        font-size: 0.63rem;
      }
    }

    /* Very small phones */
    @media (max-width: 360px) {
      .main-content {
        padding: 9px;
      }

      .hero-title {
        font-size: 1.05rem;
      }

      .week-header {
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>
  <main class="main-content">

    <a href="/sis/my/materials" class="btn-back">
      <i class="fas fa-arrow-left"></i>
      Back to All Courses
    </a>

    <!-- Course information -->
    <div class="hero">
      <div class="hero-code">
        <%= section.code %> · <%= section.group_name || 'Group' %>
      </div>

      <h1 class="hero-title"><%= section.title %></h1>

      <div class="hero-meta">
        <span>
          <i class="fas fa-chalkboard-teacher"></i>
          <%= section.teacher_name || 'TBA' %>
        </span>

        <span>
          <i class="fas fa-medal"></i>
          <%= section.credits %> Credits
        </span>
      </div>
    </div>

    <div class="layout">

      <!-- LEFT COLUMN: Syllabus and Moodle -->
      <div>

        <!-- Course syllabus -->
        <div class="premium-card">
          <div class="card-head">
            <i class="fas fa-file-pdf"></i>
            <h2>Course Syllabus</h2>
          </div>

          <div class="card-body syllabus-box">
            <% if (syllabus) { %>

              <i class="fas fa-file-pdf pdf-icon"></i>

              <div class="syllabus-title">
                <%= syllabus.file_name %>
              </div>

              <div style="font-size:0.72rem;color:#64748b;margin-bottom:12px;">
                Uploaded:
                <%= new Date(syllabus.uploaded_at).toLocaleDateString() %>
              </div>

              <a href="<%= syllabus.file_url %>"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="btn-download">
                <i class="fas fa-download"></i>
                Download Syllabus
              </a>

            <% } else { %>

              <div class="empty-box">
                <i class="fas fa-folder-open"></i>
                No syllabus has been uploaded yet.
              </div>

            <% } %>
          </div>
        </div>

        <!-- Moodle integration -->
        <% if (section.moodle_url) { %>

          <div class="premium-card">
            <div class="card-head">
              <i class="fab fa-moodle"></i>
              <h2>Moodle Integration</h2>
            </div>

            <div class="card-body moodle-box">
              <i class="fab fa-moodle moodle-icon"></i>

              <a href="<%= section.moodle_url %>"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="btn-moodle">
                <i class="fas fa-external-link-alt"></i>
                Open Moodle Course
              </a>
            </div>
          </div>

        <% } %>

      </div>

      <!-- RIGHT COLUMN: Lecture notes -->
      <div class="premium-card">

        <div class="card-head">
          <i class="fas fa-chalkboard"></i>
          <h2>Lecture Notes & Materials</h2>
        </div>

        <div class="card-body">

          <div class="timeline">

            <% let hasNotes = false; %>

            <% for (let i = 1; i <= 14; i++) { %>

              <% if (notesByWeek[i] && notesByWeek[i].length > 0) { %>

                <% hasNotes = true; %>

                <div class="timeline-item">

                  <div class="timeline-dot">
                    <%= i %>
                  </div>

                  <div class="timeline-content">

                    <div class="week-header">
                      <div class="week-title">
                        Week <%= i %>
                      </div>

                      <span style="font-size:0.7rem;font-weight:800;color:var(--amber);">
                        <%= notesByWeek[i].length %> file(s)
                      </span>
                    </div>

                    <div class="file-list">

                      <% notesByWeek[i].forEach(note => { %>

                        <div class="file-item">

                          <div class="file-info">

                            <i class="fas fa-file-alt"></i>

                            <div style="min-width:0;">
                              <div class="file-title">
                                <%= note.title %>
                              </div>

                              <div class="file-name">
                                <%= note.file_name %>
                              </div>
                            </div>

                          </div>

                          <a href="<%= note.file_url %>"
                             target="_blank"
                             rel="noopener noreferrer"
                             class="btn-file-download"
                             title="Download"
                             aria-label="Download <%= note.file_name %>">

                            <i class="fas fa-download"></i>

                          </a>

                        </div>

                      <% }) %>

                    </div>
                  </div>
                </div>

              <% } %>

            <% } %>

            <% if (!hasNotes) { %>

              <div class="empty-box">
                <i class="fas fa-inbox"></i>
                No lecture notes have been uploaded yet.
              </div>

            <% } %>

          </div>
        </div>
      </div>

    </div>
  </main>
</body>
</html>
