<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= section.code %> Materials — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.15), transparent); border-left-color: var(--gold); }
    .menu-link i { width: 24px; color: var(--gold); }
    .submenu { list-style: none; background: rgba(0,0,0,0.15); padding: 0.5rem 0; }
    .submenu .menu-link { padding-left: 3rem; font-size: 0.8rem; }

    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); max-width: 1400px; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.85rem; transition: var(--transition); }
    .btn-back:hover { color: var(--amber); transform: translateX(-3px); }

    .hero { background: linear-gradient(135deg, var(--navy), var(--deep)); border-radius: 1.5rem; padding: 2.5rem; color: #fff; margin-bottom: 2rem; position: relative; overflow: hidden; box-shadow: 0 20px 40px -10px rgba(10,30,50,0.4); }
    .hero::before { content: '📖'; position: absolute; right: -20px; bottom: -40px; font-size: 15rem; opacity: 0.05; pointer-events: none; transform: rotate(-15deg); }
    .hero-code { font-size: 0.75rem; font-weight: 800; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.5rem; }
    .hero-title { font-size: 2rem; font-weight: 800; margin-bottom: 0.8rem; }
    .hero-meta { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.85rem; font-weight: 600; color: #cbd5e1; }
    .hero-meta span { display: flex; align-items: center; gap: 0.4rem; }
    .hero-meta i { color: var(--gold); }

    .layout { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start; }
    
    .premium-card { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; margin-bottom: 2rem; }
    .card-head { padding: 1.5rem; background: #f8fafc; border-bottom: 1px solid var(--frost); display: flex; align-items: center; gap: 0.8rem; }
    .card-head i { font-size: 1.3rem; color: var(--amber); }
    .card-head h2 { font-size: 1.15rem; font-weight: 800; color: var(--navy); }
    .card-body { padding: 1.5rem; }

    /* Syllabus Card */
    .syllabus-box { text-align: center; padding: 1rem; }
    .pdf-icon { font-size: 3rem; color: #dc2626; margin-bottom: 1rem; }
    .syllabus-title { font-size: 0.95rem; font-weight: 800; color: var(--navy); word-break: break-all; margin-bottom: 0.5rem; }
    .btn-download { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 0.9rem; background: linear-gradient(135deg, var(--blue), #2563eb); color: #fff; text-decoration: none; border-radius: 10px; font-size: 0.9rem; font-weight: 800; transition: var(--transition); box-shadow: 0 4px 12px rgba(37,99,235,0.3); }
    .btn-download:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(37,99,235,0.4); }

    /* Moodle Card */
    .moodle-box { text-align: center; padding: 1rem; background: linear-gradient(135deg, #fff, #f8fafc); }
    .moodle-icon { font-size: 3rem; color: #f98012; margin-bottom: 1rem; }
    .btn-moodle { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 0.9rem; background: linear-gradient(135deg, #f98012, #f97316); color: #fff; text-decoration: none; border-radius: 10px; font-size: 0.9rem; font-weight: 800; transition: var(--transition); box-shadow: 0 4px 12px rgba(249,128,18,0.3); }
    .btn-moodle:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(249,128,18,0.4); }

    /* Timeline */
    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before { content: ''; position: absolute; left: 0.75rem; top: 0; bottom: 0; width: 2px; background: var(--frost); }
    .timeline-item { position: relative; margin-bottom: 1.5rem; }
    .timeline-dot { position: absolute; left: -1.65rem; top: 0.2rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #fff; border: 3px solid var(--amber); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 800; color: var(--navy); z-index: 1; }
    .timeline-content { background: #f8fafc; padding: 1.2rem; border-radius: 12px; border: 1px solid var(--frost); transition: var(--transition); }
    .timeline-content:hover { border-color: var(--amber); box-shadow: 0 4px 12px rgba(245,166,35,0.05); }
    
    .week-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .week-title { font-size: 0.95rem; font-weight: 800; color: var(--navy); }
    
    .file-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .file-item { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1rem; background: #fff; border-radius: 8px; border: 1px solid #eef2f7; transition: var(--transition); }
    .file-item:hover { border-color: var(--amber); transform: translateX(3px); }
    .file-info { display: flex; align-items: center; gap: 0.8rem; }
    .file-info i { font-size: 1.2rem; color: var(--blue); }
    .file-title { font-size: 0.85rem; font-weight: 800; color: var(--navy); }
    .file-name { font-size: 0.7rem; color: #94a3b8; font-weight: 600; margin-top: 2px; }
    .btn-file-download { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: #f1f5f9; color: var(--blue); text-decoration: none; transition: var(--transition); }
    .btn-file-download:hover { background: var(--amber); color: #fff; }

    .empty-box { text-align: center; padding: 2rem; color: #94a3b8; font-size: 0.85rem; font-weight: 600; }
    .empty-box i { font-size: 2.5rem; color: var(--frost); display: block; margin-bottom: 0.5rem; }
    
    @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-mark">L</div><div class="brand-name">LuxMind SIS <span>Student Portal</span></div></div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li>
        <a href="#" class="menu-link active"><i class="fas fa-book-open"></i> Courses</a>
        <ul class="submenu">
          <li><a href="/sis/my/materials" class="menu-link active"><i class="fas fa-folder-open"></i> Course Materials</a></li>
          <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
          <li><a href="/sis/my/attendance" class="menu-link"><i class="fas fa-check-square"></i> Attendance</a></li>
        </ul>
      </li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/my/materials" class="btn-back"><i class="fas fa-arrow-left"></i> Back to All Courses</a>

    <div class="hero">
      <div class="hero-code"><%= section.code %> · <%= section.group_name || 'Group' %></div>
      <h1 class="hero-title"><%= section.title %></h1>
      <div class="hero-meta">
        <span><i class="fas fa-chalkboard-teacher"></i> <%= section.teacher_name || 'TBA' %></span>
        <span><i class="fas fa-medal"></i> <%= section.credits %> Credits</span>
      </div>
    </div>

    <div class="layout">
      <!-- LEFT COLUMN: Syllabus & Moodle -->
      <div>
        <div class="premium-card">
          <div class="card-head">
            <i class="fas fa-file-pdf"></i>
            <h2>Course Syllabus</h2>
          </div>
          <div class="card-body syllabus-box">
            <% if (syllabus) { %>
              <i class="fas fa-file-pdf pdf-icon"></i>
              <div class="syllabus-title"><%= syllabus.file_name %></div>
              <div style="font-size: 0.75rem; color: #64748b; margin-bottom: 1rem;">Uploaded: <%= new Date(syllabus.uploaded_at).toLocaleDateString() %></div>
              <a href="<%= syllabus.file_url %>" target="_blank" class="btn-download"><i class="fas fa-download"></i> Download Syllabus</a>
            <% } else { %>
              <div class="empty-box">
                <i class="fas fa-folder-open"></i>
                No syllabus has been uploaded yet.
              </div>
            <% } %>
          </div>
        </div>

        <% if (section.moodle_url) { %>
          <div class="premium-card">
            <div class="card-head">
              <i class="fab fa-moodle"></i>
              <h2>Moodle Integration</h2>
            </div>
            <div class="card-body moodle-box">
              <i class="fab fa-moodle moodle-icon"></i>
              <a href="<%= section.moodle_url %>" target="_blank" class="btn-moodle"><i class="fas fa-external-link-alt"></i> Open Moodle Course</a>
            </div>
          </div>
        <% } %>
      </div>

      <!-- RIGHT COLUMN: Lecture Notes -->
      <div class="premium-card">
        <div class="card-head">
          <i class="fas fa-chalkboard"></i>
          <h2>Lecture Notes & Materials</h2>
        </div>
        <div class="card-body">
          <div class="timeline">
            <% let hasNotes = false; %>
            <% for(let i=1; i<=14; i++) { %>
              <% if (notesByWeek[i] && notesByWeek[i].length > 0) { %>
                <% hasNotes = true; %>
                <div class="timeline-item">
                  <div class="timeline-dot"><%= i %></div>
                  <div class="timeline-content">
                    <div class="week-header">
                      <div class="week-title">Week <%= i %></div>
                      <span style="font-size: 0.75rem; font-weight: 800; color: var(--amber);"><%= notesByWeek[i].length %> file(s)</span>
                    </div>
                    <div class="file-list">
                      <% notesByWeek[i].forEach(note => { %>
                        <div class="file-item">
                          <div class="file-info">
                            <i class="fas fa-file-alt"></i>
                            <div>
                              <div class="file-title"><%= note.title %></div>
                              <div class="file-name"><%= note.file_name %></div>
                            </div>
                          </div>
                          <a href="<%= note.file_url %>" target="_blank" class="btn-file-download" title="Download"><i class="fas fa-download"></i></a>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
            
            <% if (!hasNotes) { %>
              <div class="empty-box">
                <i class="fas fa-inbox"></i>
                No lecture notes have been uploaded yet.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>