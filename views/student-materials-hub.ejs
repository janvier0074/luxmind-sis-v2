
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Materials — LuxMind SIS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --navy: #0a1e32;
      --deep: #0f2a44;
      --blue: #1e4d7b;
      --amber: #f5a623;
      --gold: #ffc857;
      --frost: #d9e6f2;
      --ice: #f7fafd;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.18);
      --transition: all 0.25s ease;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--ice);
      min-height: 100vh;
      color: var(--navy);
      overflow-x: hidden;
    }

    .main-content {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--blue);
      font-weight: 800;
      text-decoration: none;
      margin-bottom: 24px;
      font-size: 0.85rem;
      transition: var(--transition);
    }

    .btn-back:hover {
      color: var(--amber);
      transform: translateX(-3px);
    }

    .page-title {
      margin-bottom: 28px;
    }

    .page-title h1 {
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 800;
      letter-spacing: -1px;
      margin-bottom: 8px;
    }

    .page-title p {
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .course-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: 20px;
      align-items: stretch;
    }

    .course-item {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .course-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--frost);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
    }

    .course-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: var(--amber);
    }

    .card-header {
      background: linear-gradient(135deg, var(--navy), var(--deep));
      padding: 16px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .course-code {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--gold);
      letter-spacing: 1px;
      text-transform: uppercase;
      overflow-wrap: anywhere;
    }

    .course-group {
      background: rgba(255,200,87,0.15);
      color: var(--gold);
      padding: 5px 10px;
      border-radius: 100px;
      font-size: 0.65rem;
      font-weight: 800;
      border: 1px solid rgba(255,200,87,0.3);
      white-space: nowrap;
    }

    .card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .course-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.5;
      margin-bottom: 8px;
      overflow-wrap: anywhere;
    }

    .course-teacher {
      font-size: 0.8rem;
      color: #64748b;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .course-teacher i {
      color: var(--amber);
      margin-right: 5px;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid #eef2f7;
    }

    .credits-badge {
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--blue);
      background: #e0f2fe;
      padding: 6px 9px;
      border-radius: 6px;
    }

    .view-btn {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--navy);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .course-card:hover .view-btn {
      color: var(--amber);
    }

    .forum-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #fff5df;
      color: #8a5700;
      border: 1px solid #f5d89d;
      padding: 10px 14px;
      border-radius: 9px;
      font-weight: 800;
      text-decoration: none;
      font-size: 0.75rem;
      transition: var(--transition);
      width: fit-content;
      max-width: 100%;
    }

    .forum-btn:hover {
      background: var(--amber);
      color: var(--navy);
    }

    .empty-state {
      background: #fff;
      padding: 48px 20px;
      border-radius: 16px;
      text-align: center;
      border: 2px dashed var(--frost);
      grid-column: 1 / -1;
    }

    .empty-state i {
      font-size: 2.5rem;
      color: #cbd5e1;
      margin-bottom: 16px;
      display: block;
    }

    .empty-state h3 {
      font-size: 1rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .empty-state p {
      color: #64748b;
      font-size: 0.85rem;
      line-height: 1.5;
    }

    @media (max-width: 600px) {
      .main-content {
        padding: 20px 15px;
      }

      .page-title {
        margin-bottom: 22px;
      }

      .page-title h1 {
        font-size: 1.45rem;
      }

      .page-title p {
        font-size: 0.82rem;
      }

      .course-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 15px;
      }

      .card-header {
        padding: 14px 16px;
      }

      .card-body {
        padding: 16px;
      }

      .course-title {
        font-size: 0.95rem;
      }

      .empty-state {
        padding: 35px 16px;
      }
    }
  </style>
</head>

<body>

  <main class="main-content">

    <a href="/sis/my" class="btn-back">
      <i class="fas fa-arrow-left"></i>
      Back to Dashboard
    </a>

    <div class="page-title">
      <h1>Course Materials 📚</h1>
      <p>Access your syllabus, lecture notes, and Moodle links for all your enrolled courses.</p>
    </div>

    <div class="course-grid">

      <% if (sections.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <h3>No active enrollments</h3>
          <p>You are not enrolled in any courses yet.</p>
        </div>
      <% } %>

      <% sections.forEach(sec => { %>

        <div class="course-item">

          <a href="/sis/course/<%= sec.section_id %>/forum" class="forum-btn">
            <i class="fas fa-comments"></i>
            Discussion Forum
          </a>

          <a href="/sis/my/materials/<%= sec.section_id %>" class="course-card">

            <div class="card-header">
              <span class="course-code"><%= sec.code %></span>
              <span class="course-group"><%= sec.group_name || '—' %></span>
            </div>

            <div class="card-body">
              <div class="course-title"><%= sec.title %></div>

              <div class="course-teacher">
                <i class="fas fa-chalkboard-teacher"></i>
                <%= sec.teacher_name || 'TBA' %>
              </div>

              <div class="card-footer">
                <span class="credits-badge">
                  <%= sec.credits %> Credits
                </span>

                <span class="view-btn">
                  View Materials
                  <i class="fas fa-arrow-right"></i>
                </span>
              </div>
            </div>

          </a>
        </div>

      <% }) %>

    </div>
  </main>

</body>
</html>
