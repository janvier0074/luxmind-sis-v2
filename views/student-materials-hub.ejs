<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Course Materials — LuxMind SIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --frost: #d9e6f2; --ice: #f7fafd;
      --shadow-soft: 0 8px 20px -6px rgba(10,30,50,0.12);
      --shadow-hover: 0 16px 32px -12px rgba(10,30,50,0.22);
      --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* Sidebar */
    .sidebar { width: 280px; background: linear-gradient(180deg, var(--navy), var(--deep)); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; z-index: 1000; }
    .sidebar-brand { padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 38px; height: 38px; background: linear-gradient(135deg, var(--amber), var(--gold)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.1rem; font-weight: 800; }
    .brand-name span { display: block; font-size: 0.6rem; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .sidebar-menu { list-style: none; padding: 0.5rem 0; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.2rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: var(--transition); border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.06); border-left-color: var(--amber); }
    .menu-link.active { color: #fff; background: linear-gradient(90deg, rgba(245,166,35,0.15), transparent); border-left-color: var(--gold); }
    .menu-link i { width: 24px; color: var(--gold); }
    .submenu { list-style: none; background: rgba(0,0,0,0.15); padding: 0.5rem 0; }
    .submenu .menu-link { padding-left: 3rem; font-size: 0.8rem; }

    /* Main Content */
    .main-content { margin-left: 280px; padding: 3rem; flex: 1; width: calc(100% - 280px); max-width: 1400px; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--blue); font-weight: 800; text-decoration: none; margin-bottom: 1.5rem; font-size: 0.85rem; transition: var(--transition); }
    .btn-back:hover { color: var(--amber); transform: translateX(-3px); }

    .page-title h1 { font-size: 2rem; font-weight: 800; letter-spacing: -1px; margin-bottom: 0.3rem; }
    .page-title p { color: #64748b; font-size: 0.95rem; font-weight: 500; margin-bottom: 2rem; }

    .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }
    
    .course-card { background: #fff; border-radius: 1.5rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; text-decoration: none; color: inherit; transition: var(--transition); display: flex; flex-direction: column; }
    .course-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-hover); border-color: var(--amber); }
    
    .card-header { background: linear-gradient(135deg, var(--navy), var(--deep)); padding: 1.2rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    .course-code { font-size: 0.75rem; font-weight: 800; color: var(--gold); letter-spacing: 1.5px; text-transform: uppercase; }
    .course-group { background: rgba(255,200,87,0.15); color: var(--gold); padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.65rem; font-weight: 800; border: 1px solid rgba(255,200,87,0.3); }
    
    .card-body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
    .course-title { font-size: 1.1rem; font-weight: 800; color: var(--navy); line-height: 1.3; margin-bottom: 0.5rem; }
    .course-teacher { font-size: 0.8rem; color: #64748b; font-weight: 600; margin-bottom: 1.5rem; }
    .course-teacher i { color: var(--amber); margin-right: 0.3rem; }
    
    .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 1rem; border-top: 1px solid #eef2f7; }
    .credits-badge { font-size: 0.75rem; font-weight: 800; color: var(--blue); background: #e0f2fe; padding: 0.3rem 0.6rem; border-radius: 6px; }
    .view-btn { font-size: 0.8rem; font-weight: 800; color: var(--navy); display: flex; align-items: center; gap: 0.4rem; }
    .course-card:hover .view-btn { color: var(--amber); }

    .empty-state { background: #fff; padding: 4rem 2rem; border-radius: 1.5rem; text-align: center; border: 2px dashed var(--frost); }
    .empty-state i { font-size: 3rem; color: var(--frost); margin-bottom: 1rem; display: block; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-mark">L</div><div class="brand-name">LuxMind SIS <span>Student Portal</span></div></div>
    <ul class="sidebar-menu">
      <li><a href="/sis/my" class="menu-link"><i class="fas fa-home"></i> Dashboard</a></li>
      <li>
        <a href="#" class="menu-link active"><i class="fas fa-book-open"></i> Courses</a>
        <ul class="submenu">
          <li><a href="/sis/my/materials" class="menu-link active"><i class="fas fa-folder-open"></i> Course Materials</a></li>
          <li><a href="/sis/my/timetable" class="menu-link"><i class="fas fa-calendar-alt"></i> Timetable</a></li>
          <li><a href="/sis/my/attendance" class="menu-link"><i class="fas fa-check-square"></i> Attendance</a></li>
        </ul>
      </li>
      <li><a href="/logout" class="menu-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="main-content">
    <a href="/sis/my" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    <div class="page-title">
      <h1>Course Materials 📚</h1>
      <p>Access your syllabus, lecture notes, and Moodle links for all your enrolled courses.</p>
    </div>

    <div class="course-grid">
      <% if (sections.length === 0) { %>
        <div class="empty-state" style="grid-column: 1 / -1;">
          <i class="fas fa-inbox"></i>
          <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem;">No active enrollments</h3>
          <p style="color: #64748b; font-size: 0.85rem;">You are not enrolled in any courses yet.</p>
        </div>
      <% } %>

      <% sections.forEach(sec => { %>



<a href="/sis/course/<%= sec.section_id %>/forum" style="display: inline-block; margin-bottom: 0.5rem; background: #f5a623; color: #0a1e32; padding: 0.4rem 1rem; border-radius: 100px; font-weight: 800; text-decoration: none; font-size: 0.75rem;">
  <i class="fas fa-comments"></i> Discussion Forum
</a>
        <a href="/sis/my/materials/<%= sec.section_id %>" class="course-card">
          <div class="card-header">
            <span class="course-code"><%= sec.code %></span>
            <span class="course-group"><%= sec.group_name || '—' %></span>
          </div>
          <div class="card-body">
            <div class="course-title"><%= sec.title %></div>
            <div class="course-teacher"><i class="fas fa-chalkboard-teacher"></i> <%= sec.teacher_name || 'TBA' %></div>
            <div class="card-footer">
              <span class="credits-badge"><%= sec.credits %> Credits</span>
              <span class="view-btn">View Materials <i class="fas fa-arrow-right"></i></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </main>
</body>
</html>