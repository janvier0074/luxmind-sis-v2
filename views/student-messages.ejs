```ejs
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Messages | LuxMind SIS</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mobile.css">

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

    :root {
      --navy: #0a1e32;
      --blue: #1e4d7b;
      --gold: #ffc857;
      --ice: #f7fafd;
      --frost: #d9e6f2;
      --muted: #64748b;
      --success: #16845d;
      --shadow: 0 8px 25px rgba(10,30,50,.07);
    }

    body {
      min-height: 100vh;
      background: var(--ice);
      color: var(--navy);
    }

    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: 265px;
      background: var(--navy);
      color: white;
      z-index: 1000;
      overflow-y: auto;
      transition: transform .3s ease;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 25px 22px;
      border-bottom: 1px solid rgba(255,255,255,.1);
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      background: var(--gold);
      color: var(--navy);
      border-radius: 11px;
      font-size: 22px;
      font-weight: 800;
    }

    .brand-name { font-weight: 800; font-size: 17px; }
    .brand-name span {
      display: block;
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 1.5px;
      margin-top: 4px;
    }

    .sidebar-menu {
      list-style: none;
      padding: 18px 0;
    }

    .menu-link {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 14px 22px;
      color: #a9b8c8;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      border-left: 4px solid transparent;
      transition: .2s;
    }

    .menu-link i {
      width: 20px;
      color: var(--gold);
    }

    .menu-link:hover,
    .menu-link.active {
      color: white;
      background: rgba(255,255,255,.07);
      border-left-color: var(--gold);
    }

    .main-content {
      margin-left: 265px;
      padding: 38px;
      min-height: 100vh;
    }

    .page-container {
      max-width: 1050px;
      margin: auto;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 30px;
    }

    .top-bar h1 {
      font-size: 27px;
      font-weight: 800;
    }

    .top-bar p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 7px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--blue);
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 25px;
    }

    .inbox-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 17px;
    }

    .inbox-heading h2 {
      font-size: 16px;
      font-weight: 800;
    }

    .message-count {
      color: var(--blue);
      background: #e8f1fa;
      border-radius: 30px;
      padding: 6px 12px;
      font-size: 11px;
      font-weight: 800;
    }

    .inbox-list {
      display: flex;
      flex-direction: column;
      gap: 17px;
    }

    .msg-card {
      background: white;
      border: 1px solid var(--frost);
      border-left: 5px solid var(--blue);
      border-radius: 14px;
      padding: 23px;
      box-shadow: var(--shadow);
    }

    .msg-card.unread {
      border-left-color: var(--gold);
      background: #fffefa;
    }

    .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 15px;
    }

    .msg-subject {
      font-size: 16px;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .msg-sender {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #edf4fa;
      color: var(--blue);
      padding: 7px 11px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
    }

    .unread-label {
      color: #946300;
      background: #fff2cf;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 800;
    }

    .msg-body {
      color: #475569;
      font-size: 13px;
      line-height: 1.8;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      padding: 15px;
      background: #f8fafc;
      border-radius: 9px;
    }

    .msg-meta {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #94a3b8;
      font-size: 11px;
      margin-top: 14px;
    }

    .reply-section {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #edf1f5;
    }

    .reply-section label {
      display: block;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 9px;
    }

    .reply-box {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .reply-input {
      width: 100%;
      min-height: 95px;
      resize: vertical;
      padding: 13px;
      border: 1px solid var(--frost);
      border-radius: 9px;
      outline: none;
      font-size: 13px;
      line-height: 1.6;
      color: var(--navy);
      background: white;
    }

    .reply-input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(30,77,123,.08);
    }

    .reply-actions {
      display: flex;
      justify-content: flex-end;
    }

    .btn-reply {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      background: var(--navy);
      color: white;
      border: none;
      border-radius: 9px;
      padding: 12px 20px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s;
    }

    .btn-reply:hover {
      background: var(--blue);
      transform: translateY(-1px);
    }

    .empty-state {
      background: white;
      border: 1px solid var(--frost);
      border-radius: 15px;
      padding: 65px 20px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .empty-icon {
      width: 75px;
      height: 75px;
      display: grid;
      place-items: center;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: #edf4fa;
      color: #91a9bf;
      font-size: 29px;
    }

    .empty-state h3 {
      font-size: 17px;
      margin-bottom: 9px;
    }

    .empty-state p {
      color: var(--muted);
      font-size: 12px;
    }

    .mobile-menu-btn {
      display: none;
      position: fixed;
      top: 15px;
      left: 15px;
      z-index: 1002;
      width: 43px;
      height: 43px;
      background: var(--navy);
      color: var(--gold);
      border: none;
      border-radius: 10px;
      font-size: 18px;
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10,30,50,.55);
      z-index: 999;
    }

    .alert {
      padding: 13px 16px;
      border-radius: 9px;
      margin-bottom: 18px;
      font-size: 12px;
      font-weight: 600;
    }

    .alert-success {
      background: #e9f8f0;
      color: #176b49;
    }

    .alert-error {
      background: #fff0f0;
      color: #a52c2c;
    }

    @media(max-width: 768px) {
      .mobile-menu-btn { display: grid; place-items: center; }

      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }

      .sidebar-overlay.active { display: block; }

      .main-content {
        margin-left: 0;
        padding: 75px 17px 25px;
      }

      .top-bar h1 { font-size: 23px; }

      .msg-card { padding: 17px; }

      .msg-header { flex-direction: column; }

      .reply-actions button { width: 100%; }
    }
  </style>

  <script src="/js/mobile.js" defer></script>
</head>

<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Open navigation">
    <i class="fas fa-bars"></i>
  </button>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">
        LuxMind SIS
        <span>STUDENT PORTAL</span>
      </div>
    </div>

    <ul class="sidebar-menu">
      <li>
        <a href="/sis/my" class="menu-link">
          <i class="fas fa-home"></i> Dashboard
        </a>
      </li>
      <li>
        <a href="/sis/my/messages" class="menu-link active">
          <i class="fas fa-envelope"></i> My Messages
        </a>
      </li>
      <li>
        <a href="/sis/my/announcements" class="menu-link">
          <i class="fas fa-bullhorn"></i> Announcements
        </a>
      </li>
      <li>
        <a href="/logout" class="menu-link">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </li>
    </ul>
  </aside>

  <main class="main-content">
    <div class="page-container">

      <a href="/sis/my" class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
      </a>

      <header class="top-bar">
        <div>
          <h1>My Messages</h1>
          <p>Communicate directly with your teachers through LuxMind SIS.</p>
        </div>
      </header>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <section>
        <div class="inbox-heading">
          <h2><i class="fas fa-inbox"></i> Inbox</h2>
          <span class="message-count">
            <%= Array.isArray(inbox) ? inbox.length : 0 %> Messages
          </span>
        </div>

        <div class="inbox-list">

          <% if (!Array.isArray(inbox) || inbox.length === 0) { %>

            <div class="empty-state">
              <div class="empty-icon">
                <i class="fas fa-envelope-open"></i>
              </div>
              <h3>Your inbox is empty</h3>
              <p>Messages from your teachers will appear here.</p>
            </div>

          <% } else { %>

            <% inbox.forEach(msg => { %>

              <article class="msg-card <%= msg.is_read ? '' : 'unread' %>">

                <div class="msg-header">
                  <div>
                    <h3 class="msg-subject">
                      <%= msg.subject || 'No subject' %>
                    </h3>
                  </div>

                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <% if (!msg.is_read) { %>
                      <span class="unread-label">NEW</span>
                    <% } %>

                    <span class="msg-sender">
                      <i class="fas fa-user-tie"></i>
                      <%= msg.sender_name || ('Account #' + msg.sender_id) %>
                    </span>
                  </div>
                </div>

                <div class="msg-body"><%= msg.body %></div>

                <div class="msg-meta">
                  <i class="far fa-clock"></i>
                  <%= msg.created_at ? new Date(msg.created_at).toLocaleString() : 'Date unavailable' %>
                </div>

                <div class="reply-section">
                  <form
                    method="POST"
                    action="/sis/my/messages/reply"
                    class="reply-box"
                  >
                    <input
                      type="hidden"
                      name="receiver_id"
                      value="<%= msg.sender_id %>"
                    >

                    <input
                      type="hidden"
                      name="subject"
                      value="<%= msg.subject || '' %>"
                    >

                    <label>Reply to this message</label>

                    <textarea
                      name="body"
                      class="reply-input"
                      placeholder="Write your reply here..."
                      maxlength="5000"
                      required
                    ></textarea>

                    <div class="reply-actions">
                      <button type="submit" class="btn-reply">
                        <i class="fas fa-paper-plane"></i>
                        Send Reply
                      </button>
                    </div>
                  </form>
                </div>

              </article>

            <% }) %>

          <% } %>

        </div>
      </section>

    </div>
  </main>

  <script>
    function toggleMobileMenu() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
  </script>

</body>
</html>
```