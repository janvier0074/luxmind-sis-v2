
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Messages | LuxMind SIS</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #10243a;
      --blue: #245b8f;
      --gold: #f4bd50;
      --background: #f3f6fb;
      --white: #ffffff;
      --muted: #718096;
      --border: #e3eaf2;
      --success: #16845d;
      --danger: #b42318;
      --shadow: 0 12px 35px rgba(16,36,58,.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      min-height: 100vh;
      background: var(--background);
      color: var(--navy);
    }

    a {
      text-decoration: none;
    }

    .top-header {
      background: var(--navy);
      color: white;
      padding: 0 6%;
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      box-shadow: 0 5px 20px rgba(16,36,58,.12);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .brand-mark {
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--gold);
      color: var(--navy);
      font-size: 23px;
      font-weight: 800;
    }

    .brand-name {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: .2px;
    }

    .brand-name span {
      display: block;
      color: var(--gold);
      font-size: 9px;
      letter-spacing: 2px;
      margin-top: 4px;
    }

    .header-links {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-link {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #d9e5f0;
      font-size: 12px;
      font-weight: 700;
      padding: 11px 15px;
      border-radius: 9px;
      transition: .2s;
    }

    .header-link:hover {
      background: rgba(255,255,255,.1);
      color: white;
    }

    .header-link.logout {
      color: var(--gold);
      border: 1px solid rgba(244,189,80,.35);
    }

    .main-content {
      width: 100%;
      max-width: 1250px;
      margin: 0 auto;
      padding: 42px 35px 65px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 28px;
    }

    .back-link:hover {
      color: var(--navy);
    }

    .page-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 32px;
      padding: 28px 30px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 17px;
      box-shadow: var(--shadow);
    }

    .heading-content {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .heading-icon {
      width: 60px;
      height: 60px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      background: #eaf2fa;
      color: var(--blue);
      font-size: 25px;
    }

    .page-heading h1 {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.6px;
    }

    .page-heading p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 7px;
      line-height: 1.6;
    }

    .heading-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 15px;
      border-radius: 10px;
      background: #fff7e5;
      color: #93640b;
      font-size: 11px;
      font-weight: 800;
    }

    .alert {
      padding: 14px 17px;
      border-radius: 11px;
      margin-bottom: 20px;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .alert-success {
      background: #e9f8f0;
      color: #176b49;
      border: 1px solid #c9eed9;
    }

    .alert-error {
      background: #fff0f0;
      color: var(--danger);
      border: 1px solid #f5d0d0;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 18px;
    }

    .section-heading h2 {
      font-size: 17px;
      font-weight: 800;
    }

    .section-heading h2 i {
      color: var(--blue);
      margin-right: 9px;
    }

    .message-count {
      color: var(--blue);
      background: #e8f1fa;
      border-radius: 30px;
      padding: 8px 14px;
      font-size: 11px;
      font-weight: 800;
    }

    .inbox-list {
      display: flex;
      flex-direction: column;
      gap: 19px;
    }

    .msg-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 5px solid var(--blue);
      border-radius: 15px;
      padding: 25px;
      box-shadow: var(--shadow);
      transition: transform .2s, box-shadow .2s;
    }

    .msg-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 38px rgba(16,36,58,.09);
    }

    .msg-card.unread {
      border-left-color: var(--gold);
      background: #fffefa;
    }

    .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 20px;
    }

    .msg-subject {
      font-size: 17px;
      font-weight: 800;
      overflow-wrap: anywhere;
      line-height: 1.5;
    }

    .msg-labels {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
    }

    .msg-sender {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #edf4fa;
      color: var(--blue);
      padding: 8px 12px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
    }

    .unread-label {
      color: #946300;
      background: #fff2cf;
      padding: 7px 11px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .5px;
    }

    .msg-body {
      color: #475569;
      font-size: 13px;
      line-height: 1.9;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      padding: 20px;
      background: #f7f9fc;
      border: 1px solid #edf1f6;
      border-radius: 11px;
    }

    .msg-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #94a3b8;
      font-size: 11px;
      margin-top: 16px;
    }

    .reply-section {
      margin-top: 23px;
      padding-top: 21px;
      border-top: 1px solid var(--border);
    }

    .reply-title {
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .reply-title i {
      color: var(--blue);
      margin-right: 7px;
    }

    .reply-box {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .reply-input {
      width: 100%;
      min-height: 115px;
      resize: vertical;
      padding: 15px;
      border: 1px solid var(--border);
      border-radius: 10px;
      outline: none;
      font-size: 13px;
      line-height: 1.7;
      color: var(--navy);
      background: white;
    }

    .reply-input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(36,91,143,.09);
    }

    .reply-input::placeholder {
      color: #a0acba;
    }

    .reply-actions {
      display: flex;
      justify-content: flex-end;
    }

    .btn-reply {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      background: var(--navy);
      color: white;
      border: none;
      border-radius: 9px;
      padding: 13px 21px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s;
    }

    .btn-reply:hover {
      background: var(--blue);
      transform: translateY(-1px);
    }

    .empty-state {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 75px 20px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .empty-icon {
      width: 82px;
      height: 82px;
      display: grid;
      place-items: center;
      margin: 0 auto 22px;
      border-radius: 50%;
      background: #edf4fa;
      color: #7897b5;
      font-size: 30px;
    }

    .empty-state h3 {
      font-size: 18px;
      margin-bottom: 10px;
      font-weight: 800;
    }

    .empty-state p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    .page-footer {
      text-align: center;
      color: #94a3b8;
      font-size: 10px;
      padding-top: 35px;
    }

    @media(max-width: 700px) {
      .top-header {
        padding: 15px 18px;
        min-height: 72px;
      }

      .brand-name {
        font-size: 15px;
      }

      .header-links {
        gap: 3px;
      }

      .header-link {
        padding: 9px;
        font-size: 11px;
      }

      .header-link span {
        display: none;
      }

      .main-content {
        padding: 25px 15px 45px;
      }

      .page-heading {
        padding: 21px 18px;
      }

      .heading-icon {
        width: 48px;
        height: 48px;
        font-size: 20px;
      }

      .page-heading h1 {
        font-size: 21px;
      }

      .heading-badge {
        width: 100%;
        justify-content: center;
      }

      .msg-card {
        padding: 18px;
      }

      .msg-header {
        flex-direction: column;
      }

      .msg-subject {
        font-size: 15px;
      }

      .reply-actions button {
        width: 100%;
      }
    }

    @media(max-width: 380px) {
      .brand-mark {
        width: 37px;
        height: 37px;
      }

      .brand-name {
        font-size: 13px;
      }

      .heading-content {
        gap: 11px;
      }
    }
  </style>
</head>

<body>

  <header class="top-header">
    <div class="brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">
        LuxMind SIS
        <span>STUDENT PORTAL</span>
      </div>
    </div>

    <nav class="header-links">
      <a href="/sis/my" class="header-link">
        <i class="fas fa-home"></i>
        <span>Dashboard</span>
      </a>

      <a href="/logout" class="header-link logout">
        <i class="fas fa-sign-out-alt"></i>
        <span>Logout</span>
      </a>
    </nav>
  </header>

  <main class="main-content">

    <a href="/sis/my" class="back-link">
      <i class="fas fa-arrow-left"></i>
      Back to Dashboard
    </a>

    <section class="page-heading">
      <div class="heading-content">
        <div class="heading-icon">
          <i class="fas fa-envelope"></i>
        </div>

        <div>
          <h1>My Messages</h1>
          <p>Communicate directly with your teachers through LuxMind SIS.</p>
        </div>
      </div>

      <div class="heading-badge">
        <i class="fas fa-shield-alt"></i>
        Private Student Inbox
      </div>
    </section>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        <i class="fas fa-check-circle"></i>
        <%= success %>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <i class="fas fa-exclamation-circle"></i>
        <%= error %>
      </div>
    <% } %>

    <section>
      <div class="section-heading">
        <h2><i class="fas fa-inbox"></i> Inbox</h2>

        <span class="message-count">
          <%= Array.isArray(inbox) ? inbox.length : 0 %> Messages
        </span>
      </div>

      <div class="inbox-list">

        <% if (!Array.isArray(inbox) || inbox.length === 0) { %>

          <div class="empty-state">
            <div class="empty-icon">
              <i class="fas fa-envelope-open"></i>
            </div>

            <h3>Your inbox is empty</h3>
            <p>Messages from your teachers will appear here.</p>
          </div>

        <% } else { %>

          <% inbox.forEach(msg => { %>

            <article class="msg-card <%= msg.is_read ? '' : 'unread' %>">

              <div class="msg-header">
                <div>
                  <h3 class="msg-subject">
                    <%= msg.subject || 'No subject' %>
                  </h3>
                </div>

                <div class="msg-labels">
                  <% if (!msg.is_read) { %>
                    <span class="unread-label">NEW</span>
                  <% } %>

                  <span class="msg-sender">
                    <i class="fas fa-user-tie"></i>
                    <%= msg.sender_name || ('Account #' + msg.sender_id) %>
                  </span>
                </div>
              </div>

              <div class="msg-body"><%= msg.body %></div>

              <div class="msg-meta">
                <i class="far fa-clock"></i>
                <%= msg.created_at ? new Date(msg.created_at).toLocaleString() : 'Date unavailable' %>
              </div>

              <div class="reply-section">

                <div class="reply-title">
                  <i class="fas fa-reply"></i>
                  Reply to this message
                </div>

                <form
                  method="POST"
                  action="/sis/my/messages/reply"
                  class="reply-box"
                >

                  <input
                    type="hidden"
                    name="receiver_id"
                    value="<%= msg.sender_id %>"
                  >

                  <input
                    type="hidden"
                    name="subject"
                    value="<%= msg.subject || '' %>"
                  >

                  <textarea
                    name="body"
                    class="reply-input"
                    placeholder="Write your reply here..."
                    maxlength="5000"
                    required
                  ></textarea>

                  <div class="reply-actions">
                    <button type="submit" class="btn-reply">
                      <i class="fas fa-paper-plane"></i>
                      Send Reply
                    </button>
                  </div>

                </form>
              </div>

            </article>

          <% }) %>

        <% } %>

      </div>
    </section>

    <footer class="page-footer">
      © <%= new Date().getFullYear() %> LuxMind SIS. All rights reserved.
    </footer>

  </main>

</body>
</html>
