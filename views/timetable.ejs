<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>My Timetable - LuxMind</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --bg-body: #f4f6fa; --bg-surface: #ffffff;
      --text-main: #0a1e32; --text-muted: #64748b;
      --primary: #1e4d7b; --border: #e2e8f0;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--bg-body); color: var(--text-main); padding: 10px; }
    
    /* Top Bar */
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .btn-back { display: inline-flex; align-items: center; gap: 6px; background: var(--primary); color: white; text-decoration: none; padding: 8px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; }
    .btn-back:hover { background: #153a5e; }

    /* Ultra-Compact Timetable */
    .timetable-wrapper { 
      background: var(--bg-surface); 
      border-radius: 8px; 
      border: 1px solid var(--border); 
      overflow: hidden; 
      width: 100%;
    }
    
    table { 
      width: 100%; 
      border-collapse: collapse; 
      table-layout: fixed; /* Forces table to fit the screen */
    }
    
    th, td { 
      border: 1px solid var(--border); 
      text-align: center; 
      vertical-align: middle; 
      padding: 2px; /* Tiny padding */
    }

    th { 
      background: #f8fafc; 
      font-size: 9px; 
      font-weight: 800; 
      color: var(--primary); 
      text-transform: uppercase; 
      height: 24px;
    }
    
    .time-col { 
      width: 32px; /* Very narrow time column */
      font-size: 8.5px; 
      font-weight: 700; 
      color: var(--text-muted); 
      background: #f8fafc;
    }

    .slot { height: 40px; background: #fff; }

    /* Tiny Course Blocks */
    .course-tile { 
      display: flex; 
      flex-direction: column; 
      justify-content: center;
      align-items: center;
      padding: 2px; 
      border-radius: 3px; 
      color: white; 
      font-size: 8px; 
      line-height: 1.1; 
      height: 100%; 
      overflow: hidden; 
    }
    .course-tile .code { font-weight: 800; font-size: 9px; }
    .course-tile .meta { font-size: 7.5px; opacity: 0.9; }
  </style>
</head>
<body>

  <!-- ONLY THE BACK BUTTON -->
  <div class="top-bar">
    <a href="/sis/my" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
  </div>

  <!-- THE TIMETABLE (FITS MOBILE WIDTH) -->
  <div class="timetable-wrapper">
    <table>
      <thead>
        <tr>
          <th class="time-col">Time</th>
          <% days.forEach(day => { %>
            <th><%= day.substring(0, 3) %></th> <!-- Mon, Tue, Wed... -->
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% timeSlots.forEach((time, timeIndex) => { %>
          <tr>
            <td class="time-col"><%= time %></td>
            <% days.forEach(day => { 
                 const course = grid[day][time];
                 let isCovered = false;
                 
                 for (let i = timeIndex - 1; i >= 0; i--) {
                   const prevCourse = grid[day][timeSlots[i]];
                   if (prevCourse && prevCourse.end_time > time) {
                     isCovered = true;
                     break;
                   }
                 }
                 if (isCovered) return; 
            %>
              <% if (course) { 
                   let rowspan = 1;
                   let checkHour = parseInt(time.split(':')[0]) + 1;
                   while (timeSlots.includes(checkHour.toString().padStart(2, '0') + ':00') && course.end_time > (checkHour.toString().padStart(2, '0') + ':00')) {
                     rowspan++; 
                     checkHour++;
                   }
              %>
                <td rowspan="<%= rowspan %>" style="padding: 1px;">
                  <div class="course-tile" style="background-color: <%= course.color %>;">
                    <div class="code"><%= course.code %></div>
                    <div class="meta"><%= course.room || 'TBA' %></div>
                  </div>
                </td>
              <% } else { %>
                <td class="slot"></td>
              <% } %>
            <% }); %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

</body>
</html>