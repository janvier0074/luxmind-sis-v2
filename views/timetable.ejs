<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Timetable</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 10px; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); letter-spacing: -0.5px; }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Warning Banner */
    .warning-banner { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; padding: 1rem 1.5rem; border-radius: 1rem; font-weight: 600; font-size: 0.9rem; margin-bottom: 1.5rem; display: flex; gap: 0.8rem; align-items: flex-start; }
    .warning-banner i { font-size: 1.2rem; margin-top: 2px; }

    /* Table Design */
    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1.2rem 1rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .data-table td { padding: 1.2rem 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; vertical-align: middle; }
    .data-table tr:hover { background: var(--ice); }
    
    .course-code { color: var(--blue); font-weight: 800; font-size: 0.9rem; }
    .course-name { color: var(--navy); font-weight: 700; }
    .instructor-name { color: #475569; font-weight: 500; font-size: 0.85rem; }
    .group-badge { background: var(--mist); color: var(--navy); padding: 0.3rem 0.8rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; border: 1px solid var(--frost); }
    
    /* Action Buttons */
    .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 8px; text-decoration: none; transition: 0.2s; border: 1px solid var(--frost); background: #fff; color: var(--blue); }
    .action-btn:hover { background: var(--blue); color: #fff; border-color: var(--blue); transform: translateY(-2px); }
    .action-btn.moodle { color: var(--amber); }
    .action-btn.moodle:hover { background: var(--amber); color: var(--navy); border-color: var(--amber); }
    
    .empty-state { text-align: center; padding: 4rem 2rem; color: #64748b; }
    .empty-state i { font-size: 3rem; color: var(--frost); margin-bottom: 1rem; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/my" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i> Student <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i> Course <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu open">
              <li class="menu-item"><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit main-icon"></i> Course Registration</a></li>
              <li class="menu-item"><a href="/sis/my/timetable" class="menu-link active"><i class="fas fa-calendar-alt main-icon"></i> Timetable</a></li>
              <li class="menu-item"><a href="#" class="menu-link"><i class="fas fa-check-circle main-icon"></i> Attendance Detail</a></li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <div class="top-bar">
      <div class="greeting">
        <h1>Course Timetable</h1>
        <p>Your enrolled courses for this semester.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-circle"></i>
        <%= user.admission_number || user.username %>
      </div>
    </div>

    <!-- CIU Warning Banner -->
    <div class="warning-banner">
      <i class="fas fa-exclamation-triangle"></i>
      <div>
        Students will have <strong>N/A</strong> grade and will not be able to write the final exam for the course(s) which have attendance less than the required attendance identified by LuxMind's Rules and Regulations.
      </div>
    </div>

    <!-- Table -->
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Course Instructor(s)</th>
            <th>Group</th>
            <th style="text-align: center;">Syllabus</th>
            <th style="text-align: center;">Attendance</th>
            <th style="text-align: center;">MOODLE</th>
          </tr>
        </thead>
        <tbody>
          <% if (courses.length === 0) { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <i class="fas fa-book-open"></i>
                  <h3>No courses found</h3>
                  <p>You are not currently enrolled in any courses.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% courses.forEach(course => { %>
              <tr>
                <td><span class="course-code"><%= course.code %></span></td>
                <td><span class="course-name"><%= course.title %></span></td>
                <td><span class="instructor-name"><%= course.teacher_name || 'TBA' %></span></td>
                <td><span class="group-badge"><%= course.group_name || 'N/A' %></span></td>
                
                <!-- Action Buttons using the REAL database links we just created -->
                <td style="text-align: center;">
                  <a href="<%= course.syllabus_url || '#' %>" target="_blank" class="action-btn" title="Download Syllabus"><i class="fas fa-file-pdf"></i></a>
                </td>
                <td style="text-align: center;">
                  <!-- This will link to the attendance page later -->
                  <a href="#" class="action-btn" title="View Attendance"><i class="fas fa-user-check"></i></a>
                </td>
                <td style="text-align: center;">
                  <a href="<%= course.moodle_url || '#' %>" target="_blank" class="action-btn moodle" title="Go to Moodle"><i class="fas fa-external-link-alt"></i></a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>

  <script>
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) submenu.classList.toggle('open');
    }
  </script>
</body>
</html>