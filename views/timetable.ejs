<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LuxMind SIS - My Timetable</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0a1e32; --deep: #0f2a44; --blue: #1e4d7b; --amber: #f5a623;
      --gold: #ffc857; --mist: #eef4fa; --frost: #d9e6f2; --ice: #f7fafd;
      --success: #1f8a5f; --danger: #b33e2e;
      --shadow-soft: 0 8px 20px -6px rgba(10, 30, 50, 0.12);
    }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--ice); min-height: 100vh; display: flex; color: var(--navy); }

    /* --- SIDEBAR --- */
    .sidebar { width: 280px; background: var(--navy); color: #fff; position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1); z-index: 100; }
    .sidebar-brand { padding: 2rem 1.5rem; display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--navy); z-index: 10; }
    .brand-mark { width: 40px; height: 40px; background: var(--amber); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: var(--navy); }
    .brand-name { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.5px; }
    .brand-name span { display: block; font-size: 0.65rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 1rem 0; }
    .menu-item { cursor: pointer; }
    .menu-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 600; transition: 0.2s; border-left: 3px solid transparent; }
    .menu-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .menu-link i.main-icon { width: 25px; color: var(--gold); font-size: 0.95rem; opacity: 0.8; }
    .menu-link .arrow { margin-left: auto; font-size: 0.65rem; transition: transform 0.3s; }
    .menu-link.active { color: #fff; background: rgba(255,255,255,0.1); border-left-color: var(--gold); }
    .submenu { list-style: none; display: none; background: rgba(0,0,0,0.15); }
    .submenu.open { display: block; }
    .submenu .menu-link { padding-left: 3.5rem; font-size: 0.8rem; }
    .submenu .submenu .menu-link { padding-left: 4.5rem; font-size: 0.75rem; }
    .menu-item.open > .menu-link .arrow { transform: rotate(90deg); }

    /* --- MAIN CONTENT --- */
    .main-content { margin-left: 280px; padding: 2.5rem; flex: 1; width: calc(100% - 280px); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .greeting h1 { font-size: 1.8rem; font-weight: 800; color: var(--navy); }
    .greeting p { color: #64748b; font-weight: 500; font-size: 0.95rem; margin-top: 0.3rem; }
    .user-pill { background: #fff; padding: 0.5rem 1rem; border-radius: 100px; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); font-weight: 700; font-size: 0.9rem; }
    .user-pill i { color: var(--amber); }

    /* Warning Banner */
    .warning-banner { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; padding: 1rem 1.5rem; border-radius: 1rem; font-weight: 600; font-size: 0.9rem; margin-bottom: 2rem; display: flex; gap: 0.8rem; align-items: flex-start; }
    .warning-banner i { font-size: 1.2rem; margin-top: 2px; }

    /* --- 1. CIU TABLE (Top) --- */
    .table-container { background: #fff; border-radius: 1.25rem; box-shadow: var(--shadow-soft); border: 1px solid var(--frost); overflow: hidden; margin-bottom: 3rem; }
    .data-table { width: 100%; border-collapse: collapse; text-align: left; }
    .data-table th { background: var(--navy); color: #fff; padding: 1.2rem 1rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .data-table td { padding: 1.2rem 1rem; border-bottom: 1px solid var(--frost); font-size: 0.9rem; font-weight: 600; vertical-align: middle; }
    .data-table tr:hover { background: var(--ice); }
    .course-code { color: var(--blue); font-weight: 800; font-size: 0.9rem; }
    .course-name { color: var(--navy); font-weight: 700; }
    .instructor-name { color: #475569; font-weight: 500; font-size: 0.85rem; }
    .group-badge { background: var(--mist); color: var(--navy); padding: 0.3rem 0.8rem; border-radius: 100px; font-size: 0.75rem; font-weight: 800; border: 1px solid var(--frost); }
    
    .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 8px; text-decoration: none; transition: 0.2s; border: 1px solid var(--frost); background: #fff; color: var(--blue); }
    .action-btn:hover { background: var(--blue); color: #fff; border-color: var(--blue); transform: translateY(-2px); }
    .action-btn.moodle { color: var(--amber); }
    .action-btn.moodle:hover { background: var(--amber); color: var(--navy); border-color: var(--amber); }

    /* --- 2. COLORFUL VISUAL GRID (Bottom) --- */
    .section-title { font-size: 1.2rem; font-weight: 800; color: var(--navy); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.8rem; }
    .section-title i { color: var(--amber); }

    .weekly-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
    
    .day-column { background: #fff; border-radius: 1rem; border: 1px solid var(--frost); overflow: hidden; box-shadow: var(--shadow-soft); display: flex; flex-direction: column; }
    .day-header { background: var(--navy); color: var(--gold); padding: 1rem; text-align: center; font-weight: 800; font-size: 0.9rem; border-bottom: 2px solid var(--amber); }
    .day-body { padding: 0.8rem; display: flex; flex-direction: column; gap: 0.8rem; flex: 1; min-height: 200px; }

    /* Colorful Course Blocks */
    .course-block { padding: 1rem; border-radius: 10px; color: #fff; position: relative; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .course-block::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: rgba(255,255,255,0.5); }
    
    /* Gradients */
    .color-0 { background: linear-gradient(135deg, #1e4d7b, #3b7cb9); } /* Blue */
    .color-1 { background: linear-gradient(135deg, #6a3f8c, #9b6fd1); } /* Purple */
    .color-2 { background: linear-gradient(135deg, #2a9d8f, #4ecdc4); } /* Teal */
    .color-3 { background: linear-gradient(135deg, #e76f51, #f4a261); } /* Orange */
    .color-4 { background: linear-gradient(135deg, #d35454, #e77a7a); } /* Red */

    .block-code { font-size: 0.75rem; font-weight: 800; opacity: 0.9; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.3rem; }
    .block-title { font-size: 0.9rem; font-weight: 700; line-height: 1.2; margin-bottom: 0.5rem; }
    .block-meta { font-size: 0.7rem; font-weight: 600; opacity: 0.9; display: flex; flex-direction: column; gap: 0.2rem; }
    .block-meta i { width: 12px; margin-right: 4px; }
    .empty-day { display: flex; align-items: center; justify-content: center; color: #cbd5e1; font-size: 0.8rem; font-weight: 600; font-style: italic; flex: 1; }
  
    /* --- MOBILE FIXES (AUTO-INJECTED) --- */
    .mobile-menu-btn { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 1001; background: var(--navy, #0a1e32); color: var(--gold, #ffc857); border: none; width: 45px; height: 45px; border-radius: 10px; font-size: 1.2rem; cursor: pointer; box-shadow: 0 8px 20px -6px rgba(10,30,50,0.12); align-items: center; justify-content: center; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10,30,50,0.5); z-index: 999; backdrop-filter: blur(2px); }
    .btn-back { display: none; align-items: center; gap: 0.5rem; color: var(--blue, #1e4d7b); font-weight: 800; text-decoration: none; margin-bottom: 1rem; font-size: 0.9rem; }

    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
      .sidebar.active { transform: translateX(0); }
      .sidebar-overlay.active { display: block; }
      .main-content { margin-left: 0 !important; width: 100% !important; padding: 1.5rem !important; padding-top: 5rem !important; }
      .btn-back { display: inline-flex; }
      .layout, .finance-layout, .attendance-grid, .tile-grid, .course-grid, .stats-grid, .semester-grid, .weekly-grid, .data-table { 
        grid-template-columns: 1fr !important; 
        gap: 1rem !important; 
      }
      .table-container, .table-wrapper { display: block; overflow-x: auto; white-space: nowrap; }
    }

  </style>
</head>
<body>

  <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileMenu()"></div>


  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">L</div>
      <div class="brand-name">LuxMind SIS <span>Student Portal</span></div>
    </div>
    <ul class="sidebar-menu">
      <li class="menu-item"><a href="/sis/my" class="menu-link"><i class="fas fa-home main-icon"></i> Dashboard</a></li>
      <li class="menu-item open">
        <a href="#" class="menu-link active" onclick="toggle(event, this)">
          <i class="fas fa-user-graduate main-icon"></i> Student <i class="fas fa-chevron-right arrow"></i>
        </a>
        <ul class="submenu open">
          <li class="menu-item open">
            <a href="#" class="menu-link" onclick="toggle(event, this)">
              <i class="fas fa-book-open main-icon"></i> Course <i class="fas fa-chevron-right arrow"></i>
            </a>
            <ul class="submenu open">
              <li class="menu-item"><a href="/sis/my/registration" class="menu-link"><i class="fas fa-edit main-icon"></i> Course Registration</a></li>
              <li class="menu-item"><a href="/sis/my/timetable" class="menu-link active"><i class="fas fa-calendar-alt main-icon"></i> Timetable</a></li>
              <li class="menu-item"><a href="/sis/my/attendance" class="menu-link"><i class="fas fa-check-circle main-icon"></i> Attendance Detail</a></li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <a href="javascript:history.back()" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

    
    <div class="top-bar">
      <div class="greeting">
        <h1>My Timetable</h1>
        <p>Your weekly class schedule and course details.</p>
      </div>
      <div class="user-pill">
        <i class="fas fa-user-circle"></i>
        <%= user.admission_number || user.username %>
      </div>
    </div>

    <!-- WARNING BANNER -->
    <div class="warning-banner">
      <i class="fas fa-exclamation-triangle"></i>
      <div>
        Students will have <strong>N/A</strong> grade and will not be able to write the final exam for the course(s) which have attendance less than the required attendance identified by LuxMind's Rules and Regulations.
      </div>
    </div>

    <!-- 1. DETAILED COURSE TABLE -->
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Course Instructor(s)</th>
            <th>Group</th>
            <th style="text-align: center;">Syllabus</th>
            <th style="text-align: center;">Attendance</th>
            <th style="text-align: center;">MOODLE</th>
          </tr>
        </thead>
        <tbody>
          <% if (courses.length === 0) { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 2rem; color: #64748b;">You are not enrolled in any courses.</td>
            </tr>
          <% } else { %>
            <% courses.forEach(course => { %>
              <tr>
                <td><span class="course-code"><%= course.code %></span></td>
                <td><span class="course-name"><%= course.title %></span></td>
                <td><span class="instructor-name"><%= course.teacher_name || 'TBA' %></span></td>
                <td><span class="group-badge"><%= course.group_name || 'N/A' %></span></td>
                <td style="text-align: center;"><a href="<%= course.syllabus_url || '#' %>" target="_blank" class="action-btn"><i class="fas fa-file-pdf"></i></a></td>
                <td style="text-align: center;"><a href="/sis/my/attendance" class="action-btn"><i class="fas fa-user-check"></i></a></td>
                <td style="text-align: center;"><a href="<%= course.moodle_url || '#' %>" target="_blank" class="action-btn moodle"><i class="fas fa-external-link-alt"></i></a></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- 2. COLORFUL WEEKLY GRID -->
    <div class="section-title"><i class="fas fa-calendar-week"></i> Weekly Schedule</div>
    
    <div class="weekly-grid">
      <% days.forEach(day => { %>
        <div class="day-column">
          <div class="day-header"><%= day %></div>
          <div class="day-body">
            <% if (schedule[day].length === 0) { %>
              <div class="empty-day">No Classes</div>
            <% } else { %>
              <% schedule[day].forEach(cls => { %>
                <div class="course-block color-<%= cls.colorIndex %>">
                  <div class="block-code"><%= cls.code %></div>
                  <div class="block-title"><%= cls.title %></div>
                  <div class="block-meta">
                    <span><i class="fas fa-clock"></i> <%= cls.start_time || 'TBA' %> - <%= cls.end_time || 'TBA' %></span>
                    <span><i class="fas fa-door-open"></i> <%= cls.room || 'TBA' %></span>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

  
  <script>
    // 1. Toggle menu function
    function toggle(event, element) {
      event.preventDefault();
      const parent = element.parentElement;
      parent.classList.toggle('open');
      const submenu = parent.querySelector('.submenu');
      if (submenu) {
        submenu.classList.toggle('open');
        // Save the state to browser memory
        const text = element.innerText.trim().split('\n')[0]; 
        if (parent.classList.contains('open')) {
          localStorage.setItem('menu_' + text, 'open');
        } else {
          localStorage.removeItem('menu_' + text);
        }
      }
    }

    // 2. Mobile toggle function
    function toggleMobileMenu() {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb && ov) {
        sb.classList.toggle('active');
        ov.classList.toggle('active');
      }
    }

    // 3. Restore open menus on page load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.menu-link').forEach(link => {
        if (link.nextElementSibling && link.nextElementSibling.classList.contains('submenu')) {
          const text = link.innerText.trim().split('\n')[0];
          if (localStorage.getItem('menu_' + text) === 'open') {
            link.parentElement.classList.add('open');
            link.nextElementSibling.classList.add('open');
          }
        }
      });
    });
  </script>

</body>
</html>